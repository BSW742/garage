---
// Where the site owner reads and answers a conversation. The token in the URL
// is the whole credential, so there is nothing to log into — they tap the link
// in the alert and start typing.
const { token } = Astro.params;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Reply · garage.co.nz</title>
    <style>
      :root {
        --ink: #10131a;
        --soft: #626b7d;
        --line: #dfe4ec;
        --wash: #f4f6fa;
        --accent: #2563eb;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--wash);
        color: var(--ink);
        display: flex;
        flex-direction: column;
        height: 100dvh;
      }
      header {
        padding: 0.9rem 1rem;
        background: #fff;
        border-bottom: 1px solid var(--line);
      }
      header strong { display: block; font-size: 1rem; }
      header span { font-size: 0.82rem; color: var(--soft); }
      #log {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .msg {
        max-width: 78%;
        padding: 0.6rem 0.85rem;
        border-radius: 14px;
        font-size: 0.95rem;
        line-height: 1.45;
        white-space: pre-wrap;
        word-wrap: break-word;
      }
      .visitor { align-self: flex-start; background: #fff; border: 1px solid var(--line); }
      .owner { align-self: flex-end; background: var(--accent); color: #fff; }
      .when { font-size: 0.7rem; color: var(--soft); margin-top: 0.15rem; }
      .owner .when { color: rgba(255,255,255,0.75); }
      form {
        display: flex;
        gap: 0.5rem;
        padding: 0.75rem;
        background: #fff;
        border-top: 1px solid var(--line);
      }
      textarea {
        flex: 1;
        resize: none;
        font: inherit;
        padding: 0.6rem 0.8rem;
        border: 1px solid var(--line);
        border-radius: 12px;
        min-height: 44px;
        max-height: 120px;
      }
      button {
        border: 0;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        padding: 0 1.1rem;
        border-radius: 12px;
        cursor: pointer;
      }
      button:disabled { opacity: 0.5; }
      #note { padding: 1.5rem; text-align: center; color: var(--soft); }
    </style>
  </head>
  <body>
    <header>
      <strong id="who">Loading…</strong>
      <span id="meta"></span>
    </header>

    <div id="log"></div>
    <p id="note" hidden></p>

    <form id="form" hidden>
      <textarea id="text" placeholder="Write a reply…" rows="1"></textarea>
      <button type="submit">Send</button>
    </form>

    <script is:inline define:vars={{ token }}>
      const log = document.getElementById('log');
      const form = document.getElementById('form');
      const text = document.getElementById('text');
      const note = document.getElementById('note');
      let seen = 0;

      function when(iso) {
        const d = new Date(iso);
        return d.toLocaleTimeString('en-NZ', { hour: 'numeric', minute: '2-digit' });
      }

      function add(m) {
        const el = document.createElement('div');
        el.className = 'msg ' + (m.sender === 'owner' ? 'owner' : 'visitor');
        el.textContent = m.body;
        const t = document.createElement('div');
        t.className = 'when';
        t.textContent = when(m.created_at);
        el.appendChild(t);
        log.appendChild(el);
        log.scrollTop = log.scrollHeight;
      }

      async function load() {
        const res = await fetch('/api/chat/thread?token=' + encodeURIComponent(token));
        const data = await res.json();
        if (!res.ok) {
          note.hidden = false;
          note.textContent = data.error || 'That link is not valid.';
          return;
        }
        document.getElementById('who').textContent =
          data.thread.visitor_name || 'Someone on your site';
        document.getElementById('meta').textContent =
          [data.thread.slug + '.garage.co.nz', data.thread.visitor_contact]
            .filter(Boolean).join(' · ');
        form.hidden = false;
        for (const m of data.messages) {
          if (m.id > seen) { add(m); seen = m.id; }
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = text.value.trim();
        if (!body) return;
        text.value = '';
        const res = await fetch('/api/chat/reply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, body }),
        });
        if (!res.ok) { text.value = body; return; }
        await load();
      });

      load();
      setInterval(load, 5000);
    </script>
  </body>
</html>
