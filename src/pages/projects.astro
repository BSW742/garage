---
import Layout from '../components/Layout.astro';

// The work page. Two thirds of it is the sites, in two columns; the last third
// is what has shipped. Both come from the database rather than a list somebody
// has to remember to edit, because a stale work page is worse than none.
//
// The cards are not screenshots. A screenshot service is a running cost and a
// thing that breaks quietly; instead each card is built from the site's own
// hero image, name and palette, framed like a browser window. It is honest —
// every pixel came off the actual site — and it stays right when they edit it.

interface Row {
  slug: string;
  config: string;
  touched: string | null;
  created_at: string | null;
}

let sites: {
  slug: string; name: string; lede: string; style: string;
  hero: string | null; primary: string; deep: string;
  touched: string | null; fresh: boolean;
}[] = [];
let entries: { id: number; title: string; body: string | null; created_at: string }[] = [];
let liveCount = 0;
let todayCount = 0;

try {
  const db = (Astro.locals as any)?.runtime?.env?.DB;
  if (db) {
    const { results } = await db
      .prepare(
        `SELECT slug, config, COALESCE(updated_at, created_at) AS touched, created_at
           FROM site_claims
          WHERE in_projects = 1 AND status != 'disabled'
          ORDER BY COALESCE(updated_at, created_at) DESC LIMIT 60`
      )
      .all();

    sites = ((results || []) as Row[])
      .map((row) => {
        let c: any = {};
        try { c = JSON.parse(row.config || '{}'); } catch { return null; }
        const pal = c.palette || {};
        const gallery = (c.sections || []).find((s: any) => s?.type === 'gallery');
        const hero =
          c.heroImage ||
          (c.images || [])[0] ||
          (gallery?.images || [])[0] ||
          (c.products || []).map((p: any) => p?.image).find(Boolean) ||
          null;
        const t = Date.parse(String(row.touched || '').replace(' ', 'T') + 'Z');
        const age = Number.isFinite(t) ? Date.now() - t : Infinity;
        return {
          touched: row.touched,
          // Only one badge, and only when it means something. A "New" flag was
          // landing on every card, because these were all seeded the same week
          // — a badge on everything is a badge on nothing. The date underneath
          // does the honest work.
          fresh: age < 2 * 86400000,
          slug: row.slug,
          name: c.name || row.slug,
          lede: String(c.lede || c.headline || '').slice(0, 110),
          style: c.style || 'modern',
          hero: typeof hero === 'string' && /^https?:\/\//.test(hero) ? hero : null,
          primary: pal.primary || '#2563eb',
          deep: pal.deep || '#1e40af',
        };
      })
      .filter(Boolean) as typeof sites;

    // The whole estate, not just what is starred — that is the number worth
    // putting on a wall.
    const tally = await db
      .prepare(
        `SELECT COUNT(*) AS live,
                SUM(CASE WHEN COALESCE(updated_at, created_at) > datetime('now','-1 day')
                         THEN 1 ELSE 0 END) AS today
           FROM site_claims WHERE status != 'disabled'`
      )
      .first();
    liveCount = Number(tally?.live || 0);
    todayCount = Number(tally?.today || 0);

    const log = await db
      .prepare('SELECT id, title, body, created_at FROM changelog ORDER BY created_at DESC LIMIT 30')
      .all();
    entries = (log.results || []) as typeof entries;
  }
} catch {
  // A work page that renders empty beats one that 500s.
}

/** How long since somebody last worked on it. */
const touchedAgo = (iso: string) => {
  const t = Date.parse(String(iso).replace(' ', 'T') + 'Z');
  if (!Number.isFinite(t)) return '';
  const days = Math.floor((Date.now() - t) / 86400000);
  if (days < 1) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30) return `${days} days ago`;
  const months = Math.round(days / 30);
  return months <= 1 ? 'last month' : `${months} months ago`;
};

const when = (iso: string) => {
  const d = new Date(iso);
  return Number.isFinite(d.getTime())
    ? d.toLocaleDateString('en-NZ', { day: 'numeric', month: 'short' })
    : '';
};
---

<Layout title="Work — garage.co.nz" description="Sites built on garage.co.nz, and what has shipped lately.">
  <div class="work">
    <header class="work-head">
      <p class="work-eyebrow">The work</p>
      <h1>Real sites, built by talking.</h1>
      <div class="work-doing">
        <a class="work-btn" href="/ai">Build yours</a>
        <button class="work-btn ghost" id="how-open" aria-expanded="false">How it works</button>
      </div>

      <p class="work-meta">
        <b>{liveCount}</b> sites live{todayCount > 0 && <>, <b>{todayCount}</b> worked on today</>}.
        Free for any New Zealand business, with a million tokens of building.
      </p>

      <div class="how" id="how" hidden>
        <ol>
          <li><b>Say what you do.</b> No forms, no templates to pick through — you describe the business in plain words and it builds the page while you watch.</li>
          <li><b>Change anything by asking.</b> Type over the words on the page, or tell it what to move. It is your site from the first minute.</li>
          <li><b>Publish to yours.garage.co.nz.</b> Free, and a million tokens of building goes with it — enough to make a site and keep changing it.</li>
          <li><b>Keep it fresh and you stay top of this page.</b> Newest first, always.</li>
        </ol>
      </div>
    </header>

    <div class="work-body">
      <section class="work-grid" aria-label="Sites built on garage.co.nz">
        {sites.length === 0 && <p class="work-none">Nothing published yet.</p>}
        {sites.map((s) => (
          <a
            class="card"
            href={`https://${s.slug}.garage.co.nz`}
            target="_blank"
            rel="noopener"
            style={`--card-primary:${s.primary};--card-deep:${s.deep}`}
          >
            <span class="card-frame">
              <span class="card-bar"><i></i><i></i><i></i><b>{s.slug}.garage.co.nz</b></span>
              <span
                class="card-shot"
                style={s.hero ? `background-image:url(${s.hero})` : ''}
              >{!s.hero && <span class="card-initial">{s.name.slice(0, 1).toUpperCase()}</span>}</span>
            </span>
            <span class="card-say">
              <b>{s.name}</b>
              {s.lede && <span>{s.lede}</span>}
              <span class="card-foot">
                <i class="card-tpl">{s.style}</i>
                {s.fresh && <i class="card-flag">Just updated</i>}
                {s.touched && <i class="card-when">{touchedAgo(s.touched)}</i>}
              </span>
            </span>
          </a>
        ))}
      </section>

      <aside class="work-log" aria-label="What has shipped">
        <h2>Shipped</h2>
        {entries.length === 0 && <p class="work-none small">Nothing logged yet.</p>}
        <ol>
          {entries.map((e) => (
            <li>
              <span class="log-when">{when(e.created_at)}</span>
              <b>{e.title}</b>
              {e.body && <p>{e.body}</p>}
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .work { max-width: 1500px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }

  .work-head { max-width: 46rem; margin-bottom: 3rem; }
  .work-eyebrow {
    font-size: 0.74rem; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 700; color: var(--color-accent, #2563eb); margin-bottom: 1rem;
  }
  .work h1 {
    font-family: var(--font-display); font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800; letter-spacing: -0.035em; line-height: 1.02;
  }
  .work-doing { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 2rem; }
  .work-btn {
    display: inline-block; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--color-accent, #2563eb); color: #fff;
    font: inherit; font-size: 0.95rem; font-weight: 600;
    padding: 0.7rem 1.5rem; text-decoration: none;
  }
  .work-btn.ghost {
    background: transparent; color: inherit;
    border: 1px solid var(--color-border, #e5e5e5);
  }
  .work-btn.ghost:hover { border-color: var(--color-text-muted); }
  /* A line of fact, not a banner. The offer is more convincing said quietly
     next to a real number than shouted out of a coloured box — the box read as
     a discount sticker and cheapened the thing it sat above. */
  .work-meta {
    margin-top: 1.1rem; font-size: 0.95rem; line-height: 1.6;
    color: var(--color-text-muted); font-variant-numeric: tabular-nums;
    max-width: 34rem;
  }
  .work-meta b { color: var(--color-text, inherit); font-weight: 700; }

  .how { margin-top: 1.2rem; }
  .how[hidden] { display: none; }
  .how ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.7rem; }
  .how li { font-size: 0.95rem; line-height: 1.6; color: var(--color-text-muted); }
  .how li b { color: var(--color-text, inherit); }

  /* Two thirds sites, one third log. */
  .work-body { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; }
  @media (min-width: 1000px) {
    .work-body { grid-template-columns: 2fr 1fr; gap: 3.5rem; }
  }

  .work-grid { display: grid; grid-template-columns: 1fr; gap: 1.4rem; }
  @media (min-width: 620px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }

  .card { display: block; text-decoration: none; color: inherit; }
  .card-frame {
    display: block; border-radius: 14px; overflow: hidden;
    border: 1px solid var(--color-border, #e5e5e5); background: #fff;
    box-shadow: 0 18px 40px -28px rgba(15, 23, 42, 0.5);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .card:hover .card-frame {
    transform: translateY(-4px);
    box-shadow: 0 28px 55px -28px rgba(15, 23, 42, 0.55);
  }
  .card-bar {
    display: flex; align-items: center; gap: 5px; padding: 8px 12px;
    background: #f6f7f9; border-bottom: 1px solid var(--color-border, #e5e5e5);
  }
  .card-bar i { width: 8px; height: 8px; border-radius: 50%; background: #d7dae0; }
  .card-bar b {
    margin-left: 8px; font-size: 11px; font-weight: 500; color: #8b91a1;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .card-shot {
    display: grid; place-items: center; aspect-ratio: 16 / 10;
    background-size: cover; background-position: center;
    background-color: color-mix(in srgb, var(--card-primary) 14%, #fff);
  }
  .card-initial {
    font-family: var(--font-display); font-size: 2.6rem; font-weight: 800;
    color: var(--card-primary); opacity: 0.55;
  }
  .card-say { display: block; padding: 0.9rem 0.2rem 0; }
  .card-say b { display: block; font-size: 1.02rem; font-weight: 700; letter-spacing: -0.01em; }
  .card-say span {
    display: block; margin-top: 0.25rem; color: var(--color-text-muted);
    font-size: 0.88rem; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.55rem; }
  .card-flag {
    font-style: normal; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 700; border-radius: 999px; padding: 0.22rem 0.6rem;
    background: #ecfdf5; color: #047857;
  }
  .card-when { font-style: normal; font-size: 0.75rem; color: var(--color-text-muted); }
  .card-tpl {
    display: inline-block; font-style: normal; font-size: 0.68rem;
    letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700;
    color: var(--card-primary);
    background: color-mix(in srgb, var(--card-primary) 12%, transparent);
    border-radius: 999px; padding: 0.22rem 0.6rem;
  }

  .work-log { position: sticky; top: 2rem; }
  .work-log h2 {
    font-size: 0.74rem; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 700; color: var(--color-text-muted); margin-bottom: 1.4rem;
  }
  .work-log ol { list-style: none; margin: 0; padding: 0; position: relative; }
  .work-log ol:before {
    content: ''; position: absolute; left: 4px; top: 6px; bottom: 6px;
    width: 1px; background: var(--color-border, #e5e5e5);
  }
  .work-log li { position: relative; padding: 0 0 1.5rem 1.6rem; }
  .work-log li:before {
    content: ''; position: absolute; left: 0; top: 6px; width: 9px; height: 9px;
    border-radius: 50%; background: var(--color-accent, #2563eb);
    box-shadow: 0 0 0 3px var(--color-bg, #fff);
  }
  .log-when {
    display: block; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-text-muted); font-weight: 600; margin-bottom: 0.2rem;
  }
  .work-log b { font-size: 0.98rem; font-weight: 700; }
  .work-log p { margin-top: 0.3rem; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.55; }

  .work-none { color: var(--color-text-muted); }
  .work-none.small { font-size: 0.9rem; }
  @media (prefers-reduced-motion: reduce) { .card:hover .card-frame { transform: none; } }
</style>

<script>
  const how = document.getElementById('how');
  const btn = document.getElementById('how-open');
  btn?.addEventListener('click', () => {
    if (!how) return;
    how.hidden = !how.hidden;
    btn.setAttribute('aria-expanded', String(!how.hidden));
    btn.textContent = how.hidden ? 'How it works' : 'Hide';
  });
</script>
