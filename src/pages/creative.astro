---
export const prerender = false;
import { ADS } from '../lib/creative';
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Creative — Garage AI visibility</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Archivo+Black&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root{
        --bg:#fafafa;--paper:#fff;--ink:#0a0a0a;--soft:#525252;--softer:#8a8a8a;
        --line:#e5e5e5;--line-2:#d4d4d4;--hot:#dc2626;--wash:#fff5f4;
        --font:'Inter',system-ui,sans-serif;--display:'Archivo Black',system-ui,sans-serif;
        --pop:'Poppins',system-ui,sans-serif;
      }
      *{box-sizing:border-box;margin:0;padding:0}
      body{background:var(--bg);color:var(--ink);font-family:var(--font);line-height:1.5;
        -webkit-font-smoothing:antialiased}
      .wrap{max-width:1060px;margin:0 auto;padding:0 1.5rem 5rem}
      .top{padding:1.6rem 0;display:flex;align-items:center;gap:.6rem;border-bottom:1px solid var(--line)}
      .mark{font-family:var(--display);font-size:1.05rem}.mark span{color:var(--hot)}
      .tag{margin-left:auto;font-size:.72rem;color:var(--softer);letter-spacing:.09em;text-transform:uppercase}
      header.intro{padding:3.4rem 0 2.6rem;max-width:38rem}
      h1{font-family:var(--display);font-size:clamp(2rem,5.4vw,3rem);line-height:1.02;
        letter-spacing:-.03em;margin-bottom:.9rem}
      .lede{color:var(--soft);font-size:1.05rem}
      .rule{font-size:.9rem;color:var(--soft);margin-top:1.4rem;padding-left:.9rem;
        border-left:2px solid var(--hot)}
      .grid{display:grid;gap:2.2rem;grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
      .item{display:flex;flex-direction:column;gap:.7rem}
      .ad{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:1.7rem;
        display:flex;flex-direction:column;justify-content:space-between;position:relative;
        overflow:hidden;text-decoration:none;color:inherit;
        box-shadow:0 1px 2px rgba(0,0,0,.04);
        transition:transform .18s cubic-bezier(.2,.7,.3,1),box-shadow .18s,border-color .18s}
      .ad:before{content:'';position:absolute;inset:0;
        background:radial-gradient(120% 80% at 100% 0,var(--wash),transparent 62%)}
      .ad>*{position:relative}
      .ad:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(10,10,10,.1);border-color:var(--line-2)}
      .ad:hover .btn{background:#b91c1c}
      .ad.square{aspect-ratio:1}
      .ad.wide{aspect-ratio:1.91}
      .ad.story{aspect-ratio:.72}
      .ad .k{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--hot);margin-bottom:.8rem}
      .ad h2{font-family:var(--display);letter-spacing:-.028em;line-height:1.03;
        font-size:clamp(1.25rem,2.1vw,1.75rem)}
      .ad.wide h2{font-size:clamp(1.15rem,1.9vw,1.5rem)}
      .ad p{color:var(--soft);font-size:.92rem;margin-top:.6rem}
      .ad .btn{margin-top:1.2rem;display:inline-block;align-self:flex-start;background:var(--hot);
        color:#fff;font-family:var(--pop);font-weight:700;font-size:.82rem;padding:.6rem 1.05rem;
        border-radius:8px;transition:background .18s}
      .ad .brand{font-family:var(--display);font-size:.75rem;color:var(--softer);margin-top:1rem}
      .meta{display:flex;gap:.55rem;align-items:baseline}
      .fmt{font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--softer);
        border:1px solid var(--line);border-radius:99px;padding:.15rem .5rem;flex:none;background:var(--paper)}
      .note{font-size:.85rem;color:var(--soft);line-height:1.55}
      .foot{margin-top:4rem;padding-top:2rem;border-top:1px solid var(--line);color:var(--soft);font-size:.9rem}
      .foot a{color:var(--hot)}
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="top"><div class="mark">garage<span>.</span></div><div class="tag">Creative — internal</div></div>

      <header class="intro">
        <h1>Sell the discovery, not the website.</h1>
        <p class="lede">Nobody wakes up wanting a new website. They do want to know whether the AI everyone keeps talking about is sending customers to the bloke down the road instead of them.</p>
        <p class="rule">Click any of these. Each one lands on the check itself, carrying its own promise through — the page you arrive on says what the ad said, because an ad that hands over to a different promise is where a funnel leaks.</p>
      </header>

      <div class="grid">
        {ADS.map((ad) => (
          <div class="item">
            <a class={`ad ${ad.kind}`} href={`/visible?ad=${ad.id}`}>
              <div>
                <div class="k">{ad.kicker}</div>
                <h2>{ad.head}</h2>
                <p>{ad.sub}</p>
              </div>
              <div>
                <div class="btn">Check my business</div>
                <div class="brand">garage.co.nz</div>
              </div>
            </a>
            <div class="meta">
              <span class="fmt">{ad.kind === 'square' ? '1:1 feed' : ad.kind === 'wide' ? '1.91:1 banner' : '4:5 story'}</span>
              <span class="fmt">{ad.id}</span>
            </div>
            <p class="note">{ad.note}</p>
          </div>
        ))}
      </div>

      <div class="foot">
        All six land on <a href="/visible">garage.co.nz/visible</a>, each with its own opening line.
        Keep the trade and town in the ad matched to the audience: “plumbers in Hamilton” to Hamilton
        plumbers, not “tradies in NZ” to everyone.
      </div>
    </div>
  </body>
</html>
