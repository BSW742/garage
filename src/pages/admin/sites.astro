---
import Layout from '../../components/Layout.astro';

const db = (Astro.locals.runtime?.env as any)?.DB;
let sites: any[] = [];
let error = '';

if (db) {
  try {
    const result = await db.prepare(`
      SELECT slug, email, source_url, edit_token, status, created_at, updated_at, in_projects,
             LENGTH(config) AS config_size,
             json_extract(config, '$.chat') AS chat_on,
             json_extract(config, '$.style') AS style,
             json_extract(config, '$.name') AS biz_name,
             json_extract(config, '$.contact.address') AS town,
             json_extract(config, '$.contact.email') AS site_email,
             owner_sent_at, owner_sent_to, unsubscribed_at,
             owner_seen_at, owner_seen_count, editor_opened_at
      FROM site_claims
      ORDER BY COALESCE(updated_at, created_at) DESC
      LIMIT 200
    `).all();
    sites = result.results || [];
  } catch (e: any) {
    error = e.message;
  }
} else {
  error = 'No database binding — run against the deployed site.';
}

// What the builder agent has cost lately. Prices are per million tokens for
// the model in use; they are here so the number means something at a glance,
// and they will need editing if the model or its pricing changes.
// Priced per model, because two different models write to this table now: the
// builder on Opus and the site assistant on Sonnet. One flat rate quietly
// overstated the chat by two thirds.
const RATES: Record<string, { in: number; out: number; cacheRead: number }> = {
  'claude-opus-5': { in: 5, out: 25, cacheRead: 0.5 },
  'claude-sonnet-5': { in: 3, out: 15, cacheRead: 0.3 },
};
const RATE_FALLBACK = { in: 5, out: 25, cacheRead: 0.5 };

let spend: any = null;
if (db) {
  try {
    const row = await db.prepare(`
      SELECT model,
             COUNT(*) AS turns,
             COALESCE(SUM(steps), 0) AS steps,
             COALESCE(SUM(input_tokens), 0) AS input,
             COALESCE(SUM(output_tokens), 0) AS output,
             COALESCE(SUM(cache_read), 0) AS cache_read
      FROM agent_usage
      WHERE created_at > datetime('now', '-7 days')
      GROUP BY model
    `).all();
    const today = await db.prepare(`
      SELECT model,
             COUNT(*) AS turns,
             COALESCE(SUM(input_tokens), 0) AS input,
             COALESCE(SUM(output_tokens), 0) AS output,
             COALESCE(SUM(cache_read), 0) AS cache_read
      FROM agent_usage
      WHERE created_at > datetime('now', '-1 day')
      GROUP BY model
    `).all();
    const cost = (rows: any) => {
      const list = Array.isArray(rows) ? rows : [rows];
      return list.reduce((sum, r) => {
        const rate = RATES[String(r?.model || '')] || RATE_FALLBACK;
        return sum
          + ((r?.input || 0) / 1e6) * rate.in
          + ((r?.output || 0) / 1e6) * rate.out
          + ((r?.cache_read || 0) / 1e6) * rate.cacheRead;
      }, 0);
    };
    const roll = (r: any) => {
      const rows = (r?.results || []) as any[];
      const sum = (k: string) => rows.reduce((n, x) => n + Number(x[k] || 0), 0);
      return {
        turns: sum('turns'), steps: sum('steps'), input: sum('input'), output: sum('output'),
        cost: cost(rows),
        chat: rows.filter((x) => x.model === 'claude-sonnet-5').reduce((n, x) => n + Number(x.turns || 0), 0),
      };
    };
    spend = { week: roll(row), today: roll(today) };
  } catch (e) {
    spend = null;
  }
}

// What the left rail is counting.
//
// Recent is the last dozen touched, not the last seven days. A time window
// looked right until it was pointed at real data and returned 38 of 40 — every
// site had been edited that week, so the view filtered nothing. A fixed count
// means "the ones I was just working on" regardless of how busy the week was.
const RECENT = 12;
const stamp = (x: any) =>
  Date.parse(String(x.updated_at || x.created_at || '').replace(' ', 'T') + 'Z') || 0;
const recentSlugs = new Set(
  [...sites].sort((a, b) => stamp(b) - stamp(a)).slice(0, RECENT).map((x: any) => x.slug)
);
const isRecent = (x: any) => recentSlugs.has(x.slug);

// A site the hourly job scraped from a real business and did not publish.
// Disabled, unlisted, and carrying somebody else's name — so it waits here
// until it is looked at. Starring one is the approval and puts it live.
const isHeld = (x: any) => x.status === 'disabled' && !!x.source_url && !x.in_projects;
const heldCount = sites.filter(isHeld).length;
const recentCount = recentSlugs.size;
const themes = Object.entries(
  sites.reduce((acc: Record<string, number>, x: any) => {
    const style = x.style || 'modern';
    acc[style] = (acc[style] || 0) + 1;
    return acc;
  }, {})
)
  .map(([style, n]) => ({ style, n: n as number }))
  .sort((a, b) => b.n - a.n);

function summarise(site: any) {
  const bits = [];
  if (site.source_url) bits.push(site.source_url);
  if (site.config_size) bits.push(Math.round(site.config_size / 1024) + 'kb');
  return bits.join(' · ');
}
---

<Layout title="Sites" description="Published sites">
  <div class="wrap">
    <header class="head">
      <div>
        <h1>Sites</h1>
        <p class="sub">{sites.length} published · edit opens the builder with the page loaded</p>
      </div>
      <div class="nav-links">
        <a href="/admin" class="nav-btn">Admin</a>
        <a href="/projects" class="nav-btn">Work page</a>
        <button id="log-add" class="nav-btn">+ Shipped</button>
        <a href="/ai" class="nav-btn primary">Build a new one</a>
      </div>
    </header>

    {spend && spend.week.turns > 0 && (
      <div class="spend">
        <span><b>{spend.today.turns}</b> messages today · <b>${spend.today.cost.toFixed(2)}</b>
          {spend.today.chat > 0 && <span class="muted"> ({spend.today.chat} from site chat)</span>}</span>
        <span><b>{spend.week.turns}</b> this week · <b>${spend.week.cost.toFixed(2)}</b></span>
        <span class="muted small">
          {spend.week.turns > 0 && (
            <>{(spend.week.steps / spend.week.turns).toFixed(1)} model calls per message ·
            {' '}{Math.round(spend.week.input / spend.week.turns).toLocaleString()} tokens in each</>
          )}
        </span>
      </div>
    )}

    {sites.length > 0 && (() => {
      const sent = sites.filter((x) => x.owner_sent_at).length;
      const looked = sites.filter((x) => x.owner_seen_at).length;
      const opened = sites.filter((x) => x.editor_opened_at).length;
      const claimed = sites.filter((x) => x.claimed_at).length;
      const off = sites.filter((x) => x.unsubscribed_at).length;
      return sent > 0 ? (
        <div class="funnel">
          <span><b>{sent}</b> sent</span>
          <span><b>{looked}</b> looked</span>
          <span><b>{opened}</b> opened the editor</span>
          <span><b>{claimed}</b> claimed</span>
          {off > 0 && <span class="muted">{off} unsubscribed</span>}
        </div>
      ) : (
        <div class="funnel none">Nothing sent to an owner yet.</div>
      );
    })()}

    <form id="log-form" class="log-form" hidden>
      <input id="log-title" maxlength="120" placeholder="What shipped? e.g. Owners can delete messages" />
      <input id="log-body" maxlength="600" placeholder="One line more, if it needs it (optional)" />
      <button type="submit" class="nav-btn primary">Add it</button>
      <button type="button" id="log-cancel" class="nav-btn">Cancel</button>
      <span id="log-said" class="muted small"></span>
    </form>

    <div class="board">
    {sites.length > 0 && (
      <aside class="rail">
        <button class="view on" data-view="all">All <i>{sites.length}</i></button>
        <button class="view" data-view="recent">Recent <i>{recentCount}</i></button>
        {heldCount > 0 && (
          <button class="view held-view" data-view="held">Waiting on you <i>{heldCount}</i></button>
        )}
        <p class="rail-head">Themes</p>
        {themes.map((t) => (
          <button class="view theme" data-view={`style:${t.style}`}>
            <span class={`dot t-${t.style}`}></span>{t.style} <i>{t.n}</i>
          </button>
        ))}
      </aside>
    )}

    <div class="main">
    {sites.length > 0 && (
      <div class="search">
        <input
          id="site-search"
          type="search"
          placeholder="Search address, business, owner, source or template…"
          autocomplete="off"
          spellcheck="false"
        />
        <span class="count" id="site-count">{sites.length} sites</span>
      </div>
    )}

    {error && <p class="error">{error}</p>}

    {sites.length === 0 && !error && <p class="empty">Nothing published yet.</p>}

    {sites.length > 0 && (
      <table>
        <thead>
          <tr>
            <th>Site</th>
            <th>Owner</th>
            <th>Progress</th>
            <th class="right"></th>
          </tr>
        </thead>
        <tbody>
          {sites.map((site) => (
            <tr
              class={isHeld(site) ? 'held' : site.status === 'disabled' ? 'off' : ''}
              data-find={[
                site.slug,
                site.biz_name,
                site.email,
                site.source_url,
                site.town,
                site.style || 'modern',
                site.status,
              ].filter(Boolean).join(' ').toLowerCase()}
              data-style={site.style || 'modern'}
              data-recent={isRecent(site) ? '1' : ''}
              data-held={isHeld(site) ? '1' : ''}
            >
              <td class="site-cell">
                <a href={`https://${site.slug}.garage.co.nz`} target="_blank" rel="noopener" class="slug">
                  {site.slug}<span>.garage.co.nz</span>
                </a>
                <span class="under">
                  <span class={`pill tpl t-${site.style || 'modern'}`}>{site.style || 'modern'}</span>
                  {isHeld(site) && (
                    <span class="pill held-pill" title="A real business, scraped but never published. Nothing of theirs is visible anywhere. Star it to put it live.">
                      waiting on you
                    </span>
                  )}
                  {site.biz_name && <span class="biz" title={summarise(site) || ''}>{site.biz_name}</span>}
                </span>
              </td>
              <td class="muted">
                <input
                  class="owner-email"
                  type="email"
                  value={site.email || ''}
                  placeholder="none"
                  data-slug={site.slug}
                  data-key={site.edit_token}
                  data-was={site.email || ''}
                />
              </td>
              <td class="nowrap send-cell">
                {!site.edit_token ? (
                  <span class="pill nokey" title="No edit key, so this site cannot be sent or republished">no key</span>
                ) : site.unsubscribed_at ? (
                  <span class="pill off-list" title="They asked not to be contacted">unsubscribed</span>
                ) : site.editor_opened_at ? (
                  <span class="pill opened" title={`Opened the builder ${site.editor_opened_at}`}>
                    opened the editor
                  </span>
                ) : site.owner_seen_at ? (
                  <span
                    class="pill looked"
                    title={`First look ${site.owner_seen_at}, last ${site.owner_seen_last || site.owner_seen_at}`}
                  >
                    looked{site.owner_seen_count > 1 ? ` ×${site.owner_seen_count}` : ''}
                  </span>
                ) : site.owner_sent_at ? (
                  <span class="pill sent" title={`Sent to ${site.owner_sent_to} — no visit yet`}>
                    sent {String(site.owner_sent_at).slice(5, 10)}
                  </span>
                ) : (site.site_email || site.email) ? (
                  <button
                    class="act send"
                    data-slug={site.slug}
                    data-key={site.edit_token}
                    data-to={site.site_email || site.email}
                    title={`Send the site to ${site.site_email || site.email}`}
                  >Send it</button>
                ) : (
                  <span class="muted small no-addr">no address</span>
                )}
              </td>
              <td class="right nowrap">
                <a href={`https://${site.slug}.garage.co.nz`} target="_blank" rel="noopener" class="act">View</a>
                <a
                  href={`/ai?edit=${encodeURIComponent(site.slug)}${site.edit_token ? `&t=${encodeURIComponent(site.edit_token)}` : ''}`}
                  class="act edit"
                >Edit</a>
                <button
                  class:list={['act', 'icon', 'feat', site.in_projects ? 'on' : '']}
                  data-slug={site.slug}
                  data-on={site.in_projects ? '1' : ''}
                  title={site.in_projects ? 'Showing on the work page' : 'Hidden from the work page'}
                  aria-label="Show on the work page"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
                  </svg>
                </button>
                {site.edit_token && (
                  <button
                    class="act icon copy"
                    data-link={`https://garage.co.nz/ai?edit=${encodeURIComponent(site.slug)}&t=${encodeURIComponent(site.edit_token)}&src=owner`}
                    title="Copy the owner's edit link"
                    aria-label="Copy the owner's edit link"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="9" width="12" height="12" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                  </button>
                )}
                {site.edit_token && (
                  <a
                    href={`https://${site.slug}.garage.co.nz/admin?k=${site.edit_token}`}
                    target="_blank"
                    rel="noopener"
                    class="act icon"
                    title={`Owner inbox for ${site.slug} — right-click to copy the link`}
                    aria-label={`Owner inbox for ${site.slug}`}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                    </svg>
                  </a>
                )}
                {site.edit_token && (
                  <button
                    class:list={['act', 'icon', 'chat', site.chat_on ? 'on' : '']}
                    data-slug={site.slug}
                    data-key={site.edit_token}
                    data-on={site.chat_on ? '1' : ''}
                    title={site.chat_on ? 'Chat widget is on — click to hide it' : 'Chat widget is off — click to show it'}
                    aria-label="Toggle the chat widget"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                    </svg>
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {sites.length > 0 && <p class="empty" id="no-hits" hidden>Nothing matches that.</p>}
    </div>
    </div>
  </div>
</Layout>

<script>
  // Filtering happens here rather than on the server: there are tens of rows,
  // not thousands, and an admin looking for one site wants it to narrow as they
  // type rather than after a round trip. Every term has to match, so "cafe
  // hamilton" finds the cafe in Hamilton and not every cafe plus everything in
  // Hamilton.
  const search = document.getElementById('site-search') as HTMLInputElement | null;
  if (search) {
    const rows = Array.from(document.querySelectorAll('tbody tr')) as HTMLElement[];
    const count = document.getElementById('site-count');
    const none = document.getElementById('no-hits');

    // Half the place names in this country carry a macron — Wānaka, Whangārei,
    // Taupō, Ōtaki — and nobody types them into a search box. Strip the marks
    // from both sides so "wanaka" finds Wānaka.
    const flatten = (v: string) =>
      v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    const index = rows.map((row) => flatten(row.dataset.find || ''));

    // The rail narrows the set, the box searches inside it. Two filters that
    // fight each other is the usual way this goes wrong, so there is one apply
    // and both feed it.
    let view = 'all';

    const inView = (row: HTMLElement) => {
      if (view === 'all') return true;
      if (view === 'recent') return row.dataset.recent === '1';
      if (view === 'held') return row.dataset.held === '1';
      if (view.startsWith('style:')) return row.dataset.style === view.slice(6);
      return true;
    };

    const apply = () => {
      const terms = flatten(search.value).split(/\s+/).filter(Boolean);
      let shown = 0;
      let inSet = 0;
      rows.forEach((row, i) => {
        const scoped = inView(row);
        if (scoped) inSet++;
        const hay = index[i];
        const hit = scoped && terms.every((t) => hay.includes(t));
        row.hidden = !hit;
        if (hit) shown++;
      });
      if (count) {
        count.textContent = terms.length || view !== 'all'
          ? `${shown} of ${rows.length}`
          : `${rows.length} sites`;
      }
      if (none) none.hidden = shown > 0;
    };

    document.querySelectorAll<HTMLElement>('.view').forEach((btn) => {
      btn.addEventListener('click', () => {
        view = btn.dataset.view || 'all';
        document.querySelectorAll('.view').forEach((b) => b.classList.toggle('on', b === btn));
        apply();
      });
    });

    search.addEventListener('input', apply);
    // Escape clears rather than closing anything, which is what a search field
    // that has been typed into should do.
    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && search.value) { e.preventDefault(); search.value = ''; apply(); }
    });
    // "/" jumps to the box, the way it does everywhere else.
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== search
          && !(document.activeElement instanceof HTMLInputElement)) {
        e.preventDefault();
        search.focus();
      }
    });
    apply();
  }

  // Sending is one click, but never a silent one — it asks first, because this
  // goes to a real business who has not heard of us.
  // The owner's own editor link. It carries the edit token and src=owner, so
  // opening it both lets them in and marks the site as claimed — which is also
  // what pays out a referral. Copying the Edit href by hand loses the src.
  const ADMIN_KEY = '83f0dd5f1e8b5b512b68fd95f564a827';

  const logForm = document.getElementById('log-form') as HTMLFormElement | null;
  document.getElementById('log-add')?.addEventListener('click', () => {
    if (!logForm) return;
    logForm.hidden = !logForm.hidden;
    if (!logForm.hidden) (document.getElementById('log-title') as HTMLInputElement)?.focus();
  });
  document.getElementById('log-cancel')?.addEventListener('click', () => {
    if (logForm) logForm.hidden = true;
  });
  logForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const title = (document.getElementById('log-title') as HTMLInputElement).value.trim();
    const body = (document.getElementById('log-body') as HTMLInputElement).value.trim();
    const said = document.getElementById('log-said');
    if (!title) return;
    if (said) said.textContent = 'Adding…';
    const res = await fetch('/api/changelog', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: ADMIN_KEY, title, body }),
    });
    const data = await res.json().catch(() => ({}));
    if (said) said.textContent = data.ok ? 'Added' : (data.error || 'Did not save');
    if (data.ok) {
      (document.getElementById('log-title') as HTMLInputElement).value = '';
      (document.getElementById('log-body') as HTMLInputElement).value = '';
    }
  });

  // Which sites appear on the work page. Off by default — it is public and
  // carries garage's name, so a site is chosen rather than merely present.
  document.querySelectorAll<HTMLElement>('button.act.feat').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const on = !btn.dataset.on;
      btn.classList.toggle('on', on);
      btn.dataset.on = on ? '1' : '';
      const res = await fetch('/api/site/feature', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: ADMIN_KEY, slug: btn.dataset.slug, on }),
      });
      if (!res.ok) { btn.classList.toggle('on', !on); btn.dataset.on = on ? '' : '1'; }
      btn.title = on ? 'Showing on the work page' : 'Hidden from the work page';
    });
  });

  document.querySelectorAll('button.act.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const link = btn.getAttribute('data-link') || '';
      const said = btn.innerHTML;
      const done = () => {
        btn.textContent = 'Copied';
        btn.classList.add('done');
        setTimeout(() => { btn.innerHTML = said; btn.classList.remove('done'); }, 1600);
      };
      try {
        await navigator.clipboard.writeText(link);
        done();
      } catch (e) {
        // Clipboard is blocked without https or a user gesture in some setups;
        // fall back to selecting it so cmd-C still works.
        const box = document.createElement('input');
        box.value = link;
        document.body.appendChild(box);
        box.select();
        try { document.execCommand('copy'); done(); } catch (e2) { box.focus(); }
        setTimeout(() => box.remove(), 100);
      }
    });
  });

  document.querySelectorAll('button.act.send').forEach((el) => {
    const btn = el as HTMLButtonElement;
    btn.addEventListener('click', async () => {
      const to = btn.dataset.to || '';
      if (!confirm(`Send ${btn.dataset.slug}.garage.co.nz to ${to}?\n\nThis emails a real business.`)) return;
      btn.disabled = true;
      const was = btn.textContent;
      btn.textContent = 'sending…';
      try {
        const res = await fetch('/api/site/offer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: btn.dataset.slug, key: btn.dataset.key, to }),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          const done = document.createElement('span');
          done.className = 'pill sent';
          done.textContent = 'sent just now';
          btn.replaceWith(done);
        } else {
          btn.textContent = was || 'Send it';
          btn.disabled = false;
          alert(data.error || 'Could not send that.');
        }
      } catch {
        btn.textContent = was || 'Send it';
        btn.disabled = false;
        alert('Could not send that.');
      }
    });
  });

  document.querySelectorAll('input.owner-email').forEach((el) => {
    const input = el as HTMLInputElement;
    const save = async () => {
      const email = input.value.trim();
      if (email === input.dataset.was) return;
      input.classList.remove('saved', 'failed');
      const res = await fetch('/api/site/email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: input.dataset.slug, key: input.dataset.key, email }),
      });
      if (res.ok) {
        input.dataset.was = email;
        input.classList.add('saved');
      } else {
        input.classList.add('failed');
      }
    };
    input.addEventListener('blur', save);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') input.blur(); });
  });

  document.querySelectorAll('button.chat').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      const on = !el.dataset.on;
      el.disabled = true;
      const res = await fetch('/api/site/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: el.dataset.slug, key: el.dataset.key, on }),
      });
      el.disabled = false;
      if (!res.ok) { el.textContent = 'Failed'; return; }
      el.dataset.on = on ? '1' : '';
      el.textContent = on ? 'Chat on' : 'Chat off';
      el.classList.toggle('on', on);
    });
  });
</script>

