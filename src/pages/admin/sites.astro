---
import Layout from '../../components/Layout.astro';

const db = (Astro.locals.runtime?.env as any)?.DB;
let sites: any[] = [];
let error = '';

if (db) {
  try {
    const result = await db.prepare(`
      SELECT slug, email, source_url, edit_token, status, created_at, updated_at,
             LENGTH(config) AS config_size,
             json_extract(config, '$.chat') AS chat_on,
             json_extract(config, '$.style') AS style,
             json_extract(config, '$.name') AS biz_name,
             json_extract(config, '$.contact.address') AS town,
             json_extract(config, '$.contact.email') AS site_email,
             owner_sent_at, owner_sent_to, unsubscribed_at,
             owner_seen_at, owner_seen_count, editor_opened_at
      FROM site_claims
      ORDER BY COALESCE(updated_at, created_at) DESC
      LIMIT 200
    `).all();
    sites = result.results || [];
  } catch (e: any) {
    error = e.message;
  }
} else {
  error = 'No database binding — run against the deployed site.';
}

// What the builder agent has cost lately. Prices are per million tokens for
// the model in use; they are here so the number means something at a glance,
// and they will need editing if the model or its pricing changes.
const PER_MILLION_IN = 5;
const PER_MILLION_OUT = 25;

let spend: any = null;
if (db) {
  try {
    const row = await db.prepare(`
      SELECT COUNT(*) AS turns,
             COALESCE(SUM(steps), 0) AS steps,
             COALESCE(SUM(input_tokens), 0) AS input,
             COALESCE(SUM(output_tokens), 0) AS output
      FROM agent_usage
      WHERE created_at > datetime('now', '-7 days')
    `).first();
    const today = await db.prepare(`
      SELECT COUNT(*) AS turns,
             COALESCE(SUM(input_tokens), 0) AS input,
             COALESCE(SUM(output_tokens), 0) AS output
      FROM agent_usage
      WHERE created_at > datetime('now', '-1 day')
    `).first();
    const cost = (r: any) =>
      ((r?.input || 0) / 1e6) * PER_MILLION_IN + ((r?.output || 0) / 1e6) * PER_MILLION_OUT;
    spend = {
      week: { ...(row as any), cost: cost(row) },
      today: { ...(today as any), cost: cost(today) },
    };
  } catch (e) {
    spend = null;
  }
}

function summarise(site: any) {
  const bits = [];
  if (site.source_url) bits.push(site.source_url);
  if (site.config_size) bits.push(Math.round(site.config_size / 1024) + 'kb');
  return bits.join(' · ');
}
---

<Layout title="Sites" description="Published sites">
  <div class="wrap">
    <header class="head">
      <div>
        <h1>Sites</h1>
        <p class="sub">{sites.length} published · edit opens the builder with the page loaded</p>
      </div>
      <div class="nav-links">
        <a href="/admin" class="nav-btn">Admin</a>
        <a href="/ai" class="nav-btn primary">Build a new one</a>
      </div>
    </header>

    {spend && spend.week.turns > 0 && (
      <div class="spend">
        <span><b>{spend.today.turns}</b> agent messages today · <b>${spend.today.cost.toFixed(2)}</b></span>
        <span><b>{spend.week.turns}</b> this week · <b>${spend.week.cost.toFixed(2)}</b></span>
        <span class="muted small">
          {spend.week.turns > 0 && (
            <>{(spend.week.steps / spend.week.turns).toFixed(1)} model calls per message ·
            {' '}{Math.round(spend.week.input / spend.week.turns).toLocaleString()} tokens in each</>
          )}
        </span>
      </div>
    )}

    {sites.length > 0 && (() => {
      const sent = sites.filter((x) => x.owner_sent_at).length;
      const looked = sites.filter((x) => x.owner_seen_at).length;
      const opened = sites.filter((x) => x.editor_opened_at).length;
      const claimed = sites.filter((x) => x.claimed_at).length;
      const off = sites.filter((x) => x.unsubscribed_at).length;
      return sent > 0 ? (
        <div class="funnel">
          <span><b>{sent}</b> sent</span>
          <span><b>{looked}</b> looked</span>
          <span><b>{opened}</b> opened the editor</span>
          <span><b>{claimed}</b> claimed</span>
          {off > 0 && <span class="muted">{off} unsubscribed</span>}
        </div>
      ) : (
        <div class="funnel none">Nothing sent to an owner yet.</div>
      );
    })()}

    {sites.length > 0 && (
      <div class="search">
        <input
          id="site-search"
          type="search"
          placeholder="Search address, business, owner, source or template…"
          autocomplete="off"
          spellcheck="false"
        />
        <span class="count" id="site-count">{sites.length} sites</span>
      </div>
    )}

    {error && <p class="error">{error}</p>}

    {sites.length === 0 && !error && <p class="empty">Nothing published yet.</p>}

    {sites.length > 0 && (
      <table>
        <thead>
          <tr>
            <th>Address</th>
            <th>Owner</th>
            <th>Business &amp; template</th>
            <th>Owner</th>
            <th class="right">Open</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((site) => (
            <tr
              class={site.status === 'disabled' ? 'off' : ''}
              data-find={[
                site.slug,
                site.biz_name,
                site.email,
                site.source_url,
                site.town,
                site.style || 'modern',
                site.status,
              ].filter(Boolean).join(' ').toLowerCase()}
            >
              <td>
                <a href={`https://${site.slug}.garage.co.nz`} target="_blank" rel="noopener" class="slug">
                  {site.slug}<span>.garage.co.nz</span>
                </a>
              </td>
              <td class="muted">
                <input
                  class="owner-email"
                  type="email"
                  value={site.email || ''}
                  placeholder="no address — email-in disabled"
                  data-slug={site.slug}
                  data-key={site.edit_token}
                  data-was={site.email || ''}
                />
              </td>
              <td class="muted small">
                {site.biz_name && <span class="biz">{site.biz_name}</span>}
                <span class={`pill tpl t-${site.style || 'modern'}`}>{site.style || 'modern'}</span>
                {summarise(site) && <span class="src">{summarise(site)}</span>}
              </td>
              <td class="nowrap send-cell">
                {!site.edit_token ? (
                  <span class="pill nokey" title="No edit key, so this site cannot be sent or republished">no key</span>
                ) : site.unsubscribed_at ? (
                  <span class="pill off-list" title="They asked not to be contacted">unsubscribed</span>
                ) : site.editor_opened_at ? (
                  <span class="pill opened" title={`Opened the builder ${site.editor_opened_at}`}>
                    opened the editor
                  </span>
                ) : site.owner_seen_at ? (
                  <span
                    class="pill looked"
                    title={`First look ${site.owner_seen_at}, last ${site.owner_seen_last || site.owner_seen_at}`}
                  >
                    looked{site.owner_seen_count > 1 ? ` ×${site.owner_seen_count}` : ''}
                  </span>
                ) : site.owner_sent_at ? (
                  <span class="pill sent" title={`Sent to ${site.owner_sent_to} — no visit yet`}>
                    sent {String(site.owner_sent_at).slice(5, 10)}
                  </span>
                ) : (site.site_email || site.email) ? (
                  <button
                    class="act send"
                    data-slug={site.slug}
                    data-key={site.edit_token}
                    data-to={site.site_email || site.email}
                    title={`Send the site to ${site.site_email || site.email}`}
                  >Send it</button>
                ) : (
                  <span class="muted small no-addr">no address</span>
                )}
              </td>
              <td class="right nowrap">
                <a href={`https://${site.slug}.garage.co.nz`} target="_blank" rel="noopener" class="act">View</a>
                <a
                  href={`/ai?edit=${encodeURIComponent(site.slug)}${site.edit_token ? `&t=${encodeURIComponent(site.edit_token)}` : ''}`}
                  class="act edit"
                >Edit</a>
                {site.edit_token && (
                  <a
                    href={`https://${site.slug}.garage.co.nz/admin?k=${site.edit_token}`}
                    target="_blank"
                    rel="noopener"
                    class="act icon"
                    title={`Owner inbox for ${site.slug} — right-click to copy the link`}
                    aria-label={`Owner inbox for ${site.slug}`}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                    </svg>
                  </a>
                )}
                {site.edit_token && (
                  <button
                    class:list={['act', 'chat', site.chat_on ? 'on' : '']}
                    data-slug={site.slug}
                    data-key={site.edit_token}
                    data-on={site.chat_on ? '1' : ''}
                    title="Show the chat widget on this site"
                  >{site.chat_on ? 'Chat on' : 'Chat off'}</button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {sites.length > 0 && <p class="empty" id="no-hits" hidden>Nothing matches that.</p>}
  </div>
</Layout>

<script>
  // Filtering happens here rather than on the server: there are tens of rows,
  // not thousands, and an admin looking for one site wants it to narrow as they
  // type rather than after a round trip. Every term has to match, so "cafe
  // hamilton" finds the cafe in Hamilton and not every cafe plus everything in
  // Hamilton.
  const search = document.getElementById('site-search') as HTMLInputElement | null;
  if (search) {
    const rows = Array.from(document.querySelectorAll('tbody tr')) as HTMLElement[];
    const count = document.getElementById('site-count');
    const none = document.getElementById('no-hits');

    // Half the place names in this country carry a macron — Wānaka, Whangārei,
    // Taupō, Ōtaki — and nobody types them into a search box. Strip the marks
    // from both sides so "wanaka" finds Wānaka.
    const flatten = (v: string) =>
      v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    const index = rows.map((row) => flatten(row.dataset.find || ''));

    const apply = () => {
      const terms = flatten(search.value).split(/\s+/).filter(Boolean);
      let shown = 0;
      rows.forEach((row, i) => {
        const hay = index[i];
        const hit = terms.every((t) => hay.includes(t));
        row.hidden = !hit;
        if (hit) shown++;
      });
      if (count) {
        count.textContent = terms.length
          ? `${shown} of ${rows.length}`
          : `${rows.length} sites`;
      }
      if (none) none.hidden = shown > 0;
    };

    search.addEventListener('input', apply);
    // Escape clears rather than closing anything, which is what a search field
    // that has been typed into should do.
    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && search.value) { e.preventDefault(); search.value = ''; apply(); }
    });
    // "/" jumps to the box, the way it does everywhere else.
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== search
          && !(document.activeElement instanceof HTMLInputElement)) {
        e.preventDefault();
        search.focus();
      }
    });
    apply();
  }

  // Sending is one click, but never a silent one — it asks first, because this
  // goes to a real business who has not heard of us.
  document.querySelectorAll('button.act.send').forEach((el) => {
    const btn = el as HTMLButtonElement;
    btn.addEventListener('click', async () => {
      const to = btn.dataset.to || '';
      if (!confirm(`Send ${btn.dataset.slug}.garage.co.nz to ${to}?\n\nThis emails a real business.`)) return;
      btn.disabled = true;
      const was = btn.textContent;
      btn.textContent = 'sending…';
      try {
        const res = await fetch('/api/site/offer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: btn.dataset.slug, key: btn.dataset.key, to }),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          const done = document.createElement('span');
          done.className = 'pill sent';
          done.textContent = 'sent just now';
          btn.replaceWith(done);
        } else {
          btn.textContent = was || 'Send it';
          btn.disabled = false;
          alert(data.error || 'Could not send that.');
        }
      } catch {
        btn.textContent = was || 'Send it';
        btn.disabled = false;
        alert('Could not send that.');
      }
    });
  });

  document.querySelectorAll('input.owner-email').forEach((el) => {
    const input = el as HTMLInputElement;
    const save = async () => {
      const email = input.value.trim();
      if (email === input.dataset.was) return;
      input.classList.remove('saved', 'failed');
      const res = await fetch('/api/site/email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: input.dataset.slug, key: input.dataset.key, email }),
      });
      if (res.ok) {
        input.dataset.was = email;
        input.classList.add('saved');
      } else {
        input.classList.add('failed');
      }
    };
    input.addEventListener('blur', save);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') input.blur(); });
  });

  document.querySelectorAll('button.chat').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      const on = !el.dataset.on;
      el.disabled = true;
      const res = await fetch('/api/site/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: el.dataset.slug, key: el.dataset.key, on }),
      });
      el.disabled = false;
      if (!res.ok) { el.textContent = 'Failed'; return; }
      el.dataset.on = on ? '1' : '';
      el.textContent = on ? 'Chat on' : 'Chat off';
      el.classList.toggle('on', on);
    });
  });
</script>

<style>
  .wrap { max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
  .spend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    align-items: baseline;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.4rem;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .spend b { font-weight: 700; }

  .pill.nokey {
    background: #fdf0ef;
    color: #b42318;
    border: 1px solid #f3c4c0;
    margin-left: 0.3rem;
  }
  .owner-email {
    font: inherit;
    font-size: 0.85rem;
    width: 100%;
    min-width: 12rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: inherit;
  }
  .owner-email:hover { border-color: var(--color-border, #e5e5e5); }
  .owner-email:focus { border-color: #2563eb; background: #fff; outline: none; }
  .owner-email::placeholder { color: #b42318; opacity: 0.75; font-size: 0.8rem; }
  .owner-email.saved { border-color: #16a34a; }
  .owner-email.failed { border-color: #dc2626; }
  .act.icon { display: inline-flex; align-items: center; padding: 0.3rem 0.5rem; }
  .act.icon svg { display: block; }
  button.act.chat { cursor: pointer; font: inherit; }
  button.act.chat.on { background: #16a34a; border-color: #16a34a; color: #fff; }
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
  h1 { font-family: var(--font-display); font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; }
  .sub { color: var(--color-text-muted); font-size: 0.95rem; }
  .nav-links { display: flex; gap: 0.5rem; }
  .nav-btn {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text);
  }
  .nav-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .nav-btn.primary { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }

  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { padding: 0.75rem 0.6rem; border-bottom: 1px solid var(--color-border); text-align: left; vertical-align: middle; }
  th { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); font-weight: 600; }
  .right { text-align: right; }
  .nowrap { white-space: nowrap; }
  .muted { color: var(--color-text-soft); }
  .small { font-size: 0.82rem; }
  tr.off { opacity: 0.5; }

  .slug { font-weight: 600; text-decoration: none; color: var(--color-text); }
  .slug span { color: var(--color-text-muted); font-weight: 400; }
  .slug:hover { color: var(--color-accent); }

  .search { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; }
  .search input {
    flex: 1; min-width: 0; font: inherit; font-size: 0.92rem;
    padding: 0.6rem 0.9rem; border: 1px solid var(--work-3, #dfe4ec);
    border-radius: 10px; background: #fff; color: inherit;
  }
  .search input:focus { outline: 2px solid #2563eb; outline-offset: -1px; border-color: transparent; }
  .search .count { font-size: 0.82rem; color: #697184; white-space: nowrap; }
  td .biz { display: block; color: #10131a; font-weight: 500; }
  td .src { display: block; }
  .pill.tpl { background: #eef2ff; color: #4338ca; margin: 0.15rem 0.35rem 0.15rem 0; display: inline-block; }
  .pill.tpl.t-cafe { background: #fdf1e7; color: #a8442a; }
  .pill.tpl.t-physio { background: #eef4ec; color: #3d6b47; }
  .pill.tpl.t-trade { background: #23262a; color: #f2591f; }
  .pill.tpl.t-tribute { background: #1c1c1f; color: #d8d3c9; }
  .pill.tpl.t-listing { background: #e8f0fe; color: #1f6feb; }
  .funnel {
    display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: baseline;
    background: #fff; border: 1px solid var(--work-3, #dfe4ec); border-radius: 12px;
    padding: 0.85rem 1.1rem; margin-bottom: 1rem; font-size: 0.9rem;
  }
  .funnel b { font-size: 1.05rem; }
  .funnel.none { color: #697184; font-size: 0.88rem; }
  .pill.looked { background: #fef3c7; color: #92400e; }
  .pill.opened { background: #dcfce7; color: #15803d; }
  .send-cell { min-width: 7.5rem; }
  button.act.send {
    font: inherit; font-size: 0.78rem; font-weight: 600; cursor: pointer;
    background: #1f6feb; color: #fff; border: 1px solid #1f6feb;
    padding: 0.3rem 0.7rem; border-radius: 7px;
  }
  button.act.send:hover { filter: brightness(1.08); }
  button.act.send:disabled { opacity: 0.6; cursor: default; }
  .pill.sent { background: #e8f0fe; color: #1f6feb; }
  .pill.off-list { background: #f1f2f4; color: #697184; }
  .no-addr { white-space: nowrap; }
  .pill { font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 999px; background: #dcfce7; color: #15803d; }
  .pill.disabled { background: #fee2e2; color: #b91c1c; }

  .act {
    display: inline-block;
    margin-left: 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    padding: 0.3rem 0.7rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
  }
  .act:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .act.edit { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .act.edit:hover { background: var(--color-accent-deep); color: #fff; }

  .error { color: #b91c1c; }
  .empty { color: var(--color-text-muted); }
</style>
