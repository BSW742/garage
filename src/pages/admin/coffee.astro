---
// COFFEE — the sales page.
//
// /admin/sites answers "is the machine working". This answers "who do I talk
// to next", which is a different question with a different shape, and cramming
// both into one table was making neither readable.
//
// One list, hottest first, and the only thing that decides order is what the
// business has actually done: a thumbs up beats a play, a play beats a send,
// a send beats a site sitting there waiting to be recorded.
import { verdictFor, stageOf, STAGES, decodeSubject, isSystemMail, type Stage } from '../../lib/outreach';

export const prerender = false;

const db = (Astro.locals.runtime?.env as any)?.DB;
let rows: any[] = [];
let error = '';

if (db) {
  try {
    const { results } = await db
      .prepare(
        `SELECT s.slug, s.email, s.config, s.source_url, s.edit_token,
                s.owner_sent_at, s.owner_sent_to, s.unsubscribed_at, s.claimed_at,
                s.created_at, s.updated_at,
                json_extract(s.config, '$.name')  AS biz,
                json_extract(s.config, '$.style') AS style,
                json_extract(s.config, '$.contact.address') AS town,
                r.key AS take, r.seconds, r.opened, r.grew, r.plays, r.furthest,
                r.liked_at, r.created_at AS take_at,
                (SELECT COUNT(*) FROM interest i WHERE i.slug = s.slug) AS wants,
                (SELECT group_concat(i.thing, ', ') FROM interest i WHERE i.slug = s.slug) AS want_list
           FROM site_claims s
           LEFT JOIN recordings r ON r.slug = s.slug AND r.status = 'live'
          WHERE s.status != 'disabled'`
      )
      .all();
    rows = results || [];
  } catch (e: any) {
    error = e.message;
  }
}

// Somebody asking for time is the hottest thing that happens, and until now it
// existed only as an email that looked like spam on a phone.
let booked: any[] = [];
if (db) {
  try {
    const { results } = await db
      .prepare("SELECT id, name, email, slot_key, topic, status, created_at FROM bookings WHERE status != 'done' ORDER BY id DESC LIMIT 12")
      .all();
    booked = results || [];
  } catch { /* an empty strip beats a page that 500s */ }
}

// The two halves of the conversation, and the people asking for time. The app
// could show inbound and had nowhere to show what was said back, which is half
// a thread and reads as though nobody ever replied.
let inbound: any[] = [];
let sent: any[] = [];
if (db) {
  try {
    const a = await db
      .prepare(
        `SELECT id, slug, from_address, subject, intent, note, body, received_at
           FROM site_mail WHERE archived_at IS NULL ORDER BY received_at DESC LIMIT 60`
      ).all();
    inbound = a.results || [];
  } catch { /* an empty tab beats a page that 500s */ }
  try {
    const b = await db
      .prepare(
        `SELECT id, to_address, subject, body, kind, slug, ok, error, sent_at
           FROM outbox WHERE archived_at IS NULL ORDER BY sent_at DESC LIMIT 60`
      ).all();
    sent = b.results || [];
  } catch { /* the table is new; older sends were never written down */ }
}

const humanIn = inbound.filter((m) => !isSystemMail(m.from_address, m.subject));
const systemIn = inbound.filter((m) => isSystemMail(m.from_address, m.subject));
// A reply Ben wrote is his; everything else the platform sent on his behalf.
const humanOut = sent.filter((m) => m.kind === 'reply');
const systemOut = sent.filter((m) => m.kind !== 'reply');

const HEAT: Record<Stage, number> = {
  keen: 0, watched: 1, sent: 2, recorded: 3, ready: 4, claimed: 5, parked: 6,
};

const list = rows
  .map((r) => {
    const verdict = verdictFor(r);
    const stage = stageOf({
      claimed_at: r.claimed_at,
      owner_sent_at: r.owner_sent_at,
      liked_at: r.liked_at,
      wants: Number(r.wants || 0),
      opened: Number(r.opened || 0),
      plays: Number(r.plays || 0),
      hasTake: !!r.take,
      verdict,
    });
    return { ...r, verdict, stage };
  })
  .sort((a, b) =>
    HEAT[a.stage as Stage] - HEAT[b.stage as Stage] ||
    String(b.updated_at || '').localeCompare(String(a.updated_at || ''))
  );

const count = (id: Stage) => list.filter((x) => x.stage === id).length;
const ago = (t: unknown) => {
  if (!t) return '';
  const d = Date.parse(String(t).replace(' ', 'T') + (String(t).endsWith('Z') ? '' : 'Z'));
  if (!isFinite(d)) return '';
  const mins = Math.round((Date.now() - d) / 60000);
  if (mins < 60) return mins + 'm';
  if (mins < 1440) return Math.round(mins / 60) + 'h';
  return Math.round(mins / 1440) + 'd';
};
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Coffee</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      /* Light, like the ops page next door. Two admin pages that are the same
         job in different colours make you check which one you are on. */
      :root {
        --page: #ffffff; --panel: #f8f9fb; --line: #e6e8ec; --ink: #0f1115;
        --dim: #6b7280; --hot: #c2410c; --go: #16a34a; --cool: #2563eb;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--page); color: var(--ink);
        font: 400 15px/1.5 Inter, system-ui, sans-serif; }
      .wrap { max-width: 82rem; margin: 0 auto; padding: 1.5rem 1.1rem 5rem; }
      h1 { font-size: 1.35rem; margin: 0; letter-spacing: -0.02em; }
      .top { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
      .top a { color: var(--cool); font-size: 0.83rem; text-decoration: none; }
      .top a:hover { text-decoration: underline; }
      .sub { color: var(--dim); font-size: 0.85rem; margin: 0.15rem 0 0; }

      /* The funnel. Each one is a filter. */
      .tabs { display: flex; gap: 0.3rem; margin-bottom: 1.1rem;
        border-bottom: 1px solid var(--line); }
      .tab { font: inherit; font-size: 0.86rem; font-weight: 600; background: none;
        border: 0; border-bottom: 2px solid transparent; color: var(--dim);
        padding: 0.5rem 0.75rem; cursor: pointer; margin-bottom: -1px; }
      .tab:hover { color: var(--ink); }
      .tab.on { color: var(--ink); border-bottom-color: var(--ink); }
      .tab i { font-style: normal; font-size: 0.72rem; color: var(--dim);
        background: var(--panel); border-radius: 999px; padding: 0.05rem 0.4rem;
        margin-left: 0.3rem; }
      section[hidden] { display: none; }

      .note { border: 1px solid var(--line); border-radius: 11px; padding: 0.8rem 0.95rem;
        margin-bottom: 0.6rem; background: #fff; }
      .note.bad { border-color: #fecaca; background: #fef2f2; }
      .note header { display: flex; gap: 0.6rem; align-items: baseline; flex-wrap: wrap; }
      .note header b { font-weight: 700; font-size: 0.92rem; }
      .note .dim { color: var(--dim); font-size: 0.78rem; }
      .tag { font-size: 0.68rem; font-weight: 600; color: var(--dim); background: var(--panel);
        border-radius: 999px; padding: 0.1rem 0.45rem; }
      .tag.bad { background: #fee2e2; color: #991b1b; }
      .note header .act { margin-left: auto; }
      .subj { margin: 0.35rem 0 0; font-weight: 600; }
      .note pre { margin: 0.5rem 0 0; white-space: pre-wrap; word-break: break-word;
        font: inherit; font-size: 0.84rem; color: #374151; max-height: 15rem; overflow: auto; }

      /* People and machines, kept apart. The one real enquiry was buried in
         nineteen bounces and read as more of the same. */
      .split { display: flex; gap: 0.3rem; margin-bottom: 0.7rem; }
      .side { font: inherit; font-size: 0.78rem; font-weight: 600; cursor: pointer;
        background: var(--panel); border: 1px solid var(--line); border-radius: 999px;
        color: var(--dim); padding: 0.25rem 0.7rem; }
      .side:hover { color: var(--ink); }
      .side.on { background: var(--ink); border-color: var(--ink); color: #fff; }
      .side i { font-style: normal; opacity: 0.7; margin-left: 0.25rem; }
      [data-side-panel][hidden] { display: none; }

      .newmsg { font: inherit; font-size: 0.83rem; font-weight: 700; cursor: pointer;
        background: var(--ink); color: #fff; border: 0; border-radius: 999px;
        padding: 0.35rem 0.85rem; }
      .newmsg:hover { background: #000; }
      .sheet { position: fixed; inset: 0; z-index: 60; display: grid; place-items: start center;
        padding: 4rem 1rem; background: rgba(15,17,21,0.45); backdrop-filter: blur(3px); }
      .sheet[hidden] { display: none; }
      .compose { width: min(38rem, 100%); border: 1px solid var(--line); border-radius: 14px;
        padding: 1rem 1.1rem; background: #fff; display: grid; gap: 0.5rem;
        box-shadow: 0 24px 60px -30px rgba(15,17,21,0.6); }
      .act.bin { padding: 0.25rem 0.5rem; font-size: 0.9rem; line-height: 1; color: var(--dim); }
      .act.bin:hover { color: #b91c1c; border-color: #fca5a5; }
      .compose-head { margin: 0; font-size: 0.68rem; letter-spacing: 0.14em;
        text-transform: uppercase; font-weight: 800; color: var(--dim); }
      .compose input, .compose textarea { font: inherit; font-size: 0.9rem; padding: 0.5rem 0.65rem;
        border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--ink); }
      .compose textarea { resize: vertical; }
      .compose-foot { display: flex; gap: 0.7rem; align-items: center; }

      .booked { border: 1.5px solid #fdba74; background: #fff7ed; border-radius: 12px;
        padding: 0.8rem 0.95rem; margin-bottom: 1.1rem; }
      .booked-head { margin: 0 0 0.5rem; font-size: 0.68rem; letter-spacing: 0.16em;
        text-transform: uppercase; font-weight: 800; color: #9a3412; }
      .booking { display: flex; gap: 0.9rem; align-items: baseline; flex-wrap: wrap;
        padding: 0.3rem 0; font-size: 0.88rem; }
      .booking + .booking { border-top: 1px solid #fed7aa; }
      .booking b { font-weight: 700; }
      .booking .dim { color: #9a3412; opacity: 0.75; font-size: 0.8rem; }
      .booking a { margin-left: auto; color: var(--cool); text-decoration: none; }
      .booking a:hover { text-decoration: underline; }

      .funnel { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
      .step { background: var(--panel); border: 1px solid var(--line); border-radius: 11px;
        padding: 0.6rem 0.85rem; cursor: pointer; text-align: left; color: var(--ink);
        font: inherit; min-width: 7.2rem;
        transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s; }
      .step:hover { border-color: #c9cdd6; transform: translateY(-1px);
        box-shadow: 0 6px 16px -12px rgba(15,17,21,0.5); }
      .step.on { border-color: var(--ink); background: #fff; }
      .step b { display: block; font-size: 1.5rem; font-weight: 800; line-height: 1.1;
        letter-spacing: -0.03em; }
      .step span { display: block; font-size: 0.72rem; color: var(--dim); }
      .step.keen b { color: var(--hot); }
      .step.watched b { color: #b45309; }
      .step.claimed b { color: var(--go); }

      table { width: 100%; border-collapse: collapse; }
      th { text-align: left; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--dim); font-weight: 700; padding: 0 0.6rem 0.5rem; }
      td { padding: 0.65rem 0.6rem; border-top: 1px solid var(--line); vertical-align: top; }
      tr:hover td { background: #f8f9fb; }
      .who a { color: var(--ink); text-decoration: none; font-weight: 600; }
      .who a:hover { text-decoration: underline; }
      .who i { display: block; font-style: normal; font-size: 0.78rem; color: var(--dim); }
      .chip { display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em;
        border-radius: 999px; padding: 0.16rem 0.5rem; border: 1px solid var(--line); color: var(--dim); }
      .chip.keen { background: #ffedd5; color: #9a3412; border-color: transparent; }
      .chip.watched { background: #fef3c7; color: #92400e; border-color: transparent; }
      .chip.sent { background: #dbeafe; color: #1e40af; border-color: transparent; }
      .chip.recorded { background: #f3e8ff; color: #6b21a8; border-color: transparent; }
      .chip.claimed { background: #dcfce7; color: #166534; border-color: transparent; }
      .signals { display: flex; gap: 0.3rem; flex-wrap: wrap; }
      .sig { font-size: 0.68rem; color: var(--dim); border: 1px solid var(--line);
        border-radius: 6px; padding: 0.1rem 0.4rem; white-space: nowrap; background: #fff; }
      .sig.on { color: var(--ink); border-color: #c9cdd6; }
      .wants { color: #9a3412; font-size: 0.75rem; margin-top: 0.25rem; }
      .why { color: var(--dim); font-size: 0.75rem; max-width: 22rem; margin-top: 0.2rem; }
      .act { display: inline-block; font: inherit; font-size: 0.78rem; font-weight: 600;
        border: 1px solid var(--line); background: #fff; color: var(--ink);
        border-radius: 8px; padding: 0.32rem 0.6rem; cursor: pointer; text-decoration: none; }
      .act:hover { border-color: var(--ink); }
      .act.primary { background: var(--go); border-color: var(--go); color: #fff; }
      .act.primary:hover { background: #15803d; }
      .right { text-align: right; white-space: nowrap; }
      .right .act + .act { margin-left: 0.3rem; }
      tr[hidden] { display: none; }
      .none { color: var(--dim); padding: 2rem 0.6rem; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="top">
        <h1>Coffee</h1>
        <p class="sub">Who to talk to next.</p>
        <span style="margin-left:auto"></span>
        <button class="newmsg" id="newmsg">New message</button>
        <a href="/record">Record</a>
        <a href="/admin/sites">Ops</a>
      </div>

      {error && <p class="none">{error}</p>}

      <div class="tabs">
        <button class="tab on" data-tab="pipe">Pipeline <i>{list.length}</i></button>
        <button class="tab" data-tab="in">Inbound <i>{humanIn.length}</i></button>
        <button class="tab" data-tab="out">Sent <i>{humanOut.length}</i></button>
        <button class="tab" data-tab="book">Bookings <i>{booked.length}</i></button>
      </div>

      <section data-panel="pipe">
      {booked.length > 0 && (
        <div class="booked">
          <p class="booked-head">Asking for your time</p>
          {booked.map((b) => (
            <div class="booking">
              <b>{b.name}</b>
              <span>{b.slot_key}</span>
              <span class="dim">{b.topic}</span>
              <button class="act" data-reply={b.email} data-subject={`About your ${b.topic || 'booking'}`}>{b.email}</button>
            </div>
          ))}
        </div>
      )}

      <div class="funnel">
        {STAGES.map((st) => (
          <button class={`step ${st.id}`} data-stage={st.id} title={st.hint}>
            <b>{count(st.id)}</b><span>{st.label}</span>
          </button>
        ))}
        <button class="step on" data-stage="" title="Everything"><b>{list.length}</b><span>All</span></button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Business</th><th>Stage</th><th>What they did</th><th></th>
          </tr>
        </thead>
        <tbody id="rows">
          {list.map((r) => (
            <tr data-stage={r.stage}>
              <td class="who">
                <a href={`https://${r.slug}.garage.co.nz`} target="_blank" rel="noopener">
                  {r.biz || r.slug}
                </a>
                <i>{r.slug}.garage.co.nz{r.town ? ` · ${String(r.town).split(',').pop()?.trim()}` : ''}</i>
                <i>{r.verdict.to || 'no address'}</i>
              </td>
              <td>
                <span class={`chip ${r.stage}`}>{r.stage}</span>
                {!r.verdict.ok && r.verdict.kind !== 'unsubscribed' && (
                  <div class="why">{r.verdict.why}</div>
                )}
                {r.verdict.kind === 'unsubscribed' && <div class="why">Asked not to be emailed.</div>}
              </td>
              <td>
                <div class="signals">
                  <span class={`sig ${r.take ? 'on' : ''}`}>{r.take ? `take ${r.seconds || 0}s` : 'no take'}</span>
                  {r.owner_sent_at && <span class="sig on">sent {ago(r.owner_sent_at)} ago</span>}
                  {Number(r.opened || 0) > 0 && <span class="sig on">opened ×{r.opened}</span>}
                  {Number(r.plays || 0) > 0 && <span class="sig on">played ×{r.plays}</span>}
                  {Number(r.furthest || 0) > 0 && <span class="sig on">watched {r.furthest}s</span>}
                  {Number(r.grew || 0) > 0 && <span class="sig on">opened Grow</span>}
                  {r.liked_at && <span class="sig on">thumbs up</span>}
                </div>
                {r.want_list && <div class="wants">wants: {r.want_list}</div>}
              </td>
              <td class="right">
                <a class="act" href={`/record?s=${r.slug}`}>{r.take ? 'Re-record' : 'Record'}</a>
                {r.verdict.to && (
                  <button
                    class={`act ${r.stage === 'recorded' ? 'primary' : ''}`}
                    data-send={r.slug}
                    data-force={r.verdict.ok ? '' : '1'}
                    title={r.verdict.ok ? `Send to ${r.verdict.to}` : r.verdict.why}
                  >{r.owner_sent_at ? 'Send again' : 'Send'}</button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {!list.length && !error && <p class="none">Nothing yet.</p>}
      </section>

      <section data-panel="in" hidden>
        <div class="split">
          <button class="side on" data-side="in-people">People <i>{humanIn.length}</i></button>
          <button class="side" data-side="in-system">System <i>{systemIn.length}</i></button>
        </div>
        {!inbound.length && <p class="none">Nothing has come in yet.</p>}
        {!humanIn.length && !!inbound.length && (
          <p class="none" data-side-panel="in-people">Nothing from a person yet.</p>
        )}
        {[...humanIn.map((m) => ({ m, side: 'in-people' })),
          ...systemIn.map((m) => ({ m, side: 'in-system' }))].map(({ m, side }) => (
          <article class="note" data-side-panel={side}>
            <header>
              <b>{m.from_address}</b>
              <span class="dim">{String(m.received_at || '').slice(0, 16).replace('T', ' ')}</span>
              {m.slug && <span class="tag">{m.slug}</span>}
              {m.intent && m.intent !== m.slug && <span class="tag">{m.intent}</span>}
              <button class="act" data-reply={m.from_address} data-subject={`Re: ${decodeSubject(m.subject) || ''}`}>Reply</button>
              <button class="act bin" data-hide="in" data-id={m.id} title="Archive">&times;</button>
            </header>
            <p class="subj">{decodeSubject(m.subject) || '(no subject)'}</p>
            {m.body && <pre>{String(m.body).slice(0, 1200)}</pre>}
            {!m.body && m.note && <pre class="dim">{m.note}</pre>}
          </article>
        ))}
      </section>

      <section data-panel="out" hidden>
        <div class="split">
          <button class="side on" data-side="out-mine">Mine <i>{humanOut.length}</i></button>
          <button class="side" data-side="out-system">System <i>{systemOut.length}</i></button>
        </div>
        {!sent.length && <p class="none">Nothing recorded yet. Everything sent from here on is kept.</p>}
        {[...humanOut.map((m) => ({ m, side: 'out-mine' })),
          ...systemOut.map((m) => ({ m, side: 'out-system' }))].map(({ m, side }) => (
          <article class={`note ${m.ok ? '' : 'bad'}`} data-side-panel={side}>
            <header>
              <b>{m.to_address}</b>
              <span class="dim">{String(m.sent_at || '').slice(0, 16).replace('T', ' ')}</span>
              {m.kind && <span class="tag">{m.kind}</span>}
              {m.slug && <span class="tag">{m.slug}</span>}
              {!m.ok && <span class="tag bad">failed</span>}
              <button class="act" data-reply={m.to_address} data-subject={decodeSubject(m.subject) || ''}>Again</button>
              <button class="act bin" data-hide="out" data-id={m.id} title="Archive">&times;</button>
            </header>
            <p class="subj">{decodeSubject(m.subject) || '(no subject)'}</p>
            {m.error && <p class="why">{m.error}</p>}
            {m.body && <pre>{String(m.body).slice(0, 1200)}</pre>}
          </article>
        ))}
      </section>

      <section data-panel="book" hidden>
        {!booked.length && <p class="none">Nobody has asked for time yet.</p>}
        {booked.map((b) => (
          <article class="note">
            <header>
              <b>{b.name}</b>
              <span class="dim">{String(b.created_at || '').slice(0, 16).replace('T', ' ')}</span>
              <span class="tag">{b.topic}</span>
              <button class="act" data-reply={b.email} data-subject={`About your ${b.topic || 'booking'}`}>Reply</button>
              <button class="act bin" data-hide="booking" data-id={b.id} title="Mark done">&times;</button>
            </header>
            <p class="subj">{b.slot_key}</p>
            <p class="why">{b.email}</p>
          </article>
        ))}
      </section>
    </div>

    <!-- Sent through Mailgun as ben@garage.co.nz. Reply used to be a mailto:
         link, which hands the job to whatever desktop client is installed and
         sends from a different address entirely — so the reply never appeared
         in Sent and the thread stayed half-written. -->
    <div class="sheet" id="sheet" hidden>
      <form class="compose" id="compose">
        <p class="compose-head">From ben@garage.co.nz</p>
        <input id="c-to" type="email" placeholder="to" required />
        <input id="c-sub" type="text" placeholder="subject" required />
        <textarea id="c-body" rows="9" placeholder="Write it here." required></textarea>
        <div class="compose-foot">
          <button type="submit" class="act primary">Send</button>
          <button type="button" class="act" id="c-shut">Cancel</button>
          <span id="c-say" class="dim"></span>
        </div>
      </form>
    </div>
    <script is:inline>
      // Show one side at a time, and remember nothing — the default is people,
      // because that is the side worth opening the page for.
      function showSide(which) {
        document.querySelectorAll('[data-side-panel]').forEach((el) => {
          const mine = el.dataset.sidePanel;
          if (mine.split('-')[0] !== which.split('-')[0]) return;
          el.hidden = mine !== which;
        });
      }
      document.querySelectorAll('.side').forEach((b) => {
        b.addEventListener('click', () => {
          b.parentElement.querySelectorAll('.side').forEach((x) => x.classList.toggle('on', x === b));
          showSide(b.dataset.side);
        });
      });
      showSide('in-people');
      showSide('out-mine');

      document.querySelectorAll('.tab').forEach((t) => {
        t.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach((x) => x.classList.toggle('on', x === t));
          document.querySelectorAll('[data-panel]').forEach((s) => {
            s.hidden = s.dataset.panel !== t.dataset.tab;
          });
        });
      });

      // ── Writing one ──────────────────────────────────────────────────
      const sheet = document.getElementById('sheet');
      const compose = document.getElementById('compose');
      const say = document.getElementById('c-say');

      function write(to, subject) {
        document.getElementById('c-to').value = to || '';
        document.getElementById('c-sub').value = subject || '';
        say.textContent = '';
        sheet.hidden = false;
        document.getElementById(to ? 'c-body' : 'c-to').focus();
      }
      function shutSheet() { sheet.hidden = true; }

      document.getElementById('newmsg').addEventListener('click', () => write('', ''));
      document.getElementById('c-shut').addEventListener('click', shutSheet);
      sheet.addEventListener('click', (e) => { if (e.target === sheet) shutSheet(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') shutSheet(); });

      // Reply, from garage — not a mailto: that hands the job to Outlook and
      // sends from an address this page never sees again.
      document.querySelectorAll('[data-reply]').forEach((b) => {
        b.addEventListener('click', () => write(b.dataset.reply, b.dataset.subject));
      });

      compose.addEventListener('submit', async (e) => {
        e.preventDefault();
        const to = document.getElementById('c-to').value.trim();
        if (!confirm('Send to ' + to + '?')) return;
        say.textContent = 'sending…';
        const r = await fetch('/api/mail/send', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            to,
            subject: document.getElementById('c-sub').value,
            text: document.getElementById('c-body').value,
          }),
        }).then((x) => x.json()).catch(() => null);
        if (r && r.ok) { say.textContent = 'sent'; setTimeout(() => location.reload(), 700); }
        else say.textContent = (r && r.message) || 'did not send';
      });

      // ── Putting one away ─────────────────────────────────────────────
      document.querySelectorAll('[data-hide]').forEach((b) => {
        b.addEventListener('click', async () => {
          const note = b.closest('.note') || b.closest('.booking');
          b.disabled = true;
          const r = await fetch('/api/mail/hide', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ kind: b.dataset.hide, id: b.dataset.id }),
          }).then((x) => x.json()).catch(() => null);
          if (r && r.ok) { if (note) note.remove(); }
          else { b.disabled = false; alert((r && r.message) || 'Could not archive that.'); }
        });
      });

      const rows = [...document.querySelectorAll('#rows tr')];
      document.querySelectorAll('.step').forEach((b) => {
        b.addEventListener('click', () => {
          document.querySelectorAll('.step').forEach((x) => x.classList.toggle('on', x === b));
          const want = b.dataset.stage;
          rows.forEach((r) => { r.hidden = !!want && r.dataset.stage !== want; });
        });
      });

      // Send from here, with the same confirmation the recorder gives — a click
      // that mails a stranger should never be one click away from a mis-click.
      document.querySelectorAll('[data-send]').forEach((b) => {
        b.addEventListener('click', async () => {
          const slug = b.dataset.send;
          const force = b.dataset.force === '1';
          const first = await fetch('/api/record/send', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, preview: true }),
          }).then((r) => r.json()).catch(() => null);
          if (!first) return alert('Could not reach the server.');
          if (!first.ok && !force) return alert(first.message);
          const draft = first.ok
            ? `To: ${first.to}\n\n${first.text}`
            : `${first.message}\n\nSend anyway?`;
          if (!confirm(draft + '\n\n— send this?')) return;
          b.disabled = true; b.textContent = 'sending…';
          const done = await fetch('/api/record/send', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, force }),
          }).then((r) => r.json()).catch(() => null);
          b.disabled = false;
          b.textContent = done && done.ok ? 'sent' : 'failed';
          if (!done || !done.ok) alert((done && done.message) || 'Did not send.');
        });
      });
    </script>

  </body>
</html>
