---
import Layout from '../components/Layout.astro';
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">For NZ charities & community projects</p>
      <h1>Free websites.<br/>Beautiful ones.</h1>
      <p class="hero-sub">We build professional websites for organisations doing good in Aotearoa. No cost, no catch.</p>
      <a href="/apply" class="hero-cta">Tell us about your project</a>
    </div>
  </section>

  <!-- How it works -->
  <section class="how">
    <div class="how-content">
      <h2>How it works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Share your story</h3>
          <p>Tell us about your organisation and what you're trying to achieve. Takes about 5 minutes.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>We design & build</h3>
          <p>Our team creates a custom website that captures your mission and connects with your community.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>You go live</h3>
          <p>Review, refine, and launch. We handle hosting forever. You focus on your mission.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Work / Case Studies -->
  <section class="work" id="work">
    <div class="work-content">
      <h2>Recent work</h2>
      <div class="projects">
        <article class="project">
          <div class="project-image">
            <div class="project-placeholder">
              <span>Coming soon</span>
            </div>
          </div>
          <div class="project-info">
            <h3>Your project here</h3>
            <p>We're just getting started. Be one of our first partners and help shape how we support community organisations.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta-content">
      <h2>Doing good in your community?</h2>
      <p>If you're a registered charity, community group, or working on a project that helps others — we'd love to hear from you.</p>
      <a href="/apply" class="cta-btn">Apply for a free website</a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .hero-sub {
    font-size: 1.25rem;
    color: var(--color-text-soft);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: inline-block;
    background: var(--color-text);
    color: white;
    padding: 1rem 2rem;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
    box-shadow: var(--shadow-md);
  }

  .hero-cta:hover {
    background: #27272a;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  /* How */
  .how {
    padding: 6rem 2rem;
    background: var(--color-surface);
  }

  .how-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .how h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 3rem;
    text-align: center;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 3rem;
  }

  .step {
    text-align: center;
  }

  .step-num {
    width: 48px;
    height: 48px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .step h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .step p {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Work */
  .work {
    padding: 6rem 2rem;
    background: var(--color-bg);
  }

  .work-content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .work h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 3rem;
    text-align: center;
  }

  .projects {
    display: grid;
    gap: 2rem;
  }

  .project {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 300px;
  }

  .project-image {
    background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-placeholder {
    padding: 2rem;
    text-align: center;
  }

  .project-placeholder span {
    color: var(--color-accent);
    font-weight: 500;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-info {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-info h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .project-info p {
    color: var(--color-text-soft);
    line-height: 1.7;
  }

  /* CTA */
  .cta {
    padding: 6rem 2rem;
    background: var(--color-text);
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta h2 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta p {
    color: rgba(255,255,255,0.7);
    font-size: 1.1rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .cta-btn {
    display: inline-block;
    background: white;
    color: var(--color-text);
    padding: 1rem 2rem;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  }

  @media (max-width: 768px) {
    .project {
      grid-template-columns: 1fr;
    }

    .project-image {
      min-height: 200px;
    }

    .project-info {
      padding: 2rem;
    }
  }
</style>
