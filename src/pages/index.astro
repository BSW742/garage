---
import Layout from '../components/Layout.astro';

// The work page. Two thirds of it is the sites, in two columns; the last third
// is what has shipped. Both come from the database rather than a list somebody
// has to remember to edit, because a stale work page is worse than none.
//
// The cards are not screenshots. A screenshot service is a running cost and a
// thing that breaks quietly; instead each card is built from the site's own
// hero image, name and palette, framed like a browser window. It is honest —
// every pixel came off the actual site — and it stays right when they edit it.

interface Row {
  slug: string;
  config: string;
  touched: string | null;
  created_at: string | null;
}

let sites: {
  slug: string; name: string; lede: string; style: string;
  hero: string | null; primary: string; deep: string;
  touched: string | null; fresh: boolean; bubbles: string[]; reel: string[]; films: number;
}[] = [];
let entries: { id: number; title: string; body: string | null; created_at: string }[] = [];
let liveCount = 0;
let todayCount = 0;

try {
  const db = (Astro.locals as any)?.runtime?.env?.DB;
  if (db) {
    const { results } = await db
      .prepare(
        // Sorted on a normalised stamp. The column has been written both as
        // datetime('now') and as toISOString() over the years, and because it
        // is compared as text the 'T' in the ISO form sorts above the space in
        // the other one — so an ISO stamp from 8am beat a SQLite stamp from
        // 6pm on the same day. Four sites published this evening sat forty
        // cards down. The writers are consistent again, and this makes the
        // ordering survive the next one that is not.
        `SELECT slug, config,
                replace(substr(COALESCE(updated_at, created_at), 1, 19), 'T', ' ') AS touched,
                created_at
           FROM site_claims
          WHERE in_projects = 1 AND status != 'disabled'
          ORDER BY touched DESC LIMIT 60`
      )
      .all();

    sites = ((results || []) as Row[])
      .map((row) => {
        let c: any = {};
        try { c = JSON.parse(row.config || '{}'); } catch { return null; }
        const pal = c.palette || {};
        // Pick a photograph, not a logo.
        //
        // The first version simply took heroImage, and Tees St's hero is a PNG
        // wordmark — so the card cropped it into two enormous letters. A card
        // that shows "ees s" is worse than a card showing nothing.
        //
        // No image is downloaded to work this out; the URL is enough. Logos are
        // PNG or SVG almost without exception, photographs are JPEG, WebP or
        // AVIF almost without exception, and anything calling itself a logo,
        // icon or badge says so in its path.
        const candidates: string[] = [
          c.heroImage,
          ...(c.images || []),
          ...(c.sections || [])
            .filter((x: any) => x?.type === 'gallery')
            .flatMap((x: any) => x.images || []),
          ...(c.products || []).map((p: any) => p?.image),
        ].filter((u: any) => typeof u === 'string' && /^https?:\/\//.test(u));

        const logoUrl = String(c.logo || '');
        const score = (u: string) => {
          const path = u.split('?')[0].toLowerCase();
          if (logoUrl && u === logoUrl) return -100;
          if (/logo|favicon|icon|sprite|badge|placeholder|filler|spacer/.test(path)) return -100;
          if (/\.(jpe?g|webp|avif)(\/|$)/.test(path) || /\.(jpe?g|webp|avif)\//.test(path)) return 2;
          if (/\.(png|svg)(\/|$)/.test(path) || /\.(png|svg)\//.test(path)) return -1;
          return 0;   // no extension to go on — a CDN URL, probably fine
        };

        // Only a picture we are reasonably sure is a picture. Shaws' six
        // "images" are white SVG category icons — best of a bad lot is still a
        // blank white card, and the branded initial at least looks deliberate.
        const hero =
          candidates
            .map((u) => ({ u, s: score(u) }))
            .filter((x) => x.s >= 0)
            .sort((a, b) => b.s - a.s)[0]?.u || null;
        const t = Date.parse(String(row.touched || '').replace(' ', 'T') + 'Z');
        const age = Number.isFinite(t) ? Date.now() - t : Infinity;
        return {
          touched: row.touched,
          // Only one badge, and only when it means something. A "New" flag was
          // landing on every card, because these were all seeded the same week
          // — a badge on everything is a badge on nothing. The date underneath
          // does the honest work.
          fresh: age < 2 * 86400000,
          // A bubbles site gets its own card treatment, so it needs several
          // pictures rather than one. Same scoring — logos are no better as a
          // bubble than they are as a hero.
          bubbles:
            (c.style || '') === 'bubbles'
              ? candidates.map((u) => ({ u, s: score(u) })).filter((x) => x.s >= 0)
                  .sort((a, b) => b.s - a.s).slice(0, 5).map((x) => x.u)
              : [],
          // A reel site has no photographs at all — it has films. Its card was
          // rendering as a single grey letter, which was the worst card on the
          // page attached to the best content on it. Take the thumbnails.
          reel:
            ['youtube', 'reel'].includes(c.style || '')
              ? (c.sections || [])
                  .flatMap((sec: any) => sec?.clips || [])
                  .map((clip: any) => String(clip?.id || ''))
                  .filter((id: string) => /^[A-Za-z0-9_-]{11}$/.test(id))
                  .slice(0, 4)
                  .map((id: string) => `https://i.ytimg.com/vi/${id}/mqdefault.jpg`)
              : [],
          films:
            ['youtube', 'reel'].includes(c.style || '')
              ? (c.sections || []).flatMap((sec: any) => sec?.clips || []).length
              : 0,
          slug: row.slug,
          name: c.name || row.slug,
          lede: String(c.lede || c.headline || '').slice(0, 110),
          style: c.style || 'modern',
          hero: typeof hero === 'string' && /^https?:\/\//.test(hero) ? hero : null,
          primary: pal.primary || '#2563eb',
          deep: pal.deep || '#1e40af',
        };
      })
      .filter(Boolean) as typeof sites;

    // The whole estate, not just what is starred — that is the number worth
    // putting on a wall.
    const tally = await db
      .prepare(
        `SELECT COUNT(*) AS live,
                SUM(CASE WHEN COALESCE(updated_at, created_at) > datetime('now','-1 day')
                         THEN 1 ELSE 0 END) AS today
           FROM site_claims WHERE status != 'disabled'`
      )
      .first();
    liveCount = Number(tally?.live || 0);
    todayCount = Number(tally?.today || 0);

    const log = await db
      .prepare('SELECT id, title, body, created_at FROM changelog ORDER BY created_at DESC LIMIT 30')
      .all();
    entries = (log.results || []) as typeof entries;
  }
} catch {
  // A work page that renders empty beats one that 500s.
}

/** How long since somebody last worked on it. */
const touchedAgo = (iso: string) => {
  const t = Date.parse(String(iso).replace(' ', 'T') + 'Z');
  if (!Number.isFinite(t)) return '';
  const days = Math.floor((Date.now() - t) / 86400000);
  if (days < 1) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30) return `${days} days ago`;
  const months = Math.round(days / 30);
  return months <= 1 ? 'last month' : `${months} months ago`;
};

const when = (iso: string) => {
  const d = new Date(iso);
  return Number.isFinite(d.getTime())
    ? d.toLocaleDateString('en-NZ', { day: 'numeric', month: 'short' })
    : '';
};
---

<Layout title="Work — garage.co.nz" description="Sites built on garage.co.nz, and what has shipped lately.">
  <img src="/lean.png" alt="Garage mascot" class="work-mascot" id="work-mascot" draggable="false" />
  <div class="work">
    <header class="work-head">
      <p class="work-eyebrow">The work</p>
      <h1>Real sites, built by talking.</h1>
      <div class="work-doing">
        <a class="work-btn" href="/ai">Build yours</a>
        <button class="work-btn ghost" id="how-open" aria-expanded="false">How it works</button>
        <span class="work-btn tag"><i></i>1 Million free tokens</span>
      </div>

      <p class="work-meta">Free for any NZ business.</p>

      <div class="how" id="how" hidden>
        <ol>
          <li><b>Say what you do.</b> No forms, no templates to pick through — you describe the business in plain words and it builds the page while you watch.</li>
          <li><b>Change anything by asking.</b> Type over the words on the page, or tell it what to move. It is your site from the first minute.</li>
          <li><b>Publish to yours.garage.co.nz.</b> Free, and a million tokens of building goes with it — enough to make a site and keep changing it.</li>
          <li><b>Keep it fresh and you stay top of this page.</b> Newest first, always.</li>
        </ol>
      </div>
    </header>

    <div class="work-body">
      <section class="work-grid" aria-label="Sites built on garage.co.nz">
        {sites.length === 0 && <p class="work-none">Nothing published yet.</p>}
        {sites.map((s) => (
          <a
            class="card"
            href={`https://${s.slug}.garage.co.nz`}
            target="_blank"
            rel="noopener"
            style={`--card-primary:${s.primary};--card-deep:${s.deep}`}
          >
            <span class="card-frame">
              <span class="card-bar"><i></i><i></i><i></i><b>{s.slug}.garage.co.nz</b></span>
              {s.reel.length >= 3 ? (
                <span class="card-shot card-reel">
                  {s.reel.slice(0, 4).map((u) => (
                    <span class="rl-tile" style={`background-image:url(${u})`}></span>
                  ))}
                  <span class="rl-badge">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                    {s.films} films
                  </span>
                </span>
              ) : s.bubbles.length >= 3 ? (
                <span class="card-shot card-bub">
                  {s.bubbles.slice(0, 5).map((u, i) => (
                    <span class={`bub b${i + 1}`} style={`background-image:url(${u})`}></span>
                  ))}
                </span>
              ) : (
                <span
                  class="card-shot"
                  style={s.hero ? `background-image:url(${s.hero})` : ''}
                >{!s.hero && <span class="card-initial">{s.name.slice(0, 1).toUpperCase()}</span>}</span>
              )}
            </span>
            <span class="card-say">
              <b>{s.name}</b>
              {s.lede && <span>{s.lede}</span>}
              <span class="card-foot">
                <i class="card-tpl">{s.style}</i>
                {s.fresh && <i class="card-flag">Just updated</i>}
                {s.touched && <i class="card-when">{touchedAgo(s.touched)}</i>}
              </span>
            </span>
          </a>
        ))}
      </section>

      <aside class="work-log" aria-label="What has shipped">
        <h2>Shipped</h2>
        {entries.length === 0 && <p class="work-none small">Nothing logged yet.</p>}
        <ol>
          {entries.map((e) => (
            <li>
              <span class="log-when">{when(e.created_at)}</span>
              <b>{e.title}</b>
              {e.body && <p>{e.body}</p>}
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</Layout>

<style>
  /* He leans the other way here. On the old home page he is turned in towards
     the headline; flipped, he leans on the left edge of the screen instead —
     which is the only place left, since the dog, his bone and the chat
     launcher all live in the bottom right. Half the size he is over there, so
     he sits beside the work rather than in front of it. */
  .work-mascot {
    /* Absolute, not fixed. Fixed kept him pinned to the glass the whole way
       down sixty cards, which is not what he does on the old home page — there
       he sits in the hero and scrolls away like anything else on the page.
       This puts him at the foot of the first screen and leaves him there. */
    position: absolute;
    left: 8px;
    top: calc(100vh - 212px);
    height: 190px;
    width: auto;
    z-index: 40;
    transform: scaleX(-1);
    transform-origin: center bottom;
    filter: drop-shadow(0 10px 26px rgba(0, 0, 0, 0.18));
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: none;
    transition: filter 0.25s ease;
  }

  .work-mascot.dragging {
    cursor: grabbing;
    filter: drop-shadow(0 18px 44px rgba(0, 0, 0, 0.3));
  }

  /* Not enough room beside the cards on a laptop, and none at all on a phone. */
  @media (max-width: 1100px) {
    .work-mascot { display: none; }
  }
  .work { max-width: 1500px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }

  .work-head { max-width: 46rem; margin-bottom: 3rem; }
  .work-eyebrow {
    font-size: 0.74rem; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 700; color: var(--color-accent, #2563eb); margin-bottom: 1rem;
  }
  .work h1 {
    font-family: var(--font-display); font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800; letter-spacing: -0.035em; line-height: 1.02;
  }
  .work-doing { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 2rem; }
  .work-btn {
    display: inline-block; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--color-accent, #2563eb); color: #fff;
    font: inherit; font-size: 0.95rem; font-weight: 600;
    padding: 0.7rem 1.5rem; text-decoration: none;
  }
  .work-btn.ghost {
    background: transparent; color: inherit;
    border: 1px solid var(--color-border, #e5e5e5);
  }
  .work-btn.ghost:hover { border-color: var(--color-text-muted); }
  /* A third bubble, sitting with the buttons but not pretending to be one —
     no pointer, no hover. It reads as a fact on the shelf beside the actions,
     which is quieter than a banner and easier to believe. */
  .work-btn.tag {
    display: inline-flex; align-items: center; gap: 0.5rem; cursor: default;
    background: color-mix(in srgb, var(--color-accent, #2563eb) 8%, transparent);
    color: var(--color-accent, #2563eb);
    border: 1px solid color-mix(in srgb, var(--color-accent, #2563eb) 20%, transparent);
    font-weight: 600;
  }
  .work-btn.tag i {
    width: 0.4rem; height: 0.4rem; border-radius: 50%; flex: none;
    background: currentColor; opacity: 0.7;
  }
  /* A line of fact, not a banner. The offer is more convincing said quietly
     next to a real number than shouted out of a coloured box — the box read as
     a discount sticker and cheapened the thing it sat above. */
  .work-meta {
    margin-top: 0.8rem; font-size: 0.95rem; line-height: 1.6;
    color: var(--color-text-muted); font-variant-numeric: tabular-nums;
    max-width: 34rem;
  }
  .work-meta b { color: var(--color-text, inherit); font-weight: 700; }

  .how { margin-top: 1.2rem; }
  .how[hidden] { display: none; }
  .how ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.7rem; }
  .how li { font-size: 0.95rem; line-height: 1.6; color: var(--color-text-muted); }
  .how li b { color: var(--color-text, inherit); }

  /* Two thirds sites, one third log. */
  .work-body { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; }
  @media (min-width: 1000px) {
    .work-body { grid-template-columns: 2fr 1fr; gap: 3.5rem; }
  }

  .work-grid { display: grid; grid-template-columns: 1fr; gap: 1.4rem; }
  @media (min-width: 620px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }

  .card { display: block; text-decoration: none; color: inherit; }
  .card-frame {
    display: block; border-radius: 14px; overflow: hidden;
    border: 1px solid var(--color-border, #e5e5e5); background: #fff;
    box-shadow: 0 18px 40px -28px rgba(15, 23, 42, 0.5);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .card:hover .card-frame {
    transform: translateY(-4px);
    box-shadow: 0 28px 55px -28px rgba(15, 23, 42, 0.55);
  }
  .card-bar {
    display: flex; align-items: center; gap: 5px; padding: 8px 12px;
    background: #f6f7f9; border-bottom: 1px solid var(--color-border, #e5e5e5);
  }
  .card-bar i { width: 8px; height: 8px; border-radius: 50%; background: #d7dae0; }
  .card-bar b {
    margin-left: 8px; font-size: 11px; font-weight: 500; color: #8b91a1;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .card-shot {
    display: grid; place-items: center; aspect-ratio: 16 / 10;
    background-size: cover; background-position: center;
    background-color: color-mix(in srgb, var(--card-primary) 14%, #fff);
  }
  /* A bubbles site gets bubbles on its card. A single cropped photograph tells
     you nothing about what that template does; five circles floating tell you
     immediately, and they are the site's own pictures. Positions are fixed
     rather than random so the card looks the same on every render. */
  .card-bub {
    position: relative; overflow: hidden;
    background:
      radial-gradient(22rem 14rem at 18% 8%, color-mix(in srgb, var(--card-primary) 22%, transparent), transparent 62%),
      radial-gradient(18rem 12rem at 88% 78%, color-mix(in srgb, var(--card-deep) 18%, transparent), transparent 62%),
      #fbfaff;
  }
  .card-bub .bub {
    position: absolute; border-radius: 50%; background-size: cover;
    background-position: center;
    box-shadow: 0 10px 22px -12px rgba(25, 23, 32, 0.6),
      inset 0 0 0 1px rgba(255, 255, 255, 0.5),
      inset 0 8px 14px -10px rgba(255, 255, 255, 0.55);
  }
  .card-bub .bub:after {
    content: ''; position: absolute; top: 10%; left: 14%; width: 26%; height: 19%;
    border-radius: 50%; filter: blur(2px);
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0));
  }
  .card-bub .b1 { width: 46%; padding-bottom: 46%; left: 4%;  top: 16%; }
  .card-bub .b2 { width: 30%; padding-bottom: 30%; left: 44%; top: 4%; }
  .card-bub .b3 { width: 34%; padding-bottom: 34%; left: 62%; top: 40%; }
  .card-bub .b4 { width: 22%; padding-bottom: 22%; left: 38%; top: 52%; }
  .card-bub .b5 { width: 17%; padding-bottom: 17%; left: 20%; top: 68%; }

  /* A reel card is four frames and a play badge. A single cropped thumbnail
     would read as a photograph; four in a grid reads as a reel, which is what
     the page behind it is. */
  .card-reel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    /* .card-shot sets place-items:center, which sizes a grid item to its
       content — and a span with nothing in it but a background image has no
       content, so all four tiles collapsed to nothing and the card rendered
       as a black box with a badge floating on it. */
    place-items: stretch;
    gap: 2px;
    background: #0b0b0d;
    position: relative;
  }

  .rl-tile { min-width: 0; min-height: 0; width: 100%; height: 100%; }

  .rl-tile {
    background-size: cover;
    background-position: center;
    background-color: #141418;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s;
    filter: saturate(0.9) brightness(0.86);
  }

  .card:hover .rl-tile { filter: saturate(1.05) brightness(1); }
  .card:hover .rl-tile:nth-child(1) { transform: scale(1.06); }
  .card:hover .rl-tile:nth-child(2) { transform: scale(1.04); }
  .card:hover .rl-tile:nth-child(3) { transform: scale(1.04); }
  .card:hover .rl-tile:nth-child(4) { transform: scale(1.06); }

  .rl-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(11, 11, 13, 0.82);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    border-radius: 999px;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: background 0.25s, border-color 0.25s;
  }

  .rl-badge svg { width: 0.95rem; height: 0.95rem; fill: currentColor; }
  .card:hover .rl-badge { background: var(--card-primary); border-color: transparent; }

  .card-initial {
    font-family: var(--font-display); font-size: 2.6rem; font-weight: 800;
    color: var(--card-primary); opacity: 0.55;
  }
  .card-say { display: block; padding: 0.9rem 0.2rem 0; }
  .card-say b { display: block; font-size: 1.02rem; font-weight: 700; letter-spacing: -0.01em; }
  .card-say span {
    display: block; margin-top: 0.25rem; color: var(--color-text-muted);
    font-size: 0.88rem; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.55rem; }
  .card-flag {
    font-style: normal; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 700; border-radius: 999px; padding: 0.22rem 0.6rem;
    background: #ecfdf5; color: #047857;
  }
  .card-when { font-style: normal; font-size: 0.75rem; color: var(--color-text-muted); }
  .card-tpl {
    display: inline-block; font-style: normal; font-size: 0.68rem;
    letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700;
    color: var(--card-primary);
    background: color-mix(in srgb, var(--card-primary) 12%, transparent);
    border-radius: 999px; padding: 0.22rem 0.6rem;
  }

  .work-log { position: sticky; top: 2rem; }
  .work-log h2 {
    font-size: 0.74rem; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 700; color: var(--color-text-muted); margin-bottom: 1.4rem;
  }
  .work-log ol { list-style: none; margin: 0; padding: 0; position: relative; }
  .work-log ol:before {
    content: ''; position: absolute; left: 4px; top: 6px; bottom: 6px;
    width: 1px; background: var(--color-border, #e5e5e5);
  }
  .work-log li { position: relative; padding: 0 0 1.5rem 1.6rem; }
  .work-log li:before {
    content: ''; position: absolute; left: 0; top: 6px; width: 9px; height: 9px;
    border-radius: 50%; background: var(--color-accent, #2563eb);
    box-shadow: 0 0 0 3px var(--color-bg, #fff);
  }
  .log-when {
    display: block; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-text-muted); font-weight: 600; margin-bottom: 0.2rem;
  }
  .work-log b { font-size: 0.98rem; font-weight: 700; }
  .work-log p { margin-top: 0.3rem; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.55; }

  .work-none { color: var(--color-text-muted); }
  .work-none.small { font-size: 0.9rem; }
  @media (prefers-reduced-motion: reduce) { .card:hover .card-frame { transform: none; } }
</style>

<script>
  const how = document.getElementById('how');
  const btn = document.getElementById('how-open');
  btn?.addEventListener('click', () => {
    if (!how) return;
    how.hidden = !how.hidden;
    btn.setAttribute('aria-expanded', String(!how.hidden));
    btn.textContent = how.hidden ? 'How it works' : 'Hide';
  });

  // Drag him wherever you want him, and he stays there. Same trick as the old
  // home page but against the viewport rather than a hero box, because this
  // page scrolls a long way and an absolute mascot would be left at the top.
  //
  // His own key: the two pages put him in different places and at different
  // sizes, and sharing one position would fling him off-screen on whichever
  // you opened second.
  (() => {
    const mascot = document.getElementById('work-mascot') as HTMLElement | null;
    if (!mascot) return;
    const KEY = 'work-mascot-pos';
    const FLIP = 'scaleX(-1)';

    // Page coordinates, not viewport ones. He belongs to the document now, so
    // dropping him at the bottom of the screen after scrolling should leave him
    // at that point in the page rather than at that point on the glass.
    const place = (x: number, y: number) => {
      const w = mascot.offsetWidth || 120;
      const h = mascot.offsetHeight || 190;
      const wide = document.documentElement.scrollWidth;
      const tall = document.documentElement.scrollHeight;
      // Never park him somewhere he cannot be picked up again.
      const left = Math.max(0, Math.min(wide - w, x));
      const top = Math.max(0, Math.min(Math.max(0, tall - h), y));
      mascot.style.left = left + 'px';
      mascot.style.top = top + 'px';
      mascot.style.bottom = 'auto';
    };

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved && typeof saved.x === 'number') place(saved.x, saved.y);
    } catch { /* a corrupt position is not worth a broken page */ }

    let dragging = false;
    let grabX = 0;
    let grabY = 0;

    const point = (e: MouseEvent | TouchEvent) =>
      'touches' in e ? e.touches[0] : (e as MouseEvent);

    const start = (e: MouseEvent | TouchEvent) => {
      dragging = true;
      mascot.classList.add('dragging');
      const p = point(e);
      const rect = mascot.getBoundingClientRect();
      grabX = p.clientX - rect.left;
      grabY = p.clientY - rect.top;
    };

    const move = (e: MouseEvent | TouchEvent) => {
      if (!dragging) return;
      e.preventDefault();
      const p = point(e);
      place(p.clientX + window.scrollX - grabX, p.clientY + window.scrollY - grabY);
    };

    const end = () => {
      if (!dragging) return;
      dragging = false;
      mascot.classList.remove('dragging');
      const rect = mascot.getBoundingClientRect();
      try {
        localStorage.setItem(KEY, JSON.stringify({
          x: rect.left + window.scrollX,
          y: rect.top + window.scrollY,
        }));
      } catch { /* private browsing — he just goes home next time */ }
    };

    mascot.addEventListener('mousedown', start);
    mascot.addEventListener('touchstart', start, { passive: true });
    document.addEventListener('mousemove', move);
    document.addEventListener('touchmove', move, { passive: false });
    document.addEventListener('mouseup', end);
    document.addEventListener('touchend', end);
    // The flip is on the element, so dragging must not overwrite transform.
    mascot.style.transform = FLIP;

    // A window that shrinks should not leave him stranded off the edge.
    window.addEventListener('resize', () => {
      const rect = mascot.getBoundingClientRect();
      if (mascot.style.left) place(rect.left + window.scrollX, rect.top + window.scrollY);
    });
  })();
</script>
