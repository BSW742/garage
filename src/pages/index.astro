---
import Layout from '../components/Layout.astro';
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">For NZ charities & community projects</p>
      <h1><span class="hit-letter hit-free" data-letter="0">F</span><span class="hit-letter hit-free" data-letter="1">r</span><span class="hit-letter hit-free" data-letter="2">e</span><span class="hit-letter hit-free" data-letter="3">e</span> <span class="hit-letter">w</span><span class="hit-letter">e</span><span class="hit-letter">b</span><span class="hit-letter">s</span><span class="hit-letter">i</span><span class="hit-letter">t</span><span class="hit-letter">e</span><span class="hit-letter">s</span>.<br/><span class="hero-accent"><span class="hit-letter">B</span><span class="hit-letter">e</span><span class="hit-letter">a</span><span class="hit-letter">u</span><span class="hit-letter">t</span><span class="hit-letter">i</span><span class="hit-letter">f</span><span class="hit-letter">u</span><span class="hit-letter">l</span></span> <span class="hit-letter">o</span><span class="hit-letter">n</span><span class="hit-letter">e</span><span class="hit-letter">s</span>.</h1>
      <p class="hero-sub">We build professional websites for organisations doing good in Aotearoa. No cost, no catch — just people helping people.</p>
      <a href="/apply" class="hero-cta">
        <span>Tell us about your project</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- How it works -->
  <section class="how">
    <div class="how-content">
      <h2 class="section-label">How it works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Share your story</h3>
          <p>Tell us about your organisation and what you're trying to achieve. Takes about 5 minutes.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>We design & build</h3>
          <p>Our team creates a custom website that captures your mission and connects with your community.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>You go live</h3>
          <p>Review, refine, and launch. We handle hosting forever. You focus on your mission.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Work / Case Studies -->
  <section class="work" id="work">
    <div class="work-content">
      <h2 class="section-label">Recent work</h2>
      <div class="projects">
        <article class="project">
          <div class="project-image">
            <div class="project-placeholder">
              <div class="placeholder-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="M21 15l-5-5L5 21"/>
                </svg>
              </div>
              <span>Coming soon</span>
            </div>
          </div>
          <div class="project-info">
            <span class="project-tag">Be first</span>
            <h3>Your project here</h3>
            <p>We're just getting started. Be one of our first partners and help shape how we support community organisations across Aotearoa.</p>
            <a href="/apply" class="project-link">Apply now</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta-bg"></div>
    <div class="cta-content">
      <h2>Doing good in<br/>your community?</h2>
      <p>If you're a registered charity, community group, or working on a project that helps others — we'd love to hear from you.</p>
      <a href="/apply" class="cta-btn">
        <span>Apply for a free website</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(37, 99, 235, 0.08) 0%, transparent 50%),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    z-index: 0;
  }

  .hero-content {
    max-width: 800px;
    position: relative;
    z-index: 1;
  }

  /* Hit letters that swing when stick hits */
  .hit-letter {
    display: inline-block;
    transform-origin: bottom center;
    transition: transform 0.1s;
  }
  .hit-letter.hit {
    animation: swingDown 2s ease-out forwards;
  }
  @keyframes swingDown {
    0% { transform: rotate(0deg); }
    15% { transform: rotate(85deg); }
    30% { transform: rotate(70deg); }
    45% { transform: rotate(80deg); }
    60% { transform: rotate(75deg); }
    100% { transform: rotate(90deg); }
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-deep) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-accent .hit-letter {
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-deep) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1.25rem;
    color: var(--color-text-soft);
    margin-bottom: 3rem;
    line-height: 1.7;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-text);
    color: white;
    padding: 1.125rem 2rem;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--shadow-lg);
  }

  .hero-cta:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
  }

  .hero-cta svg {
    transition: transform 0.3s;
  }

  .hero-cta:hover svg {
    transform: translateX(4px);
  }

  /* Section labels */
  .section-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 3.5rem;
    text-align: center;
  }

  /* How */
  .how {
    padding: 7rem 2rem;
    background: var(--color-surface);
  }

  .how-content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }

  .step {
    text-align: center;
    padding: 2rem;
  }

  .step-num {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-deep) 100%);
    color: white;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.25);
  }

  .step h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.875rem;
    color: var(--color-text);
  }

  .step p {
    color: var(--color-text-soft);
    font-size: 1rem;
    line-height: 1.7;
  }

  /* Work */
  .work {
    padding: 7rem 2rem;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  }

  .work-content {
    max-width: 1100px;
    margin: 0 auto;
  }

  .projects {
    display: grid;
    gap: 2rem;
  }

  .project {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 400px;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .project:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .project-image {
    background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 50%, #93c5fd 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .project-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 70%, rgba(255,255,255,0.4) 0%, transparent 50%);
  }

  .project-placeholder {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .placeholder-icon {
    margin-bottom: 1rem;
    color: var(--color-accent);
    opacity: 0.6;
  }

  .project-placeholder span {
    color: var(--color-accent-deep);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .project-info {
    padding: 3.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .project-info h3 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .project-info p {
    color: var(--color-text-soft);
    line-height: 1.75;
    margin-bottom: 1.5rem;
  }

  .project-link {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.2s;
  }

  .project-link:hover {
    gap: 0.75rem;
  }

  .project-link::after {
    content: '→';
  }

  /* CTA */
  .cta {
    padding: 8rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0a0a0a 0%, #171717 50%, #1e293b 100%);
    z-index: 0;
  }

  .cta-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 40% at 50% 120%, rgba(37, 99, 235, 0.15) 0%, transparent 60%);
  }

  .cta-content {
    max-width: 650px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 800;
    color: white;
    margin-bottom: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cta p {
    color: rgba(255,255,255,0.65);
    font-size: 1.15rem;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: white;
    color: var(--color-text);
    padding: 1.125rem 2rem;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }

  .cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }

  .cta-btn svg {
    transition: transform 0.3s;
  }

  .cta-btn:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 75vh;
      padding: 4rem 1.5rem;
    }

    .project {
      grid-template-columns: 1fr;
    }

    .project-image {
      min-height: 240px;
    }

    .project-info {
      padding: 2.5rem;
    }

    .cta {
      padding: 5rem 1.5rem;
    }
  }
</style>
