    <script is:inline>
      // ══════════════════════════════════════════════
      //  State
      // ══════════════════════════════════════════════
      const S = {
        slug: '',
        sourceUrl: '',
        scraped: null,
        scrapePromise: null,
        awaiting: null,       // 'name' when the agent asked for the business name
        history: [],
        site: {
          name: '',
          eyebrow: '',
          headline: '',
          lede: '',
          cta: 'Get in touch',
          palette: { primary: '#2563eb', deep: '#1e40af', wash: '#f6f8fb' },
          display: "'Poppins', system-ui, sans-serif",
          body: "'Inter', system-ui, sans-serif",
          logo: null,
          heroImage: null,
          sections: [],
          contact: { phone: '', email: '', address: '' },
          images: [],
        },
      };

      const $ = (id) => document.getElementById(id);
      const wait = (ms) => new Promise((r) => setTimeout(r, ms));

      function show(name) {
        document.querySelectorAll('.screen').forEach((s) => s.classList.toggle('is-active', s.dataset.screen === name));
        window.scrollTo(0, 0);
      }

      // ══════════════════════════════════════════════
      //  1. Hero
      // ══════════════════════════════════════════════
      $('start-btn').addEventListener('click', () => {
        show('name');
        setTimeout(() => $('slug-input').focus(), 350);
      });

      // ══════════════════════════════════════════════
      //  2. Subdomain
      // ══════════════════════════════════════════════
      const slugInput = $('slug-input');
      const domainField = $('domain-field');
      const domainStatus = $('domain-status');
      const suggestionBox = $('suggestions');
      const slugNext = $('slug-next');
      let checkTimer = null;
      let checkSeq = 0;

      const clean = (v) =>
        v.toLowerCase().replace(/^https?:\/\//, '').replace(/[^a-z0-9-]+/g, '-').replace(/-+/g, '-').replace(/^-/, '');

      slugInput.addEventListener('input', () => {
        const tidy = clean(slugInput.value);
        if (tidy !== slugInput.value) slugInput.value = tidy;
        S.slug = '';
        slugNext.disabled = true;
        suggestionBox.innerHTML = '';
        domainField.classList.remove('is-good', 'is-bad');
        clearTimeout(checkTimer);

        if (tidy.length < 3) {
          domainStatus.className = 'domain-status';
          domainStatus.textContent = tidy.length ? 'A wee bit longer…' : '';
          return;
        }

        domainStatus.className = 'domain-status';
        domainStatus.innerHTML = '<span class="spinner"></span> Checking…';
        checkTimer = setTimeout(() => checkSlug(tidy), 320);
      });

      slugInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !slugNext.disabled) slugNext.click();
      });

      async function checkSlug(slug) {
        const seq = ++checkSeq;
        try {
          const res = await fetch('/api/subdomain-check?slug=' + encodeURIComponent(slug));
          const data = await res.json();
          if (seq !== checkSeq) return; // a newer keystroke won

          if (data.available) {
            S.slug = data.slug;
            domainField.classList.add('is-good');
            domainStatus.className = 'domain-status good';
            domainStatus.textContent = '✓ ' + data.slug + '.garage.co.nz is free — grab it.';
            slugNext.disabled = false;
          } else {
            domainField.classList.add('is-bad');
            domainStatus.className = 'domain-status bad';
            domainStatus.textContent =
              data.reason === 'too-short' ? 'Three characters minimum.'
              : data.reason === 'too-long' ? 'That one is a mouthful — shorter?'
              : '✕ Taken. How about one of these?';
            suggestionBox.innerHTML = '';
            (data.suggestions || []).forEach((s) => {
              const b = document.createElement('button');
              b.className = 'suggestion';
              b.textContent = s + '.garage.co.nz';
              b.addEventListener('click', () => {
                slugInput.value = s;
                slugInput.dispatchEvent(new Event('input'));
              });
              suggestionBox.appendChild(b);
            });
          }
        } catch {
          if (seq !== checkSeq) return;
          // Offline or API down — don't block the person
          S.slug = slug;
          domainStatus.className = 'domain-status';
          domainStatus.textContent = "Couldn't reach the registry — we'll confirm at the end.";
          slugNext.disabled = false;
        }
      }

      slugNext.addEventListener('click', () => {
        $('chrome-url').textContent = S.slug + '.garage.co.nz';
        show('existing');
        setTimeout(() => $('source-url').focus(), 350);
      });

      // ══════════════════════════════════════════════
      //  3. Existing site
      // ══════════════════════════════════════════════
      $('pull-btn').addEventListener('click', () => {
        const raw = $('source-url').value.trim();
        if (!raw) { $('source-url').focus(); return; }
        S.sourceUrl = raw.replace(/^https?:\/\//, '').replace(/\/$/, '');
        S.scrapePromise = fetch('/api/scrape', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: 'https://' + S.sourceUrl }),
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => (d && !d.error ? d : null))
          .catch(() => null);
        enterBuilder();
      });

      $('fresh-btn').addEventListener('click', () => { S.sourceUrl = ''; enterBuilder(); });

      $('source-url').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('pull-btn').click(); });

      // ══════════════════════════════════════════════
      //  Agent chat plumbing
      // ══════════════════════════════════════════════
      const log = $('agent-log');
      const chipBox = $('agent-chips');

      function bubble(text, cls) {
        const el = document.createElement('div');
        el.className = 'msg ' + cls;
        el.textContent = text;
        log.appendChild(el);
        log.scrollTop = log.scrollHeight;
        return el;
      }

      async function say(text, pause) {
        const dots = document.createElement('div');
        dots.className = 'typing';
        dots.innerHTML = '<i></i><i></i><i></i>';
        log.appendChild(dots);
        log.scrollTop = log.scrollHeight;
        await wait(pause === undefined ? Math.min(900, 260 + text.length * 12) : pause);
        dots.remove();
        bubble(text, 'msg-agent');
      }

      function did(text) {
        const el = document.createElement('div');
        el.className = 'msg msg-do';
        el.textContent = '✓ ' + text;
        log.appendChild(el);
        log.scrollTop = log.scrollHeight;
      }

      function chips(list) {
        chipBox.innerHTML = '';
        list.forEach((c) => {
          const b = document.createElement('button');
          b.className = 'chip' + (c.yes ? ' chip-yes' : '');
          b.textContent = c.label;
          b.addEventListener('click', () => { chipBox.innerHTML = ''; handle(c.send || c.label); });
          chipBox.appendChild(b);
        });
      }

      const IDLE_CHIPS = [
        { label: 'Make it green' },
        { label: 'Add our services' },
        { label: 'Add contact details' },
        { label: 'Add a photo gallery' },
        { label: 'Publish it' },
      ];

      $('agent-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const text = $('agent-text').value.trim();
        if (!text) return;
        $('agent-text').value = '';
        chipBox.innerHTML = '';
        handle(text);
      });

      $('done-btn').addEventListener('click', () => handle('publish'));
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Colour helpers
      // ══════════════════════════════════════════════
      function hexToRgb(h) {
        const v = h.replace('#', '');
        const n = v.length === 3 ? v.split('').map((c) => c + c).join('') : v;
        return [parseInt(n.slice(0, 2), 16), parseInt(n.slice(2, 4), 16), parseInt(n.slice(4, 6), 16)];
      }
      function mix(hex, target, amount) {
        const a = hexToRgb(hex), b = hexToRgb(target);
        const out = a.map((c, i) => Math.round(c + (b[i] - c) * amount));
        return '#' + out.map((c) => c.toString(16).padStart(2, '0')).join('');
      }
      function paletteFrom(primary) {
        return { primary: primary, deep: mix(primary, '#000000', 0.28), wash: mix(primary, '#ffffff', 0.94) };
