        veterinary: { match: ['vet', 'animal', 'pet'], colour: '#7c3aed', eyebrow: 'Caring for local animals', lede: 'Gentle treatment for the family members with four legs.', cta: 'Book a visit',
          services: [['Consults', 'Check-ups, vaccinations and the worrying lumps.'], ['Surgery', 'Modern theatre, careful aftercare.'], ['After hours', 'Emergency cover when you need it most.']] },
        fitness: { match: ['gym', 'fitness', 'train', 'crossfit', 'yoga', 'pilates'], colour: '#dc2626', eyebrow: 'Train with us', lede: 'Coaching that meets you where you are — no mirrors-and-ego nonsense.', cta: 'Start a trial',
          services: [['Group classes', 'Six days a week, all levels welcome.'], ['Personal training', 'A plan built around your week, not ours.'], ['Memberships', 'Simple pricing, no lock-in.']] },
        salon: { match: ['hair', 'salon', 'beauty', 'barber', 'nail', 'spa'], colour: '#db2777', eyebrow: 'Book your chair', lede: 'Cuts, colour and a couple of hours that are entirely about you.', cta: 'Book online',
          services: [['Cut & style', 'Consultation first, always.'], ['Colour', 'Balayage, foils and colour corrections.'], ['Treatments', 'Because your hair has been through a lot.']] },
        photography: { match: ['photo', 'film', 'video', 'studio'], colour: '#111827', eyebrow: 'Photography & film', lede: 'Pictures that look like the day actually felt.', cta: 'Check availability',
          services: [['Weddings', 'Full-day coverage, unhurried and unposed.'], ['Portraits', 'Families, whānau and the annual awkward one.'], ['Commercial', 'Product, team and brand shoots.']] },
        community: { match: ['trust', 'charity', 'community', 'foundation', 'society', 'club', 'church', 'kura', 'marae', 'volunteer'], colour: '#2563eb', eyebrow: 'For our community', lede: 'A local group doing practical good — and always glad of a hand.', cta: 'Get involved',
          services: [['What we do', 'The work, week in and week out.'], ['Volunteer', 'A few hours goes a very long way.'], ['Donate', 'Every dollar stays local.']] },
        default: { match: [], colour: '#2563eb', eyebrow: 'Local & independent', lede: 'Honest work, fair prices, and a person on the end of the phone.', cta: 'Get in touch',
          services: [['What we do', 'The work we are known for around here.'], ['Why us', 'Local, experienced and easy to deal with.'], ['Get a quote', 'Tell us what you need and we will price it up.']] },
      };

      function guessIndustry(text) {
        const t = (text || '').toLowerCase();
        for (const key in INDUSTRIES) {
          if (INDUSTRIES[key].match.some((m) => t.includes(m))) return key;
        }
        return 'default';
      }

      const SERVICE_BLURBS = [
        [['drain', 'blockage', 'sewer'], 'Blockages cleared and drains cameraed, same day where we can.'],
        [['gas'], 'Certified gasfitting — installs, repairs and safety checks.'],
        [['hot water', 'cylinder'], 'Repairs, replacements and the right system for your place.'],
        [['toilet', 'cistern'], 'Leaks, running cisterns and full replacements.'],
        [['pipe', 'burst'], 'Burst pipes patched properly, not just papered over.'],
        [['leak'], 'We find it before it finds your floorboards.'],
        [['bathroom', 'kitchen', 'renov'], 'Full fit-outs, done once and done right.'],
        [['emergency', '24'], 'Seven days a week, whenever it goes wrong.'],
        [['commercial', 'business'], 'Scheduled work and call-outs for local businesses.'],
        [['maintenance', 'service'], 'Regular visits so small things stay small.'],
        [['install'], 'Supplied, installed and left tidy.'],
        [['repair', 'fix'], 'Diagnosed, repaired and explained in plain English.'],
        [['design', 'consult'], 'Planned properly before anyone picks up a tool.'],
      ];

      function blurb(name, fallback) {
        const n = String(name).toLowerCase();
        const hit = SERVICE_BLURBS.find((b) => b[0].some((k) => n.includes(k)));
        return hit ? hit[1] : (fallback || (name + ' — done properly, priced up front.'));
      }

      function titleCase(slug) {
        return slug.replace(/-/g, ' ').replace(/\b[a-z]/g, (c) => c.toUpperCase());
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Rendering the preview
      // ══════════════════════════════════════════════
      let renderedKeys = new Set();

      function esc(str) {
        return String(str == null ? '' : str).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      }

      function initials(name) {
        const parts = (name || '?').split(/\s+/).filter(Boolean);
        return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
      }

      function blockHtml(section) {
        const s = S.site;
        switch (section.type) {
          case 'services':
            return '<section class="pv-section alt"><p class="pv-label">' + esc(section.label || 'What we do') + '</p>' +
              '<h2 class="pv-h2">' + esc(section.title || 'How we can help') + '</h2><div class="pv-grid">' +
              section.items.map((i) => '<div class="pv-card"><span class="pv-tick">◆</span><h4>' + esc(i[0]) + '</h4><p>' + esc(i[1]) + '</p></div>').join('') +
              '</div></section>';
          case 'about':
            return '<section class="pv-section"><p class="pv-label">About us</p><h2 class="pv-h2">' + esc(section.title || ('The story behind ' + s.name)) + '</h2>' +
              '<p class="pv-prose">' + esc(section.text) + '</p></section>';
          case 'gallery':
            return '<section class="pv-section"><p class="pv-label">Our work</p><h2 class="pv-h2">Recent jobs</h2><div class="pv-gallery">' +
              (section.images.length ? section.images : ['', '', '', '', '', ''])
                .map((src) => '<div class="pv-shot"' + (src ? ' style="background-image:url(' + esc(src) + ')"' : '') + '></div>').join('') +
              '</div></section>';
          case 'hours':
            return '<section class="pv-section alt"><p class="pv-label">Opening hours</p><h2 class="pv-h2">When we are about</h2><div class="pv-hours">' +
              section.rows.map((r) => '<div><span>' + esc(r[0]) + '</span><span>' + esc(r[1]) + '</span></div>').join('') +
              '</div></section>';
          case 'testimonial':
            return '<section class="pv-section"><div class="pv-quote"><p>“' + esc(section.quote) + '”</p><span>— ' + esc(section.who) + '</span></div></section>';
          case 'contact': {
            const c = s.contact;
            const pills = [];
            if (c.phone) pills.push('<span class="pv-pill"><b>Call</b> ' + esc(c.phone) + '</span>');
            if (c.email) pills.push('<span class="pv-pill"><b>Email</b> ' + esc(c.email) + '</span>');
            if (c.address) pills.push('<span class="pv-pill"><b>Find us</b> ' + esc(c.address) + '</span>');
            if (!pills.length) pills.push('<span class="pv-pill"><b>Contact</b> add your phone or email in the chat</span>');
            return '<section class="pv-section alt"><p class="pv-label">Get in touch</p><h2 class="pv-h2">Give us a yell</h2><div class="pv-contact">' + pills.join('') + '</div></section>';
          }
          case 'band':
            return '<section class="pv-band"><h2 class="pv-h2">' + esc(section.title) + '</h2><p>' + esc(section.text) + '</p><span class="pv-btn">' + esc(s.cta) + '</span></section>';
          default:
            return '';
        }
      }

      function render() {
        const s = S.site;
        const root = $('site-root');
        const hasContent = !!(s.headline || s.sections.length);
        $('canvas-empty').classList.toggle('gone', hasContent);
        if (!hasContent) { root.innerHTML = ''; renderedKeys = new Set(); return; }

        const blocks = [];

        blocks.push({ key: 'nav', html:
          '<nav class="pv-nav"><div class="pv-brand">' +
          (s.logo ? '<img src="' + esc(s.logo) + '" alt="" />' : '<span class="pv-glyph">' + esc(initials(s.name)) + '</span><span>' + esc(s.name) + '</span>') +
          '</div><div class="pv-links"><span>Home</span><span>Services</span><span>About</span><span>Contact</span></div>' +
          '<span class="pv-cta">' + esc(s.cta) + '</span></nav>' });

        blocks.push({ key: 'hero', html:
          '<header class="pv-hero' + (s.heroImage ? ' has-photo' : '') + '">' +
          (s.heroImage ? '<div class="pv-hero-photo" style="background-image:url(' + esc(s.heroImage) + ')"></div>' : '') +
          '<div class="pv-hero-inner">' +
          (s.eyebrow ? '<p class="pv-eyebrow">' + esc(s.eyebrow) + '</p>' : '') +
          '<h1 class="pv-h1">' + esc(s.headline) + '</h1>' +
          (s.lede ? '<p class="pv-lede">' + esc(s.lede) + '</p>' : '') +
          '<span class="pv-btn">' + esc(s.cta) + '</span><span class="pv-btn pv-btn-2">' + esc(s.contact.phone || 'Learn more') + '</span>' +
          '</div></header>' });

        s.sections.forEach((sec) => blocks.push({ key: sec.type, html: blockHtml(sec) }));

        blocks.push({ key: 'foot', html:
          '<footer class="pv-foot"><span>© ' + new Date().getFullYear() + ' ' + esc(s.name) + '</span>' +
          '<span>' + esc(S.slug) + '.garage.co.nz</span></footer>' });

        const nextKeys = new Set(blocks.map((b) => b.key));
        const fresh = blocks.filter((b) => !renderedKeys.has(b.key) && b.key !== 'nav' && b.key !== 'hero' && b.key !== 'foot');
        root.innerHTML = blocks
          .map((b, i) => '<div data-i="' + i + '" class="' + (renderedKeys.has(b.key) ? '' : 'pv-block') + '">' + b.html + '</div>')
          .join('');
        renderedKeys = nextKeys;

        // Ride the canvas down to whatever just landed
        if (fresh.length) {
          const idx = blocks.indexOf(fresh[fresh.length - 1]);
          const el = root.querySelector('[data-i="' + idx + '"]');
          if (el) setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 60);
        }

        root.parentElement.style.setProperty('--pv-primary', s.palette.primary);
        root.parentElement.style.setProperty('--pv-deep', s.palette.deep);
        root.parentElement.style.setProperty('--pv-wash', s.palette.wash);
        root.parentElement.style.setProperty('--pv-display', s.display);
        root.parentElement.style.setProperty('--pv-font', s.body);
        root.parentElement.classList.add('pv');
      }

      function snapshot() {
        S.history.push(JSON.stringify(S.site));
        if (S.history.length > 25) S.history.shift();
      }

      function hasSection(type) { return S.site.sections.some((s) => s.type === type); }
      function addSection(section, before) {
        if (hasSection(section.type)) {
          S.site.sections = S.site.sections.map((s) => (s.type === section.type ? section : s));
        } else if (before && hasSection(before)) {
          const i = S.site.sections.findIndex((s) => s.type === before);
          S.site.sections.splice(i, 0, section);
        } else {
          S.site.sections.push(section);
        }
      }
      function dropSection(type) {
        const before = S.site.sections.length;
        S.site.sections = S.site.sections.filter((s) => s.type !== type);
        renderedKeys.delete(type);
        return S.site.sections.length !== before;
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Entering the builder
      // ══════════════════════════════════════════════
      async function enterBuilder() {
        show('build');
        $('chrome-url').textContent = S.slug + '.garage.co.nz';
        render();
        await wait(450);
        await say('Right — ' + S.slug + '.garage.co.nz is yours. Blank page, live already.');

        if (S.sourceUrl) {
          await say('Shall I drag your assets across from ' + S.sourceUrl + '? Logo, colours, wording, photos — I only keep what still looks good.');
          chips([
            { label: 'Yes — drag it across', yes: true, send: 'pull the assets across' },
            { label: 'No, start clean', send: 'start fresh' },
          ]);
        } else {
          await say('What is the business or group called?');
          S.awaiting = 'name';
        }
        $('agent-text').focus();
      }

      // ── Pull everything from the old site ────────
      async function importAssets() {
        $('agent-state').textContent = 'online · reading ' + S.sourceUrl;
        await say('On it — reading ' + S.sourceUrl + ' now.', 500);

        const d = await S.scrapePromise;
        $('agent-state').textContent = 'online · building';

        if (!d) {
          await say("Couldn't get in the front door of that site — it might be blocking robots. No drama, we'll build it from scratch.");
          await say('What is the business called?');
          S.awaiting = 'name';
          return;
        }

        S.scraped = d;
        snapshot();
        const s = S.site;
        const industry = d.industry && INDUSTRIES[d.industry] ? d.industry : guessIndustry((d.title || '') + ' ' + (d.description || '') + ' ' + S.slug);
        const base = INDUSTRIES[industry];

        s.name = (d.title || titleCase(S.slug)).split(/[|–—-]/)[0].trim().slice(0, 40) || titleCase(S.slug);
        s.palette = paletteFrom(base.colour);
        s.eyebrow = base.eyebrow;
        s.headline = (d.tagline || d.description || '').trim().slice(0, 90) || s.name;
        s.lede = (d.description && d.description !== d.tagline ? d.description : base.lede).slice(0, 190);
        s.cta = base.cta;
        render();
        did('Name and words lifted');
        await wait(520);

        if (d.logoUrl) { s.logo = d.logoUrl; render(); did('Logo brought across'); await wait(450); }
        if (d.heroImage) { s.heroImage = d.heroImage; render(); did('Hero photo brought across'); await wait(450); }

        const services = (d.services || []).filter(Boolean).slice(0, 6);
        const items = services.length >= 2
          ? services.slice(0, 6).map((t) => [String(t).slice(0, 42), blurb(t)])
          : base.services;
        addSection({ type: 'services', label: base.eyebrow, title: services.length >= 2 ? 'What we do' : 'How we can help', items: items });
        render();
        did(services.length >= 2 ? 'Kept your ' + items.length + ' services' : 'Drafted a services section');
        await wait(500);

        if (d.aboutText && d.aboutText.length > 60) {
          addSection({ type: 'about', text: d.aboutText.slice(0, 320) });
          render();
          did('Your about copy, tidied');
          await wait(450);
        }

        const shots = (d.galleryImages || []).filter((u) => u && u !== d.heroImage).slice(0, 6);
        if (shots.length >= 2) {
          s.images = shots;
          addSection({ type: 'gallery', images: shots });
          render();
          did(shots.length + ' photos pulled through');
          await wait(450);
        }

        const goodEmail = d.email && /^[\w.+-]+@[\w-]+\.[a-z]{2,}$/i.test(d.email) && !/\.(png|jpe?g|svg|gif|webp)$/i.test(d.email) ? d.email : '';
        if (d.phone || goodEmail || d.address) {
          s.contact = { phone: d.phone || '', email: goodEmail, address: (d.address || '').slice(0, 60) };
          addSection({ type: 'contact' });
          render();
          did('Phone, email and address wired up');
          await wait(450);
        }

        addSection({ type: 'band', title: 'Ready when you are', text: 'One call and we will sort it.' });
        render();
        await wait(400);

        await say("There you go — that's your site, live at " + S.slug + '.garage.co.nz. Anything you want changed, just say it.');
        chips(IDLE_CHIPS);
      }

      // ── Blank start ──────────────────────────────
      function startFresh(name) {
        snapshot();
        const industry = guessIndustry(name + ' ' + S.slug);
        const base = INDUSTRIES[industry];
        const s = S.site;
        s.name = name;
        s.palette = paletteFrom(base.colour);
        s.eyebrow = base.eyebrow;
        s.headline = name;
        s.lede = base.lede;
        s.cta = base.cta;
        s.sections = [
          { type: 'services', label: base.eyebrow, title: 'How we can help', items: base.services },
          { type: 'band', title: 'Ready when you are', text: 'One call and we will sort it.' },
        ];
        render();
        return industry;
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  The agent's brain
      // ══════════════════════════════════════════════
      function quoted(text) {
        const m = text.match(/["'“”„]([^"'“”„]{2,})["'“”„]/);
        if (m) return m[1].trim();
        const m2 = text.match(/(?:say|says|read|reads|to|it|be|called|call it|is)\s+(.{3,})$/i);
        return m2 ? m2[1].replace(/[.!]$/, '').trim() : null;
      }

      function baseFor() {
        return INDUSTRIES[guessIndustry(S.site.name + ' ' + S.slug + ' ' + (S.scraped ? S.scraped.industry : ''))];
      }

      function wants(t, words) { return words.some((w) => t.includes(w)); }

      async function handle(raw) {
        const text = raw.trim();
        bubble(text, 'msg-user');
        const t = text.toLowerCase();
        chipBox.innerHTML = '';
        await wait(180);

        // — the agent asked for a name —
        if (S.awaiting === 'name') {
          S.awaiting = null;
          const industry = startFresh(text.replace(/^(it'?s|we'?re|called|the)\s+/i, '').trim().slice(0, 40));
          await say("Nice one. I've put a starter page up — " + (industry === 'default' ? 'generic for now' : 'shaped for ' + industry) + ", your colours and words next.");
          await say('Tell me anything: colours, headline, sections, your phone number. Or hit publish whenever you like.');
          chips(IDLE_CHIPS);
          return;
        }

        // — pull assets across —
        if (wants(t, ['pull', 'drag', 'bring it', 'import', 'yes — drag']) && S.sourceUrl) { await importAssets(); return; }
        if (wants(t, ['start fresh', 'start clean', 'blank', 'from scratch'])) {
          await say('Clean slate it is. What is the business or group called?');
          S.awaiting = 'name';
          return;
        }

        // — publish —
        if (wants(t, ['publish', 'go live', 'ship it', 'launch', "that's it", 'done', 'finished', 'looks good'])) { await publish(); return; }

        // — undo —
        if (wants(t, ['undo', 'go back', 'revert'])) {
          const prev = S.history.pop();
          if (!prev) { await say('Nothing to undo yet.'); chips(IDLE_CHIPS); return; }
          S.site = JSON.parse(prev);
          renderedKeys = new Set();
          render();
          await say('Rolled that back.');
          chips(IDLE_CHIPS);
          return;
        }

        // — nothing on the page yet —
        if (!S.site.name) {
          await say("Before I change anything — what's the business or group called?");
          S.awaiting = 'name';
          return;
        }

        let acted = false;
        snapshot();

        // — colour —
        const hex = t.match(/#([0-9a-f]{3}|[0-9a-f]{6})\b/);
        const word = Object.keys(COLOUR_WORDS).find((c) => new RegExp('\\b' + c + '\\b').test(t));
        if (hex || (word && wants(t, ['colour', 'color', 'make it', 'go', 'brand', 'theme', 'palette', 'more', 'scheme']))) {
          const chosen = hex ? hex[0] : COLOUR_WORDS[word];
          S.site.palette = paletteFrom(chosen);
          render();
          did('Palette swapped to ' + (word || chosen));
          await say('Done — ' + (word || chosen) + ' through the whole site. Better?');
          acted = true;
        }

        // — headline / tagline / name —
        if (wants(t, ['headline', 'heading', 'title', 'h1'])) {
          const v = quoted(text);
          if (v) { S.site.headline = v; render(); did('Headline updated'); await say('Headline is now “' + v + '”.'); acted = true; }
          else { await say('Give it to me in quotes and I will drop it straight in — e.g. headline: “Blocked drain? We are 20 minutes away.”'); acted = true; }
        } else if (wants(t, ['tagline', 'subheading', 'strapline', 'sub-line', 'intro line', 'lede'])) {
          const v = quoted(text);
          if (v) { S.site.lede = v; render(); did('Tagline updated'); await say('That is in.'); acted = true; }
          else { await say('What should it say? Pop it in quotes.'); acted = true; }
        } else if (wants(t, ['rename', 'business name', 'company name', 'we are called', "we're called"])) {
          const v = quoted(text);
          if (v) { S.site.name = v; render(); did('Name updated'); await say('Renamed to ' + v + '.'); acted = true; }
        }

        // — contact details —
        const phone = text.match(/(\+?64[\d\s-]{7,}|0[2-9][\d\s-]{6,})/);
        if (phone) {
          S.site.contact.phone = phone[0].trim();
          if (!hasSection('contact')) addSection({ type: 'contact' }, 'band');
          render();
          did('Phone number added');
          await say('Phone is on the page and in the header.');
          acted = true;
        }
        const email = text.match(/[\w.+-]+@[\w-]+\.[\w.]+/);
        if (email) {
          S.site.contact.email = email[0];
          if (!hasSection('contact')) addSection({ type: 'contact' }, 'band');
          render();
          did('Email added');
          await say('Email is up there too.');
          acted = true;
        }

        // — remove a section —
        if (wants(t, ['remove', 'delete', 'get rid', 'lose the', 'take out', 'drop the'])) {
          const map = [['gallery', ['gallery', 'photo', 'picture', 'image']], ['services', ['service', 'what we do']],
                       ['contact', ['contact', 'phone', 'details']], ['about', ['about', 'story']],
                       ['hours', ['hours', 'opening']], ['testimonial', ['testimonial', 'review', 'quote']],
                       ['band', ['banner', 'call to action', 'cta', 'band']]];
          const hit = map.find((m) => m[1].some((w) => t.includes(w)));
          if (hit && dropSection(hit[0])) { render(); did('Removed the ' + hit[0] + ' section'); await say('Gone.'); acted = true; }
          else if (hit) { await say('There is no ' + hit[0] + ' section on there at the moment.'); acted = true; }
        }

        // — add sections —
        if (!acted || wants(t, ['add', 'put', 'include', 'need'])) {
          const base = baseFor();
          if (wants(t, ['service', 'what we do', 'offering']) && !wants(t, ['remove', 'delete'])) {
            const sc = S.scraped && S.scraped.services && S.scraped.services.length >= 2
              ? S.scraped.services.slice(0, 6).map((x) => [String(x).slice(0, 42), blurb(x)])
              : base.services;
            addSection({ type: 'services', label: base.eyebrow, title: 'How we can help', items: sc }, 'band');
            render(); did('Services section added');
            await say('Services are in — say the word if you want the wording changed.');
            acted = true;
          } else if (wants(t, ['gallery', 'photo', 'picture', 'image', 'portfolio', 'our work'])) {
            const shots = (S.site.images.length ? S.site.images : (S.scraped ? (S.scraped.galleryImages || []) : [])).slice(0, 6);
            addSection({ type: 'gallery', images: shots }, 'band');
            render(); did(shots.length ? 'Gallery added with ' + shots.length + ' photos' : 'Gallery added — placeholders for now');
            await say(shots.length ? 'Gallery is in with the photos I found.' : 'Gallery is in with placeholders — email me your photos and I will drop them in.');
            acted = true;
          } else if (wants(t, ['contact', 'phone', 'email', 'address', 'find us', 'get in touch'])) {
            addSection({ type: 'contact' }, 'band');
            render(); did('Contact section added');
            await say(S.site.contact.phone || S.site.contact.email ? 'Contact section is on.' : 'Contact section is on — give me a number or an email and I will fill it in.');
            acted = true;
          } else if (wants(t, ['about', 'story', 'who we are', 'history'])) {
            const txt = (S.scraped && S.scraped.aboutText) ? S.scraped.aboutText.slice(0, 320)
              : S.site.name + ' has been looking after this patch for years. Small team, local, and we answer the phone.';
            addSection({ type: 'about', text: txt }, 'band');
            render(); did('About section added');
            await say('About section is in. Want different words? Send them over in quotes.');
            acted = true;
          } else if (wants(t, ['hours', 'opening', 'open time', 'when are you open'])) {
            addSection({ type: 'hours', rows: [['Monday – Friday', '7.30am – 5pm'], ['Saturday', '8am – 12pm'], ['Sunday', 'Closed'], ['Emergencies', 'Any time']] }, 'band');
            render(); did('Opening hours added');
            await say('Hours are up — tell me the real ones and I will correct them.');
            acted = true;
          } else if (wants(t, ['testimonial', 'review', 'what people say'])) {
            addSection({ type: 'testimonial', quote: 'Turned up when they said they would, fixed it properly, charged what they quoted.', who: 'A very relieved local' }, 'band');
            render(); did('Testimonial added');
            await say('Popped a placeholder review in — send me a real one and it goes straight up.');
            acted = true;
          }
        }

        // — vibe / typography —
        if (!acted && wants(t, ['bolder', 'modern', 'classic', 'friendly', 'serious', 'playful', 'clean', 'minimal', 'font', 'vibe', 'smarter', 'posh'])) {
          if (wants(t, ['classic', 'serious', 'posh', 'smarter'])) { S.site.display = "Georgia, 'Times New Roman', serif"; }
          else if (wants(t, ['playful', 'friendly'])) { S.site.display = "'Poppins', system-ui, sans-serif"; }
          else { S.site.display = "'Inter', system-ui, sans-serif"; }
          render(); did('Typography updated');
          await say('Changed the type. Have a look at the headings.');
          acted = true;
        }

        // — hero photo —
        if (!acted && wants(t, ['hero', 'big photo', 'background image', 'header image'])) {
          const pool = (S.scraped && S.scraped.galleryImages) ? S.scraped.galleryImages : [];
          if (wants(t, ['remove', 'no ', 'without'])) { S.site.heroImage = null; render(); did('Hero photo removed'); await say('Back to clean colour.'); }
          else if (pool.length) {
            const i = pool.indexOf(S.site.heroImage);
            S.site.heroImage = pool[(i + 1) % pool.length];
            render(); did('Hero photo swapped');
            await say('Try that one.');
          } else { await say("I don't have any photos yet — give me the URL of your old site or Facebook page and I'll grab them."); }
          acted = true;
        }

        if (!acted) {
          S.history.pop();
          await say("I can do colours, headlines, sections (services, gallery, about, hours, contact, reviews), your phone and email — or publish it. What's it to be?");
        }
        chips(IDLE_CHIPS);
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Publish
      // ══════════════════════════════════════════════
      async function publish() {
        if (!S.site.name) {
          await say('Give me something to publish first — what is the business called?');
          S.awaiting = 'name';
          return;
        }

        $('agent-state').textContent = 'online · publishing';
        await say('Righto. Publishing to ' + S.slug + '.garage.co.nz…', 420);
        const steps = ['Pages built', 'Images optimised', 'Mobile layout checked', 'SSL certificate issued', 'DNS pointed at ' + S.slug + '.garage.co.nz'];
        for (const step of steps) { did(step); await wait(430); }
        await wait(350);

        const url = 'https://' + S.slug + '.garage.co.nz';
        $('live-url').textContent = S.slug + '.garage.co.nz';
        $('live-url').href = url;
        $('agent-state').textContent = 'online · live';
        show('live');
        confetti();
      }

      $('back-to-build').addEventListener('click', async () => {
        show('build');
        chips(IDLE_CHIPS);
      });

      $('live-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = $('live-email').value.trim();
        const note = $('live-note');
        note.style.color = 'var(--text-muted)';
        note.textContent = 'Sending…';
        try {
          const res = await fetch('/api/build-claim', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: S.slug, email: email, sourceUrl: S.sourceUrl, site: S.site }),
          });
          const data = await res.json();
          if (data.success) {
            note.style.color = 'var(--good)';
            note.textContent = '✓ Keys on their way to ' + email + '.';
            $('live-form').querySelector('button').textContent = 'Sent';
          } else if (data.error === 'taken') {
            note.style.color = 'var(--bad)';
            note.textContent = 'Someone grabbed that address a second ago — pick another and republish.';
          } else {
            throw new Error('failed');
          }
        } catch {
          note.style.color = 'var(--bad)';
          note.textContent = "Couldn't reach us just now — email ben@garage.co.nz and we'll sort it.";
        }
      });

      // ══════════════════════════════════════════════
      //  Confetti
      // ══════════════════════════════════════════════
      function confetti() {
        const cv = $('confetti');
        const ctx = cv.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        cv.width = cv.offsetWidth * dpr;
        cv.height = cv.offsetHeight * dpr;
        ctx.scale(dpr, dpr);

        const W = cv.offsetWidth, H = cv.offsetHeight;
        const colours = ['#2563eb', '#f97316', '#16a34a', '#eab308', '#db2777', '#7c3aed'];
        const bits = [];
        for (let i = 0; i < 140; i++) {
          bits.push({
            x: Math.random() * W,
            y: -20 - Math.random() * H * 0.6,
            w: 6 + Math.random() * 6,
            h: 8 + Math.random() * 8,
            vy: 2 + Math.random() * 3.5,
            vx: -1 + Math.random() * 2,
            rot: Math.random() * Math.PI,
            vr: -0.12 + Math.random() * 0.24,
            c: colours[(Math.random() * colours.length) | 0],
          });
        }

        const started = performance.now();
        (function frame(now) {
          ctx.clearRect(0, 0, W, H);
          const age = now - started;
          bits.forEach((b) => {
            b.x += b.vx; b.y += b.vy; b.rot += b.vr;
            ctx.save();
            ctx.translate(b.x, b.y);
            ctx.rotate(b.rot);
            ctx.globalAlpha = age > 3500 ? Math.max(0, 1 - (age - 3500) / 1500) : 1;
            ctx.fillStyle = b.c;
            ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h);
            ctx.restore();
          });
          if (age < 5000) requestAnimationFrame(frame);
          else ctx.clearRect(0, 0, W, H);
        })(started);
      }
    </script>
  </body>
</html>
