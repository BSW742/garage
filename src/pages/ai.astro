        legal: { match: ['law', 'legal', 'solicit', 'barrist', 'convey'], colour: '#1e293b', eyebrow: 'Legal advice, plainly put', lede: 'Straight answers, fixed fees where we can, and no billing you for saying hello.', cta: 'Book a consult',
          services: [['Property', 'Buying, selling and everything the bank needs.'], ['Wills & trusts', 'Sorted properly so nobody has to guess later.'], ['Business', 'Contracts, structures and disputes.']] },
        accounting: { match: ['account', 'bookkeep', 'tax', 'payroll'], colour: '#0f766e', eyebrow: 'Chartered accountants', lede: 'Tax done on time, numbers you can actually read, and a call returned same day.', cta: 'Have a chat',
          services: [['Tax & GST', 'Filed on time, every time.'], ['Bookkeeping', 'Xero set up and kept tidy.'], ['Advisory', 'What the numbers mean and what to do next.']] },
        medical: { match: ['dental', 'dentist', 'medical', 'clinic', 'health', 'physio', 'chiro', 'hospital'], colour: '#0891b2', eyebrow: 'Accepting new patients', lede: 'Careful, unhurried care from a team that remembers your name.', cta: 'Book an appointment',
          services: [['Appointments', 'Same-week bookings, online or by phone.'], ['Our team', 'Experienced clinicians, local for years.'], ['Fees', 'Clear pricing, no surprises at the desk.']] },
        veterinary: { match: ['vet', 'animal', 'pet'], colour: '#7c3aed', eyebrow: 'Caring for local animals', lede: 'Gentle treatment for the family members with four legs.', cta: 'Book a visit',
          services: [['Consults', 'Check-ups, vaccinations and the worrying lumps.'], ['Surgery', 'Modern theatre, careful aftercare.'], ['After hours', 'Emergency cover when you need it most.']] },
        fitness: { match: ['gym', 'fitness', 'train', 'crossfit', 'yoga', 'pilates'], colour: '#dc2626', eyebrow: 'Train with us', lede: 'Coaching that meets you where you are — no mirrors-and-ego nonsense.', cta: 'Start a trial',
          services: [['Group classes', 'Six days a week, all levels welcome.'], ['Personal training', 'A plan built around your week, not ours.'], ['Memberships', 'Simple pricing, no lock-in.']] },
        salon: { match: ['hair', 'salon', 'beauty', 'barber', 'nail', 'spa'], colour: '#db2777', eyebrow: 'Book your chair', lede: 'Cuts, colour and a couple of hours that are entirely about you.', cta: 'Book online',
          services: [['Cut & style', 'Consultation first, always.'], ['Colour', 'Balayage, foils and colour corrections.'], ['Treatments', 'Because your hair has been through a lot.']] },
        photography: { match: ['photo', 'film', 'video', 'studio'], colour: '#111827', eyebrow: 'Photography & film', lede: 'Pictures that look like the day actually felt.', cta: 'Check availability',
          services: [['Weddings', 'Full-day coverage, unhurried and unposed.'], ['Portraits', 'Families, whānau and the annual awkward one.'], ['Commercial', 'Product, team and brand shoots.']] },
        community: { match: ['trust', 'charity', 'community', 'foundation', 'society', 'club', 'church', 'kura', 'marae', 'volunteer'], colour: '#2563eb', eyebrow: 'For our community', lede: 'A local group doing practical good — and always glad of a hand.', cta: 'Get involved',
          services: [['What we do', 'The work, week in and week out.'], ['Volunteer', 'A few hours goes a very long way.'], ['Donate', 'Every dollar stays local.']] },
        default: { match: [], colour: '#2563eb', eyebrow: 'Local & independent', lede: 'Honest work, fair prices, and a person on the end of the phone.', cta: 'Get in touch',
          services: [['What we do', 'The work we are known for around here.'], ['Why us', 'Local, experienced and easy to deal with.'], ['Get a quote', 'Tell us what you need and we will price it up.']] },
      };

      function guessIndustry(text) {
        const t = (text || '').toLowerCase();
        for (const key in INDUSTRIES) {
          if (INDUSTRIES[key].match.some((m) => t.includes(m))) return key;
        }
        return 'default';
      }

      const SERVICE_BLURBS = [
        [['drain', 'blockage', 'sewer'], 'Blockages cleared and drains cameraed, same day where we can.'],
        [['gas'], 'Certified gasfitting — installs, repairs and safety checks.'],
        [['hot water', 'cylinder'], 'Repairs, replacements and the right system for your place.'],
        [['toilet', 'cistern'], 'Leaks, running cisterns and full replacements.'],
        [['pipe', 'burst'], 'Burst pipes patched properly, not just papered over.'],
        [['leak'], 'We find it before it finds your floorboards.'],
        [['bathroom', 'kitchen', 'renov'], 'Full fit-outs, done once and done right.'],
        [['emergency', '24'], 'Seven days a week, whenever it goes wrong.'],
        [['commercial', 'business'], 'Scheduled work and call-outs for local businesses.'],
        [['maintenance', 'service'], 'Regular visits so small things stay small.'],
        [['install'], 'Supplied, installed and left tidy.'],
        [['repair', 'fix'], 'Diagnosed, repaired and explained in plain English.'],
        [['design', 'consult'], 'Planned properly before anyone picks up a tool.'],
      ];

      function blurb(name, fallback) {
        const n = String(name).toLowerCase();
        const hit = SERVICE_BLURBS.find((b) => b[0].some((k) => n.includes(k)));
        return hit ? hit[1] : (fallback || (name + ' — done properly, priced up front.'));
      }

      // Cut to length without slicing a word in half
      function clip(text, max) {
        const clean = String(text || '').replace(/\s+/g, ' ').trim();
        if (clean.length <= max) return clean;
        const cut = clean.slice(0, max);
        const space = cut.lastIndexOf(' ');
        return (space > max * 0.6 ? cut.slice(0, space) : cut).replace(/[,;:\-–—]$/, '').trim();
      }

      // A headline should be a whole thought, not a sentence with its tail cut off
      function headlineFrom(text, fallback) {
        const clean = String(text || '').replace(/\s+/g, ' ').trim();
        if (!clean) return fallback;
        const sentence = (clean.split(/(?<=[.!?])\s+/)[0] || clean).replace(/[.]$/, '');
        if (sentence.length <= 72) return sentence;
        const clause = sentence.split(/\s*[,;—–]\s*/)[0];
        if (clause.length >= 12 && clause.length <= 72) return clause;
        return fallback;
      }

      function echoes(a, b) {
        const norm = (v) => String(v || '').toLowerCase().replace(/[^a-z0-9 ]/g, '').slice(0, 40);
        return !!norm(a) && norm(a) === norm(b);
      }

      // flowlineplumbing.co.nz tells us the business is called Flowline Plumbing
      // and that they are plumbers. Throwing that away and calling them
      // "Flowline3" off the slug is wasting the best thing we have.
      function nameFromDomain(host) {
        const bare = String(host || '').replace(/^www\./i, '').split('/')[0].split('.')[0];
        if (!bare) return '';
        let out = bare.replace(/[-_]/g, ' ');
        if (!/\s/.test(out)) {
          // Trade names run the words together. Split on a trade we recognise.
          const stems = [];
          for (const key in INDUSTRIES) for (const m of INDUSTRIES[key].match) stems.push(m);
          stems.sort((a, b) => b.length - a.length);
          for (const stem of stems) {
            const at = out.toLowerCase().indexOf(stem);
            if (at > 1) { out = out.slice(0, at) + ' ' + out.slice(at); break; }
          }
        }
        return out.replace(/\b[a-z]/g, (c) => c.toUpperCase()).trim().slice(0, 40);
      }

      function titleCase(slug) {
        return slug.replace(/-/g, ' ').replace(/\b[a-z]/g, (c) => c.toUpperCase());
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Rendering the preview
      // ══════════════════════════════════════════════
      let renderedKeys = new Set();

      function esc(str) {
        return String(str == null ? '' : str).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      }

      function initials(name) {
        const parts = (name || '?').split(/\s+/).filter(Boolean);
        return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
      }

      // Every editable string carries a path so a click can address it
      function blockHtml(section, i) {
        const s = S.site;
        const p = 'sec.' + i;
        const ed = (path, cls, tag, value, extra) =>
          '<' + tag + ' class="' + cls + '" data-edit="' + path + '"' + (extra || '') + '>' + esc(value) + '</' + tag + '>';

        switch (section.type) {
          case 'services':
            return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'What we do') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'How we can help') +
              '<div class="pv-grid">' +
              section.items.map((it, j) =>
                '<div class="pv-card" data-block="' + p + '.items.' + j + '">' +
                ed(p + '.items.' + j + '.0', '', 'h4', it[0]) +
                ed(p + '.items.' + j + '.1', '', 'p', it[1]) + '</div>').join('') +
              '</div></section>';

          case 'about':
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'About us') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || ('The story behind ' + s.name)) +
              ed(p + '.text', 'pv-prose', 'p', section.text) + '</section>';

          case 'gallery':
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Our work') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'Recent jobs') +
              '<div class="pv-gallery">' +
              (section.images.length ? section.images : ['', '', '', '', '', ''])
                .map((src, j) => '<div class="pv-shot" data-photo="' + p + '.images.' + j + '"' +
                  (src ? ' style="background-image:url(' + esc(src) + ')"' : '') + '></div>').join('') +
              '</div></section>';

          case 'hours':
            return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Opening hours') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'When we are about') +
              '<div class="pv-hours">' +
              section.rows.map((r, j) => '<div>' +
                ed(p + '.rows.' + j + '.0', '', 'span', r[0]) +
                ed(p + '.rows.' + j + '.1', '', 'span', r[1]) + '</div>').join('') +
              '</div></section>';

          case 'video': {
            // Mirrors the reel in site-render.ts. Thumbnails only — the canvas
            // is click-to-edit and a player would fight it.
            // clips is how a reel stores them — id, title and channel. The
            // older shape is a bare list of ids and still renders.
            const ids = (Array.isArray(section.clips) && section.clips.length
              ? section.clips.map((c) => c && c.id)
              : Array.isArray(section.videos) ? section.videos
              : section.videoId ? [section.videoId] : [])
              .filter((v) => /^[A-Za-z0-9_-]{11}$/.test(String(v || '')));
            if (!ids.length) return '';
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Watch') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'See us at work') +
              '<div class="pv-reel">' +
              ids.map((id) => '<div class="pv-reel-slide">' +
                '<img src="https://i.ytimg.com/vi/' + esc(id) + '/hqdefault.jpg" alt="" />' +
                '<span class="pv-reel-play"></span></div>').join('') +
              '</div>' +
              (ids.length > 1 ? '<p class="pv-reel-count">1 / ' + ids.length + '</p>' : '') +
              '</section>';
          }

          case 'alongside': {
            const list = section.partners || [];
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Who we work with') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'We work alongside') +
              (list.length
                ? '<div class="pv-along">' + list.map((who, j) =>
                    '<span class="pv-along-one" data-block="' + p + '.partners.' + j + '">' +
                    esc(who.name || '') + '</span>').join('') + '</div>'
                : '') +
              '<button type="button" class="pv-along-add" data-add="' + p + '.partners">' +
              (list.length ? '+ Add another' : '+ Add the first one') + '</button>' +
              '</section>';
          }

          case 'shop':
            // Products were the one list on the page you could not touch: no
            // block to select, so nothing to delete, and plain text rather
            // than editable fields. Everything else here has both.
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Shop') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'Have a look') +
              '<div class="pv-shop">' +
              (s.products || []).map((prod, j) => '<div class="pv-buy" data-block="products.' + j + '">' +
                '<div class="pv-buy-shot" data-photo="products.' + j + '.image"' +
                (prod.image ? ' style="background-image:url(' + esc(prod.image) + ')"' : '') + '></div>' +
                ed('products.' + j + '.name', '', 'strong', prod.name || 'Untitled') +
                (prod.text ? ed('products.' + j + '.text', '', 'p', prod.text) : '') +
                ed('products.' + j + '.price', 'pv-buy-price', 'span', prod.price || '—') +
                '</div>').join('') +
              '<button type="button" class="pv-add" data-add="products">+ Add item</button>' +
              '</div></section>';

          case 'specs':
          case 'included':
          case 'honest':
          case 'area':
          case 'credentials':
          case 'conditions':
          case 'steps':
          case 'acc': {
            const heads = { conditions: ['What we treat', 'Come in with this'],
                            steps: ['How it works', 'What happens when you come in'],
                            acc: ['ACC', 'Hurt yourself? ACC covers most of it.'],
                            area: ['Where we work', 'Areas we cover'],
                            credentials: ['Licences', 'Licensed and accountable'],
                            specs: ['Details', 'The numbers'],
                            included: ["What's included", 'Comes with it'],
                            honest: ['Known faults', 'What is wrong with it'] }[section.type];
            return '<section class="pv-section' + (section.type === 'conditions' || section.type === 'included' ? ' alt' : '') +
              (section.type === 'acc' ? ' pv-acc' : '') + (section.type === 'honest' ? ' pv-honest' : '') + '">' +
              ed(p + '.label', 'pv-label', 'p', section.label || heads[0]) +
              ed(p + '.title', 'pv-h2', 'h2', section.title || heads[1]) +
              (section.text ? ed(p + '.text', 'pv-prose', 'p', section.text) : '') +
              '<div class="pv-grid">' +
              (section.items || []).map((it, j) =>
                '<div class="pv-card" data-block="' + p + '.items.' + j + '">' +
                ed(p + '.items.' + j + '.0', '', 'h4', it[0]) +
                ed(p + '.items.' + j + '.1', '', 'p', it[1]) + '</div>').join('') +
              '</div></section>';
          }

          case 'menu': {
            const groups = section.menu || [];
            if (!groups.length) return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'The menu') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'What we are serving') +
              '<p class="pv-prose">Nothing on the menu yet — tell me what you serve.</p></section>';
            return '<section class="pv-section pv-menu">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'The menu') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'What we are serving') +
              '<div class="pv-board' + (groups.length > 1 ? ' two' : '') + '">' +
              groups.map((g, gi) => '<div class="pv-group" data-block="' + p + '.menu.' + gi + '">' +
                ed(p + '.menu.' + gi + '.heading', 'pv-group-h', 'h4', g.heading || '') +
                (g.note ? ed(p + '.menu.' + gi + '.note', 'pv-group-note', 'p', g.note) : '') +
                (g.items || []).map((it, ii) => {
                  const q = p + '.menu.' + gi + '.items.' + ii;
                  return '<div class="pv-dish" data-block="' + q + '">' +
                    ed(q + '.name', 'pv-dish-name', 'strong', it.name || '') +
                    (it.price ? ed(q + '.price', 'pv-dish-price', 'span', it.price) : '<span></span>') +
                    (it.text ? ed(q + '.text', 'pv-dish-text', 'p', it.text) : '') +
                    '</div>';
                }).join('') +
                '</div>').join('') +
              '</div></section>';
          }

          case 'pricing':
            return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Pricing') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'What it costs') +
              '<div class="pv-rates">' +
              (section.rows || []).map((r, j) => '<div>' +
                ed(p + '.rows.' + j + '.0', 'pv-rate-name', 'span', r[0]) +
                '<span class="pv-rate-dots"></span>' +
                ed(p + '.rows.' + j + '.1', 'pv-rate-price', 'span', r[1]) + '</div>').join('') +
              '</div>' +
              (section.text ? ed(p + '.text', 'pv-rate-note', 'p', section.text) : '') +
              '</section>';

          case 'faq':
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Questions') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'Common questions') +
              '<div class="pv-faq">' +
              (section.items || []).map((i, j) => '<div class="pv-faq-item">' +
                ed(p + '.items.' + j + '.0', 'pv-faq-q', 'div', i[0]) +
                ed(p + '.items.' + j + '.1', 'pv-faq-a', 'div', i[1]) + '</div>').join('') +
              '</div></section>';

          case 'testimonial':
            return '<section class="pv-section"><div class="pv-quote">' +
              ed(p + '.quote', 'pv-quote-text', 'p', section.quote) +
              ed(p + '.who', 'pv-quote-who', 'span', section.who) + '</div></section>';

          case 'contact': {
            const c = s.contact;
            const pills = [];
            if (c.phone) pills.push('<span class="pv-pill"><b>Call</b> ' + ed('contact.phone', '', 'span', c.phone) + '</span>');
            if (c.email) pills.push('<span class="pv-pill"><b>Email</b> ' + ed('contact.email', '', 'span', c.email) + '</span>');
            if (c.address) pills.push('<span class="pv-pill"><b>Find us</b> ' + ed('contact.address', '', 'span', c.address) + '</span>');
            if (!pills.length) pills.push('<span class="pv-pill"><b>Contact</b> add your phone or email in the chat</span>');
            // Mirrors the published map in site-render.ts.
            const map = c.address
              ? '<div class="pv-map"><iframe src="https://maps.google.com/maps?q=' +
                encodeURIComponent(c.address) + '&amp;output=embed" loading="lazy" ' +
                'referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe></div>'
              : '';
            return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Get in touch') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'Give us a yell') +
              '<div class="pv-contact">' + pills.join('') + '</div>' + map + '</section>';
          }

          case 'band':
            return '<section class="pv-band"' + (section.tint ? ' style="background:' + esc(section.tint) + '"' : '') + '>' +
              ed(p + '.title', 'pv-h2', 'h2', section.title) +
              ed(p + '.text', '', 'p', section.text) +
              '<span class="pv-btn" data-edit="cta">' + esc(s.cta) + '</span></section>';

          default:
            return '';
        }
      }

      // Every render path pushed the three palette variables by hand, and every
      // one of them read straight through s.palette. Fifty sites in the
      // database have no palette at all — anything the cron or a script made —
      // so opening one threw inside render() and came back as "couldn't load
      // that one". One helper, and a missing palette is now a default rather
      // than a dead builder.
      function setPalette(root, palette) {
        const pal = palette || {};
        root.parentElement.style.setProperty('--pv-primary', pal.primary || '#2563eb');
        root.parentElement.style.setProperty('--pv-deep', pal.deep || '#1e40af');
        root.parentElement.style.setProperty('--pv-wash', pal.wash || '#f6f8fb');
      }

      // Anything the builder did not write may be missing the shapes the
      // builder assumes. The cron writes no palette; the reel script wrote no
      // contact; an import may have neither. Every one of those was a
      // TypeError inside render(), which the caller reports as "couldn't load
      // that one" — the same sentence as a wrong address, so it looked like a
      // bad slug rather than a crash.
      //
      // Filling the gaps once on the way in beats guarding forty reads.
      function adopt(site) {
        const s = site || {};
        if (!Array.isArray(s.sections)) s.sections = [];
        if (!s.contact || typeof s.contact !== 'object') s.contact = {};
        if (!Array.isArray(s.products)) s.products = [];
        if (!s.palette || typeof s.palette !== 'object') s.palette = {};
        s.palette.primary = s.palette.primary || '#2563eb';
        s.palette.deep = s.palette.deep || '#1e40af';
        s.palette.wash = s.palette.wash || '#f6f8fb';
        return s;
      }

      function render() {
        if (S.editing) { S.renderQueued = true; return; }  // never yank the caret away
        const s = S.site;
        const root = $('site-root');
        loadFont(s.style);

        // Templates that are not built out of sections have no slot to show.
        if (!['tribute', 'diet', 'chain', 'listing', 'bubbles', 'game'].includes(s.style)) ensureAlongSlot();

        // Neither is a diary. What it shows is a tally of posts that live in
        // the database, not in the config, so the preview is the scoreboard
        // with nothing in it yet — which is honestly what day zero looks like.
        if (s.style === 'game') {
          const things = [];
          (s.sections || []).forEach((sec) => {
            (sec && sec.items || []).forEach((it) => { if (it && it[0]) things.push(it); });
            (sec && sec.rows || []).forEach((r) => { if (r && r[0]) things.push(r); });
          });
          (s.products || []).forEach((p) => { if (p && p.name) things.push([p.name, p.text || '']); });
          const shown = things.slice(0, 7);
          root.innerHTML =
            '<div class="pv-gm-head">' +
            (s.eyebrow ? '<p class="pv-gm-eyebrow" data-edit="eyebrow">' + esc(s.eyebrow) + '</p>' : '') +
            '<h1 class="pv-h1" data-edit="name">' + esc(s.name) + '</h1>' +
            (s.lede ? '<p class="pv-gm-lede" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
            '</div>' +
            '<div class="pv-gm-board">' +
            '<div class="pv-gm-hud"><span>FOUND <b>0</b>/' + things.length + '</span><span>GO</span></div>' +
            '<div class="pv-gm-foes">' +
            (shown.length ? shown.map(() => '\u{1F47E}').join('') : '\u{1F47E}\u{1F47E}\u{1F47E}') +
            '</div><div class="pv-gm-ship">\u{1F680}</div></div>' +
            '<p class="pv-gm-note">' +
            (things.length
              ? 'One invader per thing you do. Shoot one and it says what it was — and it is all ' +
                'written out plainly underneath for anyone who would rather just read.'
              : 'Add what you do and each one becomes an invader.') +
            '</p>';
          $('canvas-empty').classList.toggle('gone', true);
          renderedKeys = new Set(['game']);
          setPalette(root, s.palette);
          root.parentElement.classList.add('pv');
          root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-tribute', 'st-listing', 'st-diet', 'st-chain', 'st-bubbles');
          root.parentElement.classList.add('st-game');
          applyTone();
          restoreSelection();
          return;
        }

        if (s.style === 'eggs') {
          // Same three-line break as eggs-render.ts, so the shape matches.
          const words = String(s.headline || s.name || '').trim().split(/\s+/).filter(Boolean);
          let lines;
          if (words.length < 3) lines = [words.join(' ')];
          else {
            const size = Math.ceil(words.length / 3);
            lines = [];
