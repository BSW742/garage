    <script is:inline>
      // ══════════════════════════════════════════════
      //  Rendering the preview
      // ══════════════════════════════════════════════
      let renderedKeys = new Set();

      function esc(str) {
        return String(str == null ? '' : str).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      }

      function initials(name) {
        const parts = (name || '?').split(/\s+/).filter(Boolean);
        return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
      }

      // Every editable string carries a path so a click can address it
      function blockHtml(section, i) {
        const s = S.site;
        const p = 'sec.' + i;
        const ed = (path, cls, tag, value, extra) =>
          '<' + tag + ' class="' + cls + '" data-edit="' + path + '"' + (extra || '') + '>' + esc(value) + '</' + tag + '>';

        switch (section.type) {
          case 'services':
            return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'What we do') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'How we can help') +
              '<div class="pv-grid">' +
              section.items.map((it, j) =>
                '<div class="pv-card" data-block="' + p + '.items.' + j + '"><span class="pv-tick">◆</span>' +
                ed(p + '.items.' + j + '.0', '', 'h4', it[0]) +
                ed(p + '.items.' + j + '.1', '', 'p', it[1]) + '</div>').join('') +
              '</div></section>';

          case 'about':
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'About us') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || ('The story behind ' + s.name)) +
              ed(p + '.text', 'pv-prose', 'p', section.text) + '</section>';

          case 'gallery':
            return '<section class="pv-section">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Our work') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'Recent jobs') +
              '<div class="pv-gallery">' +
              (section.images.length ? section.images : ['', '', '', '', '', ''])
                .map((src, j) => '<div class="pv-shot" data-photo="' + p + '.images.' + j + '"' +
                  (src ? ' style="background-image:url(' + esc(src) + ')"' : '') + '></div>').join('') +
              '</div></section>';

          case 'hours':
            return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Opening hours') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'When we are about') +
              '<div class="pv-hours">' +
              section.rows.map((r, j) => '<div>' +
                ed(p + '.rows.' + j + '.0', '', 'span', r[0]) +
                ed(p + '.rows.' + j + '.1', '', 'span', r[1]) + '</div>').join('') +
              '</div></section>';

          case 'testimonial':
            return '<section class="pv-section"><div class="pv-quote">' +
              ed(p + '.quote', 'pv-quote-text', 'p', section.quote) +
              ed(p + '.who', 'pv-quote-who', 'span', section.who) + '</div></section>';

          case 'contact': {
            const c = s.contact;
            const pills = [];
            if (c.phone) pills.push('<span class="pv-pill"><b>Call</b> ' + ed('contact.phone', '', 'span', c.phone) + '</span>');
            if (c.email) pills.push('<span class="pv-pill"><b>Email</b> ' + ed('contact.email', '', 'span', c.email) + '</span>');
            if (c.address) pills.push('<span class="pv-pill"><b>Find us</b> ' + ed('contact.address', '', 'span', c.address) + '</span>');
            if (!pills.length) pills.push('<span class="pv-pill"><b>Contact</b> add your phone or email in the chat</span>');
            return '<section class="pv-section alt">' +
              ed(p + '.label', 'pv-label', 'p', section.label || 'Get in touch') +
              ed(p + '.title', 'pv-h2', 'h2', section.title || 'Give us a yell') +
              '<div class="pv-contact">' + pills.join('') + '</div></section>';
          }

          case 'band':
            return '<section class="pv-band"' + (section.tint ? ' style="background:' + esc(section.tint) + '"' : '') + '>' +
              ed(p + '.title', 'pv-h2', 'h2', section.title) +
              ed(p + '.text', '', 'p', section.text) +
              '<span class="pv-btn" data-edit="cta">' + esc(s.cta) + '</span></section>';

          default:
            return '';
        }
      }

      function render() {
        if (S.editing) { S.renderQueued = true; return; }  // never yank the caret away
        const s = S.site;
        const root = $('site-root');
        const hasContent = !!(s.headline || s.sections.length);
        $('canvas-empty').classList.toggle('gone', hasContent);
        if (!hasContent) { root.innerHTML = ''; renderedKeys = new Set(); return; }

        const blocks = [];

        blocks.push({ key: 'nav', html:
          '<nav class="pv-nav"><div class="pv-brand">' +
          (s.logo ? '<img src="' + esc(s.logo) + '" alt="" data-photo="logo" />' : '<span class="pv-glyph">' + esc(initials(s.name)) + '</span><span data-edit="name">' + esc(s.name) + '</span>') +
          '</div><div class="pv-links"><span>Home</span><span>Services</span><span>About</span><span>Contact</span></div>' +
          '<span class="pv-cta" data-edit="cta">' + esc(s.cta) + '</span></nav>' });

        blocks.push({ key: 'hero', html:
          '<header class="pv-hero' + (s.heroImage ? ' has-photo' : '') + '">' +
          (s.heroImage ? '<div class="pv-hero-photo" data-photo="heroImage" style="background-image:url(' + esc(s.heroImage) + ')"></div>' : '') +
          '<div class="pv-hero-inner">' +
          (s.eyebrow ? '<p class="pv-eyebrow" data-edit="eyebrow">' + esc(s.eyebrow) + '</p>' : '') +
          '<h1 class="pv-h1" data-edit="headline">' + esc(s.headline) + '</h1>' +
          (s.lede ? '<p class="pv-lede" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
          '<span class="pv-btn" data-edit="cta">' + esc(s.cta) + '</span>' +
          (s.contact.phone ? '<span class="pv-btn pv-btn-2" data-edit="contact.phone">' + esc(s.contact.phone) + '</span>' : '<span class="pv-btn pv-btn-2">Learn more</span>') +
          '</div></header>' });

        s.sections.forEach((sec, i) => blocks.push({ key: sec.type, block: 'sec.' + i, html: blockHtml(sec, i) }));

        const socialNames = Object.keys(s.socials || {});
        blocks.push({ key: 'foot', html:
          '<footer class="pv-foot"><span>© ' + new Date().getFullYear() + ' ' + esc(s.name) + '</span>' +
          (socialNames.length
            ? '<span class="pv-socials">' + socialNames.map((n) => '<span>' + esc(n[0].toUpperCase() + n.slice(1)) + '</span>').join('') + '</span>'
            : '') +
          '<span>' + esc(S.slug) + '.garage.co.nz</span></footer>' });

        const nextKeys = new Set(blocks.map((b) => b.key));
        const fresh = blocks.filter((b) => !renderedKeys.has(b.key) && b.key !== 'nav' && b.key !== 'hero' && b.key !== 'foot');
        root.innerHTML = blocks
          .map((b, i) => '<div data-i="' + i + '"' + (b.block ? ' data-block="' + b.block + '"' : '') +
            ' class="' + (renderedKeys.has(b.key) ? '' : 'pv-block') + '">' + b.html + '</div>')
          .join('');
        renderedKeys = nextKeys;

        // Ride the canvas down to whatever just landed
        if (fresh.length) {
          const idx = blocks.indexOf(fresh[fresh.length - 1]);
          const el = root.querySelector('[data-i="' + idx + '"]');
          if (el) setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 60);
        }

        root.parentElement.style.setProperty('--pv-primary', s.palette.primary);
        root.parentElement.style.setProperty('--pv-deep', s.palette.deep);
        root.parentElement.style.setProperty('--pv-wash', s.palette.wash);
        root.parentElement.classList.add('pv');
        const st = S.site.style || 'modern';
        root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic');
        root.parentElement.classList.add('st-' + st);
        applyTone();
        restoreSelection();
      }

      function snapshot() {
        S.history.push(JSON.stringify(S.site));
        if (S.history.length > 25) S.history.shift();
      }

      function hasSection(type) { return S.site.sections.some((s) => s.type === type); }
      function addSection(section, before) {
        if (hasSection(section.type)) {
          S.site.sections = S.site.sections.map((s) => (s.type === section.type ? section : s));
        } else if (before && hasSection(before)) {
          const i = S.site.sections.findIndex((s) => s.type === before);
          S.site.sections.splice(i, 0, section);
        } else {
          S.site.sections.push(section);
        }
      }
      function dropSection(type) {
        const before = S.site.sections.length;
        S.site.sections = S.site.sections.filter((s) => s.type !== type);
        renderedKeys.delete(type);
        return S.site.sections.length !== before;
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Entering the builder
      // ══════════════════════════════════════════════
      async function enterBuilder() {
        show('build');
        $('chrome-url').textContent = S.slug + '.garage.co.nz';
        render();
        await wait(450);
        await say('Right — ' + S.slug + '.garage.co.nz is yours. Blank page, live already.');

        if (S.sourceUrl) {
          await say('Shall I drag your assets across from ' + S.sourceUrl + '? Logo, colours, wording, photos — I only keep what still looks good.');
          chips([
            { label: 'Yes — drag it across', yes: true, send: 'pull the assets across' },
            { label: 'No, start clean', send: 'start fresh' },
          ]);
        } else {
          await say('What is the business or group called?');
          S.awaiting = 'name';
        }
        $('agent-text').focus();
      }

      // ── Pull everything from the old site ────────
      async function importAssets() {
        $('agent-state').textContent = 'online · reading ' + S.sourceUrl;
        await say('On it — reading ' + S.sourceUrl + ' now.', 500);

        const d = await S.scrapePromise;
        $('agent-state').textContent = 'online · building';

        if (!d) {
          await say("Couldn't get in the front door of that site — it might be blocking robots. No drama, we'll build it from scratch.");
          await say('What is the business called?');
          S.awaiting = 'name';
          return;
        }

        S.scraped = d;
        snapshot();
        const s = S.site;
        const mine = guessIndustry((d.title || '') + ' ' + (d.description || '') + ' ' + (d.services || []).join(' ') + ' ' + S.slug);
        const industry = mine !== 'default' ? mine : (d.industry && INDUSTRIES[d.industry] ? d.industry : 'default');
        const base = INDUSTRIES[industry];

        s.name = (d.title || titleCase(S.slug)).split(/[|–—-]/)[0].trim().slice(0, 40) || titleCase(S.slug);
        s.palette = paletteFrom(d.brandColour || base.colour);
        s.eyebrow = base.eyebrow;
        s.headline = headlineFrom(d.tagline || d.description || '', s.name);
        // Don't print the same sentence twice under itself
        const ledeSource = d.description && !echoes(d.description, s.headline) ? d.description : base.lede;
        s.lede = clip(ledeSource, 190);
        s.cta = base.cta;
        render();
        did('Name and words lifted');
        await wait(450);

        if (d.brandColour) { did('Your brand colour, lifted off the old site'); await wait(420); }

        if (d.logoUrl) { s.logo = d.logoUrl; render(); did('Logo brought across'); await wait(450); }
        if (d.heroImage) { s.heroImage = d.heroImage; render(); did('Hero photo brought across'); await wait(450); }

        const services = (d.services || []).filter(Boolean).slice(0, 6);
        const items = services.length >= 2
          ? services.slice(0, 6).map((t) => [String(t).slice(0, 42), blurb(t)])
          : base.services;
        addSection({ type: 'services', label: base.eyebrow, title: services.length >= 2 ? 'What we do' : 'How we can help', items: items });
        render();
        did(services.length >= 2 ? 'Kept your ' + items.length + ' services' : 'Drafted a services section');
        await wait(500);

        if (d.aboutText && d.aboutText.length > 60) {
          addSection({ type: 'about', text: d.aboutText.slice(0, 320) });
          render();
          did('Your about copy, tidied');
          await wait(450);
        }

        const shots = (d.galleryImages || []).filter((u) => u && u !== d.heroImage).slice(0, 6);
        if (shots.length >= 2) {
          s.images = shots;
          addSection({ type: 'gallery', images: shots });
          render();
          did(shots.length + ' photos pulled through');
          await wait(450);
        }

        // Scrapers happily glue two phone numbers together — sanity-check the digits
        const phoneDigits = String(d.phone || '').replace(/\D/g, '');
        const goodPhone = phoneDigits.length >= 7 && phoneDigits.length <= 11 ? d.phone : '';
        const goodEmail = d.email && /^[\w.+-]+@[\w-]+\.[a-z]{2,}$/i.test(d.email) && !/\.(png|jpe?g|svg|gif|webp)$/i.test(d.email) ? d.email : '';
        const socials = d.socials && Object.keys(d.socials).length ? d.socials : null;
        if (socials) {
          s.socials = socials;
          render();
          did(Object.keys(socials).map((k) => k[0].toUpperCase() + k.slice(1)).join(' and ') + ' linked up');
          await wait(420);
        }

        if (d.hours && d.hours.length >= 2) {
          addSection({ type: 'hours', rows: d.hours.slice(0, 4) });
          render();
          did('Your actual opening hours');
          await wait(420);
        }

        if (goodPhone || goodEmail || d.address) {
          s.contact = { phone: goodPhone, email: goodEmail, address: (d.address || '').slice(0, 60) };
          addSection({ type: 'contact' });
          render();
          did('Phone, email and address wired up');
          await wait(450);
        }

        addSection({ type: 'band', title: 'Ready when you are', text: 'One call and we will sort it.' });
        render();
        await wait(400);

        await say("There you go — that's your site, live at " + S.slug + '.garage.co.nz. Anything you want changed, just say it.');
        chips(IDLE_CHIPS);
      }

      // ── Blank start ──────────────────────────────
      function startFresh(name) {
        snapshot();
        const industry = guessIndustry(name + ' ' + S.slug);
        const base = INDUSTRIES[industry];
        const s = S.site;
        s.name = name;
        s.palette = paletteFrom(base.colour);
        s.eyebrow = base.eyebrow;
        s.headline = name;
        s.lede = base.lede;
        s.cta = base.cta;
        s.sections = [
          { type: 'services', label: base.eyebrow, title: 'How we can help', items: base.services },
          { type: 'band', title: 'Ready when you are', text: 'One call and we will sort it.' },
        ];
        render();
        return industry;
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  The agent's brain
      // ══════════════════════════════════════════════
      function quoted(text) {
        const m = text.match(/["'“”„]([^"'“”„]{2,})["'“”„]/);
        if (m) return m[1].trim();
        const m2 = text.match(/(?:say|says|read|reads|to|it|be|called|call it|is)\s+(.{3,})$/i);
        return m2 ? m2[1].replace(/[.!]$/, '').trim() : null;
      }

      function baseFor() {
        return INDUSTRIES[guessIndustry(S.site.name + ' ' + S.slug + ' ' + (S.scraped ? S.scraped.industry : ''))];
      }

      function wants(t, words) { return words.some((w) => t.includes(w)); }

      // Rewrites we can offer without inventing facts
      function rewriteFor(path, current) {
        const s = S.site;
        const base = baseFor();
        if (/headline$/.test(path)) {
          const options = [
            s.name + ' — ' + (base.eyebrow || 'local and independent').toLowerCase() + '.',
            (s.contact.phone ? 'One call and it is sorted.' : 'Sorted properly, first time.'),
            base.eyebrow + ' you can actually get hold of.',
          ];
          return options.find((o) => o !== current) || options[0];
        }
        if (/lede$|\.text$/.test(path)) {
          const options = [base.lede, 'Local, experienced, and easy to get hold of. Ring us and a person answers.',
            'Straight answers, fair prices, and the job finished when we said it would be.'];
          return options.find((o) => o !== current) || options[0];
        }
        if (/\.items\.\d+\.1$/.test(path)) {
          const name = getByPath(path.replace(/\.1$/, '.0'));
          const options = [blurb(name), name + ' sorted properly, priced before we start.',
            'Ask us about ' + String(name).toLowerCase() + ' — we do it most weeks.'];
          return options.find((o) => o !== current) || options[0];
        }
        if (/\.items\.\d+\.0$/.test(path)) return current;
        if (/cta$/.test(path)) return base.cta;
        if (/\.title$/.test(path)) return 'How we can help';
        return null;
      }

      async function handleSelected(text, t) {
        const sel = S.sel;
        const path = sel.path;

        // Remove
        if (wants(t, ['remove', 'delete', 'get rid', 'take it out', 'lose it'])) {
          snapshot();
          if (sel.kind === 'photo') {
            if (path === 'heroImage' || path === 'logo') { setByPath(path, null); }
            else {
              const m = /^sec\.(\d+)\.images\.(\d+)$/.exec(path);
              if (m) S.site.sections[Number(m[1])].images.splice(Number(m[2]), 1);
            }
            clearSelection(false); renderedKeys = new Set(); render();
            did('Photo removed'); await say('Gone.');
            return true;
          }
          if (sel.kind === 'block') {
            const item = /^sec\.(\d+)\.items\.(\d+)$/.exec(path);
            if (item) {
              S.site.sections[Number(item[1])].items.splice(Number(item[2]), 1);
              clearSelection(false); renderedKeys = new Set(); render();
              did('Service removed'); await say('Taken out.');
              return true;
            }
            const i = Number(path.split('.')[1]);
            const sec = S.site.sections[i];
            if (sec) {
              S.site.sections.splice(i, 1);
              clearSelection(false); renderedKeys = new Set(); render();
              did('Section removed'); await say('That section is gone. Say "undo" if you want it back.');
              return true;
            }
          }
          S.history.pop();
          await say('That bit is part of the page furniture — I can rewrite it, but not delete it.');
          return true;
        }

        // Swap a photo
        if (sel.kind === 'photo' && wants(t, ['swap', 'change', 'different', 'another', 'next', 'new photo'])) {
          const pool = (S.scraped && S.scraped.galleryImages ? S.scraped.galleryImages : []).concat(S.site.images || []);
          if (!pool.length) { await say("I have no other photos to hand — give me the URL of a site with your photos on it and I'll pull them in."); return true; }
          snapshot();
          const current = getByPath(path);
          const next = pool[(pool.indexOf(current) + 1) % pool.length];
          setByPath(path, next);
          render(); did('Photo swapped'); await say('Try that one. Say "swap" again to keep cycling.');
          return true;
        }

        // Colour, scoped to a band when one is selected
        const hex = t.match(/#([0-9a-f]{3}|[0-9a-f]{6})\b/);
        const word = Object.keys(COLOUR_WORDS).find((c) => new RegExp('\\b' + c + '\\b').test(t));
        if (hex || word) {
          const chosen = hex ? hex[0] : COLOUR_WORDS[word];
          paint(chosen, true);
          const scoped = sel.kind === 'block' && (S.site.sections[Number(path.split('.')[1]) ] || {}).type === 'band';
          did(scoped ? 'Band painted' : 'Colours updated');
          await say(scoped ? 'Just that band, ' + (word || chosen) + '.' : (word || chosen) + ' across the site.');
          return true;
        }

        // Rewrite the selected words
        if (sel.kind === 'text' && wants(t, ['rewrite', 'reword', 'better', 'punchier', 'shorter', 'try again', 'suggest'])) {
          const current = getByPath(path);
          const next = rewriteFor(path, current);
          if (!next) { await say("I'd only be guessing at that one — type over it and it's yours."); return true; }
          snapshot();
          setByPath(path, next);
          render(); did(sel.label + ' rewritten');
          await say('Try: “' + next + '”. Say rewrite again for another, or type over it yourself.');
          return true;
        }

        // New words for the selected bit
        if (sel.kind === 'text') {
          const value = quoted(text) || (/^(say|make it say|change it to|change to|set it to)\s+/i.test(text)
            ? text.replace(/^(say|make it say|change it to|change to|set it to)\s+/i, '').trim()
            : null);
          if (value) {
            snapshot();
            setByPath(path, value);
            render(); did(sel.label + ' updated');
            await say('Done — that now reads “' + value + '”.');
            return true;
          }
        }

        return false;  // let the normal brain have a go
      }

      async function handle(raw) {
        const text = raw.trim();
        bubble(text, 'msg-user');
        const t = text.toLowerCase();
        chipBox.innerHTML = '';
        await wait(180);

        // — something on the page is selected: act on that —
        if (S.sel && await handleSelected(text, t)) { chips(IDLE_CHIPS); return; }

        // — the agent asked for a different address —
        if (S.awaiting === 'slug') {
          const tidy = clean(text);
          if (tidy.length < 3) { await say('Three characters minimum — try another.'); return; }
          let free = false;
          try {
            const res = await fetch('/api/subdomain-check?slug=' + encodeURIComponent(tidy));
            const data = await res.json();
            free = !!data.available;
            if (!free && data.suggestions && data.suggestions.length) {
              await say('That one has gone too. ' + data.suggestions[0] + '.garage.co.nz is free if you want it.');
              return;
            }
          } catch (e) { free = true; }
          if (!free) { await say('Taken as well, sorry. Another?'); return; }
          S.awaiting = null;
          S.slug = tidy;
          S.token = null;
          $('chrome-url').textContent = S.slug + '.garage.co.nz';
          render();
          await say(S.slug + '.garage.co.nz it is. Publishing now.');
          await publish();
          return;
        }

        // — the agent asked for a name —
        if (S.awaiting === 'name') {
          S.awaiting = null;
          const industry = startFresh(text.replace(/^(it'?s|we'?re|called|the)\s+/i, '').trim().slice(0, 40));
          await say("Nice one. I've put a starter page up — " + (industry === 'default' ? 'generic for now' : 'shaped for ' + industry) + ", your colours and words next.");
          await say('Tell me anything: colours, headline, sections, your phone number. Or hit publish whenever you like.');
          chips(IDLE_CHIPS);
          return;
        }

        // — pull assets across —
        if (wants(t, ['pull', 'drag', 'bring it', 'import', 'yes — drag']) && S.sourceUrl) { await importAssets(); return; }
        if (wants(t, ['start fresh', 'start clean', 'blank', 'from scratch'])) {
          await say('Clean slate it is. What is the business or group called?');
          S.awaiting = 'name';
          return;
        }

        // — publish —
        if (wants(t, ['publish', 'go live', 'ship it', 'launch', "that's it", 'done', 'finished', 'looks good'])) { await publish(); return; }

        // — undo —
        if (wants(t, ['undo', 'go back', 'revert'])) {
          const prev = S.history.pop();
          if (!prev) { await say('Nothing to undo yet.'); chips(IDLE_CHIPS); return; }
          S.site = JSON.parse(prev);
          renderedKeys = new Set();
          render();
          await say('Rolled that back.');
          chips(IDLE_CHIPS);
          return;
        }

        // — nothing on the page yet —
        if (!S.site.name) {
          await say("Before I change anything — what's the business or group called?");
          S.awaiting = 'name';
          return;
        }

        let acted = false;
        snapshot();

        // — colour —
        const hex = t.match(/#([0-9a-f]{3}|[0-9a-f]{6})\b/);
        const word = Object.keys(COLOUR_WORDS).find((c) => new RegExp('\\b' + c + '\\b').test(t));
        if (hex || (word && wants(t, ['colour', 'color', 'make it', 'go', 'brand', 'theme', 'palette', 'more', 'scheme']))) {
          const chosen = hex ? hex[0] : COLOUR_WORDS[word];
          S.site.palette = paletteFrom(chosen);
          render();
          did('Palette swapped to ' + (word || chosen));
          await say('Done — ' + (word || chosen) + ' through the whole site. Better?');
          acted = true;
        }

        // — headline / tagline / name —
        if (wants(t, ['headline', 'heading', 'title', 'h1'])) {
          const v = quoted(text);
          if (v) { S.site.headline = v; render(); did('Headline updated'); await say('Headline is now “' + v + '”.'); acted = true; }
          else { await say('Give it to me in quotes and I will drop it straight in — e.g. headline: “Blocked drain? We are 20 minutes away.”'); acted = true; }
        } else if (wants(t, ['tagline', 'subheading', 'strapline', 'sub-line', 'intro line', 'lede'])) {
          const v = quoted(text);
          if (v) { S.site.lede = v; render(); did('Tagline updated'); await say('That is in.'); acted = true; }
          else { await say('What should it say? Pop it in quotes.'); acted = true; }
        } else if (wants(t, ['rename', 'business name', 'company name', 'we are called', "we're called"])) {
          const v = quoted(text);
          if (v) { S.site.name = v; render(); did('Name updated'); await say('Renamed to ' + v + '.'); acted = true; }
        }

        // — contact details —
        const phone = text.match(/(\+?64[\d\s-]{7,}|0[2-9][\d\s-]{6,})/);
        if (phone) {
          S.site.contact.phone = phone[0].trim();
          if (!hasSection('contact')) addSection({ type: 'contact' }, 'band');
          render();
          did('Phone number added');
          await say('Phone is on the page and in the header.');
          acted = true;
        }
        const email = text.match(/[\w.+-]+@[\w-]+\.[\w.]+/);
        if (email) {
          S.site.contact.email = email[0];
          if (!hasSection('contact')) addSection({ type: 'contact' }, 'band');
          render();
          did('Email added');
          await say('Email is up there too.');
          acted = true;
        }

        // — remove a section —
        if (wants(t, ['remove', 'delete', 'get rid', 'lose the', 'take out', 'drop the'])) {
          const map = [['gallery', ['gallery', 'photo', 'picture', 'image']], ['services', ['service', 'what we do']],
                       ['contact', ['contact', 'phone', 'details']], ['about', ['about', 'story']],
                       ['hours', ['hours', 'opening']], ['testimonial', ['testimonial', 'review', 'quote']],
                       ['band', ['banner', 'call to action', 'cta', 'band']]];
          const hit = map.find((m) => m[1].some((w) => t.includes(w)));
          if (hit && dropSection(hit[0])) { render(); did('Removed the ' + hit[0] + ' section'); await say('Gone.'); acted = true; }
          else if (hit) { await say('There is no ' + hit[0] + ' section on there at the moment.'); acted = true; }
        }

        // — add sections —
        if (!acted || wants(t, ['add', 'put', 'include', 'need'])) {
          const base = baseFor();
          if (wants(t, ['service', 'what we do', 'offering']) && !wants(t, ['remove', 'delete'])) {
            const sc = S.scraped && S.scraped.services && S.scraped.services.length >= 2
              ? S.scraped.services.slice(0, 6).map((x) => [String(x).slice(0, 42), blurb(x)])
              : base.services;
            addSection({ type: 'services', label: base.eyebrow, title: 'How we can help', items: sc }, 'band');
            render(); did('Services section added');
            await say('Services are in — say the word if you want the wording changed.');
            acted = true;
          } else if (wants(t, ['gallery', 'photo', 'picture', 'image', 'portfolio', 'our work'])) {
            const shots = (S.site.images.length ? S.site.images : (S.scraped ? (S.scraped.galleryImages || []) : [])).slice(0, 6);
            addSection({ type: 'gallery', images: shots }, 'band');
            render(); did(shots.length ? 'Gallery added with ' + shots.length + ' photos' : 'Gallery added — placeholders for now');
            await say(shots.length ? 'Gallery is in with the photos I found.' : 'Gallery is in with placeholders — email me your photos and I will drop them in.');
            acted = true;
          } else if (wants(t, ['contact', 'phone', 'email', 'address', 'find us', 'get in touch'])) {
            addSection({ type: 'contact' }, 'band');
            render(); did('Contact section added');
            await say(S.site.contact.phone || S.site.contact.email ? 'Contact section is on.' : 'Contact section is on — give me a number or an email and I will fill it in.');
            acted = true;
          } else if (wants(t, ['about', 'story', 'who we are', 'history'])) {
            const txt = (S.scraped && S.scraped.aboutText) ? S.scraped.aboutText.slice(0, 320)
              : S.site.name + ' has been looking after this patch for years. Small team, local, and we answer the phone.';
            addSection({ type: 'about', text: txt }, 'band');
            render(); did('About section added');
            await say('About section is in. Want different words? Send them over in quotes.');
            acted = true;
          } else if (wants(t, ['hours', 'opening', 'open time', 'when are you open'])) {
            addSection({ type: 'hours', rows: [['Monday – Friday', '7.30am – 5pm'], ['Saturday', '8am – 12pm'], ['Sunday', 'Closed'], ['Emergencies', 'Any time']] }, 'band');
            render(); did('Opening hours added');
            await say('Hours are up — tell me the real ones and I will correct them.');
            acted = true;
          } else if (wants(t, ['testimonial', 'review', 'what people say'])) {
            addSection({ type: 'testimonial', quote: 'Turned up when they said they would, fixed it properly, charged what they quoted.', who: 'A very relieved local' }, 'band');
            render(); did('Testimonial added');
            await say('Popped a placeholder review in — send me a real one and it goes straight up.');
            acted = true;
          }
        }

        // — design style —
        if (!acted) {
          const style = wants(t, ['brutal', 'bold', 'loud', 'punchy', 'shouty', 'blocky'])
            ? 'brutal'
            : wants(t, ['classic', 'serif', 'traditional', 'elegant', 'posh', 'smart', 'formal'])
              ? 'classic'
              : wants(t, ['modern', 'clean', 'minimal', 'simple', 'current'])
                ? 'modern'
                : null;
          if (style) {
            if (setStyle(style)) {
              await say(STYLE_NOTES[style] + ' Have a look — say "modern", "brutal" or "classic" to flip between them.');
            } else {
              await say("It's already in that style. Try one of the other two.");
            }
            acted = true;
          }
        }

        // — hero photo —
        if (!acted && wants(t, ['hero', 'big photo', 'background image', 'header image'])) {
          const pool = (S.scraped && S.scraped.galleryImages) ? S.scraped.galleryImages : [];
          if (wants(t, ['remove', 'no ', 'without'])) { S.site.heroImage = null; render(); did('Hero photo removed'); await say('Back to clean colour.'); }
          else if (pool.length) {
            const i = pool.indexOf(S.site.heroImage);
            S.site.heroImage = pool[(i + 1) % pool.length];
            render(); did('Hero photo swapped');
            await say('Try that one.');
          } else { await say("I don't have any photos yet — give me the URL of your old site or Facebook page and I'll grab them."); }
          acted = true;
        }

        if (!acted) {
          S.history.pop();
          await say("I can do colours, headlines, sections (services, gallery, about, hours, contact, reviews), your phone and email — or publish it. What's it to be?");
        }
        chips(IDLE_CHIPS);
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Direct manipulation: pick a thing, change it
      // ══════════════════════════════════════════════
      function resolvePath(path) {
        const t = String(path).split('.');
        let obj, keys;
        if (t[0] === 'sec') { obj = S.site.sections[Number(t[1])]; keys = t.slice(2); }
        else { obj = S.site; keys = t; }
        if (!obj) return null;
        for (let i = 0; i < keys.length - 1; i++) { obj = obj[keys[i]]; if (!obj) return null; }
        return { obj: obj, key: keys[keys.length - 1] };
      }
      function getByPath(path) { const r = resolvePath(path); return r ? r.obj[r.key] : undefined; }
      function setByPath(path, value) { const r = resolvePath(path); if (r) r.obj[r.key] = value; }

      const LABELS = [
        [/^name$/, 'Business name'], [/^headline$/, 'Headline'], [/^lede$/, 'Intro line'],
        [/^eyebrow$/, 'Eyebrow line'], [/^cta$/, 'Button text'], [/^logo$/, 'Logo'],
        [/^heroImage$/, 'Hero photo'], [/^contact\.phone$/, 'Phone number'],
        [/^contact\.email$/, 'Email'], [/^contact\.address$/, 'Address'],
        [/\.items\.\d+\.0$/, 'Service name'], [/\.items\.\d+\.1$/, 'Service description'],
        [/\.rows\.\d+\.0$/, 'Day'], [/\.rows\.\d+\.1$/, 'Opening hours'],
        [/\.images\.\d+$/, 'Photo'], [/\.label$/, 'Section label'], [/\.title$/, 'Section heading'],
        [/\.text$/, 'Body text'], [/\.quote$/, 'Quote'], [/\.who$/, 'Attribution'],
        [/\.items\.\d+$/, 'Service card'],
      ];
      const SECTION_NAMES = {
        services: 'Services section', about: 'About section', gallery: 'Photo gallery',
        hours: 'Opening hours', testimonial: 'Review', contact: 'Contact section', band: 'Call-to-action band',
      };
      function labelFor(path) {
        const m = /^sec\.(\d+)$/.exec(path);
        if (m) {
          const sec = S.site.sections[Number(m[1])];
          return sec ? (SECTION_NAMES[sec.type] || 'Section') : 'Section';
        }
        const hit = LABELS.find((l) => l[0].test(path));
        return hit ? hit[1] : 'This bit';
      }

      const canvas = () => $('canvas');
      let pickBar = null;
      let taughtPicking = false;

      function ensureBar() {
        if (pickBar) return pickBar;
        pickBar = document.createElement('div');
        pickBar.className = 'pick-bar';
        canvas().appendChild(pickBar);
        return pickBar;
      }

      function clearSelection(commitFirst) {
        const el = canvas().querySelector('.is-sel');
        if (el) {
          if (commitFirst !== false && el.isContentEditable) commitText(el);
          el.classList.remove('is-sel');
          el.removeAttribute('contenteditable');
        }
        S.sel = null;
        S.editing = false;
        if (pickBar) pickBar.classList.remove('on');
        $('agent-target').hidden = true;
        $('agent-text').placeholder = 'Tell me what to change…';
        if (S.renderQueued) { S.renderQueued = false; render(); }
      }

      function commitText(el) {
        const path = el.getAttribute('data-edit');
        if (!path) return;
        const value = (el.textContent || '').replace(/\s+/g, ' ').trim();
        const before = getByPath(path);
        S.editing = false;
        if (value === before) return;
        if (!value) { el.textContent = before; return; }  // refuse to leave it empty
        snapshot();
        setByPath(path, value);
        did(labelFor(path) + ' updated');
        S.renderQueued = true;
      }

      function positionBar(el) {
        const bar = ensureBar();
        const c = canvas();
        const r = el.getBoundingClientRect();
        const cr = c.getBoundingClientRect();
        bar.classList.add('on');
        const top = r.top - cr.top + c.scrollTop - bar.offsetHeight - 8;
        bar.style.top = Math.max(6, top) + 'px';
        bar.style.left = Math.max(6, Math.min(r.left - cr.left, c.clientWidth - bar.offsetWidth - 10)) + 'px';
      }

      function buildBar(kind, path) {
        const bar = ensureBar();
        const buttons = [];
        if (kind === 'text') buttons.push(['Rewrite it', () => route('rewrite this')]);
        if (kind === 'photo') {
          buttons.push(['Swap photo', () => route('find a better photo for this and use it')]);
          buttons.push(['Remove', () => route('remove this photo'), true]);
        }
        if (kind === 'block') {
          buttons.push(['Move up', () => moveSection(path, -1)]);
          buttons.push(['Move down', () => moveSection(path, 1)]);
          buttons.push(['Remove', () => route('remove this section'), true]);
        }
        bar.innerHTML = '<span class="name">' + esc(labelFor(path)) + '</span>';
        buttons.forEach((b) => {
          const el = document.createElement('button');
          el.textContent = b[0];
          if (b[2]) el.className = 'warn';
          el.addEventListener('mousedown', (e) => e.preventDefault());
          el.addEventListener('click', b[1]);
          bar.appendChild(el);
        });
        const close = document.createElement('button');
        close.textContent = '×';
        close.addEventListener('click', () => clearSelection());
        bar.appendChild(close);
        return bar;
      }

      async function select(el, kind, path) {
        clearSelection();
        S.sel = { kind: kind, path: path, label: labelFor(path) };
        el.classList.add('is-sel');

        const c = canvas();
        const r = el.getBoundingClientRect();
        const cr = c.getBoundingClientRect();
        if (r.top < cr.top + 60 || r.bottom > cr.bottom - 20) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          await wait(320);
        }

        buildBar(kind, path);
        positionBar(el);

        $('target-label').textContent = S.sel.label;
        $('agent-target').hidden = false;
        $('agent-text').placeholder = 'Change the ' + S.sel.label.toLowerCase() + '…';

        if (kind === 'text') {
          el.setAttribute('contenteditable', 'true');
          el.focus();
          S.editing = true;
        }

        if (!taughtPicking) {
          taughtPicking = true;
          await say(kind === 'text'
            ? 'Type straight over it to fix the words — or tell me what you want and I will do it.'
            : 'Got it. Tell me what to change about that, or use the buttons.');
        }
      }

      function restoreSelection() {
        if (!S.sel) return;
        const sel = S.sel;
        const el = canvas().querySelector('[data-' + (sel.kind === 'photo' ? 'photo' : sel.kind === 'block' ? 'block' : 'edit') + '="' + sel.path + '"]');
        if (!el) { clearSelection(false); return; }
        el.classList.add('is-sel');
        positionBar(el);
      }

      function moveSection(path, delta) {
        const i = Number(String(path).split('.')[1]);
        const list = S.site.sections;
        const j = i + delta;
        if (j < 0 || j >= list.length) return;
        snapshot();
        const [sec] = list.splice(i, 1);
        list.splice(j, 0, sec);
        S.sel = { kind: 'block', path: 'sec.' + j, label: labelFor('sec.' + j) };
        renderedKeys = new Set();
        render();
        did('Moved the ' + (SECTION_NAMES[sec.type] || 'section').toLowerCase());
      }

      // Clicks on the canvas pick things
      document.addEventListener('click', (e) => {
        const c = canvas();
        if (!c || !c.contains(e.target)) return;
        if (pickBar && pickBar.contains(e.target)) return;

        const text = e.target.closest('[data-edit]');
        const photo = e.target.closest('[data-photo]');
        const block = e.target.closest('[data-block]');

        if (text) { if (!text.classList.contains('is-sel')) select(text, 'text', text.getAttribute('data-edit')); return; }
        if (photo) { select(photo, 'photo', photo.getAttribute('data-photo')); return; }
        if (block) { select(block, 'block', block.getAttribute('data-block')); return; }
        clearSelection();
      });

      // Enter commits, Escape backs out
      document.addEventListener('keydown', (e) => {
        const el = canvas() && canvas().querySelector('[contenteditable="true"]');
        if (e.key === 'Escape') { clearSelection(); return; }
        if (e.key === 'Enter' && el && document.activeElement === el && !e.shiftKey) {
          e.preventDefault();
          commitText(el);
          clearSelection(false);
        }
      });

      document.addEventListener('focusout', (e) => {
        if (e.target && e.target.isContentEditable) {
          commitText(e.target);
          if (S.renderQueued) { S.renderQueued = false; render(); }
        }
      });

      $('target-clear').addEventListener('click', () => { clearSelection(); $('agent-text').focus(); });

      // ══════════════════════════════════════════════
      //  Colour: swatches and tone
      // ══════════════════════════════════════════════
      const SWATCHES = ['#2563eb', '#0ea5e9', '#0d9488', '#16a34a', '#65a30d', '#ca8a04',
                        '#ea580c', '#dc2626', '#db2777', '#7c3aed', '#78350f', '#111827'];

      const TONES = {
        light: { page: '#ffffff', ink: '#101418', soft: '#5b6472', line: '#e7ebf0', card: '#ffffff' },
        warm:  { page: '#fffaf3', ink: '#1b1410', soft: '#6b5a4c', line: '#efe2d2', card: '#fffdf9' },
        dark:  { page: '#0e1116', ink: '#f2f5fa', soft: '#a2acbd', line: '#232a35', card: '#161b23' },
      };

      function applyTone() {
        const tone = TONES[S.site.tone || 'light'];
        const el = canvas();
        if (!el) return;
        el.style.setProperty('--pv-page', tone.page);
        el.style.setProperty('--pv-ink', tone.ink);
        el.style.setProperty('--pv-soft', tone.soft);
        el.style.setProperty('--pv-line', tone.line);
        el.style.setProperty('--pv-card', tone.card);
        el.style.setProperty('--pv-wash', S.site.tone === 'dark'
          ? mix(S.site.palette.primary, '#0e1116', 0.86)
          : S.site.palette.wash);
        document.querySelectorAll('.tone[data-tone]').forEach((b) =>
          b.classList.toggle('on', b.dataset.tone === (S.site.tone || 'light')));
        document.querySelectorAll('.swatch').forEach((b) =>
          b.classList.toggle('on', b.dataset.colour === S.site.palette.primary));
        document.querySelectorAll('.style[data-style]').forEach((b) =>
          b.classList.toggle('on', b.dataset.style === (S.site.style || 'modern')));
      }

      function paint(colour, quiet) {
        snapshot();
        // A selected band gets its own colour; otherwise it is the whole site
        if (S.sel && S.sel.kind === 'block') {
          const sec = S.site.sections[Number(S.sel.path.split('.')[1])];
          if (sec && sec.type === 'band') {
            sec.tint = colour;
            render();
            if (!quiet) did('Band painted');
            return;
          }
        }
        S.site.palette = paletteFrom(colour);
        render();
        if (!quiet) did('Colours updated');
      }

      const STYLE_NOTES = {
        modern: 'Clean and current — rounded, soft shadows, plenty of air.',
        brutal: 'Loud and blocky — heavy type, hard edges, black borders. People remember it.',
        classic: 'Quiet and serif — hairlines, wide letter-spacing, an established look.',
      };

      function setStyle(style, quiet) {
        if (!STYLE_NOTES[style] || S.site.style === style) return false;
        snapshot();
        S.site.style = style;
        renderedKeys = new Set();
        render();
        if (!quiet) did(style[0].toUpperCase() + style.slice(1) + ' style');
        return true;
      }

      function buildSwatches() {
        const row = $('swatches');
        if (!row || row.childElementCount) return;
        SWATCHES.forEach((c) => {
          const b = document.createElement('button');
          b.className = 'swatch';
          b.dataset.colour = c;
          b.style.background = c;
          b.title = c;
          b.addEventListener('click', () => { paint(c); });
          row.appendChild(b);
        });
        document.querySelectorAll('.style[data-style]').forEach((b) =>
          b.addEventListener('click', () => setStyle(b.dataset.style)));
        document.querySelectorAll('.tone[data-tone]').forEach((b) =>
          b.addEventListener('click', () => {
            snapshot();
            S.site.tone = b.dataset.tone;
            render();
            did(b.dataset.tone[0].toUpperCase() + b.dataset.tone.slice(1) + ' background');
          }));
        $('roll-colour').addEventListener('click', () => {
          const next = SWATCHES[Math.floor(Math.random() * SWATCHES.length)];
          paint(next, true);
          did('Rolled a new colour');
        });
      }
      buildSwatches();
      canvas().classList.add('pickable');
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  The real agent: tools, in a loop, server-side
      // ══════════════════════════════════════════════
      async function askAgent(text) {
        bubble(text, 'msg-user');
        chipBox.innerHTML = '';
        S.thinking = true;
        $('agent-state').textContent = 'online · thinking';

        const dots = document.createElement('div');
        dots.className = 'typing';
        dots.innerHTML = '<i></i><i></i><i></i>';
        log.appendChild(dots);
        log.scrollTop = log.scrollHeight;

        try {
          const res = await fetch('/api/agent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              site: S.site,
              message: text,
              history: S.chat,
              selection: S.sel ? S.sel.label + ' (' + S.sel.path + ')' : null,
              ownImages: (S.scraped && S.scraped.galleryImages ? S.scraped.galleryImages : [])
                .concat(S.site.images || [])
                .filter(Boolean)
                .slice(0, 8),
            }),
          });

          dots.remove();

          if (res.status === 503) {
            // No key on the server — quietly fall back for the rest of the session
            S.llm = false;
            S.thinking = false;
            $('agent-state').textContent = 'online · building';
            await say("I'm running without my full brain right now, so I'll do what I can with the basics.");
            return handle(text);
          }
          if (!res.ok) throw new Error('agent ' + res.status);

          const data = await res.json();

          snapshot();
          S.site = data.site;
          S.chat = data.history || S.chat;
          renderedKeys = new Set();
          clearSelection(false);
          render();

          (data.actions || []).forEach((a) => {
            if (a.ok) did(a.summary);
            else bubble('· ' + a.summary, 'msg-note');
          });

          bubble(data.reply, 'msg-agent');
          chips(IDLE_CHIPS);
        } catch (error) {
          dots.remove();
          console.error(error);
          await say("That didn't go through — let me try it the simple way.");
          S.thinking = false;
          $('agent-state').textContent = 'online · building';
          return handle(text);
        }

        S.thinking = false;
        $('agent-state').textContent = 'online · building';
        $('agent-text').focus();
      }

      // ══════════════════════════════════════════════
      //  Publish
      // ══════════════════════════════════════════════
      async function publish() {
        if (!S.site.name) {
          await say('Give me something to publish first — what is the business called?');
          S.awaiting = 'name';
          return;
        }

        $('agent-state').textContent = 'online · publishing';
        await say('Righto. Publishing to ' + S.slug + '.garage.co.nz…', 420);

        // Claim the address while the build steps play out
        const claim = fetch('/api/build-claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: S.slug, site: S.site, sourceUrl: S.sourceUrl, token: S.token }),
        })
          .then((r) => r.json().catch(() => ({ error: 'bad-response' })))
          .catch(() => ({ error: 'network' }));

        const steps = ['Pages built', 'Images optimised', 'Mobile layout checked', 'SSL certificate issued', 'DNS pointed at ' + S.slug + '.garage.co.nz'];
        for (const step of steps) { did(step); await wait(430); }

        const result = await claim;
        $('agent-state').textContent = 'online · building';

        if (result.error === 'taken') {
          await say('Ah — somebody claimed ' + S.slug + '.garage.co.nz while we were working. Give me another address and I will publish straight away.');
          S.awaiting = 'slug';
          return;
        }
        if (!result.success) {
          await say("Publishing fell over just then. Try again in a moment, or email ben@garage.co.nz and I'll sort it by hand.");
          chips(IDLE_CHIPS);
          return;
        }

        S.token = result.token;
        try { localStorage.setItem('garage-build:' + S.slug, result.token); } catch (e) {}

        const url = result.url || ('https://' + S.slug + '.garage.co.nz');
        $('live-url').textContent = S.slug + '.garage.co.nz';
        $('live-url').href = url;
        $('agent-state').textContent = 'online · live';
        show('live');
        confetti();
      }

      $('back-to-build').addEventListener('click', async () => {
        show('build');
        chips(IDLE_CHIPS);
      });

      $('live-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = $('live-email').value.trim();
        const note = $('live-note');
        note.style.color = 'var(--text-muted)';
        note.textContent = 'Sending…';
        try {
          const res = await fetch('/api/build-claim', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: S.slug, email: email, sourceUrl: S.sourceUrl, site: S.site, token: S.token }),
          });
          const data = await res.json();
          if (data.success) {
            note.style.color = 'var(--good)';
            note.textContent = '✓ Keys on their way to ' + email + '.';
            $('live-form').querySelector('button').textContent = 'Sent';
          } else if (data.error === 'taken') {
            note.style.color = 'var(--bad)';
            note.textContent = 'Someone grabbed that address a second ago — pick another and republish.';
          } else {
            throw new Error('failed');
          }
        } catch {
          note.style.color = 'var(--bad)';
          note.textContent = "Couldn't reach us just now — email ben@garage.co.nz and we'll sort it.";
        }
      });

      // ══════════════════════════════════════════════
      //  Confetti
      // ══════════════════════════════════════════════
      function confetti() {
        const cv = $('confetti');
        const ctx = cv.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        cv.width = cv.offsetWidth * dpr;
        cv.height = cv.offsetHeight * dpr;
        ctx.scale(dpr, dpr);

        const W = cv.offsetWidth, H = cv.offsetHeight;
        const colours = ['#2563eb', '#f97316', '#16a34a', '#eab308', '#db2777', '#7c3aed'];
        const bits = [];
        for (let i = 0; i < 140; i++) {
          bits.push({
            x: Math.random() * W,
            y: -20 - Math.random() * H * 0.6,
            w: 6 + Math.random() * 6,
            h: 8 + Math.random() * 8,
            vy: 2 + Math.random() * 3.5,
            vx: -1 + Math.random() * 2,
            rot: Math.random() * Math.PI,
            vr: -0.12 + Math.random() * 0.24,
            c: colours[(Math.random() * colours.length) | 0],
          });
        }

        const started = performance.now();
        (function frame(now) {
          ctx.clearRect(0, 0, W, H);
          const age = now - started;
          bits.forEach((b) => {
            b.x += b.vx; b.y += b.vy; b.rot += b.vr;
            ctx.save();
            ctx.translate(b.x, b.y);
            ctx.rotate(b.rot);
            ctx.globalAlpha = age > 3500 ? Math.max(0, 1 - (age - 3500) / 1500) : 1;
            ctx.fillStyle = b.c;
            ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h);
            ctx.restore();
          });
          if (age < 5000) requestAnimationFrame(frame);
          else ctx.clearRect(0, 0, W, H);
        })(started);
      }
    </script>
  </body>
</html>
