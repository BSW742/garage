        margin-bottom: 0.15rem;
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--work-soft);
      }
      /* A picker card is a button: pointer, hover state, focus ring, and a
         hit area you cannot miss. It was a 64x21px label with a default
         cursor, which is why nothing appeared to happen. */
      .media-item.is-picker { cursor: pointer; transition: border-color 0.18s ease, box-shadow 0.18s ease; }
      .media-item.is-picker:hover,
      .media-item.is-picker:focus-visible {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
        outline: none;
      }
      .media-item.is-picker .media-shot { cursor: pointer; }
      .media-item.is-picker .media-act {
        flex: 1 1 100%;
        padding: 0.55rem 0.5rem;
        font-size: 0.8rem;
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }
      .media-item.is-picker:hover .media-act { background: var(--accent-deep); border-color: var(--accent-deep); }

      .media-act {
        flex: 1;
        cursor: pointer;
        border: 1px solid var(--work-3);
        background: #fff;
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.4rem 0.5rem;
        border-radius: 6px;
        cursor: pointer;
      }
      .media-act:hover { border-color: var(--accent); color: var(--accent); }
      .media-item.in-use { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
      .media-item { position: relative; }
      .media-drop {
        position: absolute;
        top: 6px; right: 6px;
        width: 22px; height: 22px;
        border: 0; border-radius: 50%;
        background: rgba(16,19,26,0.62);
        color: #fff; font-size: 10px; line-height: 1;
        display: grid; place-items: center;
        cursor: pointer; opacity: 0;
        transition: opacity 0.12s, background 0.12s;
      }
      .media-item:hover .media-drop { opacity: 1; }
      .media-drop:hover { background: #dc2626; }

      /* ── Live preview of the generated site ────── */
      #site-root { position: relative; z-index: 1; background: var(--pv-page, #fff); }
      .pv {
        --pv-primary: #2563eb;
        --pv-deep: #1e40af;
        --pv-ink: #101418;
        --pv-soft: #5b6472;
        --pv-line: #e7ebf0;
        --pv-wash: #f6f8fb;
        font-family: var(--pv-font, 'Inter', system-ui, sans-serif);
        color: var(--pv-ink);
      }
      .pv-block { animation: land 0.55s cubic-bezier(0.16, 1, 0.3, 1) both; }
      @keyframes land { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }

      .pv-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 2.2rem;
        border-bottom: 1px solid var(--pv-line);
        gap: 1rem;
      }
      .pv-brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; letter-spacing: -0.02em; font-size: 1.05rem; }
      .pv-brand img { height: 30px; width: auto; max-width: 150px; object-fit: contain; }
      .pv-brand .pv-glyph {
        width: 30px; height: 30px;
        display: grid; place-items: center;
        border-radius: 8px;
        background: var(--pv-primary);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
      }
      .pv-links { display: flex; gap: 1.3rem; font-size: 0.85rem; color: var(--pv-soft); }
      .pv-cta {
        background: var(--pv-primary);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        white-space: nowrap;
      }

      .pv-hero {
        padding: 4.5rem 2.2rem;
        text-align: center;
        background:
          radial-gradient(ellipse 70% 60% at 50% 0%, color-mix(in srgb, var(--pv-primary) 14%, transparent) 0%, transparent 60%),
          var(--pv-wash);
        position: relative;
        overflow: hidden;
      }
      .pv-hero.has-photo { color: #fff; }
      .pv-hero-photo { position: absolute; inset: 0; background-size: cover; background-position: center; }
      .pv-hero-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6,10,16,0.55), rgba(6,10,16,0.75)); }
      .pv-hero-inner { position: relative; z-index: 1; max-width: 44rem; margin: 0 auto; }
      .pv-eyebrow {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pv-primary);
        margin-bottom: 0.9rem;
      }
      .pv-hero.has-photo .pv-eyebrow { color: #fff; opacity: 0.85; }
      .pv-h1 {
        font-family: var(--pv-display, 'Poppins', system-ui, sans-serif);
        font-size: clamp(1.9rem, 4.4vw, 3rem);
        font-weight: 800;
        line-height: 1.06;
        letter-spacing: -0.035em;
        margin-bottom: 0.9rem;
      }
      .pv-lede { font-size: 1.02rem; color: var(--pv-soft); max-width: 34rem; margin: 0 auto 1.8rem; }
      .pv-hero.has-photo .pv-lede { color: rgba(255,255,255,0.86); }
      .pv-btn {
        display: inline-block;
        background: var(--pv-primary);
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.85rem 1.6rem;
        border-radius: 999px;
      }
      .pv-btn-2 { background: transparent; color: var(--pv-ink); border: 1.5px solid var(--pv-line); margin-left: 0.5rem; }
      .pv-hero.has-photo .pv-btn-2 { color: #fff; border-color: rgba(255,255,255,0.4); }

      .pv-section { padding: 3.4rem 2.2rem; }
      .pv-section.alt { background: var(--pv-wash); }
      .pv-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pv-primary);
        margin-bottom: 0.7rem;
        text-align: center;
      }
      .pv-h2 {
        font-family: var(--pv-display, 'Poppins', system-ui, sans-serif);
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        text-align: center;
        margin-bottom: 2rem;
      }
      .pv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; max-width: 60rem; margin: 0 auto; }
      .pv-card {
        background: var(--pv-card, #fff);
        border: 1px solid var(--pv-line);
        border-radius: 14px;
        padding: 1.3rem;
      }
      .pv-card h4 { font-size: 1rem; font-weight: 700; margin-bottom: 0.35rem; letter-spacing: -0.01em; }
      .pv-card p { font-size: 0.88rem; color: var(--pv-soft); }

      .pv-prose { max-width: 40rem; margin: 0 auto; text-align: center; color: var(--pv-soft); font-size: 1rem; }

      .pv-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.7rem; max-width: 60rem; margin: 0 auto; }
      .pv-shot { aspect-ratio: 4 / 3; border-radius: 12px; background: #e9edf3 center/cover no-repeat; }

      .pv-contact { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
      .pv-brand img { height: 30px; width: auto; max-width: 130px; object-fit: contain; }
      .pv-hero-logo { line-height: 0; margin-bottom: 0.6rem; }
      .pv-hero-logo img { width: auto; max-width: 78%; max-height: 110px; object-fit: contain; }
      .pv-hero.has-photo .pv-hero-logo img { filter: drop-shadow(0 4px 14px rgba(0,0,0,0.45)); }

      .pv-reel { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 2px; }
      .pv-reel-slide {
        position: relative;
        flex: 0 0 62%;
        aspect-ratio: 16/9;
        border-radius: 10px;
        overflow: hidden;
        background: #000;
      }
      .pv-reel-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .pv-reel-play {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 46px; height: 32px; border-radius: 8px;
        background: rgba(18,18,18,0.82);
      }
      .pv-reel-play::after {
        content: ''; position: absolute; top: 50%; left: 50%;
        transform: translate(-42%, -50%);
        border-style: solid; border-width: 6px 0 6px 11px;
        border-color: transparent transparent transparent #fff;
      }
      .pv-reel-count { text-align: center; margin: 0.6rem 0 0; font-size: 0.78rem; color: var(--pv-soft); }
      .pv-page { border-top: 2px dashed var(--pv-line); }
      .pv-pagetag {
        font-size: 0.68rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--pv-soft);
        margin: 0 0 0.3rem;
      }
      .pv-profiles { display: flex; flex-direction: column; gap: 1.4rem; text-align: left; }
      .pv-profile {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 1.2rem;
        align-items: center;
        padding-bottom: 1.4rem;
        border-bottom: 1px solid var(--pv-line);
      }
      .pv-profile:last-child { border-bottom: 0; padding-bottom: 0; }
      /* Swap the columns, not just the order, or the words end up in the
         photo's column and the photo swells to fill theirs. */
      .pv-profile.flip { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
      .pv-profile.flip .pv-profile-media { order: 2; }
      .pv-profile-media {
        aspect-ratio: 1;
        border-radius: 12px;
        background: var(--pv-wash) center/cover no-repeat;
        min-width: 0;
      }
      .pv-profile > div:not(.pv-profile-media) { min-width: 0; }
      .pv-profile strong { display: block; font-size: 1.05rem; letter-spacing: -0.01em; }
      .pv-profile-role { display: block; color: var(--pv-primary); font-size: 0.82rem; font-weight: 600; margin-top: 0.15rem; }
      .pv-profile p { margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--pv-soft); line-height: 1.6; }

      .pv-shop { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.8rem; text-align: left; }
      .pv-buy { border: 1px solid var(--pv-line); border-radius: 10px; overflow: hidden; padding-bottom: 0.6rem; }
      .pv-buy-shot { aspect-ratio: 4/3; background: var(--pv-wash) center/cover no-repeat; }
      .pv-buy strong { display: block; font-size: 0.85rem; margin: 0.5rem 0.6rem 0; }
      .pv-buy p { margin: 0.2rem 0.6rem 0; font-size: 0.75rem; color: var(--pv-soft); line-height: 1.45; }
      .pv-buy-price { display: block; margin: 0.35rem 0.6rem 0; font-weight: 700; color: var(--pv-primary); font-size: 0.82rem; }

      .pv-along { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 0.9rem; }
      .pv-along-one {
        border: 1px solid var(--pv-line); border-radius: 999px; padding: 0.4rem 0.95rem;
        font-size: 0.87rem; background: #fff;
      }
      .pv-along-add {
        display: block; margin: 0 auto;
        border: 1px dashed var(--pv-line); border-radius: 999px; background: transparent;
        color: var(--pv-soft); font: inherit; font-size: 0.85rem; padding: 0.45rem 1.1rem;
        cursor: pointer;
      }
      .pv-along-add:hover { border-color: var(--pv-primary); color: var(--pv-primary); }

      .pv-add {
        border: 1px dashed var(--pv-line); border-radius: 10px; background: transparent;
        color: var(--pv-soft); font: inherit; font-size: 0.85rem; cursor: pointer;
        min-height: 5rem; display: flex; align-items: center; justify-content: center;
      }
      .pv-add:hover { border-color: var(--pv-primary); color: var(--pv-primary); }

      .pv-rates { max-width: 460px; margin: 0 auto; text-align: left; }
      .pv-rates > div {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.45rem 0;
        border-bottom: 1px solid var(--pv-line);
      }
      .pv-rates > div:last-child { border-bottom: 0; }
      .pv-rate-name { font-weight: 600; font-size: 0.88rem; }
      .pv-rate-dots { flex: 1; border-bottom: 1px dotted var(--pv-line); transform: translateY(-0.22rem); min-width: 1rem; }
      .pv-rate-price { font-weight: 700; color: var(--pv-primary); font-size: 0.88rem; white-space: nowrap; }
      .pv-rate-note { font-size: 0.78rem; color: var(--pv-soft); margin-top: 0.7rem; text-align: left; max-width: 460px; margin-left: auto; margin-right: auto; }

      .pv-faq { max-width: 560px; margin: 0 auto; text-align: left; }
      .pv-faq-item {
        border: 1px solid var(--pv-line);
        border-radius: 10px;
        padding: 0.6rem 0.8rem;
        margin-bottom: 0.5rem;
      }
      .pv-faq-q { font-weight: 600; font-size: 0.9rem; }
      .pv-faq-a { color: var(--pv-soft); font-size: 0.85rem; margin-top: 0.2rem; }
      .pv-map {
        margin: 1.2rem auto 0;
        max-width: 620px;
        border: 1px solid var(--pv-line);
        border-radius: 12px;
        overflow: hidden;
        line-height: 0;
      }
      /* The canvas is click-to-edit, so the preview map must not swallow
         clicks. The published site keeps it interactive. */
      .pv-map iframe { display: block; width: 100%; height: 240px; border: 0; pointer-events: none; }
      .pv-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--pv-card, #fff);
        border: 1px solid var(--pv-line);
        border-radius: 999px;
        padding: 0.6rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 500;
      }
      .pv-pill b { color: var(--pv-primary); font-weight: 700; }

      .pv-quote { max-width: 40rem; margin: 0 auto; text-align: center; }
      .pv-quote p { font-family: var(--pv-display, 'Poppins', sans-serif); font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.5; margin-bottom: 0.8rem; }
      .pv-quote-text::before { content: '\201C'; }
      .pv-quote-text::after { content: '\201D'; }
      .pv-quote-who::before { content: '\2014\00a0'; }
      .pv-quote span { font-size: 0.85rem; color: var(--pv-soft); }

      .pv-hours { max-width: 26rem; margin: 0 auto; }
      .pv-hours div { display: flex; justify-content: space-between; padding: 0.55rem 0; border-bottom: 1px solid var(--pv-line); font-size: 0.92rem; }
      .pv-hours div span:last-child { color: var(--pv-soft); }

      .pv-band {
        background: var(--pv-primary);
        color: #fff;
        text-align: center;
        padding: 3rem 2.2rem;
      }
      .pv-band .pv-h2 { color: #fff; margin-bottom: 0.7rem; }
      .pv-band p { opacity: 0.85; margin-bottom: 1.4rem; }
      .pv-band .pv-btn { background: #fff; color: var(--pv-primary); }

      .pv-foot {
        padding: 1.6rem 2.2rem;
        border-top: 1px solid var(--pv-line);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.6rem;
        font-size: 0.8rem;
        color: var(--pv-soft);
      }

      /* ── Design styles ───────────────────────── */
      .pv.st-brutal {
        --pv-display: 'Archivo Black', Impact, sans-serif;
      }
      .st-brutal .pv-h1, .st-brutal .pv-h2 { letter-spacing: -0.02em; text-transform: uppercase; }
      .st-brutal .pv-h1 { font-size: clamp(2.1rem, 5.2vw, 3.4rem); line-height: 0.98; }
      .st-brutal .pv-hero { text-align: left; background: var(--pv-wash); border-bottom: 3px solid var(--pv-ink); }
      .st-brutal .pv-hero-inner { margin: 0; max-width: 40rem; }
      .st-brutal .pv-h2 { text-align: left; }
      .st-brutal .pv-label {
        text-align: left;
        display: inline-block;
        background: var(--pv-ink);
        color: var(--pv-page, #fff);
        padding: 0.2rem 0.5rem;
      }
      .st-brutal .pv-nav { border-bottom: 3px solid var(--pv-ink); }
      .st-brutal .pv-card {
        border: 3px solid var(--pv-ink);
        border-radius: 0;
        box-shadow: 6px 6px 0 var(--pv-ink);
      }
      .st-brutal .pv-btn, .st-brutal .pv-cta, .st-brutal .pv-pill, .st-brutal .pv-glyph {
        border-radius: 0;
        border: 3px solid var(--pv-ink);
        box-shadow: 4px 4px 0 var(--pv-ink);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .st-brutal .pv-shot { border-radius: 0; border: 3px solid var(--pv-ink); }
      .st-brutal .pv-band { border-top: 3px solid var(--pv-ink); border-bottom: 3px solid var(--pv-ink); }
      .st-brutal .pv-lede { margin-left: 0; }
      .st-brutal .pv-band { text-align: left; }
      .st-brutal .pv-hours, .st-brutal .pv-prose, .st-brutal .pv-quote { margin-left: 0; text-align: left; }
      .st-brutal .pv-contact { justify-content: flex-start; }
      .st-brutal .pv-map { margin-left: 0; border-radius: 0; border-width: 2px; }

      .pv.st-classic {
        --pv-display: 'Playfair Display', Georgia, serif;
      }
      .st-classic .pv-h1 { font-weight: 700; letter-spacing: -0.01em; }
      .st-classic .pv-h2 { font-weight: 600; letter-spacing: 0; }
      .st-classic .pv-h2::after {
        content: '';
        display: block;
        width: 42px;
        height: 1px;
        background: var(--pv-primary);
        margin: 0.9rem auto 0;
      }
      .st-classic .pv-hero { background: var(--pv-page, #fff); padding-top: 5.5rem; padding-bottom: 5.5rem; }
      .st-classic .pv-label { letter-spacing: 0.24em; color: var(--pv-soft); font-weight: 600; }
      .st-classic .pv-card {
        border: none;
        border-top: 1px solid var(--pv-line);
        border-radius: 0;
        padding-left: 0;
        padding-right: 1.2rem;
        background: none;
      }
      .st-classic .pv-btn, .st-classic .pv-cta {
        border-radius: 2px;
        font-weight: 500;
        letter-spacing: 0.04em;
      }
      .st-classic .pv-btn-2 { border-color: var(--pv-primary); color: var(--pv-primary); }
      .st-classic .pv-pill { border-radius: 2px; }
      .st-classic .pv-shot { border-radius: 2px; }
      .st-classic .pv-section { padding-top: 4.2rem; padding-bottom: 4.2rem; }
      .st-classic .pv-section.alt { background: var(--pv-wash); }

      /* ── Cafe: not a restyle of the house page, a different one ── */
      .pv.st-cafe {
        --pv-display: 'Fraunces', Georgia, serif;
        --pv-ink: #2b1e15;
        --pv-soft: #7c6852;
        --pv-line: #e2d4bf;
        --pv-wash: #f4ebdd;
      }
      .st-cafe #site-root, .pv.st-cafe { background: #fbf6ee; }
      .st-cafe .pv-h1, .st-cafe .pv-h2, .st-cafe .pv-group-h,
      .st-cafe .pv-dish-price, .st-cafe .pv-quote p { font-weight: 600; letter-spacing: -0.015em; }
      .st-cafe .pv-nav { border-bottom: 0; padding: 1rem 2.2rem; }
      .st-cafe .pv-brand { font-family: var(--pv-display); font-weight: 700; }
      .st-cafe .pv-brand .pv-glyph { border-radius: 50%; background: transparent; color: var(--pv-ink); border: 1px solid var(--pv-ink); }
      .st-cafe .pv-links { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; }
      .st-cafe .pv-cta { background: transparent; color: var(--pv-ink); border: 1px solid var(--pv-ink);
        font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; padding: 0.55rem 1.1rem; }
      .st-cafe .pv-hero { text-align: left; padding: 6.5rem 2.2rem 3.2rem; background: #231a13; color: #fff; }
      .st-cafe .pv-hero-inner { max-width: 46rem; margin: 0; }
      .st-cafe .pv-hero-photo::after { background: linear-gradient(180deg, rgba(20,13,8,0.5) 0%, rgba(20,13,8,0.2) 35%, rgba(20,13,8,0.85) 100%); }
      .st-cafe .pv-h1 { font-size: clamp(2.4rem, 6.4vw, 4.2rem); line-height: 0.98; font-weight: 700; letter-spacing: -0.02em; }
      .st-cafe .pv-hero .pv-eyebrow { color: rgba(255,255,255,0.82); letter-spacing: 0.28em; }
      .st-cafe .pv-lede { margin-left: 0; }
      .st-cafe .pv-btn { border-radius: 999px; padding: 0.7rem 1.5rem; font-size: 0.7rem;
        letter-spacing: 0.16em; text-transform: uppercase; }
      .st-cafe .pv-btn-2 { border-color: rgba(255,255,255,0.5); }
      .st-cafe .pv-label { letter-spacing: 0.28em; font-weight: 600; }
      .st-cafe .pv-section { padding: 4.4rem 2.2rem; }
      .st-cafe .pv-section.alt { background: var(--pv-wash); }
      .st-cafe .pv-card { border-radius: 2px; border: 1px solid var(--pv-line); background: #fbf6ee; }
      .st-cafe .pv-shot { border-radius: 2px; }
      .st-cafe .pv-pill { border-radius: 999px; }

      /* The menu board — the whole reason this template exists */
      .st-cafe .pv-menu { text-align: center; }
      .pv-board { max-width: 56rem; margin: 2.2rem auto 0; text-align: left; display: grid; gap: 2.6rem; }
      .pv-board.two { grid-template-columns: 1fr 1fr; gap: 2.6rem 3.4rem; }
      .pv-group-h { font-family: var(--pv-display); font-size: 1.15rem; font-weight: 600;
        display: flex; align-items: baseline; gap: 0.8rem; margin-bottom: 0.3rem; }
      .pv-group-h::after { content: ''; flex: 1; height: 1px; background: var(--pv-line); }
      .pv-group-note { font-size: 0.82rem; font-style: italic; color: var(--pv-soft); margin-bottom: 1rem; }
      .pv-dish { display: grid; grid-template-columns: 1fr auto; column-gap: 0.6rem;
        padding: 0.7rem 0; border-bottom: 1px dotted var(--pv-line); }
      .pv-dish:last-child { border-bottom: 0; }
