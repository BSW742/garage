              : '') +
            (svc && (svc.items || []).length
              ? '<div class="pv-mg-grid">' + (svc.items || []).slice(0, 3).map((it) =>
                  '<div class="pv-mg-card"><b>' + esc(it[0]) + '</b>' +
                  (it[1] ? '<span>' + esc(it[1]) + '</span>' : '') + '</div>').join('') + '</div>'
              : '');
          $('canvas-empty').classList.toggle('gone', true);
          renderedKeys = new Set(['mogged']);
          setPalette(root, s.palette);
          root.parentElement.classList.add('pv');
          root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-tribute', 'st-listing', 'st-diet', 'st-chain', 'st-bubbles', 'st-game', 'st-eggs');
          root.parentElement.classList.add('st-mogged');
