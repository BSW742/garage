      @media (max-width: 700px) { .pv-board.two { grid-template-columns: 1fr; } }

      /* Find us reads as a dark room you are looking into */
      .st-cafe .pv-section:has(.pv-contact) { background: #231a13; }
      .st-cafe .pv-section:has(.pv-contact) .pv-h2 { color: #fbf6ee; }
      .st-cafe .pv-section:has(.pv-contact) .pv-label { color: #e9b98f; }
      .st-cafe .pv-pill { background: rgba(251,246,238,0.08); border-color: rgba(251,246,238,0.28); color: #f4ebdd; }
      .st-cafe .pv-pill b { color: #e9b98f; }
      .st-cafe .pv-foot { background: #231a13; color: rgba(244,235,221,0.7); border-top: 0; }

      /* ── Clinic: light and airy, the counterweight to cafe ── */
      .pv.st-physio {
        --pv-display: 'Instrument Serif', Georgia, serif;
        --pv-ink: #26302a;
        --pv-soft: #6b7668;
        --pv-line: #e2e7dc;
        --pv-wash: #eef1e8;
      }
      .st-physio #site-root, .pv.st-physio { background: #fbfbf6; }
      .st-physio .pv-h1, .st-physio .pv-h2 { font-weight: 400; letter-spacing: -0.01em; }
      .st-physio .pv-h1 { font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.08; }
      .st-physio .pv-nav { border-bottom: 0; }
      .st-physio .pv-brand .pv-glyph { border-radius: 12px; background: var(--pv-wash); color: var(--pv-ink); }
      .st-physio .pv-cta { border-radius: 999px; }
      .st-physio .pv-hero {
        text-align: left;
        background: radial-gradient(40rem 20rem at 78% -10%, var(--pv-wash), transparent 70%), #fbfbf6;
        padding: 4rem 2.2rem 4.5rem;
      }
      .st-physio .pv-hero-inner { margin: 0; max-width: 42rem; }
      .st-physio .pv-lede { margin-left: 0; }
      .st-physio .pv-btn { border-radius: 999px; padding: 0.75rem 1.6rem; }
      .st-physio .pv-btn-2 { border-radius: 999px; }
      .st-physio .pv-label { letter-spacing: 0.22em; font-weight: 600; }
      .st-physio .pv-section { padding: 4rem 2.2rem; }
      .st-physio .pv-section.alt { background: var(--pv-wash); }
      .st-physio .pv-card {
        border-radius: 20px; border: 1px solid var(--pv-line); background: #fbfbf6; padding: 1.5rem 1.4rem;
      }
      .st-physio .pv-shot, .st-physio .pv-map { border-radius: 20px; }
      .st-physio .pv-pill { border-radius: 999px; }
      .st-physio .pv-foot { background: #fbfbf6; border-top: 1px solid var(--pv-line); }
      /* The ACC block is the one dark moment on an otherwise pale page */
      .st-physio .pv-acc { background: #2f3d2c; border-radius: 28px; margin: 0 2.2rem; }
      .st-physio .pv-acc .pv-h2 { color: #fff; }
      .st-physio .pv-acc .pv-label { color: #a8c49b; }
      .st-physio .pv-acc .pv-prose { color: rgba(232,237,228,0.75); }
      .st-physio .pv-acc .pv-card {
        background: rgba(255,255,255,0.06); border-color: rgba(232,237,228,0.18); color: #e8ede4;
      }
      .st-physio .pv-acc .pv-card p { color: rgba(232,237,228,0.72); }

      /* ── Trade: dark, dense, phone-first ── */
      .pv.st-trade {
        --pv-display: 'Barlow Condensed', Oswald, Impact, sans-serif;
        --pv-ink: #eef1f2;
        --pv-soft: #a2aaad;
        --pv-line: #2b3034;
        --pv-wash: #1e2225;
      }
      .st-trade #site-root, .pv.st-trade { background: #141719; }
      .st-trade .pv-h1, .st-trade .pv-h2, .st-trade .pv-card h4 {
        text-transform: uppercase; font-weight: 700; letter-spacing: -0.005em; line-height: 0.98;
      }
      .st-trade .pv-h1 { font-size: clamp(2.2rem, 6vw, 4rem); }
      .st-trade .pv-nav { border-bottom: 1px solid var(--pv-line); }
      .st-trade .pv-brand { font-family: var(--pv-display); text-transform: uppercase; font-size: 1.2rem; }
      .st-trade .pv-brand .pv-glyph { border-radius: 0; }
      .st-trade .pv-links { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 600; }
      .st-trade .pv-cta {
        border-radius: 0; font-family: var(--pv-display); font-size: 1.1rem; text-transform: uppercase;
      }
      .st-trade .pv-hero { text-align: left; background: #1e2225; padding: 4rem 2.2rem; }
      .st-trade .pv-hero-inner { margin: 0; max-width: 44rem; }
      .st-trade .pv-hero-photo::after { background: linear-gradient(100deg, rgba(20,23,25,0.95) 20%, rgba(20,23,25,0.55)); }
      .st-trade .pv-lede { margin-left: 0; color: #cfd6d8; }
      .st-trade .pv-btn, .st-trade .pv-btn-2 { border-radius: 0; font-weight: 600; }
      .st-trade .pv-label { letter-spacing: 0.2em; font-weight: 700; }
      .st-trade .pv-section { padding: 4rem 2.2rem; }
      .st-trade .pv-section.alt { background: #1e2225; }
      .st-trade .pv-grid { gap: 1px; background: var(--pv-line); border: 1px solid var(--pv-line); }
      .st-trade .pv-card { border-radius: 0; border: 0; background: #141719; padding: 1.6rem 1.4rem; }
      .st-trade .pv-shot, .st-trade .pv-map, .st-trade .pv-pill { border-radius: 0; }
      .st-trade .pv-gallery { gap: 2px; }
      .st-trade .pv-foot { background: #141719; border-top: 1px solid var(--pv-line); }
      .st-trade .pv-hours div, .st-trade .pv-rates > div { border-color: var(--pv-line); }

      /* ── Tribute: a name, two dates, and photographs ── */
      .pv.st-tribute { --pv-display: 'Cormorant Garamond', Georgia, serif; --pv-ink: #f2efe9; }
      .st-tribute #site-root, .pv.st-tribute { background: #0d0d0e; color: #f2efe9; }
      .pv-trib-head { padding: 3.5rem 1.5rem 2rem; text-align: center; }
      .pv-trib-face {
        width: 7rem; aspect-ratio: 1; border-radius: 50%; margin: 0 auto 1.6rem;
        background: #17171a center/cover; box-shadow: 0 0 0 1px #26262a;
      }
      .st-tribute .pv-h1 {
        font-family: var(--pv-display); font-weight: 300; text-transform: none;
        font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: 0.005em; margin-bottom: 0;
      }
      .pv-trib-dates {
        font-family: var(--pv-display); color: #9a958c; margin-top: 0.7rem;
        font-size: 1.05rem; letter-spacing: 0.06em;
      }
      .pv-trib-note { color: #9a958c; font-size: 0.92rem; max-width: 30rem; margin: 1.2rem auto 0; }
      .pv-trib-wall { column-count: 3; column-gap: 0.5rem; padding: 1.5rem 0.5rem 3rem; }
      .pv-trib-wall img {
        width: 100%; height: auto; display: block; break-inside: avoid;
        margin-bottom: 0.5rem; background: #17171a;
      }
      .pv-trib-empty { color: #9a958c; text-align: center; padding: 3rem 1.5rem 5rem; font-size: 0.92rem; }

      /* ── Listing: photos, a price, the numbers ── */
      /* Game preview. The real board is a canvas and cannot be edited in place,
         so the preview shows the shape of it and where the words end up. */
      .pv.st-game { --pv-display: 'Press Start 2P', monospace; }
      .st-game #site-root, .pv.st-game { background: #07060d; color: #e9e6ff; }
      .pv-gm-head { padding: 2.2rem 1.5rem 1rem; text-align: center; }
      .pv-gm-eyebrow { font-family: var(--pv-display); font-size: 0.5rem; letter-spacing: 0.1em;
        color: #8e88a8; margin-bottom: 0.9rem; }
      .st-game .pv-h1 {
        font-family: var(--pv-display); font-weight: 400; text-transform: none;
        font-size: clamp(0.85rem, 2.6vw, 1.4rem); line-height: 1.5; margin-bottom: 0;
        color: var(--pv-primary);
      }
      .pv-gm-lede { color: #8e88a8; font-size: 0.88rem; margin: 0.9rem auto 0; max-width: 24rem; }
      .pv-gm-board { margin: 1.2rem 1.5rem 0; border: 2px solid #241f3a; border-radius: 8px;
        background: #05040a; padding: 0.9rem; }
      .pv-gm-hud { font-family: var(--pv-display); font-size: 0.45rem; color: #8e88a8;
        display: flex; justify-content: space-between; margin-bottom: 1rem; }
      .pv-gm-hud b { color: var(--pv-primary); font-weight: 400; }
      .pv-gm-foes { display: flex; justify-content: space-around; font-size: 1.1rem; }
      .pv-gm-ship { text-align: center; margin-top: 1.6rem; font-size: 1rem; }
      .pv-gm-note { margin: 1.1rem 1.5rem 2.4rem; color: #8e88a8; font-size: 0.8rem;
        text-align: center; }
      .st-game .pv-section, .st-game .pv-card { background: transparent; }
      /* Producer preview. Values lifted straight from eggs-render.ts so the
         two cannot drift: same cream, same orange, same broken headline. */
      .pv.st-eggs { --pv-display: 'Bricolage Grotesque', system-ui, sans-serif; }
      .st-eggs #site-root, .pv.st-eggs { background: #fbf6ec; color: #231f1a; }
      .pv-eg-hero { position: relative; overflow: hidden; padding: 2.2rem 1.5rem 1.8rem;
        display: grid; gap: 1.4rem; grid-template-columns: 1fr; align-items: center; }
      @media (min-width: 620px) { .pv-eg-hero { grid-template-columns: 1.05fr 0.95fr; } }
      .pv-eg-blob { position: absolute; width: 18rem; height: 14rem; top: -5rem; right: -6rem;
        border-radius: 50%; filter: blur(38px); opacity: 0.5;
        background: color-mix(in srgb, var(--pv-primary) 45%, #ffc94d); }
      .pv-eg-in { position: relative; z-index: 1; }
      .pv-eg-eyebrow { display: inline-block; font-family: var(--pv-display); font-weight: 700;
        font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--pv-primary); border: 1.5px solid color-mix(in srgb, var(--pv-primary) 35%, transparent);
        border-radius: 999px; padding: 0.3rem 0.8rem; margin-bottom: 0.9rem; }
      .st-eggs .pv-h1 { font-family: var(--pv-display); font-weight: 800; text-transform: none;
        letter-spacing: -0.03em; line-height: 0.98; text-align: left;
        font-size: clamp(1.5rem, 4.4vw, 2.4rem); margin-bottom: 0; }
      .st-eggs .pv-h1 span { display: block; }
      .st-eggs .pv-h1 span:nth-child(2) { padding-left: 0.7em; }
      .st-eggs .pv-h1 span:nth-child(3) { padding-left: 0.25em; font-style: italic;
        color: var(--pv-primary); }
      .pv-eg-lede { margin-top: 0.8rem; color: #7c7266; font-size: 0.86rem; }
      .pv-eg-btn { display: inline-block; margin-top: 1rem; background: #231f1a; color: #fbf6ec;
        border-radius: 999px; padding: 0.5rem 1.1rem; font-size: 0.8rem; font-weight: 600; }
      .pv-eg-shot { position: relative; z-index: 1; border-radius: 1.2rem; aspect-ratio: 4/3;
        background: #fffdf8 center/cover no-repeat; box-shadow: 0 18px 40px -26px rgba(35,31,26,0.5); }
      .pv-eg-sec { padding: 1.6rem 1.5rem 0; }
      .pv-eg-sec h2 { font-family: var(--pv-display); font-weight: 800; letter-spacing: -0.03em;
        text-align: left; font-size: 1.3rem; margin-bottom: 0.9rem; }
      .pv-eg-range { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
      .pv-eg-item { background: #fffdf8; border: 1px solid #e8ddc9; border-radius: 0.9rem;
        overflow: hidden; }
      .pv-eg-item i { display: block; aspect-ratio: 1;
        background: color-mix(in srgb, var(--pv-primary) 18%, #fffdf8) center/cover no-repeat; }
      .pv-eg-item b { display: block; padding: 0.5rem 0.6rem 0; font-size: 0.78rem; font-weight: 600; }
      .pv-eg-item span { display: block; padding: 0.15rem 0.6rem 0.6rem; font-size: 0.75rem;
        color: var(--pv-primary); font-weight: 700; font-family: var(--pv-display); }
      .pv-eg-certs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; }
      .pv-eg-cert { background: #fffdf8; border: 1px solid #e8ddc9; border-radius: 0.8rem;
        padding: 0.8rem 0.4rem; text-align: center; font-size: 0.7rem; }
      .pv-eg-cert i { display: grid; place-items: center; width: 1.8rem; height: 1.8rem;
        margin: 0 auto 0.4rem; border-radius: 50%; font-style: normal; font-weight: 800;
        font-family: var(--pv-display); font-size: 0.7rem;
        background: color-mix(in srgb, var(--pv-primary) 35%, #fffdf8); }
      .pv-eg-facts { display: grid; grid-template-columns: repeat(4, 1fr);
        border: 1px solid #e8ddc9; border-radius: 0.9rem; overflow: hidden; background: #fffdf8; }
      .pv-eg-fact { padding: 0.8rem 0.3rem; text-align: center; box-shadow: 0 0 0 0.5px #e8ddc9; }
      .pv-eg-fact b { display: block; font-family: var(--pv-display); font-weight: 800;
        font-size: 1.1rem; letter-spacing: -0.03em; }
      .pv-eg-fact span { display: block; margin-top: 0.15rem; font-size: 0.58rem;
        letter-spacing: 0.1em; text-transform: uppercase; color: #7c7266; font-weight: 600; }

      /* Agency preview. Same navy, same electric blue, same italic word. */
      /* Reel: a dark room and a lit screen. */
      .pv.st-reel { --pv-display: 'Space Grotesk', system-ui, sans-serif; }
      .st-reel #site-root, .pv.st-reel { background: #0b0b0d; color: #f4f4f5; }
      .st-reel .pv-nav { border-bottom: 1px solid #26262d; background: transparent; }
      .st-reel .pv-brand, .st-reel .pv-h1, .st-reel .pv-h2 { color: #f4f4f5;
        font-family: var(--pv-display); font-weight: 700; letter-spacing: -0.028em;
        text-align: left; text-transform: none; }
      .st-reel .pv-hero { text-align: left; color: #f4f4f5; background: #141418; }
      .st-reel .pv-lede { color: #8f8f99; }
      .st-reel .pv-cta, .st-reel .pv-btn { background: var(--pv-primary); color: #000;
        border-radius: 8px; font-weight: 600; }
      .st-reel .pv-card, .st-reel .pv-band, .st-reel .pv-hours, .st-reel .pv-rates {
        background: #141418; border: 1px solid #26262d; border-radius: 12px; color: #f4f4f5; }
      .st-reel .pv-section { border-color: #26262d; }
      .st-reel .pv-shot, .st-reel .pv-hero-photo { border-radius: 12px; }
      .st-reel .pv-label, .st-reel .pv-eyebrow { color: var(--pv-primary);
        letter-spacing: 0.26em; text-transform: uppercase; }
      .st-reel .pv-quote p, .st-reel .pv-prose, .st-reel .pv-contact { color: #f4f4f5; }
      .st-reel .pv-foot { border-top: 1px solid #26262d; color: #8f8f99; }

      /* Clubs: three codes, one dark field. */
      .pv.st-rugby, .pv.st-soccer, .pv.st-basketball {
        --pv-display: 'Barlow Condensed', system-ui, sans-serif; }
      .st-rugby #site-root, .pv.st-rugby { background: #0f1512; color: #f2f4f2; }
      .st-soccer #site-root, .pv.st-soccer { background: #0c1220; color: #f2f4f2; }
      .st-basketball #site-root, .pv.st-basketball { background: #17120e; color: #f2f4f2; }
      .st-rugby .pv-nav, .st-soccer .pv-nav, .st-basketball .pv-nav {
        border-bottom: 1px solid rgba(242,244,242,0.14); background: transparent; }
      .st-rugby .pv-brand, .st-soccer .pv-brand, .st-basketball .pv-brand,
      .st-rugby .pv-h1, .st-soccer .pv-h1, .st-basketball .pv-h1,
      .st-rugby .pv-h2, .st-soccer .pv-h2, .st-basketball .pv-h2 {
        color: #f2f4f2; font-family: var(--pv-display); font-weight: 700;
        text-transform: uppercase; text-align: left; letter-spacing: 0.005em; }
      .st-rugby .pv-hero, .st-soccer .pv-hero, .st-basketball .pv-hero {
        text-align: left; color: #f2f4f2; background: rgba(255,255,255,0.03); }
      .st-rugby .pv-lede, .st-soccer .pv-lede, .st-basketball .pv-lede { color: #9aa5a0; }
      .st-rugby .pv-cta, .st-soccer .pv-cta, .st-basketball .pv-cta,
      .st-rugby .pv-btn, .st-soccer .pv-btn, .st-basketball .pv-btn {
        background: var(--pv-primary); color: #fff; border-radius: 3px;
        font-family: var(--pv-display); font-weight: 700; text-transform: uppercase; }
      .st-rugby .pv-card, .st-soccer .pv-card, .st-basketball .pv-card,
      .st-rugby .pv-band, .st-soccer .pv-band, .st-basketball .pv-band,
      .st-rugby .pv-hours, .st-soccer .pv-hours, .st-basketball .pv-hours,
      .st-rugby .pv-rates, .st-soccer .pv-rates, .st-basketball .pv-rates {
        background: rgba(255,255,255,0.04); border: 1px solid rgba(242,244,242,0.14);
        border-radius: 6px; color: #f2f4f2; }
      .st-rugby .pv-section, .st-soccer .pv-section, .st-basketball .pv-section {
        border-color: rgba(242,244,242,0.14); }
      .st-rugby .pv-label, .st-soccer .pv-label, .st-basketball .pv-label,
      .st-rugby .pv-eyebrow, .st-soccer .pv-eyebrow, .st-basketball .pv-eyebrow {
        color: var(--pv-primary); letter-spacing: 0.22em; text-transform: uppercase;
        font-family: var(--pv-display); }
      .st-rugby .pv-quote p, .st-soccer .pv-quote p, .st-basketball .pv-quote p,
      .st-rugby .pv-prose, .st-soccer .pv-prose, .st-basketball .pv-prose,
      .st-rugby .pv-contact, .st-soccer .pv-contact, .st-basketball .pv-contact { color: #f2f4f2; }
      .st-rugby .pv-foot, .st-soccer .pv-foot, .st-basketball .pv-foot {
        border-top: 1px solid rgba(242,244,242,0.14); color: #9aa5a0; }

      /* Charity: warm paper, one loud accent. */
      .pv.st-charity { --pv-display: 'Sora', system-ui, sans-serif; }
      .st-charity #site-root, .pv.st-charity { background: #fbfaf8; color: #1c1a17; }
      .st-charity .pv-h1, .st-charity .pv-h2 { font-family: var(--pv-display); font-weight: 700;
        letter-spacing: -0.022em; text-align: left; text-transform: none; }
      .st-charity .pv-hero { text-align: left; }
      .st-charity .pv-lede { color: #6f6960; }
      .st-charity .pv-cta, .st-charity .pv-btn { background: var(--pv-primary); color: #fff;
        border-radius: 999px; font-weight: 600; }
      .st-charity .pv-card { background: #fff; border: 1px solid #e8e3db; border-radius: 14px; }
      .st-charity .pv-band { background: color-mix(in srgb, var(--pv-primary) 10%, #fbfaf8); }
      .st-charity .pv-label, .st-charity .pv-eyebrow { color: var(--pv-primary);
        letter-spacing: 0.24em; text-transform: uppercase; }

      /* Town hall: newsprint and a wooden floor. */
      .pv.st-townhall { --pv-display: 'Newsreader', Georgia, serif; }
      .st-townhall #site-root, .pv.st-townhall { background: #f7f5f0; color: #1f1d18; }
      .st-townhall .pv-h1, .st-townhall .pv-h2 { font-family: var(--pv-display); font-weight: 600;
        letter-spacing: -0.008em; text-align: left; text-transform: none; }
      .st-townhall .pv-hero { text-align: left; }
      .st-townhall .pv-lede { color: #6e685d; }
      .st-townhall .pv-cta, .st-townhall .pv-btn { background: #1f1d18; color: #f7f5f0;
        border-radius: 3px; }
      .st-townhall .pv-card { background: #fff; border: 1px solid #e0dbd0; border-radius: 8px; }
      .st-townhall .pv-band { background: color-mix(in srgb, var(--pv-primary) 9%, #f7f5f0); }
      .st-townhall .pv-label, .st-townhall .pv-eyebrow { color: var(--pv-primary);
        letter-spacing: 0.24em; text-transform: uppercase; }

      /* Daycare: daylight, rounded, not a single primary colour. */
      .pv.st-daycare { --pv-display: 'Nunito', system-ui, sans-serif; }
      .st-daycare #site-root, .pv.st-daycare { background: #fdfbf7; color: #26221d; }
      .st-daycare .pv-h1, .st-daycare .pv-h2 { font-family: var(--pv-display); font-weight: 700;
        letter-spacing: -0.016em; text-align: left; text-transform: none; }
      .st-daycare .pv-hero { text-align: left; }
      .st-daycare .pv-lede { color: #726a5f; }
      .st-daycare .pv-cta, .st-daycare .pv-btn { background: var(--pv-primary); color: #fff;
        border-radius: 999px; font-weight: 700; }
      .st-daycare .pv-card, .st-daycare .pv-hours { background: #fff; border: 1px solid #eae3d8;
        border-radius: 16px; }
      .st-daycare .pv-band { background: color-mix(in srgb, var(--pv-primary) 11%, #fdfbf7); }
      .st-daycare .pv-label, .st-daycare .pv-eyebrow { color: var(--pv-primary);
        letter-spacing: 0.24em; text-transform: uppercase; }

      /* Workshop: paper and unglazed clay. */
      .pv.st-workshop { --pv-display: 'Fraunces', Georgia, serif; }
