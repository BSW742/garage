        photography: { match: ['photo', 'film', 'video', 'studio'], colour: '#111827', eyebrow: 'Photography & film', lede: 'Pictures that look like the day actually felt.', cta: 'Check availability',
          services: [['Weddings', 'Full-day coverage, unhurried and unposed.'], ['Portraits', 'Families, whānau and the annual awkward one.'], ['Commercial', 'Product, team and brand shoots.']] },
