          } else {
            const w = raw.split(/\s+/);
            head = w.length < 3 ? esc(raw)
              : esc(w.slice(0, -1).join(' ')) + ' <em>' + esc(w[w.length - 1]) + '</em>';
          }
          const proofs = ((s.sections || []).filter((x) => x && x.type === 'included')[0] || {}).items || [];
          const trust = (s.sections || []).filter((x) => x && x.type === 'alongside')[0];
          const define = (s.sections || []).filter((x) => x && x.type === 'define')[0];
          const svc = (s.sections || []).filter((x) => x && x.type === 'services')[0];
          const mark = String(s.name || '').split(/\s+/);

          root.innerHTML =
            '<div class="pv-mg-nav"><span class="pv-mg-mark">' + esc(mark[0] || '') +
              '<span>' + esc(mark.slice(1).join(' ')) + '.</span></span>' +
              '<span class="pv-mg-pill" data-edit="cta">' + esc(s.cta || 'Get in touch') + '</span></div>' +
            '<div class="pv-mg-hero"><div>' +
            '<h1 class="pv-h1" data-edit="headline">' + head + '</h1>' +
            (s.lede ? '<p class="pv-mg-lede" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
            '<span class="pv-mg-btn">' + esc(s.cta || 'Get in touch') + '</span>' +
            (proofs.length
              ? '<div class="pv-mg-ticks">' + proofs.slice(0, 3).map((p) =>
                  '<span class="pv-mg-tick"><i>\u2713</i>' + esc(p[0]) + '</span>').join('') + '</div>'
              : '') +
            '</div><div class="pv-mg-shot" data-photo="heroImage"' +
            (s.heroImage ? ' style="background-image:url(' + esc(s.heroImage) + ')"' : '') + '></div></div>' +
            (trust && (trust.partners || []).length
              ? '<div class="pv-mg-trust"><p>' + esc(trust.text || 'Trusted by') + '</p>' +
                '<div class="pv-mg-logos">' + (trust.partners || []).slice(0, 6).map((p) =>
                  '<span>' + esc(p.name || '') + '</span>').join('') + '</div></div>'
              : '') +
            (define && define.text
              ? '<div class="pv-mg-define"><div class="pv-mg-word" data-edit="' +
                'sec.' + s.sections.indexOf(define) + '.label">' + esc(define.label || '') + '</div>' +
                '<div class="pv-mg-meaning"><b>' + esc(define.title || 'verb.') + '</b> ' +
                esc(define.text) +
                (define.quote ? '<p class="pv-mg-usage">\u201c' + esc(define.quote) + '\u201d</p>' : '') +
