---
// GARAGE AI — the builder with a real agent behind it.
// Same flow as /build, but the chat goes to Claude with tools rather than
// a local intent engine. Falls back to the local engine if the key is missing.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Build it with AI | garage.co.nz</title>
    <meta name="description" content="Pick a name, chat to the agent, watch your website appear. Live in two minutes — free for NZ charities and community projects." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&family=Archivo+Black&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- ══ 1. HERO ══ -->
    <section class="screen screen-hero is-active" data-screen="hero">
      <header class="mini-header">
        <a href="/" class="mini-logo">garage<span class="dot-orange">.</span>co<span class="dot">.</span>nz</a>
        <span class="mini-tag">ai</span>
      </header>

      <div class="hero-inner">
        <p class="eyebrow">No forms. No brief. No waiting.</p>
        <h1>Let's build.</h1>
        <p class="hero-sub">Pick your address, chat to the agent, watch your site appear.<br />Live before your coffee goes cold.</p>
        <button class="btn-primary btn-xl" id="start-btn">
          <span>Let's build</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="hero-foot">Free for NZ charities &amp; community projects.</p>
      </div>
    </section>

    <!-- ══ 2. PICK A SUBDOMAIN ══ -->
    <section class="screen" data-screen="name">
      <div class="screen-inner">
        <p class="step-label">Step 1 of 2</p>
        <h2 class="q">First — your address.</h2>
        <p class="hint">Yours the second you're done. Point your own domain at it whenever you like.</p>

        <div class="domain-field" id="domain-field">
          <input id="slug-input" type="text" placeholder="westcoastplumbers" autocomplete="off" autocapitalize="off" spellcheck="false" />
          <span class="domain-suffix">.garage.co.nz</span>
        </div>

        <div class="domain-status" id="domain-status"></div>
        <div class="suggestions" id="suggestions"></div>

        <button class="btn-primary" id="slug-next" disabled>
          <span>Continue</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══ 3. EXISTING SITE ══ -->
    <section class="screen" data-screen="existing">
      <div class="screen-inner">
        <p class="step-label">Step 2 of 2</p>
        <h2 class="q">Got something already?</h2>
        <p class="hint">Old site, Facebook page, anything with your logo and words on it. I'll lift what's worth keeping — you'll approve it in a second.</p>

        <input id="source-url" type="url" class="big-input" placeholder="westcoastplumbers.co.nz" autocomplete="off" spellcheck="false" />

        <div class="two-up">
          <button class="btn-primary" id="pull-btn">
            <span>Pull it across</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="btn-ghost" id="fresh-btn">Nah — blank page</button>
        </div>
      </div>
    </section>

    <!-- ══ 4. THE BUILDER ══ -->
    <section class="screen screen-build" data-screen="build">
      <div class="builder">
        <!-- Canvas -->
        <div class="canvas-wrap">
          <div class="browser-chrome">
            <span class="chrome-dots"><i></i><i></i><i></i></span>
            <span class="chrome-url" id="chrome-url">yoursite.garage.co.nz</span>
            <span class="chrome-live"><i class="pulse"></i> live</span>
          </div>
          <div class="canvas" id="canvas">
            <div class="canvas-empty" id="canvas-empty">
              <div class="empty-mark"></div>
              <p>A completely blank page.</p>
              <span>Say the word and it fills up →</span>
            </div>
            <div id="site-root"></div>
          </div>
        </div>

        <!-- Agent -->
        <aside class="agent">
          <div class="agent-head">
            <span class="agent-avatar">◐</span>
            <div class="agent-id">
              <strong>Garage agent</strong>
              <span id="agent-state">online · building</span>
            </div>
            <button class="agent-done" id="done-btn">Publish</button>
          </div>

          <div class="agent-log" id="agent-log"></div>
          <div class="agent-chips" id="agent-chips"></div>

          <div class="agent-paint">
            <div class="paint-row styles">
              <button class="tone style" data-style="modern">Modern</button>
              <button class="tone style" data-style="brutal">Brutal</button>
              <button class="tone style" data-style="classic">Classic</button>
            </div>
            <div class="paint-row" id="swatches"></div>
            <div class="paint-row tones">
              <button class="tone" data-tone="light">Light</button>
              <button class="tone" data-tone="warm">Warm</button>
              <button class="tone" data-tone="dark">Dark</button>
              <button class="tone roll" id="roll-colour" title="Surprise me">⟳</button>
            </div>
          </div>

          <div class="agent-target" id="agent-target" hidden>
            <span id="target-label">Headline</span>
            <button id="target-clear" aria-label="Stop editing this">×</button>
          </div>

          <form class="agent-input" id="agent-form" autocomplete="off">
            <input id="agent-text" type="text" placeholder="Tell me what to change…" />
            <button type="submit" aria-label="Send">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        </aside>
      </div>
    </section>

    <!-- ══ 5. LIVE ══ -->
    <section class="screen screen-live" data-screen="live">
      <canvas id="confetti"></canvas>
      <div class="live-inner">
        <div class="live-badge">Yippeeeee</div>
        <h2 class="live-h">You have a website.</h2>
        <a class="live-url" id="live-url" href="#" target="_blank" rel="noopener">yoursite.garage.co.nz</a>
        <p class="live-sub">It's live right now. Chuck your email in and I'll send you the keys — edit it any time by chatting to the agent.</p>
        <form class="live-form" id="live-form">
          <input id="live-email" type="email" placeholder="you@example.co.nz" required />
          <button class="btn-primary" type="submit">Send me the keys</button>
        </form>
        <p class="live-note" id="live-note"></p>
        <button class="btn-ghost" id="back-to-build">← Keep tinkering</button>
      </div>
    </section>

    <style is:global>
      :root {
        --bg: #fafafa;
        --surface: #ffffff;
        --text: #0a0a0a;
        --text-soft: #404040;
        --text-muted: #737373;
        --border: #e5e5e5;
        --accent: #2563eb;
        --accent-soft: #dbeafe;
        --accent-deep: #1e40af;
        --good: #16a34a;
        --bad: #dc2626;
        --work: #0f1115;
        --work-2: #181b22;
        --work-3: #242833;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-display: 'Poppins', system-ui, -apple-system, sans-serif;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 24px;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body {
        height: 100%;
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }

      /* ── Screens ───────────────────────────────── */
      .screen {
        display: none;
        min-height: 100vh;
        min-height: 100dvh;
      }
      .screen.is-active { display: flex; flex-direction: column; }
      .screen.is-active > * { animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; }

      @keyframes rise {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: none; }
      }

      .screen-inner {
        margin: auto;
        width: 100%;
        max-width: 640px;
        padding: 2rem 1.5rem 5rem;
      }

      /* ── Header ────────────────────────────────── */
      .mini-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 1.4rem 2rem;
      }
      .mini-logo {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.03em;
        color: var(--text);
        text-decoration: none;
      }
      .dot-orange { color: #f97316; }
      .dot { color: var(--accent); }
      .mini-tag {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
      }

      /* ── Hero ──────────────────────────────────── */
      .screen-hero {
        background:
          radial-gradient(ellipse 70% 50% at 50% -10%, rgba(37, 99, 235, 0.10) 0%, transparent 55%),
          linear-gradient(180deg, #ffffff 0%, #f6f8fb 100%);
      }
      .hero-inner {
        margin: auto;
        text-align: center;
        padding: 2rem 1.5rem 8rem;
        max-width: 720px;
      }
      .eyebrow {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.2rem;
      }
      .hero-inner h1 {
        font-family: var(--font-display);
        font-size: clamp(3.5rem, 14vw, 7rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.045em;
        margin-bottom: 1.4rem;
      }
      .hero-sub {
        font-size: clamp(1.05rem, 2.4vw, 1.3rem);
        color: var(--text-soft);
        margin-bottom: 2.5rem;
      }
      .hero-foot {
        margin-top: 1.6rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      /* ── Buttons ───────────────────────────────── */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--text);
        color: #fff;
        border: none;
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 600;
        padding: 0.95rem 1.6rem;
        border-radius: 999px;
        cursor: pointer;
        transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s, background 0.18s, opacity 0.18s;
        box-shadow: 0 6px 20px rgba(0,0,0,0.14);
      }
      .btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(0,0,0,0.2); }
      .btn-primary:active:not(:disabled) { transform: translateY(0); }
      .btn-primary:disabled { opacity: 0.35; cursor: not-allowed; box-shadow: none; }
      .btn-primary svg { transition: transform 0.18s; }
      .btn-primary:hover:not(:disabled) svg { transform: translateX(3px); }

      .btn-xl { font-size: 1.15rem; padding: 1.15rem 2.2rem; background: var(--accent); box-shadow: 0 10px 34px rgba(37,99,235,0.35); }
      .btn-xl:hover { background: var(--accent-deep); box-shadow: 0 16px 44px rgba(37,99,235,0.42); }

      .btn-ghost {
        background: none;
        border: none;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-muted);
        padding: 0.95rem 0.5rem;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-color: var(--border);
      }
      .btn-ghost:hover { color: var(--text); }

      /* ── Question screens ──────────────────────── */
      .step-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 0.9rem;
      }
      .q {
        font-family: var(--font-display);
        font-size: clamp(2rem, 6vw, 2.9rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.035em;
        margin-bottom: 0.8rem;
      }
      .hint {
        color: var(--text-muted);
        font-size: 1.02rem;
        margin-bottom: 2rem;
        max-width: 34rem;
      }

      /* ── Domain field ──────────────────────────── */
      .domain-field {
        display: flex;
        align-items: center;
        background: var(--surface);
        border: 2px solid var(--border);
        border-radius: var(--radius-md);
        padding: 0.4rem 1.1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        overflow: hidden;
      }
      .domain-field:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
      .domain-field.is-good { border-color: var(--good); box-shadow: 0 0 0 4px rgba(22,163,74,0.12); }
      .domain-field.is-bad { border-color: var(--bad); box-shadow: 0 0 0 4px rgba(220,38,38,0.10); }

      #slug-input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        font-family: var(--font-display);
        font-size: clamp(1.2rem, 4vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        padding: 0.7rem 0;
        background: none;
        color: var(--text);
      }
      #slug-input::placeholder { color: #cbd5e1; }
      .domain-suffix {
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 3.4vw, 1.7rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--text-muted);
        white-space: nowrap;
      }

      .domain-status {
        min-height: 1.9rem;
        margin-top: 0.9rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .domain-status.good { color: var(--good); }
      .domain-status.bad { color: var(--bad); }
      .spinner {
        width: 14px; height: 14px;
        border: 2px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      .suggestions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.6rem; }
      .suggestion {
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 999px;
        padding: 0.45rem 0.9rem;
        font-family: var(--font-sans);
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
      }
      .suggestion:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

      .big-input {
        width: 100%;
        border: 2px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--surface);
        font-family: var(--font-sans);
        font-size: 1.15rem;
        padding: 1.05rem 1.2rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        margin-bottom: 1.6rem;
      }
      .big-input:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }

      .two-up { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    </style>

    <style is:global>
      /* ── Builder shell ─────────────────────────── */
      .screen-build.is-active { display: block; position: fixed; inset: 0; height: 100vh; height: 100dvh; overflow: hidden; }
      .builder {
        display: grid;
        grid-template-columns: 1fr 400px;
        height: 100%;
        background: var(--work);
      }

      .canvas-wrap {
        display: flex;
        flex-direction: column;
        padding: 1.6rem 1.6rem 2rem;
        min-width: 0;
        min-height: 0;
      }

      .browser-chrome {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        background: var(--work-2);
        border: 1px solid var(--work-3);
        border-bottom: none;
        border-radius: 12px 12px 0 0;
        padding: 0.7rem 1rem;
      }
      .chrome-dots { display: flex; gap: 6px; }
      .chrome-dots i { width: 10px; height: 10px; border-radius: 50%; background: #3a3f4c; }
      .chrome-url {
        flex: 1;
        background: #0b0d12;
        border-radius: 999px;
        padding: 0.3rem 0.9rem;
        font-size: 0.82rem;
        color: #8b93a5;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .chrome-live {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #4ade80;
      }
      .pulse { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; animation: pulse 1.8s ease-in-out infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.8); } }

      .canvas {
        flex: 1;
        min-height: 0;
        background: #fff;
        border-radius: 0 0 12px 12px;
        overflow-y: auto;
        overflow-x: hidden;
        position: relative;
        box-shadow: 0 30px 80px rgba(0,0,0,0.5);
      }

      .canvas-empty {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        color: #b9c0cc;
        text-align: center;
        pointer-events: none;
        transition: opacity 0.4s;
      }
      .canvas-empty.gone { opacity: 0; }
      .empty-mark {
        width: 46px; height: 46px;
        border: 2px dashed #d7dde6;
        border-radius: 10px;
        margin-bottom: 0.7rem;
      }
      .canvas-empty p { font-family: var(--font-display); font-weight: 600; color: #8f98a6; }
      .canvas-empty span { font-size: 0.85rem; }

      /* ── Agent panel ───────────────────────────── */
      .agent {
        display: flex;
        flex-direction: column;
        background: var(--work-2);
        border-left: 1px solid var(--work-3);
        min-height: 0;
      }
      .agent-head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.1rem 1.2rem;
        border-bottom: 1px solid var(--work-3);
      }
      .agent-avatar {
        width: 34px; height: 34px;
        display: grid; place-items: center;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), #8b5cf6);
        color: #fff;
        font-size: 1rem;
        animation: spin 4s linear infinite;
      }
      .agent-id { flex: 1; line-height: 1.25; }
      .agent-id strong { display: block; color: #f4f6fa; font-size: 0.92rem; font-weight: 600; }
      .agent-id span { font-size: 0.75rem; color: #6f7889; }
      .agent-done {
        border: 1px solid var(--work-3);
        background: transparent;
        color: #cbd3e0;
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.15s;
      }
      .agent-done:hover { background: #4ade80; border-color: #4ade80; color: #08210f; }

      .agent-log {
        flex: 1;
        overflow-y: auto;
        padding: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        scroll-behavior: smooth;
      }
      .msg {
        max-width: 88%;
        padding: 0.7rem 0.95rem;
        border-radius: 14px;
        font-size: 0.92rem;
        line-height: 1.5;
        animation: pop 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
        white-space: pre-wrap;
      }
      @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(0.97); } to { opacity: 1; transform: none; } }
      .msg-agent { align-self: flex-start; background: var(--work-3); color: #e8ecf3; border-bottom-left-radius: 4px; }
      .msg-user { align-self: flex-end; background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
      .msg-note {
        align-self: flex-start;
        background: none;
        color: #7c8496;
        font-size: 0.8rem;
      }
      .msg-do {
        align-self: flex-start;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(74, 222, 128, 0.09);
        border: 1px solid rgba(74, 222, 128, 0.25);
        color: #86efac;
        font-size: 0.82rem;
        padding: 0.5rem 0.8rem;
        border-radius: 8px;
      }

      .typing { display: flex; gap: 4px; align-self: flex-start; padding: 0.85rem 0.95rem; background: var(--work-3); border-radius: 14px; border-bottom-left-radius: 4px; }
      .typing i { width: 6px; height: 6px; border-radius: 50%; background: #8b93a5; animation: blink 1.2s infinite; }
      .typing i:nth-child(2) { animation-delay: 0.15s; }
      .typing i:nth-child(3) { animation-delay: 0.3s; }
      @keyframes blink { 0%, 60%, 100% { opacity: 0.25; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }

      .agent-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 1.2rem 0.8rem; }
      .chip {
        border: 1px solid var(--work-3);
        background: rgba(255,255,255,0.03);
        color: #c3cad8;
        font-family: var(--font-sans);
        font-size: 0.8rem;
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.15s;
        animation: pop 0.25s both;
      }
