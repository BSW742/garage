---
// GARAGE AI — the builder with a real agent behind it.
// The chat goes to Claude with tools rather than a local intent engine.
// Falls back to the local engine if the key is missing.

// Someone arriving here from the offer email has gone a step past looking —
// they have opened the thing that changes their site. Worth knowing, and
// distinguishable from us opening it from the admin list by the src marker.
const cameFromOffer = Astro.url.searchParams.get('src') === 'owner';
const openedSlug = Astro.url.searchParams.get('edit') || '';
if (cameFromOffer && openedSlug) {
  const trackDb = (Astro.locals.runtime?.env as any)?.DB;
  if (trackDb) {
    try {
      await trackDb
        .prepare(
          `UPDATE site_claims SET editor_opened_at = COALESCE(editor_opened_at, ?) WHERE slug = ?`
        )
        .bind(new Date().toISOString(), openedSlug)
        .run();
    } catch {
      // never let a metric stop the builder loading
    }
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Build it with AI | garage.co.nz</title>
    <meta name="description" content="Pick a name, chat to the agent, watch your website appear. Live in two minutes — free for NZ charities and community projects." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&family=Archivo+Black&family=Playfair+Display:wght@600;700&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Sora:wght@400;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Nunito:wght@400;600;700&family=Space+Grotesk:wght@400;500;700&family=Instrument+Serif:ital@0;1&family=Barlow+Condensed:wght@600;700&family=Cormorant+Garamond:wght@300;400&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- ══ 1. HERO ══ -->
    <section class="screen screen-hero is-active" data-screen="hero">
      <header class="mini-header">
        <a href="/" class="mini-logo">garage<span class="dot-orange">.</span>co<span class="dot">.</span>nz</a>
        <span class="mini-tag">ai</span>
      </header>

      <div class="hero-inner">
        <p class="eyebrow">No forms. No brief. No waiting.</p>
        <h1>Let's build.</h1>
        <p class="hero-sub">Pick your address, chat to the agent, watch your site appear.<br />Live before your coffee goes cold.</p>
        <button class="btn-primary btn-xl" id="start-btn">
          <span>Let's build</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="hero-foot">Free for NZ charities &amp; community projects.</p>
      </div>
    </section>

    <!-- ══ 2. PICK A SUBDOMAIN ══ -->
    <section class="screen" data-screen="name">
      <div class="screen-inner">
        <p class="step-label">Step 1 of 2</p>
        <h2 class="q">First — your address.</h2>
        <p class="hint">Yours the second you're done. Point your own domain at it whenever you like.</p>

        <div class="domain-field" id="domain-field">
          <input id="slug-input" type="text" placeholder="westcoastplumbers" autocomplete="off" autocapitalize="off" spellcheck="false" />
          <span class="domain-suffix">.garage.co.nz</span>
        </div>

        <div class="domain-status" id="domain-status"></div>
        <div class="suggestions" id="suggestions"></div>

        <button class="btn-primary" id="slug-next" disabled>
          <span>Continue</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══ 3. EXISTING SITE ══ -->
    <section class="screen" data-screen="existing">
      <div class="screen-inner">
        <p class="step-label">Step 2 of 2</p>
        <h2 class="q">Got something already?</h2>
        <p class="hint">Old site, Facebook page, anything with your logo and words on it. I'll lift what's worth keeping — you'll approve it in a second.</p>

        <input id="source-url" type="url" class="big-input" placeholder="westcoastplumbers.co.nz" autocomplete="off" spellcheck="false" />

        <div class="two-up">
          <button class="btn-primary" id="pull-btn">
            <span>Pull it across</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="btn-ghost" id="fresh-btn">Nah — blank page</button>
        </div>
      </div>
    </section>

    <!-- ══ 4. THE BUILDER ══ -->
    <section class="screen screen-build" data-screen="build">
      <div class="builder">
        <!-- Canvas -->
        <div class="canvas-wrap">
          <div class="browser-chrome">
            <span class="chrome-dots"><i></i><i></i><i></i></span>
            <span class="chrome-url" id="chrome-url">yoursite.garage.co.nz</span>
            <span class="chrome-live"><i class="pulse"></i> live</span>
          </div>
          <div class="canvas" id="canvas">
            <div class="canvas-empty" id="canvas-empty">
              <div class="empty-mark"></div>
              <p>A completely blank page.</p>
              <span>Say the word and it fills up →</span>
            </div>
            <div id="site-root"></div>
          </div>
        </div>

        <!-- Agent -->
        <aside class="agent">
          <div class="agent-head">
            <span class="agent-avatar">◐</span>
            <div class="agent-id">
              <strong>Garage agent</strong>
              <span id="agent-state">online · building</span>
            </div>
            <button class="agent-done" id="style-btn" aria-expanded="false">Style</button>
            <button class="agent-done" id="media-btn">Media</button>
            <button class="agent-done" id="done-btn">Publish</button>

            <!-- Style controls live behind the Style button, anchored to the
                 head, so they stay out of the conversation. -->
            <div class="agent-paint" id="agent-paint" hidden>
              <div class="paint-groups">
                <div class="paint-group">
                  <p>Business</p>
                  <div>
                    <button class="tone style" data-style="modern">Modern</button>
                    <button class="tone style" data-style="classic">Classic</button>
                    <button class="tone style" data-style="brutal">Brutal</button>
                    <button class="tone style" data-style="mogged">Agency</button>
                    <button class="tone style" data-style="trade">Trade</button>
                  </div>
                </div>
                <div class="paint-group">
                  <p>Food &amp; drink</p>
                  <div>
                    <button class="tone style" data-style="cafe">Cafe</button>
                    <button class="tone style" data-style="eggs">Producer</button>
                  </div>
                </div>
                <div class="paint-group">
                  <p>Body</p>
                  <div>
                    <button class="tone style" data-style="physio">Clinic</button>
                    <button class="tone style" data-style="beauty">Beauty</button>
                    <button class="tone style" data-style="yoga">Yoga</button>
                    <button class="tone style" data-style="pilates">Pilates</button>
                    <button class="tone style" data-style="sauna">Sauna</button>
                  </div>
                </div>
                <div class="paint-group">
                  <p>Makers</p>
                  <div>
                    <button class="tone style" data-style="workshop">Workshop</button>
                  </div>
                </div>
                <div class="paint-group">
                  <p>Clubs &amp; community</p>
                  <div>
                    <button class="tone style" data-style="rugby">Rugby</button>
                    <button class="tone style" data-style="soccer">Soccer</button>
                    <button class="tone style" data-style="basketball">Basketball</button>
                    <button class="tone style" data-style="charity">Charity</button>
                    <button class="tone style" data-style="townhall">Town hall</button>
                    <button class="tone style" data-style="daycare">Daycare</button>
                  </div>
                </div>
                <div class="paint-group">
                  <p>Pictures</p>
                  <div>
                    <button class="tone style" data-style="bubbles">Bubbles</button>
                    <button class="tone style" data-style="montage">Montage</button>
                    <button class="tone style" data-style="reel">Reel</button>
                    <button class="tone style" data-style="tribute">Tribute</button>
                  </div>
                </div>
                <div class="paint-group">
                  <p>One of a kind</p>
                  <div>
                    <button class="tone style" data-style="listing">Listing</button>
                    <button class="tone style" data-style="chain">Chain</button>
                    <button class="tone style" data-style="diet">Diary</button>
                    <button class="tone style" data-style="game">Game</button>
                  </div>
                </div>
              </div>
              <div class="paint-row colour-line">
                <button class="tone colour-open" id="colour-open" aria-expanded="false">
                  <i id="colour-now"></i><span>Colour</span>
                </button>
              </div>
              <div class="paint-row swatches" id="swatches" hidden></div>
              <div class="paint-row tones">
                <button class="tone" data-tone="light">Light</button>
                <button class="tone" data-tone="warm">Warm</button>
                <button class="tone" data-tone="dark">Dark</button>
                <button class="tone roll" id="roll-colour" title="Surprise me">⟳</button>
              </div>
            </div>
          </div>

          <div class="agent-log" id="agent-log"></div>
          <div class="agent-chips" id="agent-chips"></div>

          <div class="agent-target" id="agent-target" hidden>
            <span id="target-label">Headline</span>
            <button id="target-clear" aria-label="Stop editing this">×</button>
          </div>

          <form class="agent-input" id="agent-form" autocomplete="off">
            <input id="agent-text" type="text" placeholder="Tell me what to change…" />
            <button type="submit" aria-label="Send">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        </aside>
      </div>
    </section>

    <!-- ══ MEDIA LIBRARY ══ -->
    <div class="meter-back" id="meter-back" hidden>
      <div class="meter-card" role="dialog" aria-modal="true" aria-labelledby="meter-title">
        <p class="meter-eyebrow" id="meter-eyebrow">Free while you build</p>
        <h2 id="meter-title">Nice work</h2>
        <div class="meter-bar"><i id="meter-fill"></i></div>
        <p class="meter-count" id="meter-count"></p>
        <p class="meter-say" id="meter-say"></p>
        <div class="meter-do">
          <button type="button" class="meter-go" id="meter-go">Keep going</button>
          <button type="button" class="meter-ask" id="meter-ask">Earn more</button>
        </div>
      </div>
    </div>

    <div class="meter-back" id="along-back" hidden>
      <div class="meter-card" role="dialog" aria-modal="true" aria-labelledby="along-title">
        <p class="meter-eyebrow">Who you work alongside</p>
        <h2 id="along-title">Add a business</h2>
        <p class="meter-say">Your sparkie, your roofer, whoever is on site with you. We make
          them a page with your name on it and let them know you put them there.</p>
        <input type="text" id="along-name" maxlength="60" placeholder="Business name" />
        <input type="text" id="along-contact" maxlength="120" placeholder="Phone, email or website" />
        <div class="meter-do">
          <button type="button" class="meter-go" id="along-save" disabled>Add them</button>
          <button type="button" class="meter-quiet" id="along-cancel">Not now</button>
        </div>
        <p class="meter-msg" id="along-msg"></p>
      </div>
    </div>

    <div class="meter-back" id="refer-back" hidden>
      <div class="meter-card" role="dialog" aria-modal="true" aria-labelledby="refer-title">
        <div id="refer-form">
          <p class="meter-eyebrow">Earn more</p>
          <h2 id="refer-title">Put a business forward</h2>
          <p class="meter-say">Somebody you actually use — your sparkie, your supplier, the
            cafe you get your coffee from. We build them a page with your name on it and tell
            them you said so. When they take it, you get 250,000 tokens.</p>
          <input type="text" id="refer-name" maxlength="60" placeholder="Their business name" />
          <input type="email" id="refer-email" maxlength="120" placeholder="Their email" />
          <div class="meter-do">
            <button type="button" class="meter-go" id="refer-send" disabled>Send it</button>
            <button type="button" class="meter-quiet" id="refer-cancel">Not now</button>
          </div>
          <p class="meter-msg" id="refer-msg"></p>
        </div>
        <div id="refer-done" class="meter-hide">
          <p class="meter-eyebrow">Sent</p>
          <h2 id="refer-done-title">On its way</h2>
          <p class="meter-say" id="refer-done-say"></p>
          <div class="meter-do">
            <button type="button" class="meter-go" id="refer-again">Put another forward</button>
            <button type="button" class="meter-quiet" id="refer-close">Done</button>
          </div>
        </div>
      </div>
    </div>

    <div class="media-back" id="media-back" hidden>
      <div class="media-modal">
        <div class="media-head">
          <strong>Media</strong>
          <span id="media-count"></span>
          <label class="media-upload">
            <input type="file" id="media-file" accept="image/*" multiple hidden />
            <span>Upload photos</span>
          </label>
          <button class="media-close" id="media-close" aria-label="Close">×</button>
        </div>
        <div class="media-grid" id="media-grid"></div>
        <p class="media-empty" id="media-empty">
          Nothing here yet. Upload photos from your phone or computer, or ask the agent to find some.
        </p>
      </div>
    </div>

    <!-- ══ 5. LIVE ══ -->
    <section class="screen screen-live" data-screen="live">
      <canvas id="confetti"></canvas>
      <div class="live-inner">
        <div class="live-badge">Yippeeeee</div>
        <h2 class="live-h">You have a website.</h2>
        <div class="scoreboard" id="scoreboard" hidden>
          <div class="sb-row">
            <span class="sb-label">Your old site</span>
            <span class="sb-num sb-was" id="sb-was">0</span>
          </div>
          <div class="sb-arrow">↓</div>
          <div class="sb-row sb-now-row">
            <span class="sb-label">This one</span>
            <span class="sb-num sb-now" id="sb-now">0</span>
          </div>
          <p class="sb-line" id="sb-line"></p>
        </div>
        <a class="live-url" id="live-url" href="#" target="_blank" rel="noopener">yoursite.garage.co.nz</a>
        <p class="live-sub">It's live right now. Chuck your email in and I'll send you the keys — edit it any time by chatting to the agent.</p>
        <form class="live-form" id="live-form">
          <input id="live-email" type="email" placeholder="you@example.co.nz" required />
          <button class="btn-primary" type="submit">Send me the keys</button>
        </form>
        <p class="live-note" id="live-note"></p>
        <button class="btn-ghost" id="back-to-build">← Keep tinkering</button>
      </div>
    </section>

    <style is:global>
      :root {
        --bg: #fafafa;
        --surface: #ffffff;
        --text: #0a0a0a;
        --text-soft: #404040;
        --text-muted: #737373;
        --border: #e5e5e5;
        --accent: #2563eb;
        --accent-soft: #dbeafe;
        --accent-deep: #1e40af;
        --good: #16a34a;
        --bad: #dc2626;
        --work: #eceff4;
        --work-2: #ffffff;
        --work-3: #dfe4ec;
        --work-ink: #10131a;
        --work-soft: #626b7d;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-display: 'Poppins', system-ui, -apple-system, sans-serif;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 24px;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body {
        height: 100%;
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }

      /* ── Screens ───────────────────────────────── */
      .screen {
        display: none;
        min-height: 100vh;
        min-height: 100dvh;
      }
      .screen.is-active { display: flex; flex-direction: column; }
      .screen.is-active > * { animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; }

      @keyframes rise {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: none; }
      }

      .screen-inner {
        margin: auto;
        width: 100%;
        max-width: 640px;
        padding: 2rem 1.5rem 5rem;
      }

      /* ── Header ────────────────────────────────── */
      .mini-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 1.4rem 2rem;
      }
      .mini-logo {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.03em;
        color: var(--text);
        text-decoration: none;
      }
      .dot-orange { color: #f97316; }
      .dot { color: var(--accent); }
      .mini-tag {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
      }

      /* ── Hero ──────────────────────────────────── */
      .screen-hero {
        background:
          radial-gradient(ellipse 70% 50% at 50% -10%, rgba(37, 99, 235, 0.10) 0%, transparent 55%),
          linear-gradient(180deg, #ffffff 0%, #f6f8fb 100%);
      }
      .hero-inner {
        margin: auto;
        text-align: center;
        padding: 2rem 1.5rem 8rem;
        max-width: 720px;
      }
      .eyebrow {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.2rem;
      }
      .hero-inner h1 {
        font-family: var(--font-display);
        font-size: clamp(3.5rem, 14vw, 7rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.045em;
        margin-bottom: 1.4rem;
      }
      .hero-sub {
        font-size: clamp(1.05rem, 2.4vw, 1.3rem);
        color: var(--text-soft);
        margin-bottom: 2.5rem;
      }
      .hero-foot {
        margin-top: 1.6rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      /* ── Buttons ───────────────────────────────── */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--text);
        color: #fff;
        border: none;
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 600;
        padding: 0.95rem 1.6rem;
        border-radius: 999px;
        cursor: pointer;
        transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s, background 0.18s, opacity 0.18s;
        box-shadow: 0 6px 20px rgba(0,0,0,0.14);
      }
      .btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(0,0,0,0.2); }
      .btn-primary:active:not(:disabled) { transform: translateY(0); }
      .btn-primary:disabled { opacity: 0.35; cursor: not-allowed; box-shadow: none; }
      .btn-primary svg { transition: transform 0.18s; }
      .btn-primary:hover:not(:disabled) svg { transform: translateX(3px); }

      .btn-xl { font-size: 1.15rem; padding: 1.15rem 2.2rem; background: var(--accent); box-shadow: 0 10px 34px rgba(37,99,235,0.35); }
      .btn-xl:hover { background: var(--accent-deep); box-shadow: 0 16px 44px rgba(37,99,235,0.42); }

      .btn-ghost {
        background: none;
        border: none;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-muted);
        padding: 0.95rem 0.5rem;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-color: var(--border);
      }
      .btn-ghost:hover { color: var(--text); }

      /* ── Question screens ──────────────────────── */
      .step-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 0.9rem;
      }
      .q {
        font-family: var(--font-display);
        font-size: clamp(2rem, 6vw, 2.9rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.035em;
        margin-bottom: 0.8rem;
      }
      .hint {
        color: var(--text-muted);
        font-size: 1.02rem;
        margin-bottom: 2rem;
        max-width: 34rem;
      }

      /* ── Domain field ──────────────────────────── */
      .domain-field {
        display: flex;
        align-items: center;
        background: var(--surface);
        border: 2px solid var(--border);
        border-radius: var(--radius-md);
        padding: 0.4rem 1.1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        overflow: hidden;
      }
      .domain-field:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
      .domain-field.is-good { border-color: var(--good); box-shadow: 0 0 0 4px rgba(22,163,74,0.12); }
      .domain-field.is-bad { border-color: var(--bad); box-shadow: 0 0 0 4px rgba(220,38,38,0.10); }

      #slug-input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        font-family: var(--font-display);
        font-size: clamp(1.2rem, 4vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        padding: 0.7rem 0;
        background: none;
        color: var(--text);
      }
      #slug-input::placeholder { color: #cbd5e1; }
      .domain-suffix {
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 3.4vw, 1.7rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--text-muted);
        white-space: nowrap;
      }

      .domain-status {
        min-height: 1.9rem;
        margin-top: 0.9rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-muted);
        display: flex;
        align-items: center;
