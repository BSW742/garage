          return;
        }

        if (s.style === 'bubbles') {
          const shots = [];
          (s.products || []).forEach((p, j) => {
            if (p && p.image) shots.push({ url: p.image, path: 'products.' + j + '.image' });
          });
          (s.images || []).forEach((u, j) => {
            if (u && shots.length < 12) shots.push({ url: u, path: 'images.' + j });
          });
          root.innerHTML =
            '<div class="pv-bb-head">' +
            (s.eyebrow ? '<p class="pv-bb-eyebrow" data-edit="eyebrow">' + esc(s.eyebrow) + '</p>' : '') +
            '<h1 class="pv-h1" data-edit="name">' + esc(s.name) + '</h1>' +
            (s.lede ? '<p class="pv-bb-lede" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
            (shots.length ? '<p class="pv-bb-hint" data-edit="cta">' +
              esc(s.cta || 'Burst one to see what it is') + '</p>' : '') +
            '</div>' +
            (shots.length
              ? '<div class="pv-bb-field">' + shots.map((sh) =>
                  '<div class="pv-bb-bub" data-photo="' + sh.path + '" style="background-image:url(' +
                  esc(sh.url) + ')"></div>').join('') + '</div>'
              : '<p class="pv-bb-note">Add some photographs — each one becomes a bubble, ' +
                'and what you write about it is what shows when somebody bursts it.</p>');
          $('canvas-empty').classList.toggle('gone', true);
          renderedKeys = new Set(['bubbles']);
          setPalette(root, s.palette);
          root.parentElement.classList.add('pv');
          root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-tribute', 'st-listing', 'st-diet', 'st-chain');
          root.parentElement.classList.add('st-bubbles');
          applyTone();
          restoreSelection();
          return;
        }

        if (s.style === 'chain') {
          const target = Math.max(1, Math.round(Number(s.target)) || 30);
          root.innerHTML =
            '<div class="pv-ch-head">' +
            (s.eyebrow ? '<p class="pv-ch-occ" data-edit="eyebrow">' + esc(s.eyebrow) + '</p>' : '') +
            '<h1 class="pv-h1" data-edit="name">' + esc(s.name) + '</h1>' +
            (s.lede ? '<p class="pv-ch-lede" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
            '</div>' +
            '<div class="pv-ch-lock">' +
            '<div class="pv-ch-count">0<small> of <span data-edit="target">' + target + '</span></small></div>' +
            '<div class="pv-ch-bar"><i></i></div>' +
            '<p class="pv-ch-seal">Every message stays sealed until it is full.</p>' +
            '</div>' +
            '<p class="pv-ch-note">Messages arrive from the page itself. Nothing to write here — ' +
            'send the link and watch the count.</p>';
          $('canvas-empty').classList.toggle('gone', true);
          renderedKeys = new Set(['chain']);
          setPalette(root, s.palette);
          root.parentElement.classList.add('pv');
          root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-tribute', 'st-listing', 'st-diet');
          root.parentElement.classList.add('st-chain');
          applyTone();
          restoreSelection();
          return;
        }

        if (s.style === 'diet') {
          const pair = String(s.cta || '').split('/');
          const good = esc((pair[0] || 'Good').trim() || 'Good');
          const bad = esc((pair[1] || 'Bad').trim() || 'Bad');
          const row = (when, mark, cls) =>
            '<div class="pv-dt-row"><div><span class="pv-dt-when">' + when + '</span>' +
            (mark ? '<br /><span class="pv-dt-mark ' + cls + '">' + mark + '</span>' : '') +
            '</div><div><div class="pv-dt-shot"></div></div></div>';
          root.innerHTML =
            '<div class="pv-dt-head">' +
            '<h1 class="pv-h1" data-edit="name">' + esc(s.name) + '</h1>' +
            (s.eyebrow ? '<span class="pv-dt-sub" data-edit="eyebrow">' + esc(s.eyebrow) + '</span>' : '') +
            '</div>' +
            (s.lede ? '<p class="pv-dt-lede" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
            '<div class="pv-dt-strip">' + Array(31).join('<i></i>') + '</div>' +
            '<div class="pv-dt-days">' +
            row('Today', good, 'g') + row('Yesterday', bad, 'b') + row('Mon', good, 'g') +
            '</div>' +
            '<p class="pv-dt-note">A row a day, newest first, filled in as things are posted. ' +
            'The two words on every day are <b data-edit="cta">' + esc(s.cta || 'Good / Bad') + '</b>.</p>';
          $('canvas-empty').classList.toggle('gone', true);
          renderedKeys = new Set(['diet']);
          setPalette(root, s.palette);
          root.parentElement.classList.add('pv');
          root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-tribute', 'st-listing', 'st-chain');
          root.parentElement.classList.add('st-diet');
          applyTone();
          restoreSelection();
          return;
        }

        // A tribute is not built out of sections, so the ordinary block loop
        // has nothing to walk. It gets its own two-part shape instead.
        if (s.style === 'montage') {
          const shots = (s.images || []).filter(Boolean);
          root.innerHTML =
            '<div class="pv-trib-head">' +
            '<h1 class="pv-h1" data-edit="name">' + esc(s.name) + '</h1>' +
            (s.lede ? '<p class="pv-trib-note" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
            '</div>' +
            (shots.length
              ? '<div class="pv-trib-wall">' + shots.map((u, i) =>
                  '<img src="' + esc(u) + '" alt="" data-photo="images.' + i + '" />').join('') + '</div>'
              : '<p class="pv-trib-empty">No pictures yet — add some and they fill the page.</p>');
          $('canvas-empty').classList.toggle('gone', true);
          renderedKeys = new Set(['montage']);
          setPalette(root, s.palette);
          root.parentElement.classList.add('pv');
          root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-diet', 'st-chain', 'st-bubbles', 'st-game', 'st-eggs', 'st-mogged', 'st-listing');
          root.parentElement.classList.add('st-tribute', 'st-montage');
          applyTone();
          restoreSelection();
          return;
        }

        if (s.style === 'tribute') {
          const shots = (s.images || []).filter(Boolean);
          root.innerHTML =
            '<div class="pv-trib-head">' +
            (s.heroImage ? '<div class="pv-trib-face" data-photo="heroImage" style="background-image:url(' + esc(s.heroImage) + ')"></div>' : '') +
            '<h1 class="pv-h1" data-edit="name">' + esc(s.name) + '</h1>' +
            (s.eyebrow ? '<p class="pv-trib-dates" data-edit="eyebrow">' + esc(s.eyebrow) + '</p>' : '') +
            (s.lede ? '<p class="pv-trib-note" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
            '</div>' +
            (shots.length
              ? '<div class="pv-trib-wall">' + shots.map((u, i) =>
                  '<img src="' + esc(u) + '" alt="" data-photo="images.' + i + '" />').join('') + '</div>'
              : '<p class="pv-trib-empty">No photographs yet — add some and they will fill the page.</p>');
          $('canvas-empty').classList.toggle('gone', true);
          renderedKeys = new Set(['tribute']);
          setPalette(root, s.palette);
          root.parentElement.classList.add('pv');
          root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-diet', 'st-chain');
          root.parentElement.classList.add('st-tribute');
          applyTone();
          restoreSelection();
          return;
        }

        const hasContent = !!(s.headline || s.sections.length);
        $('canvas-empty').classList.toggle('gone', hasContent);
        if (!hasContent) { root.innerHTML = ''; renderedKeys = new Set(); return; }

        // Mirrors navLinks() in site-render.ts so the nav here matches the
        // one that actually publishes.
        const NAV_LABELS = s.style === 'trade'
          ? { services: 'What we do', area: 'Areas', gallery: 'Recent jobs', credentials: 'Licences',
              about: 'About', pricing: 'Pricing', hours: 'Hours', faq: 'FAQ', contact: 'Contact' }
          : s.style === 'physio'
          ? { conditions: 'What we treat', services: 'Services', steps: 'How it works', acc: 'ACC',
              about: 'About', gallery: 'The clinic', pricing: 'Fees', hours: 'Hours',
              faq: 'Questions', contact: 'Find us' }
          : s.style === 'cafe'
          ? { menu: 'Menu', pricing: 'Menu', services: 'What we do', about: 'Our story',
              gallery: 'Gallery', hours: 'Hours', faq: 'Questions', contact: 'Find us' }
          : { services: 'Services', about: 'About', gallery: 'Gallery',
              hours: 'Hours', faq: 'FAQ', contact: 'Contact' };
        function navLinks(site) {
          const seen = {};
          const out = ['<span>Home</span>'];
          (site.sections || []).forEach((sec) => {
            const label = NAV_LABELS[sec.type];
            if (!label || seen[sec.type]) return;
            if (sec.type === 'contact') {
              const c = site.contact || {};
              if (!c.phone && !c.email && !c.address) return;
            }
            seen[sec.type] = true;
            out.push('<span>' + label + '</span>');
          });
          // Pages, same rule as site-render.ts: a link once there is a page.
          if ((site.team || []).length) out.push('<span>Team</span>');
          if ((site.cases || []).length) out.push('<span>Case studies</span>');
          return out.join('');
        }

        // Matches heroLogo in site-render.ts.
        function plainWords(v) { return String(v || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }

        const blocks = [];

        blocks.push({ key: 'nav', html:
          '<nav class="pv-nav"><div class="pv-brand">' +
          (s.logo ? '<img src="' + esc(s.logo) + '" alt="" data-photo="logo" />' : '<span class="pv-glyph">' + esc(initials(s.name)) + '</span><span data-edit="name">' + esc(s.name) + '</span>') +
          '</div><div class="pv-links">' + navLinks(s) + '</div>' +
          '<span class="pv-cta" data-edit="cta">' + esc(s.cta) + '</span></nav>' });

        blocks.push({ key: 'hero', html:
          '<header class="pv-hero' + (s.heroImage ? ' has-photo' : '') + '">' +
          (s.heroImage ? '<div class="pv-hero-photo" data-photo="heroImage" style="background-image:url(' + esc(s.heroImage) + ')"></div>' : '') +
          '<div class="pv-hero-inner">' +
          (s.eyebrow ? '<p class="pv-eyebrow" data-edit="eyebrow">' + esc(s.eyebrow) + '</p>' : '') +
          (plainWords(s.headline) === plainWords(s.name) && s.logo
            ? '<h1 class="pv-h1 pv-hero-logo"><img src="' + esc(s.logo) + '" alt="" data-photo="logo" /></h1>'
            : '<h1 class="pv-h1" data-edit="headline">' + esc(s.headline) + '</h1>') +
          (s.lede ? '<p class="pv-lede" data-edit="lede">' + esc(s.lede) + '</p>' : '') +
          '<span class="pv-btn" data-edit="cta">' + esc(s.cta) + '</span>' +
          (s.contact.phone ? '<span class="pv-btn pv-btn-2" data-edit="contact.phone">' + esc(s.contact.phone) + '</span>' : '<span class="pv-btn pv-btn-2">Learn more</span>') +
          '</div></header>' });

        s.sections.forEach((sec, i) => blocks.push({ key: sec.type, block: 'sec.' + i, html: blockHtml(sec, i) }));

        // These publish as their own pages, but they still have to be visible
        // here — a section you cannot see in the builder is one you rebuild by
        // hand or delete by accident.
        (s.team || []).length && blocks.push({ key: 'team', html:
          '<section class="pv-section pv-page"><p class="pv-pagetag">Its own page · /team</p>' +
          '<h2 class="pv-h2">Our team</h2><div class="pv-profiles">' +
          s.team.map((p, i) => '<div class="pv-profile' + (i % 2 ? ' flip' : '') + '">' +
            '<div class="pv-profile-media"' + (p.image ? ' style="background-image:url(' + esc(p.image) + ')"' : '') + '></div>' +
            '<div><strong>' + esc(p.name || '') + '</strong>' +
            (p.role ? '<span class="pv-profile-role">' + esc(p.role) + '</span>' : '') +
            (p.text ? '<p>' + esc(p.text) + '</p>' : '') + '</div></div>').join('') +
          '</div></section>' });

        (s.cases || []).length && blocks.push({ key: 'cases', html:
          '<section class="pv-section pv-page"><p class="pv-pagetag">Its own page · /case-studies</p>' +
          '<h2 class="pv-h2">Case studies</h2><div class="pv-profiles">' +
          s.cases.map((c, i) => '<div class="pv-profile' + (i % 2 ? ' flip' : '') + '">' +
            '<div class="pv-profile-media"' + (c.videoId ? ' style="background-image:url(https://i.ytimg.com/vi/' + esc(c.videoId) + '/hqdefault.jpg)"' : '') + '></div>' +
            '<div><strong>' + esc(c.title || '') + '</strong>' +
            (c.role ? '<span class="pv-profile-role">' + esc(c.role) + '</span>' : '') +
            (c.text ? '<p>' + esc(c.text) + '</p>' : '') + '</div></div>').join('') +
          '</div></section>' });

        const socialNames = Object.keys(s.socials || {});
        blocks.push({ key: 'foot', html:
          '<footer class="pv-foot"><span>© ' + new Date().getFullYear() + ' ' + esc(s.name) + '</span>' +
          (socialNames.length
            ? '<span class="pv-socials">' + socialNames.map((n) => '<span>' + esc(n[0].toUpperCase() + n.slice(1)) + '</span>').join('') + '</span>'
            : '') +
          '<span>' + esc(S.slug) + '.garage.co.nz</span></footer>' });

        const nextKeys = new Set(blocks.map((b) => b.key));
        const fresh = blocks.filter((b) => !renderedKeys.has(b.key) && b.key !== 'nav' && b.key !== 'hero' && b.key !== 'foot');
        root.innerHTML = blocks
          .map((b, i) => '<div data-i="' + i + '"' + (b.block ? ' data-block="' + b.block + '"' : '') +
            ' class="' + (renderedKeys.has(b.key) ? '' : 'pv-block') + '">' + b.html + '</div>')
          .join('');
        renderedKeys = nextKeys;

        // Ride the canvas down to whatever just landed
        if (fresh.length) {
          const idx = blocks.indexOf(fresh[fresh.length - 1]);
          const el = root.querySelector('[data-i="' + idx + '"]');
          if (el) setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 60);
        }

        setPalette(root, s.palette);
        root.parentElement.classList.add('pv');
        const st = S.site.style || 'modern';
        root.parentElement.classList.remove('st-modern', 'st-brutal', 'st-classic', 'st-cafe', 'st-physio', 'st-trade', 'st-tribute', 'st-listing', 'st-diet', 'st-chain', 'st-bubbles', 'st-game', 'st-eggs', 'st-mogged', 'st-montage', 'st-beauty', 'st-yoga', 'st-pilates', 'st-workshop', 'st-sauna', 'st-rugby', 'st-soccer', 'st-basketball', 'st-charity',
          'st-townhall', 'st-daycare', 'st-reel');
        root.parentElement.classList.add('st-' + st);
        applyTone();
        restoreSelection();
      }

      function snapshot() {
        S.history.push(JSON.stringify(S.site));
        if (S.history.length > 25) S.history.shift();
      }

      function hasSection(type) { return S.site.sections.some((s) => s.type === type); }
      function addSection(section, before) {
        if (hasSection(section.type)) {
          S.site.sections = S.site.sections.map((s) => (s.type === section.type ? section : s));
        } else if (before && hasSection(before)) {
          const i = S.site.sections.findIndex((s) => s.type === before);
          S.site.sections.splice(i, 0, section);
        } else {
          S.site.sections.push(section);
        }
      }
      function dropSection(type) {
        const before = S.site.sections.length;
        S.site.sections = S.site.sections.filter((s) => s.type !== type);
        renderedKeys.delete(type);
        return S.site.sections.length !== before;
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Entering the builder
      // ══════════════════════════════════════════════
      async function enterBuilder() {
        show('build');
        $('chrome-url').textContent = S.slug + '.garage.co.nz';
        render();
        await wait(450);
        if (S.fromVisibility) {
          const v = S.fromVisibility;
          await say('Right — ' + S.slug + '.garage.co.nz is yours, live from this second.');
          await say(
            v.beatName
              ? 'Let us go and take ' + v.beatName + "'s spot. Reading " + v.site + ' now.'
              : 'Reading ' + v.site + ' now and building from whatever is worth keeping.'
          );
          await importAssets();
          return;
        }

        await say('Right — ' + S.slug + '.garage.co.nz is yours. Blank page, live already.');

        if (S.sourceUrl) {
          await say('Shall I drag your assets across from ' + S.sourceUrl + '? Logo, colours, wording, photos — I only keep what still looks good.');
          chips([
            { label: 'Yes — drag it across', yes: true, send: 'pull the assets across' },
            { label: 'No, start clean', send: 'start fresh' },
          ]);
        } else {
          await say('What is the business or group called?');
          S.awaiting = 'name';
        }
        $('agent-text').focus();
      }

      // A blocked scrape is not one thing. A CAPTCHA, a JavaScript shell and a
      // 403 need different answers from them, and "it might be blocking robots"
      // is no use to anybody.
      function scrapeExcuse(detail, site) {
        const d = String(detail || '');
        if (/sgcaptcha/i.test(d)) {
          return 'Your old site sits behind a CAPTCHA from your web host, so I cannot read it — ' +
            'building this one fresh instead. Photos are the bit I actually need: put a few in ' +
            'and it will look like your business straight away.';
        }
        if (/captcha|challenge|cf-mitigated: challenge/i.test(d)) {
          return site + ' is behind a bot check we get stopped by. Faster to build it here — ' +
            'tell me what you do and drop your photos in.';
        }
        if (/empty page/i.test(d)) {
          return site + ' builds itself with JavaScript, so there is nothing in the page for me to read. ' +
            'We will do it here instead.';
        }
        const http = d.match(/HTTP (\d{3})/);
        if (http) return site + ' turned us away (' + http[1] + '). No drama, we will build it here.';
        return "Couldn't get in the front door of " + site + ' — plenty of sites block robots. ' +
          'No drama, we will build it here.';
      }

      // ── Pull everything from the old site ────────
      async function importAssets() {
        $('agent-state').textContent = 'online · reading ' + S.sourceUrl;
        await say('On it — reading ' + S.sourceUrl + ' now.', 500);

        const d = await S.scrapePromise;
        $('agent-state').textContent = 'online · building';

        if (!d) {
          // We could not fetch their material, so we have to ask for it. The
          // old path built a generic shell and never mentioned it, which is
          // how someone ends up staring at an empty page nobody explained.
          S.scrapeBlocked = true;
          await say(scrapeExcuse(S.scrapeError, S.sourceUrl));
          await say('What is the business called?');
          S.awaiting = 'name';
          return;
        }

        S.scraped = d;
        snapshot();

        if (d.blocked) {
          // We could not read the page, but we are not starting from nothing.
          S.scrapeBlocked = true;
          await say(scrapeExcuse(d.blockedReason, S.sourceUrl));
          if (d.logoUrl) await say('I did get your logo off it, mind you — and your colours with it.');
        }

        const s = S.site;
        const fromDomain = nameFromDomain(S.sourceUrl);
        const mine = guessIndustry(
          (d.title || '') + ' ' + (d.description || '') + ' ' + (d.services || []).join(' ') +
          ' ' + S.slug + ' ' + S.sourceUrl
        );
        const industry = mine !== 'default' ? mine : (d.industry && INDUSTRIES[d.industry] ? d.industry : 'default');
        const base = INDUSTRIES[industry];

        s.name = (d.title || fromDomain || titleCase(S.slug)).split(/[|–—-]/)[0].trim().slice(0, 40)
          || titleCase(S.slug);
        s.palette = paletteFrom(d.brandColour || base.colour);
        // A white mark on transparency vanishes on a pale page. Move the page to
        // the logo rather than throwing the logo away.
        if (d.logoNeedsDark) s.tone = 'dark';
        s.eyebrow = base.eyebrow;
        s.headline = headlineFrom(d.tagline || d.description || '', s.name);
        // Don't print the same sentence twice under itself
        const ledeSource = d.description && !echoes(d.description, s.headline) ? d.description : base.lede;
        s.lede = clip(ledeSource, 190);
        s.cta = base.cta;
        render();
        did(d.blocked
          ? 'Name and trade read off your web address'
          : 'Name and words lifted');
        await wait(450);

        if (d.brandColour) { did('Your brand colour, lifted off the old site'); await wait(420); }

        if (d.logoUrl) { s.logo = d.logoUrl; render(); did('Logo brought across'); await wait(450); }
        if (d.heroImage) { s.heroImage = d.heroImage; render(); did('Hero photo brought across'); await wait(450); }

        const services = (d.services || []).filter(Boolean).slice(0, 6);
        const items = services.length >= 2
          ? services.slice(0, 6).map((t) => [String(t).slice(0, 42), blurb(t)])
          : base.services;
        addSection({ type: 'services', label: base.eyebrow, title: services.length >= 2 ? 'What we do' : 'How we can help', items: items });
        render();
        did(services.length >= 2 ? 'Kept your ' + items.length + ' services' : 'Drafted a services section');
        await wait(500);

        if (d.aboutText && d.aboutText.length > 60) {
          addSection({ type: 'about', text: d.aboutText.slice(0, 320) });
          render();
          did('Your about copy, tidied');
          await wait(450);
        }

        const shots = (d.galleryImages || []).filter((u) => u && u !== d.heroImage).slice(0, 6);
        if (shots.length >= 2) {
          s.images = shots;
          addSection({ type: 'gallery', images: shots });
          render();
          did(shots.length + ' photos pulled through');
          await wait(450);
        }

        // Scrapers happily glue two phone numbers together — sanity-check the digits
        const phoneDigits = String(d.phone || '').replace(/\D/g, '');
        const goodPhone = phoneDigits.length >= 7 && phoneDigits.length <= 11 ? d.phone : '';
        const goodEmail = d.email && /^[\w.+-]+@[\w-]+\.[a-z]{2,}$/i.test(d.email) && !/\.(png|jpe?g|svg|gif|webp)$/i.test(d.email) ? d.email : '';
        const socials = d.socials && Object.keys(d.socials).length ? d.socials : null;
        if (socials) {
          s.socials = socials;
          render();
          did(Object.keys(socials).map((k) => k[0].toUpperCase() + k.slice(1)).join(' and ') + ' linked up');
          await wait(420);
        }

        if (d.hours && d.hours.length >= 2) {
          addSection({ type: 'hours', rows: d.hours.slice(0, 4) });
          render();
          did('Your actual opening hours');
          await wait(420);
        }

        if (goodPhone || goodEmail || d.address) {
          s.contact = { phone: goodPhone, email: goodEmail, address: (d.address || '').slice(0, 60) };
          addSection({ type: 'contact' });
          render();
          did('Phone, email and address wired up');
          await wait(450);
        }

        addSection({ type: 'band', title: 'Ready when you are', text: 'One call and we will sort it.' });
        render();
        await wait(400);

        await say("There you go — that's your site, live at " + S.slug + '.garage.co.nz. Anything you want changed, just say it.');

        const gallery = (s.sections.find((x) => x.type === 'gallery') || {}).images || [];
        if (S.scrapeBlocked || gallery.length < 3) {
          await say('It would look a good deal more like your business with a few of your own photos in it.');
          chips([{ label: 'Add my photos', yes: true, act: () => openMedia(null) }].concat(IDLE_CHIPS.slice(1)));
          return;
        }
        chips(IDLE_CHIPS);
      }

      // ── Blank start ──────────────────────────────
      function startFresh(name) {
        snapshot();
        const industry = guessIndustry(name + ' ' + S.slug);
        const base = INDUSTRIES[industry];
        const s = S.site;
        s.name = name;
        s.palette = paletteFrom(base.colour);
        s.eyebrow = base.eyebrow;
        s.headline = name;
        s.lede = base.lede;
        s.cta = base.cta;
        s.sections = [
          { type: 'services', label: base.eyebrow, title: 'How we can help', items: base.services },
          { type: 'band', title: 'Ready when you are', text: 'One call and we will sort it.' },
        ];
        render();
        return industry;
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  The agent's brain
      // ══════════════════════════════════════════════
      function quoted(text) {
        const m = text.match(/["'“”„]([^"'“”„]{2,})["'“”„]/);
        if (m) return m[1].trim();
        const m2 = text.match(/(?:say|says|read|reads|to|it|be|called|call it|is)\s+(.{3,})$/i);
        return m2 ? m2[1].replace(/[.!]$/, '').trim() : null;
      }

      function baseFor() {
        return INDUSTRIES[guessIndustry(S.site.name + ' ' + S.slug + ' ' + (S.scraped ? S.scraped.industry : ''))];
      }

      function wants(t, words) { return words.some((w) => t.includes(w)); }

      // Rewrites we can offer without inventing facts
      function rewriteFor(path, current) {
        const s = S.site;
        const base = baseFor();
        if (/headline$/.test(path)) {
          const options = [
            s.name + ' — ' + (base.eyebrow || 'local and independent').toLowerCase() + '.',
            (s.contact.phone ? 'One call and it is sorted.' : 'Sorted properly, first time.'),
            base.eyebrow + ' you can actually get hold of.',
          ];
          return options.find((o) => o !== current) || options[0];
        }
        if (/lede$|\.text$/.test(path)) {
          const options = [base.lede, 'Local, experienced, and easy to get hold of. Ring us and a person answers.',
            'Straight answers, fair prices, and the job finished when we said it would be.'];
          return options.find((o) => o !== current) || options[0];
        }
        if (/\.items\.\d+\.1$/.test(path)) {
          const name = getByPath(path.replace(/\.1$/, '.0'));
          const options = [blurb(name), name + ' sorted properly, priced before we start.',
            'Ask us about ' + String(name).toLowerCase() + ' — we do it most weeks.'];
          return options.find((o) => o !== current) || options[0];
        }
        if (/\.items\.\d+\.0$/.test(path)) return current;
        if (/cta$/.test(path)) return base.cta;
        if (/\.title$/.test(path)) return 'How we can help';
        return null;
      }

      async function handleSelected(text, t) {
        const sel = S.sel;
        const path = sel.path;

        // Remove
        if (wants(t, ['remove', 'delete', 'get rid', 'take it out', 'lose it'])) {
          snapshot();
          if (sel.kind === 'photo') {
            if (path === 'heroImage' || path === 'logo') { setByPath(path, null); }
            else {
              const m = /^sec\.(\d+)\.images\.(\d+)$/.exec(path);
              if (m) S.site.sections[Number(m[1])].images.splice(Number(m[2]), 1);
            }
            clearSelection(false); renderedKeys = new Set(); render();
            did('Photo removed'); await say('Gone.');
            return true;
          }
          if (sel.kind === 'block') {
            const item = /^sec\.(\d+)\.items\.(\d+)$/.exec(path);
            if (item) {
              S.site.sections[Number(item[1])].items.splice(Number(item[2]), 1);
              clearSelection(false); renderedKeys = new Set(); render();
              did('Service removed'); await say('Taken out.');
              return true;
            }
            const i = Number(path.split('.')[1]);
            const sec = S.site.sections[i];
            if (sec) {
              S.site.sections.splice(i, 1);
              clearSelection(false); renderedKeys = new Set(); render();
              did('Section removed'); await say('That section is gone. Say "undo" if you want it back.');
              return true;
            }
          }
          S.history.pop();
          await say('That bit is part of the page furniture — I can rewrite it, but not delete it.');
          return true;
        }

        // Swap a photo
        if (sel.kind === 'photo' && wants(t, ['swap', 'change', 'different', 'another', 'next', 'new photo'])) {
          const pool = (S.scraped && S.scraped.galleryImages ? S.scraped.galleryImages : []).concat(S.site.images || []);
          if (!pool.length) { await say("I have no other photos to hand — give me the URL of a site with your photos on it and I'll pull them in."); return true; }
          snapshot();
          const current = getByPath(path);
          const next = pool[(pool.indexOf(current) + 1) % pool.length];
          setByPath(path, next);
          render(); did('Photo swapped'); await say('Try that one. Say "swap" again to keep cycling.');
          return true;
        }

        // Colour, scoped to a band when one is selected
        const hex = t.match(/#([0-9a-f]{3}|[0-9a-f]{6})\b/);
        const word = Object.keys(COLOUR_WORDS).find((c) => new RegExp('\\b' + c + '\\b').test(t));
        if (hex || word) {
          const chosen = hex ? hex[0] : COLOUR_WORDS[word];
          paint(chosen, true);
          const scoped = sel.kind === 'block' && (S.site.sections[Number(path.split('.')[1]) ] || {}).type === 'band';
          did(scoped ? 'Band painted' : 'Colours updated');
          await say(scoped ? 'Just that band, ' + (word || chosen) + '.' : (word || chosen) + ' across the site.');
          return true;
        }

        // Rewrite the selected words
        if (sel.kind === 'text' && wants(t, ['rewrite', 'reword', 'better', 'punchier', 'shorter', 'try again', 'suggest'])) {
          const current = getByPath(path);
          const next = rewriteFor(path, current);
          if (!next) { await say("I'd only be guessing at that one — type over it and it's yours."); return true; }
          snapshot();
          setByPath(path, next);
          render(); did(sel.label + ' rewritten');
          await say('Try: “' + next + '”. Say rewrite again for another, or type over it yourself.');
          return true;
        }

        // New words for the selected bit
        if (sel.kind === 'text') {
          const value = quoted(text) || (/^(say|make it say|change it to|change to|set it to)\s+/i.test(text)
            ? text.replace(/^(say|make it say|change it to|change to|set it to)\s+/i, '').trim()
            : null);
          if (value) {
            snapshot();
            setByPath(path, value);
            render(); did(sel.label + ' updated');
            await say('Done — that now reads “' + value + '”.');
            return true;
          }
        }

        return false;  // let the normal brain have a go
      }

      async function handle(raw) {
        const text = raw.trim();
        bubble(text, 'msg-user');
        const t = text.toLowerCase();
        chipBox.innerHTML = '';
        await wait(180);

        // — something on the page is selected: act on that —
        if (S.sel && await handleSelected(text, t)) { chips(IDLE_CHIPS); return; }

        // — the agent asked for a different address —
        if (S.awaiting === 'slug') {
          const tidy = clean(text);
          if (tidy.length < 3) { await say('Three characters minimum — try another.'); return; }
          let free = false;
          try {
            const res = await fetch('/api/subdomain-check?slug=' + encodeURIComponent(tidy));
            const data = await res.json();
            free = !!data.available;
            if (!free && data.suggestions && data.suggestions.length) {
              await say('That one has gone too. ' + data.suggestions[0] + '.garage.co.nz is free if you want it.');
              return;
            }
          } catch (e) { free = true; }
          if (!free) { await say('Taken as well, sorry. Another?'); return; }
          S.awaiting = null;
          S.slug = tidy;
          S.token = null;
          $('chrome-url').textContent = S.slug + '.garage.co.nz';
          render();
          await say(S.slug + '.garage.co.nz it is. Publishing now.');
          await publish();
          return;
        }

        // — drawing a logo —
        if (S.awaiting === 'logoanimate') {
          S.awaiting = null;
          if (/animate|yes|yep|go on|do it/i.test(text)) { await animateLogo(); return; }
          chips(IDLE_CHIPS);
          return;
        }

        if (S.awaiting === 'logoverdict') {
          await logoVerdict(text);
          return;
        }

        if (S.awaiting === 'logostyle') {
          // "try find my one" is a request to look again, not a style.
          if (/find|look|search|mine|my one|existing|real/i.test(text)) {
            S.awaiting = null;
            S.scraped = null;
            if (await offerRealLogo()) return;
            await offerToDraw();
            return;
          }
          const styles = { cartoon: 'cartoon', simple: 'mark', badge: 'badge', letter: 'letter' };
          const pick = Object.keys(styles).find((k) => new RegExp(k, 'i').test(text));
          S.awaiting = null;
          // Whatever they typed goes straight through. The model understands
          // "watercolour" or "1970s" far better than our four buttons do.
          await askTradeThenDraw(pick ? styles[pick] : text.trim().slice(0, 60));
          return;
        }

        if (S.awaiting === 'logotrade') {
          S.awaiting = null;
          S.logoTrade = text.trim().slice(0, 60);
          await drawLogo(S.logoStyle || 'mark');
          return;
        }

        if (/\blogo\b/i.test(t)) {
          if (!S.site.name) { await say('Tell me the business name first and I will draw one.'); return; }
          // Most of these businesses already have a logo. Drawing a new one
          // before even looking for theirs is solving the wrong problem.
          if (await offerRealLogo()) return;
          await offerToDraw();
          return;
        }

        if (S.awaiting === 'realogo') {
          S.awaiting = null;
          if (/use it|yes|keep|yep|that/i.test(text)) {
            snapshot();
            // Keep our own copy — their old site is the one being replaced.
            let keep = S.foundLogo;
            try {
              const res = await fetch('/api/logo/adopt', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: S.foundLogo }),
              });
              const saved = await res.json();
              if (saved.url) keep = saved.url;
            } catch (e) { /* hotlink rather than lose it */ }
            S.site.logo = keep;
            render();
            did('Their own logo');
            await say('Good — that is the real one, which beats anything I could draw.');
            chips(IDLE_CHIPS);
            return;
          }
          await offerToDraw();
          return;
        }

        // — the agent asked for a name —
        if (S.awaiting === 'name') {
          S.awaiting = null;
          const given = text.replace(/^(it'?s|we'?re|called|the)\s+/i, '').trim().slice(0, 40);
          // A page that already has content is not waiting to be born. Answering
          // "what is it called?" over the top of it must fill the name back in,
          // never rebuild the site out from under everything already on it.
          const built = (S.site.sections || []).length || (S.site.images || []).length;
          if (built) {
            snapshot();
            S.site.name = given;
            if (!S.site.headline) S.site.headline = given;
            render();
            did('Business name updated');
            await say('Got it — ' + given + '. Publishing now.');
            return publish();
          }
          const industry = startFresh(given);
          await say("Nice one. I've put a starter page up — " + (industry === 'default' ? 'generic for now' : 'shaped for ' + industry) + ", your colours and words next.");
          if (S.scrapeBlocked) {
            await say("Since I couldn't get your photos off the old site, put a few in here and I'll build the page around them — they beat anything I can find.");
            chips([{ label: 'Add my photos', yes: true, act: () => openMedia(null) }].concat(IDLE_CHIPS.slice(1)));
            return;
          }
          await say('Tell me anything: colours, headline, sections, your phone number. Or hit publish whenever you like.');
          chips(IDLE_CHIPS);
          return;
        }

        // — pull assets across —
        if (wants(t, ['pull', 'drag', 'bring it', 'import', 'yes — drag']) && S.sourceUrl) { await importAssets(); return; }
        if (wants(t, ['start fresh', 'start clean', 'blank', 'from scratch'])) {
          await say('Clean slate it is. What is the business or group called?');
          S.awaiting = 'name';
          return;
        }

        // — publish —
        if (wants(t, ['publish', 'go live', 'ship it', 'launch', "that's it", 'done', 'finished', 'looks good'])) { await publish(); return; }

        // — undo —
        if (wants(t, ['undo', 'go back', 'revert'])) {
          const prev = S.history.pop();
          if (!prev) { await say('Nothing to undo yet.'); chips(IDLE_CHIPS); return; }
          S.site = adopt(JSON.parse(prev));
          renderedKeys = new Set();
          render();
          await say('Rolled that back.');
          chips(IDLE_CHIPS);
          return;
        }

        // — nothing on the page yet —
        if (!S.site.name) {
          await say("Before I change anything — what's the business or group called?");
          S.awaiting = 'name';
          return;
        }

        let acted = false;
        snapshot();

        // — colour —
        const hex = t.match(/#([0-9a-f]{3}|[0-9a-f]{6})\b/);
        const word = Object.keys(COLOUR_WORDS).find((c) => new RegExp('\\b' + c + '\\b').test(t));
        if (hex || (word && wants(t, ['colour', 'color', 'make it', 'go', 'brand', 'theme', 'palette', 'more', 'scheme']))) {
          const chosen = hex ? hex[0] : COLOUR_WORDS[word];
          S.site.palette = paletteFrom(chosen);
          render();
          did('Palette swapped to ' + (word || chosen));
          await say('Done — ' + (word || chosen) + ' through the whole site. Better?');
          acted = true;
        }

        // — headline / tagline / name —
        if (wants(t, ['headline', 'heading', 'title', 'h1'])) {
          const v = quoted(text);
          if (v) { S.site.headline = v; render(); did('Headline updated'); await say('Headline is now “' + v + '”.'); acted = true; }
          else { await say('Give it to me in quotes and I will drop it straight in — e.g. headline: “Blocked drain? We are 20 minutes away.”'); acted = true; }
        } else if (wants(t, ['tagline', 'subheading', 'strapline', 'sub-line', 'intro line', 'lede'])) {
          const v = quoted(text);
          if (v) { S.site.lede = v; render(); did('Tagline updated'); await say('That is in.'); acted = true; }
          else { await say('What should it say? Pop it in quotes.'); acted = true; }
        } else if (wants(t, ['rename', 'business name', 'company name', 'we are called', "we're called"])) {
          const v = quoted(text);
          if (v) { S.site.name = v; render(); did('Name updated'); await say('Renamed to ' + v + '.'); acted = true; }
        }

        // — contact details —
        const phone = text.match(/(\+?64[\d\s-]{7,}|0[2-9][\d\s-]{6,})/);
        if (phone) {
          S.site.contact.phone = phone[0].trim();
          if (!hasSection('contact')) addSection({ type: 'contact' }, 'band');
          render();
          did('Phone number added');
          await say('Phone is on the page and in the header.');
          acted = true;
        }
        const email = text.match(/[\w.+-]+@[\w-]+\.[\w.]+/);
        if (email) {
          S.site.contact.email = email[0];
          if (!hasSection('contact')) addSection({ type: 'contact' }, 'band');
          render();
          did('Email added');
          await say('Email is up there too.');
          acted = true;
        }

        // — remove a section —
        if (wants(t, ['remove', 'delete', 'get rid', 'lose the', 'take out', 'drop the'])) {
          const map = [['gallery', ['gallery', 'photo', 'picture', 'image']], ['services', ['service', 'what we do']],
                       ['contact', ['contact', 'phone', 'details']], ['about', ['about', 'story']],
                       ['hours', ['hours', 'opening']], ['testimonial', ['testimonial', 'review', 'quote']],
                       ['band', ['banner', 'call to action', 'cta', 'band']]];
          const hit = map.find((m) => m[1].some((w) => t.includes(w)));
          if (hit && dropSection(hit[0])) { render(); did('Removed the ' + hit[0] + ' section'); await say('Gone.'); acted = true; }
          else if (hit) { await say('There is no ' + hit[0] + ' section on there at the moment.'); acted = true; }
        }

        // — add sections —
        if (!acted || wants(t, ['add', 'put', 'include', 'need'])) {
          const base = baseFor();
          if (wants(t, ['service', 'what we do', 'offering']) && !wants(t, ['remove', 'delete'])) {
            const sc = S.scraped && S.scraped.services && S.scraped.services.length >= 2
              ? S.scraped.services.slice(0, 6).map((x) => [String(x).slice(0, 42), blurb(x)])
              : base.services;
            addSection({ type: 'services', label: base.eyebrow, title: 'How we can help', items: sc }, 'band');
            render(); did('Services section added');
            await say('Services are in — say the word if you want the wording changed.');
            acted = true;
          } else if (wants(t, ['gallery', 'photo', 'picture', 'image', 'portfolio', 'our work'])) {
            const shots = (S.site.images.length ? S.site.images : (S.scraped ? (S.scraped.galleryImages || []) : [])).slice(0, 6);
            addSection({ type: 'gallery', images: shots }, 'band');
            render(); did(shots.length ? 'Gallery added with ' + shots.length + ' photos' : 'Gallery added — placeholders for now');
            await say(shots.length ? 'Gallery is in with the photos I found.' : 'Gallery is in with placeholders — email me your photos and I will drop them in.');
            acted = true;
          } else if (wants(t, ['contact', 'phone', 'email', 'address', 'find us', 'get in touch'])) {
            addSection({ type: 'contact' }, 'band');
            render(); did('Contact section added');
            await say(S.site.contact.phone || S.site.contact.email ? 'Contact section is on.' : 'Contact section is on — give me a number or an email and I will fill it in.');
            acted = true;
          } else if (wants(t, ['about', 'story', 'who we are', 'history'])) {
            const txt = (S.scraped && S.scraped.aboutText) ? S.scraped.aboutText.slice(0, 320)
              : S.site.name + ' has been looking after this patch for years. Small team, local, and we answer the phone.';
            addSection({ type: 'about', text: txt }, 'band');
            render(); did('About section added');
            await say('About section is in. Want different words? Send them over in quotes.');
            acted = true;
          } else if (wants(t, ['hours', 'opening', 'open time', 'when are you open'])) {
            addSection({ type: 'hours', rows: [['Monday – Friday', '7.30am – 5pm'], ['Saturday', '8am – 12pm'], ['Sunday', 'Closed'], ['Emergencies', 'Any time']] }, 'band');
            render(); did('Opening hours added');
            await say('Hours are up — tell me the real ones and I will correct them.');
            acted = true;
          } else if (wants(t, ['testimonial', 'review', 'what people say'])) {
            addSection({ type: 'testimonial', quote: 'Turned up when they said they would, fixed it properly, charged what they quoted.', who: 'A very relieved local' }, 'band');
            render(); did('Testimonial added');
            await say('Popped a placeholder review in — send me a real one and it goes straight up.');
            acted = true;
          }
        }

        // — design style —
        if (!acted) {
          const style = wants(t, ['brutal', 'bold', 'loud', 'punchy', 'shouty', 'blocky'])
            ? 'brutal'
            : wants(t, ['classic', 'serif', 'traditional', 'elegant', 'posh', 'smart', 'formal'])
              ? 'classic'
              : wants(t, ['modern', 'clean', 'minimal', 'simple', 'current'])
                ? 'modern'
                : null;
          if (style) {
            if (setStyle(style)) {
              await say(STYLE_NOTES[style] + ' Have a look — say "modern", "brutal", "classic", "cafe", "physio", "trade", "tribute", "listing", "diary", "chain", "bubbles", "game", "producer", "agency", "montage", "beauty", "yoga", "pilates", "workshop", "sauna", "rugby", "soccer", "basketball", "charity", "town hall", "daycare" or "reel" to flip between them.');
            } else {
              await say("It's already in that style. Try one of the other two.");
            }
            acted = true;
          }
        }

        // — hero photo —
        if (!acted && wants(t, ['hero', 'big photo', 'background image', 'header image'])) {
          const pool = (S.scraped && S.scraped.galleryImages) ? S.scraped.galleryImages : [];
          if (wants(t, ['remove', 'no ', 'without'])) { S.site.heroImage = null; render(); did('Hero photo removed'); await say('Back to clean colour.'); }
          else if (pool.length) {
            const i = pool.indexOf(S.site.heroImage);
            S.site.heroImage = pool[(i + 1) % pool.length];
            render(); did('Hero photo swapped');
            await say('Try that one.');
          } else { await say("I don't have any photos yet — give me the URL of your old site or Facebook page and I'll grab them."); }
          acted = true;
        }

        if (!acted) {
          S.history.pop();
          await say("I can do colours, headlines, sections (services, gallery, about, hours, contact, reviews), your phone and email — or publish it. What's it to be?");
        }
        chips(IDLE_CHIPS);
      }
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Direct manipulation: pick a thing, change it
      // ══════════════════════════════════════════════
      function resolvePath(path) {
        const t = String(path).split('.');
        let obj, keys;
        if (t[0] === 'sec') { obj = S.site.sections[Number(t[1])]; keys = t.slice(2); }
        else { obj = S.site; keys = t; }
        if (!obj) return null;
        for (let i = 0; i < keys.length - 1; i++) { obj = obj[keys[i]]; if (!obj) return null; }
        return { obj: obj, key: keys[keys.length - 1] };
      }
      function getByPath(path) { const r = resolvePath(path); return r ? r.obj[r.key] : undefined; }
      function setByPath(path, value) { const r = resolvePath(path); if (r) r.obj[r.key] = value; }

      const LABELS = [
        // Ahead of the generic rules below — products.0.text would otherwise
        // match /\.text$/ and come back as "Body text".
        [/^products\.\d+$/, 'Shop item'],
        [/^products\.\d+\.name$/, 'Item name'],
        [/^products\.\d+\.price$/, 'Price'],
        [/^products\.\d+\.text$/, 'Item description'],
        [/^products\.\d+\.image$/, 'Item photo'],
        [/^name$/, 'Business name'], [/^headline$/, 'Headline'], [/^lede$/, 'Intro line'],
        [/^eyebrow$/, 'Eyebrow line'], [/^cta$/, 'Button text'], [/^logo$/, 'Logo'],
        [/^heroImage$/, 'Hero photo'], [/^contact\.phone$/, 'Phone number'],
        [/^contact\.email$/, 'Email'], [/^contact\.address$/, 'Address'],
        [/\.items\.\d+\.0$/, 'Service name'], [/\.items\.\d+\.1$/, 'Service description'],
        [/\.rows\.\d+\.0$/, 'Day'], [/\.rows\.\d+\.1$/, 'Opening hours'],
        [/\.images\.\d+$/, 'Photo'], [/\.label$/, 'Section label'], [/\.title$/, 'Section heading'],
        [/\.text$/, 'Body text'], [/\.quote$/, 'Quote'], [/\.who$/, 'Attribution'],
        [/\.items\.\d+$/, 'Service card'],
      ];
      const SECTION_NAMES = {
        services: 'Services section', about: 'About section', gallery: 'Photo gallery',
        hours: 'Opening hours', testimonial: 'Review', contact: 'Contact section',
        band: 'Call-to-action band', shop: 'Shop', menu: 'Menu', faq: 'FAQ',
        pricing: 'Pricing', video: 'Video', specs: 'Details', included: "What's included",
        honest: 'Known faults', area: 'Areas covered', credentials: 'Licences',
        conditions: 'What we treat', steps: 'How it works', acc: 'ACC',
      };
      /**
       * The free-use meter. A site gets a million tokens before we ask for
       * anything, and every hundred thousand is worth saying out loud: it
       * shows the allowance is real and being spent, without a running counter
       * nagging in the corner the whole time.
       *
       * The milestone is remembered per site, so reloading the page does not
       * replay a modal somebody has already dismissed.
       */
      const FREE_TOKENS = 1000000;
      const METER_STEP = 100000;

      function meterKey() { return 'garage-meter:' + (S.slug || 'draft'); }

      function meterSeen() {
        try { return Number(localStorage.getItem(meterKey()) || 0); } catch (e) { return 0; }
      }
      function meterRemember(step) {
        try { localStorage.setItem(meterKey(), String(step)); } catch (e) {}
      }

      // "340,000" reads better than 340000 in a sentence about generosity.
      function commas(n) { return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

      // Tokens mean nothing to somebody building a cafe website, so say it in
      // the thing they have actually been doing.
      function inChanges(tokens) {
        const each = 25000;              // measured: about one message to the agent
        return Math.max(1, Math.round(tokens / each));
      }

      function showMeter(used, free) {
        const full = used >= free;
        const back = $('meter-back');
        const pct = Math.min(100, Math.round((used / free) * 100));

        back.classList.toggle('full', full);
        $('meter-eyebrow').textContent = full ? 'That is the free million' : 'Free while you build';
        $('meter-title').textContent = full
          ? 'You have used it all'
          : commas(used) + ' tokens in';
        $('meter-count').innerHTML = commas(used) + ' <span>of ' + commas(free) + '</span>';
        const earned = (S.usage && S.usage.earned) || 0;
        const pending = (S.usage && S.usage.pending) || 0;
        const waiting = pending
          ? ' ' + pending + (pending === 1 ? ' business you put forward has' : ' businesses you put forward have') +
            ' not taken their page yet.'
          : '';

        $('meter-say').textContent = full
          ? 'Your site stays live and everything on it is yours — nothing switches off. ' +
            'To keep building, put a business you use forward: 250,000 tokens when they take their page.' + waiting
          : 'That is roughly ' + inChanges(used) + ' changes so far. ' +
            commas(free - used) + ' left' +
            (earned ? ', including ' + commas(earned) + ' you have earned.' : ', which is plenty.') +
            waiting;
        $('meter-go').textContent = full ? 'Not now' : 'Keep going';
        $('meter-ask').textContent = full ? 'Put a business forward' : 'Earn more';

        back.hidden = false;
        // Let the bar animate from empty rather than appearing already full.
        $('meter-fill').style.width = '0%';
        requestAnimationFrame(() => { $('meter-fill').style.width = pct + '%'; });
      }

      function checkMeter(usage) {
        if (!usage || !usage.free) return;
        S.usage = usage;
        const step = Math.floor(usage.used / METER_STEP);
        if (step < 1 || step <= meterSeen()) return;
        meterRemember(step);
        showMeter(usage.used, usage.free);
      }

      /**
       * Quietly mark the site as theirs. Idempotent server-side, so calling it
       * on every owner visit and again on publish costs nothing.
       */
      function claimSite() {
        if (!S.slug || !S.token) return;
        fetch('/api/site/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: S.slug, key: S.token }),
        }).catch(() => {});
      }

      // ── Putting a business forward ──────────────────────────────────────
      function openRefer() {
        $('meter-back').hidden = true;
        if (!S.slug || !S.token) {
          say('Publish this one first — then you can put other businesses forward from it.');
          return;
        }
        $('refer-form').classList.remove('meter-hide');
        $('refer-done').classList.add('meter-hide');
        $('refer-msg').textContent = '';
        $('refer-name').value = '';
        $('refer-email').value = '';
        $('refer-send').disabled = true;
        $('refer-back').hidden = false;
        setTimeout(() => $('refer-name').focus(), 60);
      }

      function referReady() {
        const name = $('refer-name').value.trim();
        const email = $('refer-email').value.trim();
        $('refer-send').disabled = !(name && /^[^@\s]+@[^@\s.]+\.[^@\s]+$/.test(email));
      }

      async function sendRefer() {
        const btn = $('refer-send');
        if (btn.disabled) return;
        btn.disabled = true;
        $('refer-msg').textContent = 'Sending…';
        try {
          const res = await fetch('/api/refer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              slug: S.slug,
              key: S.token,
              name: $('refer-name').value,
              email: $('refer-email').value,
            }),
          });
          const data = await res.json();
          if (!data || !data.ok) {
            $('refer-msg').textContent = (data && data.error) || 'That did not send, sorry.';
            btn.disabled = false;
            return;
          }
          $('refer-form').classList.add('meter-hide');
          $('refer-done').classList.remove('meter-hide');
          $('refer-done-title').textContent = 'Sent to ' + data.name;
          $('refer-done-say').textContent =
            commas(data.reward) + ' tokens land the moment they take their page. ' +
            'Nothing to chase — we will tell you when it happens.';
          did('Put ' + data.name + ' forward');
        } catch (e) {
          $('refer-msg').textContent = 'That did not send, sorry.';
          btn.disabled = false;
        }
      }

      /**
       * The builder only ever loaded nine families, so any template using its
       * own face previewed in a fallback — Anton became Impact, Press Start 2P
       * became monospace. Fetched on demand rather than all at once, because
       * most sessions never touch most of them.
       */
      const STYLE_FONTS = {
        diet: 'Anton',
        chain: 'Newsreader:ital,wght@0,300;0,400;0,500;1,300',
        bubbles: 'Syne:wght@400;600;800',
        game: 'Press+Start+2P',
        eggs: 'Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800',
        mogged: 'Plus+Jakarta+Sans:ital,wght@0,500;0,700;0,800;1,800',
      };
      const fontsIn = new Set();
      function loadFont(style) {
        const family = STYLE_FONTS[style];
        if (!family || fontsIn.has(style)) return;
        fontsIn.add(style);
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://fonts.googleapis.com/css2?family=' + family + '&display=swap';
        document.head.appendChild(link);
      }

      function labelFor(path) {
        const m = /^sec\.(\d+)$/.exec(path);
        if (m) {
          const sec = S.site.sections[Number(m[1])];
          return sec ? (SECTION_NAMES[sec.type] || 'Section') : 'Section';
        }
        const hit = LABELS.find((l) => l[0].test(path));
        return hit ? hit[1] : 'This bit';
      }

      const canvas = () => $('canvas');
      let pickBar = null;
      let taughtPicking = false;

      function ensureBar() {
        if (pickBar) return pickBar;
        pickBar = document.createElement('div');
        pickBar.className = 'pick-bar';
        canvas().appendChild(pickBar);
        return pickBar;
      }

      function clearSelection(commitFirst) {
        hideDeleteBadge();
        const el = canvas().querySelector('.is-sel');
        if (el) {
          if (commitFirst !== false && el.isContentEditable) commitText(el);
          el.classList.remove('is-sel');
          el.removeAttribute('contenteditable');
        }
        S.sel = null;
        S.editing = false;
        if (pickBar) pickBar.classList.remove('on');
        $('agent-target').hidden = true;
        $('agent-text').placeholder = 'Tell me what to change…';
        if (S.renderQueued) { S.renderQueued = false; render(); }
      }

      function commitText(el) {
        const path = el.getAttribute('data-edit');
        if (!path) return;
        const value = (el.textContent || '').replace(/\s+/g, ' ').trim();
        const before = getByPath(path);
        S.editing = false;
        if (value === before) return;
        if (!value) { el.textContent = before; return; }  // refuse to leave it empty
        snapshot();
        setByPath(path, value);
        // Confirming a change that did not happen is worse than no message at
        // all — it sends people off to publish something that was never edited.
        if (getByPath(path) !== value) {
          el.textContent = before;
          did('Could not change ' + labelFor(path).toLowerCase(), true);
          return;
        }
        did(labelFor(path) + ' updated');
        S.renderQueued = true;
      }

      function positionBar(el) {
        const bar = ensureBar();
        const c = canvas();
        const r = el.getBoundingClientRect();
        const cr = c.getBoundingClientRect();
        bar.classList.add('on');
        const top = r.top - cr.top + c.scrollTop - bar.offsetHeight - 8;
        bar.style.top = Math.max(6, top) + 'px';
        bar.style.left = Math.max(6, Math.min(r.left - cr.left, c.clientWidth - bar.offsetWidth - 10)) + 'px';
      }

      function buildBar(kind, path) {
        const bar = ensureBar();
        const buttons = [];
        if (kind === 'text') buttons.push(['Rewrite it', () => route('rewrite this')]);
        if (kind === 'photo') {
          buttons.push(['Swap photo', () => openMedia({ path: path })]);
          buttons.push(['Remove', () => deleteSelected(), true]);
        }
        if (kind === 'block') {
          buttons.push(['Move up', () => moveSection(path, -1)]);
          buttons.push(['Move down', () => moveSection(path, 1)]);
          buttons.push(['Remove', () => deleteSelected(), true]);
        }
        bar.innerHTML = '<span class="name">' + esc(labelFor(path)) + '</span>';
        buttons.forEach((b) => {
          const el = document.createElement('button');
          el.textContent = b[0];
          if (b[2]) el.className = 'warn';
          el.addEventListener('mousedown', (e) => e.preventDefault());
          el.addEventListener('click', b[1]);
          bar.appendChild(el);
        });
        const close = document.createElement('button');
        close.textContent = 'Done';
        close.title = 'Stop editing this';
        close.addEventListener('click', () => clearSelection());
        bar.appendChild(close);
        return bar;
      }

      async function select(el, kind, path) {
        clearSelection();
        S.sel = { kind: kind, path: path, label: labelFor(path) };
        el.classList.add('is-sel');

        const c = canvas();
        const r = el.getBoundingClientRect();
        const cr = c.getBoundingClientRect();
        if (r.top < cr.top + 60 || r.bottom > cr.bottom - 20) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          await wait(320);
        }

        buildBar(kind, path);
        positionBar(el);
        placeDeleteBadge(el);

        $('target-label').textContent = S.sel.label;
        $('agent-target').hidden = false;
        $('agent-text').placeholder = 'Change the ' + S.sel.label.toLowerCase() + '…';

        if (kind === 'text') {
          el.setAttribute('contenteditable', 'true');
          el.focus();
          S.editing = true;
        }

        if (!taughtPicking) {
          taughtPicking = true;
          await say(kind === 'text'
            ? 'Type straight over it to fix the words — or tell me what you want and I will do it.'
            : 'Got it. Tell me what to change about that, or use the buttons.');
        }
      }

      function restoreSelection() {
        if (!S.sel) return;
        const sel = S.sel;
        const el = canvas().querySelector('[data-' + (sel.kind === 'photo' ? 'photo' : sel.kind === 'block' ? 'block' : 'edit') + '="' + sel.path + '"]');
        if (!el) { clearSelection(false); return; }
        el.classList.add('is-sel');
        positionBar(el);
      }

      /**
       * Every block path names a slot in some list: "sec.2" is a section,
       * "sec.2.items.0" a card inside one, "sec.1.menu.0.items.3" a dish, and
       * "products.4" a thing in the shop. Resolve them all the same way — the
       * last number is the index, everything before it is the list — because
       * the alternative is what was here before, which read the number after
       * "sec." no matter what the rest of the path said and deleted a whole
       * section when somebody removed one card from it.
       */
      /**
       * Add an empty one and put the cursor in its name with the placeholder
       * already selected, so adding an item is: click, type, click, type.
       */
      function addTo(what) {
        if (what !== 'products') return;
        snapshot();
        if (!Array.isArray(S.site.products)) S.site.products = [];
        S.site.products.push({ name: 'New item', price: '' });
        const j = S.site.products.length - 1;
        renderedKeys = new Set();
        render();
        did('Added an item');
        const el = canvas().querySelector('[data-edit="products.' + j + '.name"]');
        if (!el) return;
        select(el, 'text', 'products.' + j + '.name');
        try {
          const range = document.createRange();
          range.selectNodeContents(el);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
        } catch (e) { /* the field is still there to type in */ }
      }

      /**
       * "We work alongside". The slot always shows in the editor, even when
       * the section is empty — the gap is the whole nudge. The public page
       * only renders it once there is somebody in it.
       */
      let alongTarget = null;

      function openAlong(path) {
        alongTarget = path;
        $('along-name').value = '';
        $('along-contact').value = '';
        $('along-msg').textContent = '';
        $('along-save').disabled = true;
        $('along-back').hidden = false;
        setTimeout(() => $('along-name').focus(), 60);
      }

      function alongReady() {
        $('along-save').disabled = !$('along-name').value.trim();
      }

      function saveAlong() {
        const name = $('along-name').value.trim().slice(0, 60);
        if (!name) return;
        const spot = String(alongTarget || '').split('.');
        const sec = S.site.sections[Number(spot[1])];
        if (!sec) return;
        snapshot();
        if (!Array.isArray(sec.partners)) sec.partners = [];
        sec.partners.push({ name: name, contact: $('along-contact').value.trim().slice(0, 120) });
        renderedKeys = new Set();
        render();
        $('along-back').hidden = true;
        // Future tense on purpose: nothing is sent until they publish.
        did('Added ' + name);
        say('Added. When you publish, we will make ' + name +
            ' a page and let them know you put them there.');
      }

      /**
       * Every site gets the slot whether or not the agent thought to add one.
       * Kept out of the config until somebody uses it, so an untouched site
       * never publishes an empty section.
       */
      function ensureAlongSlot() {
        const list = S.site.sections || (S.site.sections = []);
        if (list.some((x) => x && x.type === 'alongside')) return;
        list.push({ type: 'alongside', label: 'Who we work with', title: 'We work alongside', partners: [] });
      }

      /**
       * On publish, and only on publish: make a page for everybody they named
       * and tell them about it. Typing a name into a site that never goes up
       * must not put an email in somebody's inbox.
       */
      async function sendAlongside() {
        if (!S.slug || !S.token) return;
        const waiting = [];
        (S.site.sections || []).forEach((sec) => {
          if (sec && sec.type === 'alongside') {
            (sec.partners || []).forEach((p) => { if (p && p.name && !p.slug) waiting.push(p); });
          }
        });
        if (!waiting.length) return;
        try {
          const res = await fetch('/api/alongside', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: S.slug, key: S.token, partners: waiting }),
          });
          const data = await res.json();
          if (!data || !data.ok) return;
          // Fold the new addresses back in so the links work straight away.
          (S.site.sections || []).forEach((sec) => {
            if (!sec || sec.type !== 'alongside') return;
            sec.partners = (sec.partners || []).map((p) => {
              const found = data.partners.find((o) => o.name === p.name);
              return found && found.slug ? { ...p, slug: found.slug, sent: !!found.sent } : p;
            });
          });
          const told = data.partners.filter((p) => p.sent && p.slug).length;
          if (told) {
            say(told === 1
              ? 'Told them they are on your page.'
              : 'Told all ' + told + ' of them they are on your page.');
          }
        } catch (e) { /* their site is up; this can wait for the next publish */ }
      }

      function blockAt(path) {
        const parts = String(path).split('.');
        const index = Number(parts[parts.length - 1]);
        if (!Number.isInteger(index) || index < 0) return null;

        let list;
        if (parts.length === 2) {
          list = parts[0] === 'sec' ? S.site.sections : S.site[parts[0]];
        } else if (parts[0] === 'sec') {
          let obj = (S.site.sections || [])[Number(parts[1])];
          for (let i = 2; i < parts.length - 1 && obj; i++) obj = obj[parts[i]];
          list = obj;
        }
        if (!Array.isArray(list) || index >= list.length) return null;
        return { list: list, index: index };
      }

      // What to call the thing that just went, so the confirmation says
      // something the person recognises rather than "block".
      function blockName(path, gone) {
        if (/^sec\.\d+$/.test(path)) {
          return (SECTION_NAMES[gone && gone.type] || 'section').toLowerCase();
        }
        if (Array.isArray(gone) && gone[0]) return '\u201c' + gone[0] + '\u201d';
        if (gone && gone.name) return '\u201c' + gone.name + '\u201d';
        if (gone && gone.heading) return '\u201c' + gone.heading + '\u201d';
        return labelFor(path).toLowerCase();
      }

      /**
       * Delete whatever is selected. Local and instant — asking the agent to
       * remove something means a round trip and a bill for a decision the
       * click already made. snapshot() first, so undo puts it straight back.
       */
      function deleteSelected(target) {
        const sel = target || S.sel;
        if (!sel) return;
        snapshot();
        // Drop the selection without committing first. The element still holds
        // the old text in the DOM, so a commit here would write the very thing
        // we are deleting straight back into the model.
        clearSelection(false);

        if (sel.kind === 'block') {
          const spot = blockAt(sel.path);
          if (!spot) { did('Could not remove that', true); return; }
          const was = spot.list.length;
          const [gone] = spot.list.splice(spot.index, 1);
          renderedKeys = new Set();
          render();
          if (spot.list.length === was) { did('Could not remove that', true); return; }
          did('Removed ' + blockName(sel.path, gone));
          return;
        }

        if (sel.kind === 'photo') {
          const was = getByPath(sel.path);
          setAtPath(sel.path, null);
          renderedKeys = new Set();
          render();
          if (getByPath(sel.path) === was && was) { did('Could not remove that photo', true); return; }
          did('Removed a photo');
          return;
        }

        setAtPath(sel.path, '');
        renderedKeys = new Set();
        render();
        if (getByPath(sel.path)) { did('Could not remove the ' + sel.label.toLowerCase(), true); return; }
        did('Removed the ' + sel.label.toLowerCase());
      }

      // Walks a path like "sec.2.items.0.1" or "contact.phone" and sets it.
      function setAtPath(path, value) {
        const parts = String(path).split('.');
        let target = S.site;
        if (parts[0] === 'sec') {
          target = S.site.sections[Number(parts[1])];
          parts.splice(0, 2);
        }
        if (!target) return;
        while (parts.length > 1) {
          const step = parts.shift();
          target = target[step];
          if (!target) return;
        }
        const last = parts[0];
        if (Array.isArray(target) && /^\d+$/.test(last)) {
          if (value === null || value === '') target.splice(Number(last), 1);
          else target[Number(last)] = value;
        } else {
          target[last] = value === null ? null : value;
        }
      }

      /**
       * A cross on the top-right of whatever is selected. The toolbar already
       * carries Remove, but the eye goes to the thing being edited, not to a
       * bar floating above it — so put the destructive control where the
       * attention already is, and make it look destructive.
       */
      let badgeTarget = null;

      function placeDeleteBadge(el, target) {
        badgeTarget = target || S.sel;
        let badge = document.getElementById('del-badge');
        if (!badge) {
          badge = document.createElement('button');
          badge.id = 'del-badge';
          badge.type = 'button';
          badge.innerHTML = '&#10005;';
          badge.title = 'Delete this';
          badge.setAttribute('aria-label', 'Delete this');
          badge.addEventListener('mousedown', (e) => e.preventDefault());
          badge.addEventListener('click', (e) => {
            e.stopPropagation();
            deleteSelected(badgeTarget);
          });
          canvas().appendChild(badge);
        }
        // Same frame of reference as positionBar, so it tracks the canvas
        // scrolling rather than drifting off the element.
        const c = canvas();
        const r = el.getBoundingClientRect();
        const cr = c.getBoundingClientRect();
        badge.style.top = (r.top - cr.top + c.scrollTop + 6) + 'px';
        badge.style.left = Math.min(r.right - cr.left - 28, c.clientWidth - 34) + 'px';
        badge.hidden = false;
      }

      function hideDeleteBadge() {
        const badge = document.getElementById('del-badge');
        if (badge) badge.hidden = true;
      }

      function moveSection(path, delta) {
        const spot = blockAt(path);
        if (!spot) return;
        const j = spot.index + delta;
        if (j < 0 || j >= spot.list.length) return;
        snapshot();
        const [moved] = spot.list.splice(spot.index, 1);
        spot.list.splice(j, 0, moved);
        // Follow it, so a second click moves the same thing again instead of
        // whatever has just slid into its place.
        const parts = String(path).split('.');
        parts[parts.length - 1] = String(j);
        const now = parts.join('.');
        S.sel = { kind: 'block', path: now, label: labelFor(now) };
        renderedKeys = new Set();
        render();
        did('Moved ' + blockName(path, moved));
      }

      // A section is nearly impossible to click — every click inside one lands
      // on the text or photo it contains. So offer the cross on hover instead.
      document.addEventListener('mouseover', (e) => {
        const c = canvas();
        if (!c || !c.contains(e.target) || !c.classList.contains('pickable')) return;
        if (S.sel) return;
        const badge = document.getElementById('del-badge');
        if (badge && badge.contains(e.target)) return;
        const block = e.target.closest('[data-block]');
        if (!block) return;
        placeDeleteBadge(block, {
          kind: 'block',
          path: block.getAttribute('data-block'),
          label: labelFor(block.getAttribute('data-block')),
        });
      });

      document.addEventListener('mouseout', (e) => {
        const c = canvas();
        if (!c || S.sel) return;
        const to = e.relatedTarget;
        if (to && (c.contains(to) || (document.getElementById('del-badge') || {}).contains?.(to))) return;
        hideDeleteBadge();
      });

      // Clicks on the canvas pick things
      document.addEventListener('click', (e) => {
        const c = canvas();
        if (!c || !c.contains(e.target)) return;
        if (pickBar && pickBar.contains(e.target)) return;

        // "+ Add item" sits inside the canvas, so it has to be caught before
        // the click turns into a selection.
        const add = e.target.closest('[data-add]');
        if (add) {
          const what = add.getAttribute('data-add');
          if (/\.partners$/.test(what)) openAlong(what);
          else addTo(what);
          return;
        }

        const text = e.target.closest('[data-edit]');
        const photo = e.target.closest('[data-photo]');
        const block = e.target.closest('[data-block]');

        if (text) { if (!text.classList.contains('is-sel')) select(text, 'text', text.getAttribute('data-edit')); return; }
        if (photo) { select(photo, 'photo', photo.getAttribute('data-photo')); return; }
        if (block) { select(block, 'block', block.getAttribute('data-block')); return; }
        clearSelection();
      });

      // Enter commits, Escape backs out
      document.addEventListener('keydown', (e) => {
        const el = canvas() && canvas().querySelector('[contenteditable="true"]');
        if (e.key === 'Escape') { clearSelection(); return; }
        if (e.key === 'Enter' && el && document.activeElement === el && !e.shiftKey) {
          e.preventDefault();
          commitText(el);
          clearSelection(false);
        }
      });

      document.addEventListener('focusout', (e) => {
        if (e.target && e.target.isContentEditable) {
          commitText(e.target);
          if (S.renderQueued) { S.renderQueued = false; render(); }
        }
      });

      $('target-clear').addEventListener('click', () => { clearSelection(); $('agent-text').focus(); });

      $('meter-go').addEventListener('click', () => { $('meter-back').hidden = true; });
      $('meter-ask').addEventListener('click', openRefer);
      $('along-cancel').addEventListener('click', () => { $('along-back').hidden = true; });
      $('along-save').addEventListener('click', saveAlong);
      $('along-name').addEventListener('input', alongReady);
      $('along-contact').addEventListener('keydown', (e) => { if (e.key === 'Enter') saveAlong(); });
      $('along-back').addEventListener('click', (e) => {
        if (e.target === $('along-back')) $('along-back').hidden = true;
      });
      $('refer-cancel').addEventListener('click', () => { $('refer-back').hidden = true; });
      $('refer-close').addEventListener('click', () => { $('refer-back').hidden = true; });
      $('refer-again').addEventListener('click', openRefer);
      $('refer-send').addEventListener('click', sendRefer);
      $('refer-name').addEventListener('input', referReady);
      $('refer-email').addEventListener('input', referReady);
      $('refer-email').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') sendRefer();
      });
      $('refer-back').addEventListener('click', (e) => {
        if (e.target === $('refer-back')) $('refer-back').hidden = true;
      });
      $('meter-back').addEventListener('click', (e) => {
        if (e.target === $('meter-back')) $('meter-back').hidden = true;
      });

      // ══════════════════════════════════════════════
      //  Colour: swatches and tone
      // ══════════════════════════════════════════════
      const SWATCHES = ['#2563eb', '#0ea5e9', '#0d9488', '#16a34a', '#65a30d', '#ca8a04',
                        '#ea580c', '#dc2626', '#db2777', '#7c3aed', '#78350f', '#111827'];

      const TONES = {
        light: { page: '#ffffff', ink: '#101418', soft: '#5b6472', line: '#e7ebf0', card: '#ffffff' },
        warm:  { page: '#fffaf3', ink: '#1b1410', soft: '#6b5a4c', line: '#efe2d2', card: '#fffdf9' },
        dark:  { page: '#0e1116', ink: '#f2f5fa', soft: '#a2acbd', line: '#232a35', card: '#161b23' },
      };

      function applyTone() {
        const tone = TONES[S.site.tone || 'light'];
        const el = canvas();
        if (!el) return;
        el.style.setProperty('--pv-page', tone.page);
        el.style.setProperty('--pv-ink', tone.ink);
        el.style.setProperty('--pv-soft', tone.soft);
        el.style.setProperty('--pv-line', tone.line);
        el.style.setProperty('--pv-card', tone.card);
        el.style.setProperty('--pv-wash', S.site.tone === 'dark'
          ? mix((S.site.palette || {}).primary || '#2563eb', '#0e1116', 0.86)
          : (S.site.palette || {}).wash || '#f6f8fb');
        document.querySelectorAll('.tone[data-tone]').forEach((b) =>
          b.classList.toggle('on', b.dataset.tone === (S.site.tone || 'light')));
        document.querySelectorAll('.swatch').forEach((b) =>
          b.classList.toggle('on', b.dataset.colour === (S.site.palette || {}).primary));
        document.querySelectorAll('.style[data-style]').forEach((b) =>
          b.classList.toggle('on', b.dataset.style === (S.site.style || 'modern')));
      }

      function paint(colour, quiet) {
        snapshot();
        // A selected band gets its own colour; otherwise it is the whole site
        if (S.sel && S.sel.kind === 'block') {
          const sec = S.site.sections[Number(S.sel.path.split('.')[1])];
          if (sec && sec.type === 'band') {
            sec.tint = colour;
            render();
            if (!quiet) did('Band painted');
            return;
          }
        }
        S.site.palette = paletteFrom(colour);
        render();
        if (!quiet) did('Colours updated');
      }

      const STYLE_NOTES = {
        modern: 'Clean and current — rounded, soft shadows, plenty of air.',
        brutal: 'Loud and blocky — heavy type, hard edges, black borders. People remember it.',
        classic: 'Quiet and serif — hairlines, wide letter-spacing, an established look.',
        cafe: 'For places that serve food — full-bleed photo, warm cream and espresso, and the menu doing the talking.',
        physio: 'Light and airy for clinics — pale paper, deep sage, a fine serif, and what you treat leading the page.',
        trade: 'Dark and blunt for tradies — the phone number everywhere, areas covered, and photos of real jobs.',
        yoga: 'A studio page — the week on one screen, passes with their prices on them, and teachers with faces. Warm sand and a serif.',
        pilates: 'The same studio page, cooler and flatter. Timetable, passes, teachers — more gym than temple.',
        reel: 'Video first — a subject and the films already made about it. One feature up top, the rest on a wall, every one credited to whoever made it.',
        rugby: 'For a rugby club — grades by age so a parent finds their kid in one look, the sponsors up where they belong, subs and training nights, and the clubrooms.',
        soccer: 'The club page in football colours — grades, fixtures, subs, training, and the businesses that pay for the strips.',
        basketball: 'The club page for a basketball club — grades, the schedule, subs, and your sponsors on the wall.',
        charity: 'For an appeal or a trust — every amount is a price tag on a real thing, where the money goes is on the page, and your charity number sits in the footer where anyone can check it.',
        townhall: 'For a hall let out by the hour — two rates because community groups pay less, capacity by layout, what is actually in the kitchen, and the bond.',
        daycare: 'For an early childhood centre — fees banded by age, 20 Hours ECE explained properly, your ratios and licence, and how a day actually goes.',
        workshop: 'For makers who teach — pottery, jewellery, wood, glass. Paper and unglazed clay, the classes as cards, and every one of them saying what you carry out of the door.',
        sauna: 'For saunas, bathhouses and ice baths — a dark room with the heat under it, the round explained for a first-timer, and sessions priced by the body and the pass.',
        beauty: 'For salons and spas — one photograph given room, treatments priced in the open, and a booking button that follows you down the page.',
        montage: 'A title and then nothing but pictures — a wall of them, and anyone can add one. No dates, no portrait, no words to speak of.',
        tribute: 'A memorial page — a name, two dates, and a wall of photographs. Almost no words.',
        listing: 'One thing for sale — big photos, the price, the numbers, and an honest list of what is wrong with it.',
        mogged: 'Confident and sales-led for people who sell expertise — a heavy headline with one word in italic, three proofs, a wall of client names, and a definition of what you want to be known for.',
        eggs: 'For people who make a thing rather than do a job — the range, the certifications, the numbers, and where to buy it. Cream and warm orange.',
        game: 'Space Invaders, where the invaders are what you do — shoot one and it tells you what it was. Everything is written out plainly underneath.',
        bubbles: 'A gallery that floats — every picture is a bubble, and bursting one tells you what it is. For makers, artists and anyone whose work is the pitch.',
        chain: 'A collective message for one person — it collects until it hits a target, and nobody can read a word until it does.',
        diet: 'A food diary in public — a row a day with what you ate, marked good or bad, and a plain line for every day you skipped.',
      };

      function setStyle(style, quiet) {
        if (!STYLE_NOTES[style] || S.site.style === style) return false;
        snapshot();
        S.site.style = style;
        renderedKeys = new Set();
        render();
        if (!quiet) did(style[0].toUpperCase() + style.slice(1) + ' style');
        return true;
      }

      // Keep the little disc on the Colour button showing what is actually on.
      function markColour() {
        const dot = $('colour-now');
        if (dot) dot.style.background = (S.site.palette || {}).primary || '#2563eb';
      }

      function buildSwatches() {
        const row = $('swatches');
        if (!row || row.childElementCount) return;

        const open = $('colour-open');
        open.addEventListener('click', () => {
          const shut = row.hidden;
          row.hidden = !shut;
          open.setAttribute('aria-expanded', String(shut));
        });
        markColour();
        SWATCHES.forEach((c) => {
          const b = document.createElement('button');
          b.className = 'swatch';
          b.dataset.colour = c;
          b.style.background = c;
          b.title = c;
          b.addEventListener('click', () => { paint(c); markColour(); });
          row.appendChild(b);
        });
        document.querySelectorAll('.style[data-style]').forEach((b) =>
          b.addEventListener('click', () => setStyle(b.dataset.style)));
        document.querySelectorAll('.tone[data-tone]').forEach((b) =>
          b.addEventListener('click', () => {
            snapshot();
            S.site.tone = b.dataset.tone;
            render();
            did(b.dataset.tone[0].toUpperCase() + b.dataset.tone.slice(1) + ' background');
          }));
        $('roll-colour').addEventListener('click', () => {
          const next = SWATCHES[Math.floor(Math.random() * SWATCHES.length)];
          paint(next, true);
          markColour();
          did('Rolled a new colour');
        });
      }
      buildSwatches();
      canvas().classList.add('pickable');
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  Media library
      // ══════════════════════════════════════════════
      function addMedia(url, source) {
        if (!url || !/^https?:\/\//i.test(url)) return;
        if (S.media.some((m) => m.url === url)) return;
        S.media.push({ url: url, source: source || 'found' });
      }

      function mediaInUse(url) {
        if (S.site.heroImage === url || S.site.logo === url) return true;
        return (S.site.sections || []).some((sec) => (sec.images || []).includes(url));
      }

      function renderMedia() {
        const grid = $('media-grid');
        grid.innerHTML = '';
        $('media-empty').hidden = S.media.length > 0;
        $('media-count').textContent = S.mediaTarget
          ? 'Pick one for the ' + labelFor(S.mediaTarget.path).toLowerCase()
          : S.media.length
            ? S.media.length + (S.media.length === 1 ? ' photo' : ' photos')
            : '';

        S.media.forEach((item) => {
          const card = document.createElement('div');
          // Picking a photo means clicking the photo. The small button below it
          // stays for keyboard and for clarity, but nobody should have to find
          // it — the obvious target was doing nothing at all.
          card.className = 'media-item' + (mediaInUse(item.url) ? ' in-use' : '')
            + (S.mediaTarget ? ' is-picker' : '');

          const shot = document.createElement('span');
          shot.className = 'media-shot';
          shot.style.backgroundImage = 'url(' + item.url + ')';
          card.appendChild(shot);

          const meta = document.createElement('div');
          meta.className = 'media-meta';
          const src = document.createElement('span');
          src.className = 'media-src';
          src.textContent = mediaInUse(item.url) ? 'on the page' : item.source;
          meta.appendChild(src);

          // Opened from a photo on the page, the library is a picker: one
          // button that puts this image in that slot.
          const acts = S.mediaTarget
            ? [['Use this', () => { snapshot(); setByPath(S.mediaTarget.path, item.url); }]]
            : [['Hero', () => { snapshot(); S.site.heroImage = item.url; }],
               ['Gallery', () => {
                  snapshot();
                  const gallery = S.site.sections.find((x) => x.type === 'gallery');
                  if (gallery) gallery.images = [...(gallery.images || []), item.url].slice(0, 8);
                  else S.site.sections.push({ type: 'gallery', images: [item.url] });
                }],
               ['Logo', () => { snapshot(); S.site.logo = item.url; }]];

          const run = (label, apply) => {
            apply();
            renderedKeys = new Set();
            render();
            if (S.mediaTarget) {
              $('media-back').hidden = true;
              S.mediaTarget = null;
              did('Photo swapped');
              return;
            }
            renderMedia();
            did(label === 'Gallery' ? 'Added a photo to the gallery' : label + ' photo set');
          };

          acts.forEach(([label, apply]) => {
            const b = document.createElement('button');
            b.className = 'media-act';
            b.textContent = label;
            b.addEventListener('click', (e) => { e.stopPropagation(); run(label, apply); });
            meta.appendChild(b);
          });

          // Clicking anywhere on the card picks it, when the library was opened
          // to fill a slot. The × has its own stopPropagation already.
          if (S.mediaTarget) {
            const [label, apply] = acts[0];
            card.setAttribute('role', 'button');
            card.setAttribute('tabindex', '0');
            card.setAttribute('aria-label', 'Use this photo');
            card.addEventListener('click', () => run(label, apply));
            card.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); run(label, apply); }
            });
          }

          // There was no way to get rid of anything at all.
          const drop = document.createElement('button');
          drop.className = 'media-drop';
          drop.innerHTML = '&#10005;';
          drop.title = 'Take this out of the library';
          drop.setAttribute('aria-label', 'Remove from library');
          drop.addEventListener('click', (e) => {
            e.stopPropagation();
            S.media = S.media.filter((m) => m.url !== item.url);
            renderMedia();
          });
          card.appendChild(drop);

          card.appendChild(meta);
          grid.appendChild(card);
        });
      }

      // What we honestly have. Vision verdicts if the images were looked at,
      // and nothing claimed about confidence if they were not.
      function mediaTally() {
        const uploaded = S.media.filter((m) => m.source === 'yours').length;
        let theirs = uploaded;
        let confidence = null;
        if (S.scraped) {
          if (Array.isArray(S.scraped.vision)) {
            theirs += S.scraped.vision.filter((v) => v.kind === 'photo' && v.quality >= 3).length;
            confidence = typeof S.scraped.mediaConfidence === 'number'
              ? S.scraped.mediaConfidence
              : null;
          } else {
            theirs += (S.scraped.galleryImages || []).length;
          }
        }
        return { theirs: theirs, confidence: confidence };
      }

      function openMedia(target) {
        S.mediaTarget = target || null;
        // Anything already on the page or scraped counts as media
        (S.site.images || []).forEach((u) => addMedia(u, 'their site'));
        if (S.scraped) {
          addMedia(S.scraped.heroImage, 'their site');
          addMedia(S.scraped.logoUrl, 'their site');
          (S.scraped.galleryImages || []).forEach((u) => addMedia(u, 'their site'));
        }
        addMedia(S.site.heroImage, 'their site');
        renderMedia();
        $('media-back').hidden = false;
      }

      // Style panel — a dropdown off the head, so the thread stays clean.
      const paintPanel = $('agent-paint');
      const styleBtn = $('style-btn');
      function setPaint(open) {
        paintPanel.hidden = !open;
        styleBtn.classList.toggle('on', open);
        styleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      styleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setPaint(paintPanel.hidden);
      });
      paintPanel.addEventListener('click', (e) => e.stopPropagation());
      document.addEventListener('click', () => { if (!paintPanel.hidden) setPaint(false); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !paintPanel.hidden) setPaint(false);
      });

      $('media-btn').addEventListener('click', () => openMedia(null));
      $('media-close').addEventListener('click', () => { $('media-back').hidden = true; S.mediaTarget = null; });
      $('media-back').addEventListener('click', (e) => {
        if (e.target === $('media-back')) $('media-back').hidden = true;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !$('media-back').hidden) $('media-back').hidden = true;
      });

      // A screenshot off a retina display is a 10MB PNG, and base64 makes it
      // 13MB on the wire before the worker has to walk it a byte at a time.
      // Nothing on a web page needs to be wider than this, so shrink first and
      // let the original go. Falls back to the untouched file if anything in
      // here fails — a slow upload beats no upload.
      const MAX_EDGE = 2000;
      function shrink(file) {
        return new Promise((resolve) => {
          if (!/^image\//.test(file.type) || /svg|gif/.test(file.type)) return resolve(file);
          const img = new Image();
          const src = URL.createObjectURL(file);
          img.onload = () => {
            URL.revokeObjectURL(src);
            const scale = Math.min(1, MAX_EDGE / Math.max(img.width, img.height));
            if (scale === 1 && file.size < 1.5e6) return resolve(file);
            try {
              const canvas = document.createElement('canvas');
              canvas.width = Math.round(img.width * scale);
              canvas.height = Math.round(img.height * scale);
              canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
              canvas.toBlob(
                (blob) => resolve(blob && blob.size < file.size ? blob : file),
                'image/jpeg',
                0.9
              );
            } catch (err) { resolve(file); }
          };
          img.onerror = () => { URL.revokeObjectURL(src); resolve(file); };
          img.src = src;
        });
      }

      // One upload path, whether the file arrived through the picker or off the
      // clipboard. Returns the URLs that made it.
      async function ingestImages(files) {
        const list = [...files].slice(0, 12);
        const urls = [];
        for (const raw of list) {
          try {
            const file = await shrink(raw);
            const dataUrl = await new Promise((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result);
              reader.onerror = reject;
              reader.readAsDataURL(file);
            });
            const res = await fetch('/api/upload', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ image: dataUrl }),
            });
            const data = await res.json();
            if (data.url) { addMedia(data.url, 'yours'); urls.push(data.url); }
          } catch (err) {
            console.error('upload failed', err);
          }
        }
        renderMedia();
        return urls;
      }

      $('media-file').addEventListener('change', async (e) => {
        const files = [...(e.target.files || [])].slice(0, 12);
        if (!files.length) return;
        $('media-count').textContent = 'Uploading ' + files.length + '…';
        const urls = await ingestImages(files);
        e.target.value = '';
        if (urls.length) did(urls.length + (urls.length === 1 ? ' photo uploaded' : ' photos uploaded'));
      });

      // ── Paste ────────────────────────────────────
      // A screenshot on the clipboard is the fastest a photo ever gets from
      // someone's screen into their site. It should not need a file picker.
      document.addEventListener('paste', async (e) => {
        const items = [...((e.clipboardData && e.clipboardData.items) || [])];
        const files = items
          .filter((i) => i.kind === 'file' && /^image\//.test(i.type))
          .map((i) => i.getAsFile())
          .filter(Boolean);
        // No image on the clipboard means this is an ordinary text paste, and
        // the field it landed in should get it untouched.
        if (!files.length) return;
        e.preventDefault();

        // Show it straight away off the local file, so the thread reacts at
        // clipboard speed rather than at upload speed.
        const holders = files.map((file) => {
          const el = document.createElement('div');
          el.className = 'msg msg-user msg-shot pending';
          const img = document.createElement('img');
          img.src = URL.createObjectURL(file);
          img.alt = 'Pasted photo';
          el.appendChild(img);
          document.getElementById('agent-log').appendChild(el);
          return { el, img };
        });
        document.getElementById('agent-log').scrollTop = 999999;

        const urls = await ingestImages(files);

        holders.forEach((h, i) => {
          URL.revokeObjectURL(h.img.src);
          if (urls[i]) { h.img.src = urls[i]; h.el.classList.remove('pending'); }
          else { h.el.remove(); }
        });

        if (!urls.length) { say('That one would not upload, sorry — try the photos panel.'); return; }

        // If a slot in the media panel is waiting on a photo, the paste was an
        // answer to that question. Put it where it was asked for.
        if (S.mediaTarget) {
          const target = S.mediaTarget;
          snapshot();
          setByPath(target.path, urls[0]);
          S.mediaTarget = null;
          $('media-back').hidden = true;
          render();
          did('Used the pasted photo for ' + labelFor(target.path).toLowerCase());
          say('In it goes.');
          return;
        }

        did(urls.length + (urls.length === 1 ? ' photo pasted' : ' photos pasted'));
        say(urls.length === 1
          ? 'Got it. Tell me where you want it — hero, gallery, anywhere.'
          : 'Got all ' + urls.length + '. Tell me where you want them.');
      });
    </script>

    <script is:inline>
      // ══════════════════════════════════════════════
      //  The real agent: tools, in a loop, server-side
      // ══════════════════════════════════════════════
      async function askAgent(text) {
        bubble(text, 'msg-user');
        chipBox.innerHTML = '';
        S.thinking = true;
        $('agent-state').textContent = 'online · thinking';

        const dots = document.createElement('div');
        dots.className = 'typing';
        dots.innerHTML = '<i></i><i></i><i></i>';
        log.appendChild(dots);
        log.scrollTop = log.scrollHeight;

        const tally = mediaTally();

        try {
          const res = await fetch('/api/agent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              site: S.site,
              message: text,
              slug: S.slug || null,
              history: S.chat,
              selection: S.sel ? S.sel.label + ' (' + S.sel.path + ')' : null,
              sourceUrl: S.sourceUrl || null,
              theirPhotos: tally.theirs,
              mediaConfidence: tally.confidence,
              ownImages: S.media.filter((m) => m.source === 'yours').map((m) => m.url)
                .concat(S.scraped && S.scraped.galleryImages ? S.scraped.galleryImages : [])
                .concat(S.site.images || [])
                .filter(Boolean)
                .slice(0, 10),
            }),
          });

          dots.remove();

          if (res.status === 503) {
            // Missing key, or a deploy rolling over. Only give up on the agent
            // after it says so twice — a single blip shouldn't cost the session.
            S.llmMisses = (S.llmMisses || 0) + 1;
            if (S.llmMisses >= 2) S.llm = false;
            S.thinking = false;
            $('agent-state').textContent = 'online · building';
            await say("I'm running without my full brain right now, so I'll do what I can with the basics.");
            return handle(text);
          }
          S.llmMisses = 0;
          if (!res.ok) throw new Error('agent ' + res.status);

          const data = await res.json();

          snapshot();
          S.site = adopt(data.site);
          S.chat = data.history || S.chat;
          renderedKeys = new Set();
          clearSelection(false);
          render();

          (data.foundImages || []).forEach((u) => addMedia(u, 'found'));
          (data.actions || []).forEach((a) => {
            if (a.ok) did(a.summary);
            else bubble('· ' + a.summary, 'msg-note');
          });

          bubble(data.reply, 'msg-agent');
          if (data.askPhotos) {
            // They are here, now, with the photos on them. One tap, no modal ambush.
            chips([
              { label: 'Add my photos', yes: true, act: () => openMedia(null) },
              { label: 'Not now', act: () => chips(IDLE_CHIPS) },
            ]);
          } else {
            chips(IDLE_CHIPS);
          }

          // After the reply lands, not before — the modal should feel like a
          // note on what just happened, not an interruption of it.
          checkMeter(data.usage);
        } catch (error) {
          dots.remove();
          console.error(error);
          await say("That didn't go through — let me try it the simple way. Say it again if you want me to have another crack.");
          S.thinking = false;
          $('agent-state').textContent = 'online · building';
          return handle(text);
        }

        S.thinking = false;
        $('agent-state').textContent = 'online · building';
        $('agent-text').focus();
      }

      // ══════════════════════════════════════════════
      //  Publish
      // ══════════════════════════════════════════════
      async function publish() {
        if (!S.site.name) {
          await say('Give me something to publish first — what is the business called?');
          S.awaiting = 'name';
          return;
        }

        $('agent-state').textContent = 'online · publishing';
        await say('Righto. Publishing to ' + S.slug + '.garage.co.nz…', 420);

        // Claim the address while the build steps play out
        const claim = fetch('/api/build-claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: S.slug, site: S.site, sourceUrl: S.sourceUrl, token: S.token }),
        })
          .then((r) => r.json().catch(() => ({ error: 'bad-response' })))
          .catch(() => ({ error: 'network' }));

        const steps = ['Pages built', 'Images optimised', 'Mobile layout checked', 'SSL certificate issued', 'DNS pointed at ' + S.slug + '.garage.co.nz'];
        mascot();
        for (const step of steps) { did(step); await wait(430); }

        const result = await claim;
        $('agent-state').textContent = 'online · building';

        if (result.error === 'no-key' || result.error === 'not-saved') {
          // Not a contested address — the record itself cannot be written to.
          await say('I could not save to ' + S.slug + '.garage.co.nz. That address is yours, but its edit key is missing, so publishing is blocked until it is repaired. Nothing you did caused this and your changes are still here.');
          $('agent-state').textContent = 'online · needs a hand';
        } else if (result.error === 'taken') {
          await say('Ah — somebody claimed ' + S.slug + '.garage.co.nz while we were working. Give me another address and I will publish straight away.');
          S.awaiting = 'slug';
          return;
        }
        if (!result.success) {
          await say("Publishing fell over just then. Try again in a moment, or email ben@garage.co.nz and I'll sort it by hand.");
          chips(IDLE_CHIPS);
          return;
        }

        S.token = result.token;
        // Publishing is the other way somebody says a page is theirs.
        claimSite();
        sendAlongside();
        try { localStorage.setItem('garage-build:' + S.slug, result.token); } catch (e) {}

        const url = result.url || ('https://' + S.slug + '.garage.co.nz');
        $('live-url').textContent = S.slug + '.garage.co.nz';
        $('live-url').href = url;
        $('agent-state').textContent = 'online · live';
        show('live');
        confetti();

        // The number that shamed them is the number that pays them off.
        if (S.fromVisibility) showScore(url);
      }

      // Score the site we just published and put it next to the one they arrived
      // with. Nothing else on this screen means as much to them as this does.
      async function showScore(liveUrl) {
        const v = S.fromVisibility;
        const board = $('scoreboard');
        board.hidden = false;
        $('sb-was').textContent = v.score;
        $('sb-line').textContent = 'Checking the new one…';

        let now = 0;
        try {
          const res = await fetch('/api/visibility?url=' + encodeURIComponent(liveUrl));
          const data = await res.json();
          now = Number(data.score) || 0;
        } catch (e) {
          board.hidden = true;
          return;
        }

        const target = $('sb-now');
        let n = 0;
        const tick = () => {
          n += Math.max(1, Math.round((now - n) / 7));
          if (n >= now) { target.textContent = now; return; }
          target.textContent = n;
          requestAnimationFrame(tick);
        };
        tick();

        $('sb-line').textContent = v.beat && now > v.beat
          ? 'That puts you ahead of ' + (v.beatName || 'the competition') + ' on ' + v.beat + '. When AI gets asked who to ring in ' + (v.place || 'your area') + ', it can now read every word about you.'
          : 'AI can now read your services, your hours and how to reach you — none of which it could get from the old site.';
      }

      $('back-to-build').addEventListener('click', async () => {
        show('build');
        chips(IDLE_CHIPS);
      });

      $('live-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = $('live-email').value.trim();
        const note = $('live-note');
        note.style.color = 'var(--text-muted)';
        note.textContent = 'Sending…';
        try {
          const res = await fetch('/api/build-claim', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: S.slug, email: email, sourceUrl: S.sourceUrl, site: S.site, token: S.token }),
          });
          const data = await res.json();
          if (data.success) {
            note.style.color = 'var(--good)';
            note.textContent = '✓ Keys on their way to ' + email + '.';
            $('live-form').querySelector('button').textContent = 'Sent';
          } else if (data.error === 'taken') {
            note.style.color = 'var(--bad)';
            note.textContent = 'Someone grabbed that address a second ago — pick another and republish.';
          } else {
            throw new Error('failed');
          }
        } catch {
          note.style.color = 'var(--bad)';
          note.textContent = "Couldn't reach us just now — email ben@garage.co.nz and we'll sort it.";
        }
      });

      // ══════════════════════════════════════════════
      //  Confetti
      // ══════════════════════════════════════════════
      function confetti() {
        const cv = $('confetti');
        const ctx = cv.getContext('2d');
        const dpr = window.devicePixelRatio || 1;
        cv.width = cv.offsetWidth * dpr;
        cv.height = cv.offsetHeight * dpr;
        ctx.scale(dpr, dpr);

        const W = cv.offsetWidth, H = cv.offsetHeight;
        const colours = ['#2563eb', '#f97316', '#16a34a', '#eab308', '#db2777', '#7c3aed'];
        const bits = [];
        for (let i = 0; i < 140; i++) {
          bits.push({
            x: Math.random() * W,
            y: -20 - Math.random() * H * 0.6,
            w: 6 + Math.random() * 6,
            h: 8 + Math.random() * 8,
            vy: 2 + Math.random() * 3.5,
            vx: -1 + Math.random() * 2,
            rot: Math.random() * Math.PI,
            vr: -0.12 + Math.random() * 0.24,
            c: colours[(Math.random() * colours.length) | 0],
          });
        }

        const started = performance.now();
        (function frame(now) {
          ctx.clearRect(0, 0, W, H);
          const age = now - started;
          bits.forEach((b) => {
            b.x += b.vx; b.y += b.vy; b.rot += b.vr;
            ctx.save();
            ctx.translate(b.x, b.y);
            ctx.rotate(b.rot);
            ctx.globalAlpha = age > 3500 ? Math.max(0, 1 - (age - 3500) / 1500) : 1;
            ctx.fillStyle = b.c;
            ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h);
            ctx.restore();
          });
          if (age < 5000) requestAnimationFrame(frame);
          else ctx.clearRect(0, 0, W, H);
        })(started);
      }
    </script>
  </body>
</html>
