---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Free beautiful websites for New Zealand charities and community projects. No cost, no catch — just good people helping good causes.",
} = Astro.props;
const siteUrl = "https://garage.co.nz";
const fullTitle = title === "Home" ? "garage.co.nz — Free Websites for NZ Charities" : `${title} | garage.co.nz`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="garage.co.nz" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "garage.co.nz",
      "url": siteUrl,
      "description": "Free websites for New Zealand charities and community projects.",
      "areaServed": {
        "@type": "Country",
        "name": "New Zealand"
      }
    })} />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">
        <span class="logo-text">garage</span>
      </a>
      <nav class="nav">
        <a href="#work" class="nav-link">Our Work</a>
        <a href="/apply" class="nav-link nav-cta">Apply</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-content">
        <p class="footer-mission">Good websites for good people.</p>
        <p class="footer-copy">garage.co.nz — Aotearoa</p>
      </div>
    </footer>

    <!-- Cartoon sheepdog -->
    <div class="sheepdog" id="sheepdog">
      <svg viewBox="0 0 80 50" fill="none">
        <!-- Body -->
        <ellipse cx="40" cy="32" rx="22" ry="14" fill="#f5f5f5" stroke="#333" stroke-width="1.5"/>
        <!-- Spots -->
        <ellipse cx="32" cy="30" rx="8" ry="6" fill="#1a1a1a"/>
        <ellipse cx="50" cy="28" rx="6" ry="5" fill="#1a1a1a"/>
        <!-- Back legs -->
        <g class="back-legs">
          <path d="M28 42 Q26 50 24 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-bl"/>
          <path d="M35 42 Q37 50 39 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-br"/>
        </g>
        <!-- Front legs -->
        <g class="front-legs">
          <path d="M48 42 Q46 50 44 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-fl"/>
          <path d="M55 42 Q57 50 59 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-fr"/>
        </g>
        <!-- Tail -->
        <path d="M18 28 Q10 24 8 28 Q6 32 12 30" fill="#f5f5f5" stroke="#333" stroke-width="1.5" class="tail"/>
        <!-- Head -->
        <ellipse cx="62" cy="24" rx="14" ry="12" fill="#f5f5f5" stroke="#333" stroke-width="1.5"/>
        <!-- Ear -->
        <ellipse cx="54" cy="14" rx="6" ry="8" fill="#1a1a1a" stroke="#333" stroke-width="1" class="ear"/>
        <!-- Face patch -->
        <ellipse cx="66" cy="22" rx="8" ry="7" fill="#1a1a1a"/>
        <!-- Snout -->
        <ellipse cx="72" cy="26" rx="5" ry="4" fill="#f5f5f5" stroke="#333" stroke-width="1.5"/>
        <!-- Nose -->
        <ellipse cx="75" cy="25" rx="2.5" ry="2" fill="#1a1a1a"/>
        <!-- Eye -->
        <circle cx="64" cy="20" r="3" fill="#fff"/>
        <circle cx="65" cy="20" r="1.5" fill="#1a1a1a"/>
        <!-- Tongue (when running) -->
        <path d="M70 30 Q72 34 74 33" stroke="#ff6b6b" stroke-width="2" stroke-linecap="round" fill="none" class="tongue"/>
      </svg>
    </div>

    <!-- Throwable stick -->
    <div class="throw-stick" id="throw-stick">
      <svg viewBox="0 0 50 70" fill="none">
        <!-- Vibration lines - cartoon style -->
        <path d="M8 20 Q5 22 8 24" stroke="#666" stroke-width="1.5" stroke-linecap="round" fill="none" class="vibe vibe-1"/>
        <path d="M6 30 Q3 32 6 34" stroke="#666" stroke-width="1.5" stroke-linecap="round" fill="none" class="vibe vibe-2"/>
        <path d="M8 40 Q5 42 8 44" stroke="#666" stroke-width="1.5" stroke-linecap="round" fill="none" class="vibe vibe-3"/>
        <path d="M42 20 Q45 22 42 24" stroke="#666" stroke-width="1.5" stroke-linecap="round" fill="none" class="vibe vibe-1"/>
        <path d="M44 30 Q47 32 44 34" stroke="#666" stroke-width="1.5" stroke-linecap="round" fill="none" class="vibe vibe-2"/>
        <path d="M42 40 Q45 42 42 44" stroke="#666" stroke-width="1.5" stroke-linecap="round" fill="none" class="vibe vibe-3"/>
        <!-- Branch -->
        <g class="stick-body">
          <!-- Main branch -->
          <path d="M20 8 Q22 20 26 35 Q28 50 32 62" stroke="#5D4037" stroke-width="6" stroke-linecap="round" fill="none"/>
          <path d="M20 8 Q22 20 26 35 Q28 50 32 62" stroke="#795548" stroke-width="4" stroke-linecap="round" fill="none"/>
          <!-- Small twig top -->
          <path d="M21 12 Q17 8 14 6" stroke="#5D4037" stroke-width="3" stroke-linecap="round" fill="none"/>
          <path d="M21 12 Q17 8 14 6" stroke="#795548" stroke-width="2" stroke-linecap="round" fill="none"/>
          <!-- Small twig middle -->
          <path d="M25 28 Q30 24 34 22" stroke="#5D4037" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          <path d="M25 28 Q30 24 34 22" stroke="#795548" stroke-width="1.5" stroke-linecap="round" fill="none"/>
          <!-- Knot -->
          <ellipse cx="26" cy="38" rx="3" ry="2" fill="#4E342E"/>
        </g>
      </svg>
    </div>

    <!-- Flying stick (for animation) -->
    <div class="flying-stick" id="flying-stick">
      <svg viewBox="0 0 70 16" fill="none">
        <!-- Main branch -->
        <path d="M5 8 Q20 6 35 8 Q50 10 65 8" stroke="#5D4037" stroke-width="6" stroke-linecap="round" fill="none"/>
        <path d="M5 8 Q20 6 35 8 Q50 10 65 8" stroke="#795548" stroke-width="4" stroke-linecap="round" fill="none"/>
        <!-- Small twig -->
        <path d="M15 7 Q12 3 10 2" stroke="#5D4037" stroke-width="2" stroke-linecap="round" fill="none"/>
        <path d="M50 9 Q53 13 56 14" stroke="#5D4037" stroke-width="2" stroke-linecap="round" fill="none"/>
      </svg>
    </div>



    <style is:global>
      /* Throwable stick */
      .throw-stick {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 50px;
        height: 70px;
        z-index: 9998;
        cursor: pointer;
        pointer-events: auto;
        transition: transform 0.1s;
      }
      .throw-stick:hover {
        transform: scale(1.1);
      }
      .throw-stick:hover .stick-body {
        animation: wiggleStick 0.08s ease-in-out infinite;
      }
      .throw-stick .stick-body {
        animation: gentleWiggle 1.5s ease-in-out infinite;
        transform-origin: 25px 35px;
      }
      /* Cartoon vibration lines */
      .throw-stick .vibe {
        opacity: 0;
        animation: vibeFlash 0.4s ease-out infinite;
      }
      .throw-stick .vibe-1 { animation-delay: 0s; }
      .throw-stick .vibe-2 { animation-delay: 0.13s; }
      .throw-stick .vibe-3 { animation-delay: 0.26s; }
      .throw-stick.thrown {
        opacity: 0;
        pointer-events: none;
      }
      @keyframes gentleWiggle {
        0%, 100% { transform: rotate(-2deg) translateX(0); }
        25% { transform: rotate(1deg) translateX(1px); }
        50% { transform: rotate(2deg) translateX(0); }
        75% { transform: rotate(-1deg) translateX(-1px); }
      }
      @keyframes wiggleStick {
        0%, 100% { transform: rotate(-4deg) translateX(-1px); }
        50% { transform: rotate(4deg) translateX(1px); }
      }
      @keyframes vibeFlash {
        0% { opacity: 0; transform: scale(0.8); }
        20% { opacity: 0.7; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.2); }
      }

      /* Flying stick */
      .flying-stick {
        position: fixed;
        width: 70px;
        height: 16px;
        z-index: 10000;
        pointer-events: none;
        opacity: 0;
        display: none;
      }
      .flying-stick.flying {
        display: block;
        opacity: 1;
        animation: spinStick 0.3s linear infinite;
      }
      .flying-stick.landed {
        display: block;
        opacity: 1;
        animation: none;
        transform: rotate(15deg);
      }
      @keyframes spinStick {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      /* Sheepdog */
      .sheepdog {
        position: fixed;
        width: 80px;
        height: 50px;
        z-index: 9997;
        pointer-events: none;
        top: 60%;
        left: -100px;
        opacity: 0;
        transition: opacity 0.3s;
      }
      .sheepdog.visible {
        opacity: 1;
      }
      .sheepdog svg {
        width: 100%;
        height: 100%;
      }
      .sheepdog.flipped {
        transform: scaleX(-1);
      }
      .sheepdog.running .leg-bl {
        animation: dogLegBack 0.15s ease-in-out infinite;
        transform-origin: 28px 42px;
      }
      .sheepdog.running .leg-br {
        animation: dogLegBack 0.15s ease-in-out infinite reverse;
        transform-origin: 35px 42px;
      }
      .sheepdog.running .leg-fl {
        animation: dogLegFront 0.15s ease-in-out infinite;
        transform-origin: 48px 42px;
      }
      .sheepdog.running .leg-fr {
        animation: dogLegFront 0.15s ease-in-out infinite reverse;
        transform-origin: 55px 42px;
      }
      .sheepdog.running .tail {
        animation: wagTail 0.2s ease-in-out infinite;
        transform-origin: 18px 28px;
      }
      .sheepdog.running .ear {
        animation: flopEar 0.15s ease-in-out infinite;
        transform-origin: 54px 18px;
      }
      .sheepdog.running .tongue {
        animation: wagTongue 0.2s ease-in-out infinite;
      }
      .sheepdog:not(.running) .tongue {
        opacity: 0;
      }
      @keyframes dogLegBack {
        0%, 100% { transform: rotate(-15deg); }
        50% { transform: rotate(15deg); }
      }
      @keyframes dogLegFront {
        0%, 100% { transform: rotate(15deg); }
        50% { transform: rotate(-15deg); }
      }
      @keyframes wagTail {
        0%, 100% { transform: rotate(-10deg); }
        50% { transform: rotate(10deg); }
      }
      @keyframes flopEar {
        0%, 100% { transform: rotate(-5deg); }
        50% { transform: rotate(5deg); }
      }
      @keyframes wagTongue {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(2px); }
      }

      @media (max-width: 640px) {
        .throw-stick {
          bottom: 20px;
          right: 20px;
        }
        .sheepdog {
          width: 60px;
          height: 38px;
        }
      }
    </style>

    <script>
      // Sheepdog logic
      const dog = document.getElementById('sheepdog');
      const throwStick = document.getElementById('throw-stick');
      const flyingStick = document.getElementById('flying-stick');

      if (dog && throwStick && flyingStick) {
        let dogX = -100;
        let dogY = window.innerHeight * 0.6;
        let dogTargetX = dogX;
        let dogTargetY = dogY;
        let dogRunning = false;
        let dogDirection = 1;
        let dogVisible = false;
        let isFetching = false;
        let stickLandX = 0;
        let stickLandY = 0;
        let hasStick = false;

        function pickDogTarget() {
          if (isFetching) return;
          const margin = 100;
          dogTargetX = margin + Math.random() * (window.innerWidth - margin * 2);
          dogTargetY = 150 + Math.random() * (window.innerHeight - 350);
        }

        function updateDog() {
          const dx = dogTargetX - dogX;
          const dy = dogTargetY - dogY;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist > 10) {
            const speed = isFetching ? 4 : 2.5;
            dogX += (dx / dist) * speed;
            dogY += (dy / dist) * speed;

            if (!dogRunning) {
              dogRunning = true;
              dog.classList.add('running');
            }

            if (dx < -5 && dogDirection !== -1) {
              dogDirection = -1;
              dog.classList.add('flipped');
            } else if (dx > 5 && dogDirection !== 1) {
              dogDirection = 1;
              dog.classList.remove('flipped');
            }
          } else {
            if (dogRunning) {
              dogRunning = false;
              dog.classList.remove('running');
            }

            // Check if fetching and reached stick
            if (isFetching && !hasStick) {
              hasStick = true;
              flyingStick.style.display = 'none';
              // Return to throw area
              const stickRect = throwStick.getBoundingClientRect();
              dogTargetX = stickRect.left - 60;
              dogTargetY = stickRect.top;
            }

            // Check if returned with stick
            if (hasStick && Math.abs(dogX - dogTargetX) < 20) {
              setTimeout(() => {
                isFetching = false;
                hasStick = false;
                throwStick.classList.remove('thrown');
              }, 500);
            }
          }

          dog.style.left = dogX + 'px';
          dog.style.top = dogY + 'px';
          requestAnimationFrame(updateDog);
        }

        // Bark sound
        const barkAudio = new Audio('/bark.mp3');
        barkAudio.volume = 0.6;

        function playBark() {
          barkAudio.currentTime = 0;
          barkAudio.play().catch(() => {});
        }

        // Throw stick on click
        throwStick.addEventListener('click', () => {
          if (isFetching || !dogVisible) return;

          // Bark!
          playBark();

          isFetching = true;
          throwStick.classList.add('thrown');

          // Calculate throw trajectory
          const stickRect = throwStick.getBoundingClientRect();
          const startX = stickRect.left;
          const startY = stickRect.top;

          // Land in visible hero/white area only
          const hero = document.querySelector('.hero, .hero-content');
          let landArea = { left: 150, right: window.innerWidth - 200, top: 180, bottom: 450 };

          if (hero) {
            const rect = hero.getBoundingClientRect();
            landArea = {
              left: Math.max(100, rect.left + 80),
              right: Math.min(window.innerWidth - 150, rect.right - 80),
              top: Math.max(140, rect.top + 60),
              bottom: Math.min(rect.bottom - 80, 500)
            };
          }

          stickLandX = landArea.left + Math.random() * (landArea.right - landArea.left);
          stickLandY = landArea.top + Math.random() * (landArea.bottom - landArea.top);

          // Animate flying stick
          flyingStick.style.display = 'block';
          flyingStick.style.left = startX + 'px';
          flyingStick.style.top = startY + 'px';
          flyingStick.classList.add('flying');
          flyingStick.classList.remove('landed');

          let progress = 0;
          const flyDuration = 800;
          const startTime = Date.now();

          function animateThrow() {
            progress = (Date.now() - startTime) / flyDuration;

            if (progress < 1) {
              const x = startX + (stickLandX - startX) * progress;
              const arcHeight = -200 * Math.sin(progress * Math.PI);
              const y = startY + (stickLandY - startY) * progress + arcHeight;

              flyingStick.style.left = x + 'px';
              flyingStick.style.top = y + 'px';
              requestAnimationFrame(animateThrow);
            } else {
              // Stick landed
              flyingStick.style.left = stickLandX + 'px';
              flyingStick.style.top = stickLandY + 'px';
              flyingStick.classList.remove('flying');
              flyingStick.classList.add('landed');

              // Send Barney to fetch
              dogTargetX = stickLandX;
              dogTargetY = stickLandY;
            }
          }

          animateThrow();
        });

        // Dog enters after a delay
        setTimeout(() => {
          dogVisible = true;
          dog.classList.add('visible');
          pickDogTarget();
          updateDog();
        }, 4000);

        // Dog runs to new spots frequently (but not while fetching)
        setInterval(() => {
          if (dogVisible && !isFetching && Math.random() < 0.5) {
            pickDogTarget();
          }
        }, 3000);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fafafa;
    --color-surface: #ffffff;
    --color-text: #0a0a0a;
    --color-text-soft: #404040;
    --color-text-muted: #737373;
    --color-border: #e5e5e5;
    --color-accent: #2563eb;
    --color-accent-soft: #dbeafe;
    --color-accent-deep: #1e40af;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-display: 'Poppins', system-ui, -apple-system, sans-serif;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
    --shadow-lg: 0 16px 48px rgba(0,0,0,0.12);
    --shadow-xl: 0 24px 64px rgba(0,0,0,0.16);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 24px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(255,255,255,0.9);
  }

  .logo {
    text-decoration: none;
  }

  .logo-text {
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-cta {
    background: var(--color-text);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
  }

  .nav-cta:hover {
    background: #27272a;
  }

  main {
    flex: 1;
  }

  footer {
    border-top: 1px solid var(--color-border);
    padding: 3rem 2rem;
    text-align: center;
    background: var(--color-surface);
  }

  .footer-mission {
    font-size: 1rem;
    color: var(--color-text-soft);
    margin-bottom: 0.5rem;
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .site-header {
      padding: 1rem;
    }

    .nav {
      gap: 1rem;
    }
  }
</style>
