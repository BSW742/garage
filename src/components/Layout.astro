<script is:inline>
(function(){
  var SLUG = 'garage', KEY = 'gg-thread';
  var host = document.getElementById('gg-chat');
  if (!host) return;
  host.innerHTML =
    '<button id="gg-launch"><i></i><span id="gg-launch-label">Chat to Ben</span></button>' +
    '<div id="gg-panel"><div class="gg-top"><i></i><span id="gg-who">Ben</span>' +
    '<button id="gg-x" aria-label="Close">&times;</button></div>' +
    '<div class="gg-log" id="gg-log"></div>' +
    '<form class="gg-form" id="gg-form">' +
    '<input id="gg-in" placeholder="Ask me anything" autocomplete="off" />' +
    '<button type="submit">Send</button></form></div>';

  var panel = document.getElementById('gg-panel');
  var log = document.getElementById('gg-log');
  var thread = null, visitor = null, asked = false;
  try {
    thread = localStorage.getItem(KEY);
    visitor = localStorage.getItem(KEY + ':who');
  } catch (e) {}

  // People answer "can I grab your name" two ways: with just their name, or
  // with their name buried in a whole question. Short, no question mark, a
  // couple of words — that is a name. Anything else is the question, and we
  // ask for the name once afterwards rather than nagging.
  function looksLikeName(text) {
    var t = text.trim();
    if (t.length > 32 || /[?@\d]/.test(t)) return null;
    var words = t.replace(/^(hi|hey|kia ora|hello|yo)[,! ]+/i, '')
                 .replace(/^(i'?m|i am|it'?s|this is|my name is|name'?s)\s+/i, '').trim();
    if (!words || words.split(/\s+/).length > 3) return null;
    return words.slice(0, 40);
  }

  function add(text, mine){
    var d = document.createElement('div');
    d.className = 'gg-m ' + (mine ? 'gg-me' : 'gg-them');
    d.textContent = text;
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
  }

  document.getElementById('gg-launch').addEventListener('click', function(){
    panel.classList.add('on');
    document.body.classList.add('gg-open');
    document.getElementById('gg-launch').style.display = 'none';
    if (!log.childElementCount) {
      add('Before I get the real human Ben — can I grab your name? And by all means ' +
          'fire away with your question. He is online far too much, so you will hear ' +
          'back soon.', false);
    }
    document.getElementById('gg-in').focus();
    pull();
  });
  document.getElementById('gg-x').addEventListener('click', function(){
    panel.classList.remove('on');
    document.body.classList.remove('gg-open');
    document.getElementById('gg-launch').style.display = '';
  });

  document.getElementById('gg-form').addEventListener('submit', async function(e){
    e.preventDefault();
    var input = document.getElementById('gg-in');
    var body = input.value.trim();
    if (!body) return;
    input.value = '';
    add(body, true);

    var name = null;
    if (!visitor) {
      name = looksLikeName(body);
      if (name) {
        visitor = name;
        try { localStorage.setItem(KEY + ':who', visitor); } catch (e) {}
      }
    }

    try {
      var res = await fetch('/api/chat', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slug: SLUG, body: body, threadId: thread || undefined,
          name: name || undefined
        })
      });
      var data = await res.json();
      if (data.threadId) {
        thread = data.threadId;
        try { localStorage.setItem(KEY, thread); } catch (e) {}
      }

      if (name) {
        setTimeout(function(){ add('Thanks ' + name + ' — what can I help with?', false); }, 350);
      } else if (!visitor && !asked) {
        asked = true;
        setTimeout(function(){ add('Onto it. Sorry — what was your name?', false); }, 350);
      }
    } catch (err) {
      add('That did not send — try again in a moment.', false);
    }
  });

  // How long ago Ben was last about, anywhere on garage.co.nz. The dot stays
  // green because he asked for it; the words are what make it feel staffed
  // rather than decorative.
  function ago(iso){
    var t = Date.parse(iso || '');
    if (!t) return null;
    var mins = Math.round((Date.now() - t) / 60000);
    if (mins < 2) return 'here now';
    if (mins < 60) return mins + ' mins ago';
    var hrs = Math.round(mins / 60);
    if (hrs < 24) return hrs === 1 ? 'an hour ago' : hrs + ' hours ago';
    var days = Math.round(hrs / 24);
    return days === 1 ? 'yesterday' : days + ' days ago';
  }

  async function freshen(){
    try {
      var r = await fetch('/api/chat/presence?slug=' + encodeURIComponent(SLUG));
      var d = await r.json();
      var when = ago(d.seenAt);
      var who = document.getElementById('gg-who');
      var lab = document.getElementById('gg-launch-label');
      if (who) who.textContent = when ? 'Ben \u00b7 ' + when : 'Ben';
      if (lab) lab.textContent = d.online ? 'Ben is here' : 'Chat to Ben';
    } catch (e) {}
  }
  freshen();
  setInterval(freshen, 60000);

  // threadId, not thread — the endpoint reads threadId and quietly returns an
  // empty list for anything else, so replies never arrived. And "after" is the
  // last message id we have, which is what stops the same reply appearing
  // twice when the panel is reopened.
  var after = 0;
  async function pull(){
    if (!thread) return;
    try {
      var res = await fetch('/api/chat?threadId=' + encodeURIComponent(thread) +
        '&slug=' + encodeURIComponent(SLUG) + '&after=' + after);
      var data = await res.json();
      (data.messages || []).forEach(function(m){
        if (m.id > after) after = m.id;
        if (m.sender !== 'visitor') add(m.body, false);
      });
    } catch (e) {}
  }
  setInterval(function(){ if (panel.classList.contains('on')) pull(); }, 5000);
})();
</script>
