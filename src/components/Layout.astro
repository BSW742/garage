---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Free beautiful websites for New Zealand charities and community projects. No cost, no catch — just good people helping good causes.",
} = Astro.props;
const siteUrl = "https://garage.co.nz";
const fullTitle = title === "Home" ? "garage.co.nz — Free Websites for NZ Charities" : `${title} | garage.co.nz`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="garage.co.nz" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "garage.co.nz",
      "url": siteUrl,
      "description": "Free websites for New Zealand charities and community projects.",
      "areaServed": {
        "@type": "Country",
        "name": "New Zealand"
      }
    })} />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">
        <span class="logo-text">garage</span>
      </a>
      <nav class="nav">
        <a href="#work" class="nav-link">Our Work</a>
        <a href="/apply" class="nav-link nav-cta">Apply</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-content">
        <p class="footer-mission">Good websites for good people.</p>
        <p class="footer-copy">garage.co.nz — Aotearoa</p>
      </div>
    </footer>

    <!-- Wandering stick man -->
    <div class="stickman" id="stickman">
      <svg viewBox="0 0 40 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="20" cy="10" r="8" />
        <line x1="20" y1="18" x2="20" y2="45" />
        <line x1="20" y1="28" x2="8" y2="38" class="arm-left" />
        <g class="arm-stick">
          <line x1="20" y1="28" x2="32" y2="38" class="arm-right" />
          <line x1="32" y1="38" x2="38" y2="65" class="stick" />
        </g>
        <line x1="20" y1="45" x2="10" y2="70" class="leg-left" />
        <line x1="20" y1="45" x2="30" y2="70" class="leg-right" />
      </svg>
    </div>

    <style is:global>
      .stickman {
        position: fixed;
        width: 48px;
        height: 96px;
        color: #404040;
        opacity: 0.7;
        z-index: 9999;
        pointer-events: none;
        top: 50%;
        left: 50px;
      }
      .stickman svg {
        width: 100%;
        height: 100%;
      }
      .stickman.walking .leg-left {
        animation: walkLeft 0.7s ease-in-out infinite;
        transform-origin: 20px 45px;
      }
      .stickman.walking .leg-right {
        animation: walkRight 0.7s ease-in-out infinite;
        transform-origin: 20px 45px;
      }
      .stickman.walking .arm-left {
        animation: armSwing 0.7s ease-in-out infinite;
        transform-origin: 20px 28px;
      }
      .stickman.walking .arm-stick {
        animation: armSwing 0.7s ease-in-out infinite reverse;
        transform-origin: 20px 28px;
      }
      .stickman.flipped {
        transform: scaleX(-1);
      }
      .stickman.tapping .arm-stick {
        animation: tapStick 0.4s ease-in-out;
        transform-origin: 20px 28px;
      }
      @keyframes walkLeft {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(-20deg); }
      }
      @keyframes walkRight {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(20deg); }
      }
      @keyframes armSwing {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(15deg); }
      }
      @keyframes tapStick {
        0% { transform: rotate(0deg); }
        30% { transform: rotate(-60deg); }
        50% { transform: rotate(-45deg); }
        70% { transform: rotate(-55deg); }
        100% { transform: rotate(0deg); }
      }
    </style>

    <script>
      const stickman = document.getElementById('stickman');
      if (stickman) {
        let x = 100;
        let y = 300;
        let targetX = x;
        let targetY = y;
        let isWalking = false;
        let isTapping = false;
        let direction = 1;

        function getHeroArea() {
          const hero = document.querySelector('.hero-content, .hero, main');
          if (hero) {
            const rect = hero.getBoundingClientRect();
            return {
              left: rect.left + 40,
              right: rect.right - 40,
              top: rect.top + 80,
              bottom: rect.bottom - 20
            };
          }
          return {
            left: 100,
            right: window.innerWidth - 100,
            top: 150,
            bottom: 500
          };
        }

        function pickNewTarget() {
          const area = getHeroArea();
          targetX = area.left + Math.random() * (area.right - area.left);
          targetY = area.top + Math.random() * (area.bottom - area.top);
        }

        function doTap() {
          if (isTapping || isWalking) return;
          isTapping = true;
          stickman.classList.add('tapping');
          setTimeout(() => {
            stickman.classList.remove('tapping');
            isTapping = false;
          }, 400);
        }

        function update() {
          const dx = targetX - x;
          const dy = targetY - y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist > 5 && !isTapping) {
            x += (dx / dist) * 0.6;
            y += (dy / dist) * 0.6;

            if (!isWalking) {
              isWalking = true;
              stickman.classList.add('walking');
            }

            if (dx < -1 && direction !== -1) {
              direction = -1;
              stickman.classList.add('flipped');
            } else if (dx > 1 && direction !== 1) {
              direction = 1;
              stickman.classList.remove('flipped');
            }
          } else {
            if (isWalking) {
              isWalking = false;
              stickman.classList.remove('walking');
            }
            if (Math.random() < 0.006) pickNewTarget();
            if (Math.random() < 0.008) doTap();
          }

          stickman.style.left = x + 'px';
          stickman.style.top = y + 'px';
          requestAnimationFrame(update);
        }

        setTimeout(() => { pickNewTarget(); update(); }, 2000);
        setInterval(() => { if (!isWalking && Math.random() < 0.25) pickNewTarget(); }, 5000);
        setInterval(() => { if (!isWalking && !isTapping && Math.random() < 0.4) doTap(); }, 3000);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fafafa;
    --color-surface: #ffffff;
    --color-text: #0a0a0a;
    --color-text-soft: #404040;
    --color-text-muted: #737373;
    --color-border: #e5e5e5;
    --color-accent: #2563eb;
    --color-accent-soft: #dbeafe;
    --color-accent-deep: #1e40af;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-display: 'Poppins', system-ui, -apple-system, sans-serif;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
    --shadow-lg: 0 16px 48px rgba(0,0,0,0.12);
    --shadow-xl: 0 24px 64px rgba(0,0,0,0.16);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 24px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(255,255,255,0.9);
  }

  .logo {
    text-decoration: none;
  }

  .logo-text {
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-cta {
    background: var(--color-text);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
  }

  .nav-cta:hover {
    background: #27272a;
  }

  main {
    flex: 1;
  }

  footer {
    border-top: 1px solid var(--color-border);
    padding: 3rem 2rem;
    text-align: center;
    background: var(--color-surface);
  }

  .footer-mission {
    font-size: 1rem;
    color: var(--color-text-soft);
    margin-bottom: 0.5rem;
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .site-header {
      padding: 1rem;
    }

    .nav {
      gap: 1rem;
    }
  }
</style>
