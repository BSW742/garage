---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Free beautiful websites for New Zealand charities and community projects. No cost, no catch — just good people helping good causes.",
} = Astro.props;
const siteUrl = "https://garage.co.nz";
const fullTitle = title === "Home" ? "garage.co.nz — Free Websites for NZ Charities" : `${title} | garage.co.nz`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="garage.co.nz" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "garage.co.nz",
      "url": siteUrl,
      "description": "Free websites for New Zealand charities and community projects.",
      "areaServed": {
        "@type": "Country",
        "name": "New Zealand"
      }
    })} />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">
        <span class="logo-text">garage<span class="dot-orange">.</span>co<span class="dot">.</span>nz</span>
      </a>
      <nav class="nav">
        <a href="/projects" class="nav-link nav-icon hide-mobile" title="Our Projects">
          <img src="/nav/projects.png" alt="Our Projects" />
        </a>
        <a href="/merch" class="nav-link nav-icon" title="Merch">
          <img src="/nav/merch-v2.png" alt="Merch" />
        </a>
        <a href="/noticeboard" class="nav-link nav-icon" title="Community noticeboard">
          <img src="/nav/megaphone-v2.png" alt="Noticeboard" />
        </a>
        <a href="/booking" class="nav-link nav-icon" title="Book a chat">
          <img src="/nav/booking.png" alt="Book" />
        </a>
        <a href="/coffee" class="nav-link nav-icon nav-coffee hide-mobile" title="My favourite coffee">
          <img src="/nav/coffee-v2.png" alt="Coffee" />
        </a>
        <a href="https://youtube.com/@raglanders" target="_blank" class="nav-link nav-icon hide-mobile" title="Raglanders YouTube">
          <img src="/nav/youtube.svg" alt="YouTube" />
        </a>
        <a href="/apply" class="nav-link nav-cta hide-mobile">Apply</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-content">
        <p class="footer-mission">Good websites for good people.</p>
        <p class="footer-copy">garage.co.nz — Aotearoa</p>
      </div>
    </footer>

    <!-- Cartoon sheepdog -->
    <div class="sheepdog" id="sheepdog">
      <svg viewBox="0 0 80 50" fill="none">
        <!-- Body -->
        <ellipse cx="40" cy="32" rx="22" ry="14" fill="#f5f5f5" stroke="#333" stroke-width="1.5"/>
        <!-- Spots -->
        <ellipse cx="32" cy="30" rx="8" ry="6" fill="#1a1a1a"/>
        <ellipse cx="50" cy="28" rx="6" ry="5" fill="#1a1a1a"/>
        <!-- Back legs -->
        <g class="back-legs">
          <path d="M28 42 Q26 50 24 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-bl"/>
          <path d="M35 42 Q37 50 39 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-br"/>
        </g>
        <!-- Front legs -->
        <g class="front-legs">
          <path d="M48 42 Q46 50 44 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-fl"/>
          <path d="M55 42 Q57 50 59 52" stroke="#333" stroke-width="4" stroke-linecap="round" class="leg-fr"/>
        </g>
        <!-- Tail -->
        <path d="M18 28 Q10 24 8 28 Q6 32 12 30" fill="#f5f5f5" stroke="#333" stroke-width="1.5" class="tail"/>
        <!-- Head -->
        <ellipse cx="62" cy="24" rx="14" ry="12" fill="#f5f5f5" stroke="#333" stroke-width="1.5"/>
        <!-- Ear -->
        <ellipse cx="54" cy="14" rx="6" ry="8" fill="#1a1a1a" stroke="#333" stroke-width="1" class="ear"/>
        <!-- Face patch -->
        <ellipse cx="66" cy="22" rx="8" ry="7" fill="#1a1a1a"/>
        <!-- Snout -->
        <ellipse cx="72" cy="26" rx="5" ry="4" fill="#f5f5f5" stroke="#333" stroke-width="1.5"/>
        <!-- Nose -->
        <ellipse cx="75" cy="25" rx="2.5" ry="2" fill="#1a1a1a"/>
        <!-- Eye -->
        <circle cx="64" cy="20" r="3" fill="#fff" class="eye-open"/>
        <circle cx="65" cy="20" r="1.5" fill="#1a1a1a" class="eye-open"/>
        <!-- Closed eye -->
        <path d="M61 20 Q64 22 67 20" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" fill="none" class="eye-closed"/>
        <!-- Tongue (when running) -->
        <path d="M70 30 Q72 34 74 33" stroke="#ff6b6b" stroke-width="2" stroke-linecap="round" fill="none" class="tongue"/>
      </svg>
    </div>

    <!-- Dog kennel -->
    <div class="kennel" id="kennel">
      <svg viewBox="0 0 50 45" fill="none">
        <!-- Main house body -->
        <rect x="5" y="18" width="40" height="25" rx="3" fill="#D2691E" stroke="#8B4513" stroke-width="2"/>
        <!-- Roof -->
        <path d="M2 20 L25 4 L48 20 Z" fill="#B22222" stroke="#8B0000" stroke-width="2"/>
        <!-- Door opening -->
        <ellipse cx="25" cy="33" rx="10" ry="9" fill="#3D2314"/>
        <!-- Roof ridge highlight -->
        <path d="M25 6 L25 4" stroke="#CD5C5C" stroke-width="3" stroke-linecap="round"/>
        <!-- Sleeping dog face (hidden until occupied) -->
        <g class="kennel-sleeper">
          <!-- Face -->
          <ellipse cx="25" cy="34" rx="7" ry="6" fill="#f5f5f5"/>
          <!-- Black patch over eye area -->
          <ellipse cx="27" cy="32" rx="4" ry="3" fill="#1a1a1a"/>
          <!-- Closed eyes - happy sleeping -->
          <path d="M22 33 Q24 31 26 33" stroke="#333" stroke-width="1.2" stroke-linecap="round" fill="none"/>
          <path d="M26 32 Q28 30 30 32" stroke="#fff" stroke-width="1.2" stroke-linecap="round" fill="none"/>
          <!-- Nose -->
          <ellipse cx="25" cy="36" rx="2" ry="1.5" fill="#1a1a1a"/>
        </g>
      </svg>
    </div>

    <!-- Throwable bone -->
    <div class="throw-stick" id="throw-stick">
      <svg viewBox="0 0 50 70" fill="none" class="bone-svg">
        <g class="stick-body">
          <!-- Bone shaft -->
          <rect x="20" y="18" width="10" height="34" rx="3" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1.5"/>
          <!-- Top knuckle left -->
          <ellipse cx="18" cy="14" rx="7" ry="6" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1.5"/>
          <!-- Top knuckle right -->
          <ellipse cx="32" cy="14" rx="7" ry="6" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1.5"/>
          <!-- Bottom knuckle left -->
          <ellipse cx="18" cy="56" rx="7" ry="6" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1.5"/>
          <!-- Bottom knuckle right -->
          <ellipse cx="32" cy="56" rx="7" ry="6" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1.5"/>
        </g>
      </svg>
    </div>

    <!-- Flying bone (for animation) -->
    <div class="flying-stick" id="flying-stick">
      <svg viewBox="0 0 70 20" fill="none">
        <!-- Bone shaft -->
        <rect x="18" y="7" width="34" height="6" rx="2" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1"/>
        <!-- Left knuckle top -->
        <ellipse cx="14" cy="6" rx="6" ry="5" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1"/>
        <!-- Left knuckle bottom -->
        <ellipse cx="14" cy="14" rx="6" ry="5" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1"/>
        <!-- Right knuckle top -->
        <ellipse cx="56" cy="6" rx="6" ry="5" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1"/>
        <!-- Right knuckle bottom -->
        <ellipse cx="56" cy="14" rx="6" ry="5" fill="#F5F5DC" stroke="#D4C5A9" stroke-width="1"/>
      </svg>
    </div>

    <!-- Poop container -->
    <div id="poop-container"></div>



    <style is:global>
      /* Kennel */
      .kennel {
        position: fixed;
        bottom: 40px;
        right: 20px;
        width: 50px;
        height: 45px;
        z-index: 9996;
        cursor: pointer;
        transition: transform 0.2s;
        filter: drop-shadow(2px 3px 2px rgba(0, 0, 0, 0.2));
      }
      .kennel:hover {
        transform: scale(1.1);
      }
      .kennel .kennel-sleeper {
        opacity: 0;
        transition: opacity 0.3s;
      }
      .kennel.occupied .kennel-sleeper {
        opacity: 1;
      }
      .kennel.occupied::after {
        content: '💤';
        position: absolute;
        top: -5px;
        right: 0px;
        font-size: 16px;
        animation: sleepBob 2s ease-in-out infinite;
      }
      @keyframes sleepBob {
        0%, 100% { transform: translateY(0); opacity: 0.7; }
        50% { transform: translateY(-5px); opacity: 1; }
      }

      /* Throwable stick */
      .throw-stick {
        position: fixed;
        bottom: 30px;
        right: 80px;
        width: 50px;
        height: 70px;
        z-index: 9998;
        cursor: pointer;
        pointer-events: auto;
        transition: transform 0.1s;
      }
      .throw-stick:hover {
        transform: scale(1.1);
      }
      .throw-stick svg {
        animation: stickJiggle 0.15s ease-in-out infinite;
        transform-origin: 25px 56px;
        filter: drop-shadow(2px 3px 2px rgba(0, 0, 0, 0.25));
      }
      .throw-stick:hover svg {
        animation: stickJiggleFast 0.08s ease-in-out infinite;
      }
      .throw-stick.thrown {
        opacity: 0;
        pointer-events: none;
      }
      @keyframes stickJiggle {
        0%, 100% { transform: rotate(-3deg); }
        50% { transform: rotate(3deg); }
      }
      @keyframes stickJiggleFast {
        0%, 100% { transform: rotate(-5deg); }
        50% { transform: rotate(5deg); }
      }

      /* Flying bone */
      .flying-stick {
        position: fixed;
        width: 70px;
        height: 20px;
        z-index: 10000;
        pointer-events: none;
        filter: drop-shadow(2px 3px 2px rgba(0, 0, 0, 0.25));
      }
      .flying-stick.spinning {
        animation: spinStick 0.3s linear infinite;
      }
      .flying-stick.landed {
        animation: none;
        transform: rotate(15deg);
      }
      @keyframes spinStick {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      /* Sheepdog */
      .sheepdog {
        position: fixed;
        width: 80px;
        height: 50px;
        z-index: 9997;
        pointer-events: none;
        top: 60%;
        left: -100px;
        opacity: 0;
        transition: opacity 0.3s;
      }
      .sheepdog.visible {
        opacity: 1;
      }
      .sheepdog svg {
        width: 100%;
        height: 100%;
      }
      .sheepdog.flipped {
        transform: scaleX(-1);
      }
      .sheepdog.running .leg-bl {
        animation: dogLegBack 0.15s ease-in-out infinite;
        transform-origin: 28px 42px;
      }
      .sheepdog.running .leg-br {
        animation: dogLegBack 0.15s ease-in-out infinite reverse;
        transform-origin: 35px 42px;
      }
      .sheepdog.running .leg-fl {
        animation: dogLegFront 0.15s ease-in-out infinite;
        transform-origin: 48px 42px;
      }
      .sheepdog.running .leg-fr {
        animation: dogLegFront 0.15s ease-in-out infinite reverse;
        transform-origin: 55px 42px;
      }
      .sheepdog.running .tail {
        animation: wagTail 0.2s ease-in-out infinite;
        transform-origin: 18px 28px;
      }
      .sheepdog.running .ear {
        animation: flopEar 0.15s ease-in-out infinite;
        transform-origin: 54px 18px;
      }
      .sheepdog.running .tongue {
        animation: wagTongue 0.2s ease-in-out infinite;
      }
      .sheepdog:not(.running) .tongue {
        opacity: 0;
      }
      .sheepdog .eye-closed {
        opacity: 0;
      }
      .sheepdog.squatting svg {
        transform: rotate(-12deg);
        transform-origin: 70px 40px;
      }
      .sheepdog.squatting .eye-open {
        opacity: 0;
      }
      .sheepdog.squatting .eye-closed {
        opacity: 1;
      }
      .sheepdog.squatting .tail {
        animation: tailLift 0.4s ease-in-out infinite;
      }
      @keyframes tailLift {
        0%, 100% { transform: rotate(10deg); }
        50% { transform: rotate(25deg); }
      }

      /* Poop */
      .poop {
        position: fixed;
        font-size: 20px;
        z-index: 9996;
        pointer-events: none;
        animation: poopDrop 0.4s ease-out forwards;
      }
      @keyframes poopDrop {
        0% { transform: scale(0) translateY(-10px); opacity: 0; }
        50% { transform: scale(1.2) translateY(0); opacity: 1; }
        100% { transform: scale(1) translateY(0); opacity: 1; }
      }
      .poop.fade {
        animation: poopFade 3s ease-out forwards;
      }
      @keyframes poopFade {
        0% { opacity: 1; }
        70% { opacity: 1; }
        100% { opacity: 0; }
      }
      @keyframes dogLegBack {
        0%, 100% { transform: rotate(-15deg); }
        50% { transform: rotate(15deg); }
      }
      @keyframes dogLegFront {
        0%, 100% { transform: rotate(15deg); }
        50% { transform: rotate(-15deg); }
      }
      @keyframes wagTail {
        0%, 100% { transform: rotate(-10deg); }
        50% { transform: rotate(10deg); }
      }
      @keyframes flopEar {
        0%, 100% { transform: rotate(-5deg); }
        50% { transform: rotate(5deg); }
      }
      @keyframes wagTongue {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(2px); }
      }

      @media (max-width: 640px) {
        .throw-stick {
          bottom: 20px;
          right: 60px;
        }
        .kennel {
          bottom: 30px;
          right: 10px;
        }
        .sheepdog {
          width: 60px;
          height: 38px;
        }
      }
    </style>

    <script>
      // Sheepdog logic
      const dog = document.getElementById('sheepdog');
      const throwStick = document.getElementById('throw-stick');
      const flyingStick = document.getElementById('flying-stick');
      const kennel = document.getElementById('kennel');

      if (dog && throwStick && flyingStick) {
        let dogX = -100;
        let dogY = window.innerHeight * 0.6;
        let dogTargetX = dogX;
        let dogTargetY = dogY;
        let dogRunning = false;
        let dogDirection = 1;
        let dogVisible = false;
        let isFetching = false;
        let stickLandX = 0;
        let stickLandY = 0;
        let hasStick = false;
        let throwCount = 0;
        let isPooping = false;
        let isReturning = false;  // Guard for return-home timeout
        let isInKennel = true;  // Toby starts in the kennel
        const poopContainer = document.getElementById('poop-container');
        const counterNum = document.getElementById('counter-num');
        const fizzContainer = document.getElementById('fizz-container');
        let globalThrowCount = 0;

        // Hide flying stick initially
        flyingStick.style.opacity = '0';

        // Load throw count from server
        fetch('/api/throws')
          .then(r => r.json())
          .then(data => {
            globalThrowCount = data.count || 0;
            if (counterNum) counterNum.textContent = globalThrowCount.toString();
          })
          .catch(() => {});

        // Fizz celebration effect
        function showFizz() {
          if (!fizzContainer) return;
          const emojis = ['✨', '🎉', '⭐', '🌟', '💫'];
          for (let i = 0; i < 6; i++) {
            const fizz = document.createElement('div');
            fizz.className = 'fizz';
            fizz.textContent = emojis[Math.floor(Math.random() * emojis.length)];
            fizz.style.left = (Math.random() * 40 + 10) + 'px';
            fizz.style.animationDelay = (Math.random() * 0.2) + 's';
            fizzContainer.appendChild(fizz);
            setTimeout(() => fizz.remove(), 1000);
          }
        }

        // Increment counter with celebration
        function incrementCounter() {
          globalThrowCount++;
          if (counterNum) {
            counterNum.textContent = globalThrowCount.toString();
            counterNum.classList.add('pop');
            setTimeout(() => counterNum.classList.remove('pop'), 400);
          }
          showFizz();
          // Save to server
          fetch('/api/throws', { method: 'POST' }).catch(() => {});
        }

        function doPoop() {
          if (isPooping || isFetching || !dogVisible || dogRunning) return;

          isPooping = true;
          dog.classList.add('squatting');
          dog.classList.remove('running');

          // Drop the poop after squatting
          setTimeout(() => {
            if (poopContainer) {
              const poop = document.createElement('div');
              poop.className = 'poop';
              poop.textContent = '💩';
              // Position at the back end (tail area)
              const poopOffsetX = dogDirection === 1 ? -5 : 45;
              poop.style.left = (dogX + poopOffsetX) + 'px';
              poop.style.top = (dogY + 30) + 'px';
              poopContainer.appendChild(poop);

              // Fade and remove after a while
              setTimeout(() => {
                poop.classList.add('fade');
                setTimeout(() => poop.remove(), 3000);
              }, 5000);
            }

            // Stand back up
            setTimeout(() => {
              dog.classList.remove('squatting');
              isPooping = false;
            }, 500);
          }, 1500);
        }

        function pickDogTarget() {
          if (isFetching) return;
          const margin = 100;
          dogTargetX = margin + Math.random() * (window.innerWidth - margin * 2);
          dogTargetY = 150 + Math.random() * (window.innerHeight - 350);
        }

        function updateDog() {
          // Don't move while pooping
          if (isPooping) {
            requestAnimationFrame(updateDog);
            return;
          }

          const dx = dogTargetX - dogX;
          const dy = dogTargetY - dogY;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist > 10) {
            const speed = isFetching ? 4 : 2.5;
            dogX += (dx / dist) * speed;
            dogY += (dy / dist) * speed;

            if (!dogRunning) {
              dogRunning = true;
              dog.classList.add('running');
            }

            if (dx < -5 && dogDirection !== -1) {
              dogDirection = -1;
              dog.classList.add('flipped');
            } else if (dx > 5 && dogDirection !== 1) {
              dogDirection = 1;
              dog.classList.remove('flipped');
            }
          } else {
            if (dogRunning) {
              dogRunning = false;
              dog.classList.remove('running');
            }


            // Check if fetching and reached stick
            if (isFetching && !hasStick) {
              hasStick = true;
              // Hide the stick - dog has it now
              flyingStick.style.opacity = '0';
              flyingStick.classList.remove('spinning', 'landed');
              // Return to throw area
              const stickRect = throwStick.getBoundingClientRect();
              dogTargetX = stickRect.left - 60;
              dogTargetY = stickRect.top;
            }

            // Check if returned with stick (only schedule once)
            if (hasStick && Math.abs(dogX - dogTargetX) < 20 && !isReturning) {
              isReturning = true;
              setTimeout(() => {
                isFetching = false;
                hasStick = false;
                isReturning = false;
                throwStick.classList.remove('thrown');
              }, 300);  // Reduced from 500ms
            }
          }

          dog.style.left = dogX + 'px';
          dog.style.top = dogY + 'px';
          requestAnimationFrame(updateDog);
        }

        // Bark sound
        const barkAudio = new Audio('/bark.mp3');
        barkAudio.volume = 0.6;

        function playBark() {
          barkAudio.currentTime = 0;
          barkAudio.play().catch(() => {});
        }

        // Throw stick on click
        throwStick.addEventListener('click', () => {
          if (isFetching) return;

          // Wake dog from kennel if sleeping
          if (isInKennel && kennel) {
            isInKennel = false;
            dogVisible = true;
            kennel.classList.remove('occupied');

            // Position dog at kennel entrance
            const kennelRect = kennel.getBoundingClientRect();
            dogX = kennelRect.left + 10;
            dogY = kennelRect.top + kennelRect.height - 50;
            dog.style.left = dogX + 'px';
            dog.style.top = dogY + 'px';

            dog.classList.add('visible');
            dog.style.opacity = '1';
          }

          if (!dogVisible) return;

          // Set state first, then bark (in case audio has async issues)
          isFetching = true;
          isReturning = false;  // Reset just in case
          throwStick.classList.add('thrown');

          playBark();
          incrementCounter();

          // Calculate throw trajectory
          const stickRect = throwStick.getBoundingClientRect();
          const startX = stickRect.left;
          const startY = stickRect.top;

          // First throw targets BEAUTIFUL, subsequent throws target other letters
          let unhitLetters: NodeListOf<Element>;
          if (throwCount === 0) {
            // First throw: only BEAUTIFUL letters
            unhitLetters = document.querySelectorAll('.hit-letter.hit-first:not(.hit)');
          } else {
            // Subsequent throws: other letters (not BEAUTIFUL)
            unhitLetters = document.querySelectorAll('.hit-letter:not(.hit-first):not(.hit)');
          }

          let targetLetter: Element | null = null;

          if (unhitLetters.length > 0) {
            targetLetter = unhitLetters[Math.floor(Math.random() * unhitLetters.length)];
            const letterRect = targetLetter.getBoundingClientRect();
            // Land stick near the letter (slight random offset)
            stickLandX = letterRect.left + letterRect.width / 2 + (Math.random() - 0.5) * 60;
            stickLandY = letterRect.top + letterRect.height + 20 + Math.random() * 30;
          } else {
            // No letters left, land in hero area
            const hero = document.querySelector('.hero, .hero-content');
            let landArea = { left: 150, right: window.innerWidth - 200, top: 180, bottom: 450 };
            if (hero) {
              const rect = hero.getBoundingClientRect();
              landArea = {
                left: Math.max(100, rect.left + 80),
                right: Math.min(window.innerWidth - 150, rect.right - 80),
                top: Math.max(140, rect.top + 60),
                bottom: Math.min(rect.bottom - 80, 500)
              };
            }
            stickLandX = landArea.left + Math.random() * (landArea.right - landArea.left);
            stickLandY = landArea.top + Math.random() * (landArea.bottom - landArea.top);
          }

          throwCount++;

          // Reset stick state and position BEFORE showing
          flyingStick.style.opacity = '0';
          flyingStick.classList.remove('landed', 'spinning');
          flyingStick.style.left = startX + 'px';
          flyingStick.style.top = startY + 'px';

          // Wait one frame to ensure position is painted, then show and animate
          requestAnimationFrame(() => {
            flyingStick.classList.add('spinning');
            flyingStick.style.opacity = '1';

            const flyDuration = 800;
            const startTime = Date.now();

            function animateThrow() {
              const elapsed = Date.now() - startTime;
              const progress = Math.min(elapsed / flyDuration, 1);

              const x = startX + (stickLandX - startX) * progress;
              const arcHeight = -200 * Math.sin(progress * Math.PI);
              const y = startY + (stickLandY - startY) * progress + arcHeight;

              flyingStick.style.left = x + 'px';
              flyingStick.style.top = y + 'px';

              if (progress < 1) {
                requestAnimationFrame(animateThrow);
              } else {
                // Stick landed
                flyingStick.classList.remove('spinning');
                flyingStick.classList.add('landed');

                // Hit the targeted letter
                if (targetLetter) {
                  targetLetter.classList.add('hit');
                }

                // Send dog to fetch
                dogTargetX = stickLandX;
                dogTargetY = stickLandY;
              }
            }

            requestAnimationFrame(animateThrow);
          });
        });

        // Kennel click - dismiss dog instantly
        if (kennel) {
          kennel.addEventListener('click', () => {
            if (!dogVisible || isFetching || isInKennel) return;

            isInKennel = true;
            kennel.classList.add('occupied');
            dog.style.opacity = '0';

            // Set position to kennel (in case we need it later)
            const kennelRect = kennel.getBoundingClientRect();
            dogX = kennelRect.left - 20;
            dogY = kennelRect.top + 10;
            dogTargetX = dogX;
            dogTargetY = dogY;
          });
        }

        // Toby starts in the kennel - mark it as occupied
        if (kennel) {
          kennel.classList.add('occupied');
        }

        // Start the dog update loop (but he stays in kennel until bone is thrown)
        updateDog();

        // Dog runs to new spots frequently (but not while fetching or in kennel)
        setInterval(() => {
          if (dogVisible && !isFetching && !isPooping && !isInKennel && Math.random() < 0.5) {
            pickDogTarget();
          }
        }, 3000);

        // Occasionally poop when idle (not in kennel)
        setInterval(() => {
          if (dogVisible && !isFetching && !isPooping && !dogRunning && !isInKennel && Math.random() < 0.3) {
            doPoop();
          }
        }, 8000);
      }
    </script>
  </body>
</html>

