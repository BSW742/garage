<script is:inline>
  // The cart in the nav, on every page.
  //
  // It used to live only on /merch and only in memory, so it vanished the
  // moment you clicked anything. Now the basket is written to localStorage by
  // the merch page and read back here, which is what lets the button follow you
  // around — and what lets it know to stay hidden, which is the usual case.
  (function () {
    var KEY = 'garage-cart';
    var btn = document.getElementById('floating-cart');
    var badge = document.getElementById('cart-count');
    if (!btn || !badge) return;

    function count() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return 0;
        var items = JSON.parse(raw);
        if (!Array.isArray(items)) return 0;
        return items.reduce(function (n, i) { return n + (Number(i && i.quantity) || 0); }, 0);
      } catch (e) {
        return 0;
      }
    }

    function paint() {
      var n = count();
      badge.textContent = String(n);
      btn.classList.toggle('is-empty', n === 0);
      btn.hidden = n === 0;
    }

    // Merch owns the cart while you are on it — it opens its own drawer and
    // calls this after every change. Everywhere else the button is a way back.
    window.garageCartPainted = paint;
    if (location.pathname !== '/merch') {
      btn.addEventListener('click', function () { location.href = '/merch'; });
    }

    // Another tab emptying the basket should empty this one's button too.
    window.addEventListener('storage', function (e) { if (e.key === KEY) paint(); });
    paint();
  })();
</script>
