---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Free beautiful websites for New Zealand charities and community projects. No cost, no catch — just good people helping good causes.",
} = Astro.props;
const siteUrl = "https://garage.co.nz";
const fullTitle = title === "Home" ? "garage.co.nz — Free Websites for NZ Charities" : `${title} | garage.co.nz`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="garage.co.nz" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "garage.co.nz",
      "url": siteUrl,
      "description": "Free websites for New Zealand charities and community projects.",
      "areaServed": {
        "@type": "Country",
        "name": "New Zealand"
      }
    })} />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">
        <span class="logo-text">garage</span>
      </a>
      <nav class="nav">
        <a href="#work" class="nav-link">Our Work</a>
        <a href="/apply" class="nav-link nav-cta">Apply</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-content">
        <p class="footer-mission">Good websites for good people.</p>
        <p class="footer-copy">garage.co.nz — Aotearoa</p>
      </div>
    </footer>

    <!-- Warning sign with escaping stick man -->
    <div class="warning-sign" id="warning-sign">
      <svg viewBox="0 0 100 90" fill="none">
        <!-- Triangle -->
        <path d="M50 5 L95 82 L5 82 Z" fill="#ff3b30" stroke="#fff" stroke-width="2"/>
        <path d="M50 15 L85 75 L15 75 Z" fill="#fff"/>
        <!-- Figure inside (will fade out) -->
        <g class="sign-figure" fill="#333">
          <circle cx="50" cy="38" r="5"/>
          <path d="M50 43 L50 58 M50 48 L42 55 M50 48 L58 52 M50 58 L43 72 M50 58 L55 72"
                stroke="#333" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          <line x1="58" y1="52" x2="62" y2="68" stroke="#333" stroke-width="2" stroke-linecap="round"/>
        </g>
      </svg>
    </div>

    <!-- The escaped stick man -->
    <div class="stickman" id="stickman">
      <svg viewBox="0 0 40 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <circle cx="20" cy="10" r="7" fill="currentColor" stroke="none"/>
        <line x1="20" y1="17" x2="20" y2="42" />
        <line x1="20" y1="26" x2="10" y2="36" class="arm-left" />
        <g class="arm-stick">
          <line x1="20" y1="26" x2="30" y2="34" class="arm-right" />
          <line x1="30" y1="34" x2="35" y2="58" class="stick" />
        </g>
        <line x1="20" y1="42" x2="12" y2="65" class="leg-left" />
        <line x1="20" y1="42" x2="28" y2="65" class="leg-right" />
      </svg>
    </div>

    <style is:global>
      .warning-sign {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 70px;
        height: 63px;
        z-index: 9998;
        opacity: 0.85;
        transition: opacity 0.3s;
        cursor: default;
      }
      .warning-sign:hover {
        opacity: 1;
      }
      .warning-sign svg {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 2px 8px rgba(0,0,0,0.15));
      }
      .warning-sign .sign-figure {
        opacity: 1;
        transition: opacity 0.5s;
      }
      .warning-sign.escaped .sign-figure {
        opacity: 0.15;
      }

      .stickman {
        position: fixed;
        width: 48px;
        height: 96px;
        color: #1a1a1a;
        z-index: 9999;
        pointer-events: none;
        opacity: 0;
        bottom: 45px;
        right: 40px;
      }
      .stickman.visible {
        opacity: 1;
      }
      .stickman svg {
        width: 100%;
        height: 100%;
      }
      .stickman.jumping {
        animation: jumpOut 0.6s ease-out forwards;
      }
      .stickman.walking .leg-left {
        animation: walkLeft 0.7s ease-in-out infinite;
        transform-origin: 20px 42px;
      }
      .stickman.walking .leg-right {
        animation: walkRight 0.7s ease-in-out infinite;
        transform-origin: 20px 42px;
      }
      .stickman.walking .arm-left {
        animation: armSwing 0.7s ease-in-out infinite;
        transform-origin: 20px 26px;
      }
      .stickman.walking .arm-stick {
        animation: armSwing 0.7s ease-in-out infinite reverse;
        transform-origin: 20px 26px;
      }
      .stickman.flipped {
        transform: scaleX(-1);
      }
      .stickman.tapping .arm-stick {
        animation: tapStick 0.4s ease-in-out;
        transform-origin: 20px 26px;
      }
      @keyframes jumpOut {
        0% { transform: scale(0.5) translateY(20px); opacity: 0; }
        50% { transform: scale(1.1) translateY(-30px); opacity: 1; }
        100% { transform: scale(1) translateY(0); opacity: 1; }
      }
      @keyframes walkLeft {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(-20deg); }
      }
      @keyframes walkRight {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(20deg); }
      }
      @keyframes armSwing {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(15deg); }
      }
      @keyframes tapStick {
        0% { transform: rotate(0deg); }
        30% { transform: rotate(-60deg); }
        50% { transform: rotate(-45deg); }
        70% { transform: rotate(-55deg); }
        100% { transform: rotate(0deg); }
      }

      @media (max-width: 640px) {
        .warning-sign {
          width: 50px;
          height: 45px;
          bottom: 20px;
          right: 20px;
        }
        .stickman {
          width: 36px;
          height: 72px;
        }
      }
    </style>

    <script>
      const stickman = document.getElementById('stickman');
      const sign = document.getElementById('warning-sign');

      if (stickman && sign) {
        let x, y;
        let targetX, targetY;
        let isWalking = false;
        let isTapping = false;
        let hasEscaped = false;
        let direction = 1;

        // Get sign position for starting point
        function getSignPos() {
          const rect = sign.getBoundingClientRect();
          return { x: rect.left, y: rect.top };
        }

        function getHeroArea() {
          const hero = document.querySelector('.hero-content, .hero, main');
          if (hero) {
            const rect = hero.getBoundingClientRect();
            return {
              left: Math.max(60, rect.left + 40),
              right: Math.min(window.innerWidth - 60, rect.right - 40),
              top: rect.top + 100,
              bottom: Math.min(rect.bottom - 20, window.innerHeight - 150)
            };
          }
          return {
            left: 100,
            right: window.innerWidth - 100,
            top: 200,
            bottom: window.innerHeight - 200
          };
        }

        function pickNewTarget() {
          const area = getHeroArea();
          targetX = area.left + Math.random() * (area.right - area.left);
          targetY = area.top + Math.random() * (area.bottom - area.top);
        }

        function doTap() {
          if (isTapping || isWalking) return;
          isTapping = true;
          stickman.classList.add('tapping');
          setTimeout(() => {
            stickman.classList.remove('tapping');
            isTapping = false;
          }, 400);
        }

        function escape() {
          const signPos = getSignPos();
          x = signPos.x;
          y = signPos.y;

          sign.classList.add('escaped');
          stickman.style.left = x + 'px';
          stickman.style.top = y + 'px';
          stickman.classList.add('visible', 'jumping');

          setTimeout(() => {
            stickman.classList.remove('jumping');
            hasEscaped = true;
            pickNewTarget();
            update();
          }, 600);
        }

        function update() {
          if (!hasEscaped) return;

          const dx = targetX - x;
          const dy = targetY - y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist > 5 && !isTapping) {
            x += (dx / dist) * 0.7;
            y += (dy / dist) * 0.7;

            if (!isWalking) {
              isWalking = true;
              stickman.classList.add('walking');
            }

            if (dx < -1 && direction !== -1) {
              direction = -1;
              stickman.classList.add('flipped');
            } else if (dx > 1 && direction !== 1) {
              direction = 1;
              stickman.classList.remove('flipped');
            }
          } else {
            if (isWalking) {
              isWalking = false;
              stickman.classList.remove('walking');
            }
            if (Math.random() < 0.005) pickNewTarget();
            if (Math.random() < 0.008) doTap();
          }

          stickman.style.left = x + 'px';
          stickman.style.top = y + 'px';
          requestAnimationFrame(update);
        }

        // Escape after a delay
        setTimeout(escape, 2500);

        // Occasionally wander to new spots
        setInterval(() => { if (hasEscaped && !isWalking && Math.random() < 0.3) pickNewTarget(); }, 5000);
        setInterval(() => { if (hasEscaped && !isWalking && !isTapping && Math.random() < 0.4) doTap(); }, 3500);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fafafa;
    --color-surface: #ffffff;
    --color-text: #0a0a0a;
    --color-text-soft: #404040;
    --color-text-muted: #737373;
    --color-border: #e5e5e5;
    --color-accent: #2563eb;
    --color-accent-soft: #dbeafe;
    --color-accent-deep: #1e40af;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-display: 'Poppins', system-ui, -apple-system, sans-serif;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
    --shadow-lg: 0 16px 48px rgba(0,0,0,0.12);
    --shadow-xl: 0 24px 64px rgba(0,0,0,0.16);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 24px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(255,255,255,0.9);
  }

  .logo {
    text-decoration: none;
  }

  .logo-text {
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-cta {
    background: var(--color-text);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
  }

  .nav-cta:hover {
    background: #27272a;
  }

  main {
    flex: 1;
  }

  footer {
    border-top: 1px solid var(--color-border);
    padding: 3rem 2rem;
    text-align: center;
    background: var(--color-surface);
  }

  .footer-mission {
    font-size: 1rem;
    color: var(--color-text-soft);
    margin-bottom: 0.5rem;
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .site-header {
      padding: 1rem;
    }

    .nav {
      gap: 1rem;
    }
  }
</style>
